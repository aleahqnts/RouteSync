@page "/trip-active/{TripId}"
@layout LoginLayout
@implements IDisposable
@inject SessionService Session
@inject DriverDataService Data
@inject ITripTracker Tracker
@inject TelemetryQueue Queue
@inject NavigationManager Nav
@using System.Text.Json

@if (loading)
{
    <div class="ta-loading">Loading...</div>
}
else if (trip is null)
{
    <div class="ta"><p class="ta-empty">Trip not found.</p></div>
}
else
{
    <MessageAlert />
    <div class="ta">
        <div class="ta-head">
            <h1>Active Trip</h1>
            <p class="status"><span class="dot"></span> In Progress</p>
        </div>
        <p class="date">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>

        <div class="bus-card">
            <span class="bus-ico"><svg viewBox="0 0 49 52" fill="none"><path d="M12.25 45.5C11.67 45.5 11.19 45.29 10.8 44.88C10.4 44.46 10.21 43.95 10.21 43.33V38.89C9.6 38.17 9.1 37.37 8.73 36.48C8.35 35.6 8.17 34.63 8.17 33.58V13C8.17 10 9.48 7.81 12.1 6.42C14.72 5.03 18.85 4.33 24.5 4.33C30.35 4.33 34.54 5 37.06 6.34C39.57 7.67 40.83 9.89 40.83 13V33.58C40.83 34.63 40.65 35.6 40.27 36.48C39.9 37.37 39.4 38.17 38.79 38.89V43.33C38.79 43.95 38.6 44.46 38.2 44.88C37.81 45.29 37.33 45.5 36.75 45.5H34.71C34.13 45.5 33.64 45.29 33.25 44.88C32.86 44.46 32.67 43.95 32.67 43.33V41.17H16.33V43.33C16.33 43.95 16.14 44.46 15.75 44.88C15.36 45.29 14.87 45.5 14.29 45.5H12.25ZM12.25 21.67H36.75V15.17H12.25V21.67ZM17.35 34.67C18.2 34.67 18.93 34.35 19.52 33.72C20.12 33.09 20.42 32.32 20.42 31.42C20.42 30.51 20.12 29.75 19.52 29.11C18.93 28.48 18.2 28.17 17.35 28.17C16.5 28.17 15.78 28.48 15.18 29.11C14.59 29.75 14.29 30.51 14.29 31.42C14.29 32.32 14.59 33.09 15.18 33.72C15.78 34.35 16.5 34.67 17.35 34.67ZM31.65 34.67C32.5 34.67 33.22 34.35 33.82 33.72C34.41 33.09 34.71 32.32 34.71 31.42C34.71 30.51 34.41 29.75 33.82 29.11C33.22 28.48 32.5 28.17 31.65 28.17C30.8 28.17 30.07 28.48 29.48 29.11C28.88 29.75 28.58 30.51 28.58 31.42C28.58 32.32 28.88 33.09 29.48 33.72C30.07 34.35 30.8 34.67 31.65 34.67ZM16.33 36.83H32.67C33.79 36.83 34.75 36.41 35.55 35.56C36.35 34.71 36.75 33.69 36.75 32.5V26H12.25V32.5C12.25 33.69 12.65 34.71 13.45 35.56C14.25 36.41 15.21 36.83 16.33 36.83Z" fill="#4BA2A3" /></svg></span>
            <div>
                <p class="bus-name">@(vehicle?.VehicleId ?? trip.VehicleId) <span class="plate">(@(vehicle?.PlateNumber ?? "—"))</span></p>
                <p class="route">@(route?.RouteName ?? $"Route {trip.RouteId}")</p>
                <p class="trip-id">Trip ID: @trip.TripId</p>
            </div>
        </div>

        <div class="counter-card">
            <p class="counter-label">Passenger Counter</p>
            @if (cameraAlive)
            {
                <p class="auto-badge"><span class="auto-dot"></span> Auto-counting (camera)</p>
                <div class="counter">
                    <span class="count">@total</span>
                </div>
            }
            else if (!ShowManual)
            {
                <p class="auto-badge pending"><span class="auto-dot"></span> Connecting to camera counter&#8230;</p>
                <div class="counter">
                    <span class="count">@total</span>
                </div>
            }
            else
            {
                <div class="counter">
                    <button class="cbtn minus" @onclick="Dec">&#8722;</button>
                    <span class="count">@total</span>
                    <button class="cbtn plus" @onclick="Inc">&#43;</button>
                </div>
            }
        </div>

        @* Camera card. Calibration itself happens on the photo editor, so this is the way
           in to it plus a liveness indicator. *@
        @if (!string.IsNullOrEmpty(CamDeviceId))
        {
            <div class="cam-card">
                <div class="cam-head-row">
                    <span class="cam-title">Camera</span>
                    <span class="cam-chip @CamChipClass">@CamChipLabel</span>
                </div>
                <button class="cam-btn calib" @onclick="@(() => Nav.NavigateTo($"/camera-calibrate/{TripId}"))">
                    Calibrate Camera
                </button>
            </div>
        }

        <div class="stat-row">
            <div class="stat-card">
                <p class="stat-label">Total Passengers</p>
                <p class="stat-value">@total</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Estimated Revenue</p>
                <p class="stat-value">&#8369;@Revenue.ToString("N2")</p>
            </div>
        </div>

        <div class="progress-card">
            <p class="prog-label">Trip Progress</p>
            <p class="prog-remaining">@Remaining</p>
            <div class="bar"><div class="fill" style="width:@(ProgressPct)%"></div></div>
            <div class="prog-times">
                <span>@DateTime.Today.Add(trip.ShiftStartTime).ToString("h:mm tt")</span>
                <span>@DateTime.Today.Add(trip.ShiftEndTime).ToString("h:mm tt")</span>
            </div>
        </div>

        <button class="btn-end" @onclick="@(() => showConfirm = true)">End Shift</button>
    </div>

    @if (showConfirm)
    {
        <div class="overlay">
            <div class="confirm">
                <div class="flag">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#2e9e8f" stroke-width="2"><path d="M5 21V4M5 4h11l-2 4 2 4H5" /></svg>
                </div>
                <h2>Are you sure you want to end this shift?</h2>
                <p class="c-sub">This will complete your shift for today.</p>

                <div class="c-card">
                    <div class="c-bus-row">
                        <span class="c-bus-ico"><svg viewBox="0 0 49 52" fill="none"><path d="M12.25 45.5C11.67 45.5 11.19 45.29 10.8 44.88C10.4 44.46 10.21 43.95 10.21 43.33V38.89C9.6 38.17 9.1 37.37 8.73 36.48C8.35 35.6 8.17 34.63 8.17 33.58V13C8.17 10 9.48 7.81 12.1 6.42C14.72 5.03 18.85 4.33 24.5 4.33C30.35 4.33 34.54 5 37.06 6.34C39.57 7.67 40.83 9.89 40.83 13V33.58C40.83 34.63 40.65 35.6 40.27 36.48C39.9 37.37 39.4 38.17 38.79 38.89V43.33C38.79 43.95 38.6 44.46 38.2 44.88C37.81 45.29 37.33 45.5 36.75 45.5H34.71C34.13 45.5 33.64 45.29 33.25 44.88C32.86 44.46 32.67 43.95 32.67 43.33V41.17H16.33V43.33C16.33 43.95 16.14 44.46 15.75 44.88C15.36 45.29 14.87 45.5 14.29 45.5H12.25ZM12.25 21.67H36.75V15.17H12.25V21.67ZM17.35 34.67C18.2 34.67 18.93 34.35 19.52 33.72C20.12 33.09 20.42 32.32 20.42 31.42C20.42 30.51 20.12 29.75 19.52 29.11C18.93 28.48 18.2 28.17 17.35 28.17C16.5 28.17 15.78 28.48 15.18 29.11C14.59 29.75 14.29 30.51 14.29 31.42C14.29 32.32 14.59 33.09 15.18 33.72C15.78 34.35 16.5 34.67 17.35 34.67ZM31.65 34.67C32.5 34.67 33.22 34.35 33.82 33.72C34.41 33.09 34.71 32.32 34.71 31.42C34.71 30.51 34.41 29.75 33.82 29.11C33.22 28.48 32.5 28.17 31.65 28.17C30.8 28.17 30.07 28.48 29.48 29.11C28.88 29.75 28.58 30.51 28.58 31.42C28.58 32.32 28.88 33.09 29.48 33.72C30.07 34.35 30.8 34.67 31.65 34.67ZM16.33 36.83H32.67C33.79 36.83 34.75 36.41 35.55 35.56C36.35 34.71 36.75 33.69 36.75 32.5V26H12.25V32.5C12.25 33.69 12.65 34.71 13.45 35.56C14.25 36.41 15.21 36.83 16.33 36.83Z" fill="#4BA2A3" /></svg></span>
                        <div>
                            <p class="c-bus-name">@(vehicle?.VehicleId ?? trip.VehicleId) <span class="plate">(@(vehicle?.PlateNumber ?? "—"))</span></p>
                            <p class="c-route">@(route?.RouteName ?? $"Route {trip.RouteId}")</p>
                        </div>
                    </div>

                    <div class="c-grid2">
                        <div><p class="c-k">Start Time</p><p class="c-v">@StartLabel</p></div>
                        <div><p class="c-k">End Time</p><p class="c-v">@PhTime.Now.ToString("h:mm tt")</p></div>
                    </div>
                    <div class="c-div"></div>
                    <div class="c-grid2">
                        <div><p class="c-k">Total Passengers</p><p class="c-v">@total</p></div>
                        <div><p class="c-k">Estimated Revenue</p><p class="c-v">&#8369;@Revenue.ToString("N2")</p></div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(msg))
                {
                    <p class="err">@msg</p>
                }

                <div class="c-actions">
                    <button class="btn-cancel" @onclick="@(() => showConfirm = false)" disabled="@ending">Cancel</button>
                    <button class="btn-endred" @onclick="EndTrip" disabled="@ending">End Shift</button>
                </div>
            </div>
        </div>
    }
}

@if (askLeave)
{
    @* Back from the counter asks first. The trip is unaffected either way, but leaving by
       accident mid-boarding costs the driver the tap controls until they navigate back. *@
    <div style="position:fixed; inset:0; z-index:9400; background:rgba(15,22,44,.55);
                display:flex; align-items:center; justify-content:center; padding:28px;"
         @onclick="@(() => askLeave = false)">
        <div style="width:100%; max-width:340px; background:#fff; border-radius:20px;
                    padding:22px 20px 16px; box-shadow:0 24px 60px rgba(15,22,44,.45);"
             @onclick:stopPropagation="true">
            <p style="margin:0 0 6px; font:800 18px sans-serif; color:#1b2a56;">Leave the counter?</p>
            <p style="margin:0 0 18px; font:14px sans-serif; color:#5a6473; line-height:1.45;">
                The trip keeps running and your count is saved. You can come back from Home.
            </p>
            <div style="display:flex; gap:10px;">
                <button @onclick="@(() => askLeave = false)"
                        style="flex:1; padding:12px 0; border:1px solid #e2e5ec; border-radius:999px;
                               background:#fff; color:#1b2a56; font:700 14px sans-serif; cursor:pointer;">
                    Stay
                </button>
                <button @onclick="LeaveToHome"
                        style="flex:1; padding:12px 0; border:none; border-radius:999px;
                               background:#1b2a56; color:#fff; font:700 14px sans-serif; cursor:pointer;">
                    Leave
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string TripId { get; set; } = "";

    private bool loading = true;
    private bool showConfirm;
    private bool ending;
    private string? msg;
    private int total;
    private decimal fare;
    private Trip? trip;
    private BusRoute? route;
    private Vehicle? vehicle;

    private bool askLeave;

    private System.Threading.Timer? timer;
    private int tick;
    private DateTime now = PhTime.Now;

    // A fresh heartbeat means the camera owns the count, so the manual controls hide.
    private bool cameraAlive;
    private int hbPollFails;
    private static readonly TimeSpan HeartbeatStale = TimeSpan.FromSeconds(12);

    // Manual counting is the fallback, not the default. The camera takes about 10 seconds
    // to send its first heartbeat, from a 4s trip poll and a 5s flush, so a grace window
    // covers the start of a trip rather than showing the buttons and taking them away.
    //
    // The grace applies only until the first heartbeat of the trip arrives. After that a
    // stale heartbeat means the camera has died, so the manual controls appear at once.
    private bool cameraSeen;
    private DateTime graceEndUtc = DateTime.MaxValue;
    private static readonly TimeSpan CameraGrace = TimeSpan.FromSeconds(30);
    private bool ShowManual => !cameraAlive && (cameraSeen || DateTime.UtcNow >= graceEndUtc);

    private string CountKey => $"trip_count_{TripId}";
    private string CacheKey => $"trip_cache_{TripId}";
    private const string ActiveKey = "fw_active_trip";
    private decimal Revenue => total * fare;

    private string StartLabel => trip?.ActualStartTime is not null
        ? PhTime.Raw(trip.ActualStartTime.Value).ToString("h:mm tt")
        : (trip is null ? "" : DateTime.Today.Add(trip.ShiftStartTime).ToString("h:mm tt"));

    // The shift window is anchored to the trip's own date. An end at or before the start
    // means an overnight shift, for example 10pm to 6am, whose end rolls to the next day
    // so the progress bar and the countdown cover the same real period.
    private DateTime ShiftStart => trip is null ? DateTime.MinValue : trip.Date.Date + trip.ShiftStartTime;
    private DateTime ShiftEnd => trip is null ? DateTime.MinValue
        : trip.Date.Date + trip.ShiftEndTime + (trip.ShiftEndTime <= trip.ShiftStartTime ? TimeSpan.FromDays(1) : TimeSpan.Zero);

    private int ProgressPct
    {
        get
        {
            if (trip is null) return 0;
            if (now <= ShiftStart) return 0;
            if (now >= ShiftEnd) return 100;
            var pct = (now - ShiftStart).TotalSeconds / (ShiftEnd - ShiftStart).TotalSeconds * 100;
            return (int)Math.Clamp(pct, 0, 100);
        }
    }

    private string Remaining
    {
        get
        {
            if (trip is null) return "";
            var left = ShiftEnd - now;
            if (left <= TimeSpan.Zero) return "Shift ended";
            return $"{(int)left.TotalHours}h {left.Minutes}m remaining";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/"); return; }

        // Network first, falling back to the cached trip when offline, so counting
        // survives dead zones and app restarts.
        try
        {
            trip = await Data.GetTripAsync(TripId);
            if (trip is not null)
            {
                route = await Data.GetRouteAsync(trip.RouteId);
                vehicle = await Data.GetVehicleAsync(trip.VehicleId);
                fare = await Data.GetFareAsync();
                await SaveCacheAsync();
            }
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[TripActive.Load] {ex}"); }

        try
        {
        if (trip is null) await LoadCacheAsync();

        // A finished trip must never reach the counting screen. Opening it here would set
        // this trip as the resume target and start GPS tracking against it, so a stray
        // navigation would attach telemetry to a trip that ended and send the next app
        // launch straight back into it.
        if (trip is not null && !string.Equals(trip.TripStatus, "Active", StringComparison.OrdinalIgnoreCase))
        {
            // Clear the resume target too, so a stale one does not send every launch back
            // through this screen.
            if (await SecureStorage.Default.GetAsync(ActiveKey) == TripId)
                SecureStorage.Default.Remove(ActiveKey);

            Nav.NavigateTo($"/trip-report/{TripId}", new NavigationOptions { ReplaceHistoryEntry = true });
            return;
        }

        if (trip is not null)
        {
            // Prefer the locally saved running count, which survives a crash.
            var saved = await SecureStorage.Default.GetAsync(CountKey);
            total = int.TryParse(saved, out var s) ? s : trip.TotalBoarded;
            // Seed the mirror so the tracker has a count to log from its first fix.
            await SecureStorage.Default.SetAsync(CountKey, total.ToString());

            // The camera may already be counting this trip, after an app restart
            // mid-trip. Its heartbeat is evaluated before the first poll so the manual
            // controls do not appear and immediately disappear.
            graceEndUtc = DateTime.UtcNow + CameraGrace;
            ApplyCameraState(trip);

            // Record this trip as the resume target and start background tracking.
            await SecureStorage.Default.SetAsync(ActiveKey, TripId);
            // Location access is confirmed here because this is the one screen both Start
            // Trip and Resume Trip land on. Resuming skips the trip details page, and the
            // grant may have been revoked since the last trip.
            await EnsureLocationPermissionAsync();
            Tracker.Start(TripId);

            // Hardware back asks before leaving, because a single stray press mid-boarding
            // takes the tap controls away until the driver navigates back.
            BackNavigation.PageHandler = HandleHardwareBack;

            // Back online, so drain any queued telemetry and trip finalizations.
            _ = Queue.FlushAsync();
        }
        }
        finally
        {
            // Cleared whatever happened above. Left raised by a throw, the counting screen
            // shows a skeleton over a trip that is already running, and the only way out is
            // to leave the page and come back.
            loading = false;
        }

        // One tick a second for the progress bar, with a database flush every 15.
        timer = new System.Threading.Timer(_ => OnTick(), null, 1000, 1000);
    }

    // Foreground location is requested before background. The request repeats whenever
    // the grant is missing, so the driver is prompted in the app rather than having to
    // find the setting.
    private static async Task EnsureLocationPermissionAsync()
    {
        try
        {
            var s = await Permissions.CheckStatusAsync<Permissions.LocationWhenInUse>();
            if (s != PermissionStatus.Granted)
                await Permissions.RequestAsync<Permissions.LocationWhenInUse>();

            var bg = await Permissions.CheckStatusAsync<Permissions.LocationAlways>();
            if (bg != PermissionStatus.Granted)
                await Permissions.RequestAsync<Permissions.LocationAlways>();
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[TripActive.Perm] {ex}"); }
    }

    private async Task SaveCacheAsync()
    {
        if (trip is null) return;
        var c = new TripCache(trip.TripId, vehicle?.VehicleId ?? trip.VehicleId,
            vehicle?.PlateNumber ?? "—", trip.RouteId, route?.RouteName ?? $"Route {trip.RouteId}",
            trip.ShiftStartTime.Ticks, trip.ShiftEndTime.Ticks, trip.Date.Ticks,
            trip.TotalBoarded, fare, trip.TripStatus, trip.ActualStartTime?.Ticks);
        await SecureStorage.Default.SetAsync(CacheKey, JsonSerializer.Serialize(c));
    }

    private async Task LoadCacheAsync()
    {
        var json = await SecureStorage.Default.GetAsync(CacheKey);
        if (string.IsNullOrEmpty(json)) return;
        var c = JsonSerializer.Deserialize<TripCache>(json);
        if (c is null) return;
        trip = new Trip
        {
            TripId = c.TripId, VehicleId = c.VehicleId, RouteId = c.RouteId,
            ShiftStartTime = TimeSpan.FromTicks(c.StartTicks), ShiftEndTime = TimeSpan.FromTicks(c.EndTicks),
            Date = new DateTime(c.DateTicks), TotalBoarded = c.TotalBoarded, TripStatus = c.Status,
            ActualStartTime = c.ActualStartTicks is null ? null : new DateTime(c.ActualStartTicks.Value)
        };
        route = new BusRoute { RouteName = c.RouteName };
        vehicle = new Vehicle { VehicleId = c.VehicleId, PlateNumber = c.Plate };
        fare = c.Fare;
    }

    private record TripCache(string TripId, string VehicleId, string Plate, int RouteId,
        string RouteName, long StartTicks, long EndTicks, long DateTicks, int TotalBoarded,
        decimal Fare, string Status, long? ActualStartTicks);

    private void OnTick()
    {
        now = PhTime.Now;
        tick++;
        // While the camera is alive it owns trips.total_boarded, so the manual flush is
        // suppressed and the two never write over each other. It resumes on its own once
        // the heartbeat goes stale.
        if (tick % 15 == 0 && !cameraAlive) _ = Flush();
        if (tick % 5 == 0) _ = RefreshCameraStateAsync();
        // Liveness indicator on the camera card.
        if (tick % 5 == 0) _ = RefreshCameraPanelAsync();
        InvokeAsync(StateHasChanged);
    }

    // The counter app stamps count_heartbeat in real UTC every 5 seconds, unlike the
    // local-time convention used elsewhere. PhTime.Raw recovers the stored instant so
    // freshness is compared against UtcNow without an eight-hour skew.
    private void ApplyCameraState(Trip t)
    {
        var hb = t.CountHeartbeat;
        if (hb is not null) cameraSeen = true;
        var fresh = hb is not null && DateTime.UtcNow - PhTime.Raw(hb.Value) < HeartbeatStale;
        // The camera's total can only raise the local one. A lagging read must never
        // discard taps the driver has just made.
        if (fresh && t.TotalBoarded > total) total = t.TotalBoarded;
        cameraAlive = fresh;
    }

    private async Task RefreshCameraStateAsync()
    {
        try
        {
            var t = await Data.GetTripAsync(TripId);
            if (t is null) return;
            hbPollFails = 0;
            ApplyCameraState(t);
            if (cameraAlive)
            {
                // Keep the mirror current. The background tracker logs this value into
                // telemetry and ending the trip audits against it.
                await SecureStorage.Default.SetAsync(CountKey, total.ToString());
            }
        }
        catch
        {
            // After roughly 15 seconds of failed reads, fail open and reveal the manual
            // controls so the driver can keep counting. The camera's monotonic merge
            // reconciles the two totals later.
            if (++hbPollFails >= 3) cameraAlive = false;
        }
    }

    // Camera liveness. Calibration lives on the photo editor at /camera-calibrate, so
    // this page only reports whether the counter phone is alive, from a device_status
    // heartbeat roughly every 12 seconds.

    private DeviceStatusDto? camStatus;
    private static readonly TimeSpan CamStale = TimeSpan.FromSeconds(30);

    private string? CamDeviceId => vehicle?.CounterDeviceId;

    private bool CamOnline => camStatus?.LastSeen is DateTimeOffset seen
        && DateTimeOffset.UtcNow - seen < CamStale;

    private string CamChipClass => CamOnline ? "on" : "off";
    private string CamChipLabel => CamOnline ? "Online" : "Offline";

    private async Task RefreshCameraPanelAsync()
    {
        if (CamDeviceId is not string dev || string.IsNullOrEmpty(dev)) return;
        try { camStatus = await Data.GetDeviceStatusAsync(dev); }
        catch { /* offline: keep the last known state */ }
        await InvokeAsync(StateHasChanged);
    }

    private async Task Inc()
    {
        total++;
        await SecureStorage.Default.SetAsync(CountKey, total.ToString());
    }

    private async Task Dec()
    {
        if (total > 0) total--;
        await SecureStorage.Default.SetAsync(CountKey, total.ToString());
    }

    private async Task Flush()
    {
        try { await Data.UpdateTripProgressAsync(TripId, total, Revenue); }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[TripActive.Flush] {ex}"); }
    }

    private async Task EndTrip()
    {
        ending = true;
        msg = null;
        try
        {
            // Use whichever of the in-memory count and the per-tap mirror is fresher, so
            // the audit never records a stale value.
            var saved = await SecureStorage.Default.GetAsync(CountKey);
            var finalTotal = Math.Max(total, int.TryParse(saved, out var s) ? s : 0);
            var finalRevenue = finalTotal * fare;

            // Enqueue first so the finalization survives being offline. The PATCH is the
            // single authoritative write of trips.total_boarded.
            await Queue.EnqueueFinalizeAsync(new FleetWiseMobile.Models.PendingTripFinalize
            {
                TripId = TripId,
                TotalBoarded = finalTotal,
                Revenue = finalRevenue,
                EndTime = PhTime.Now,
                VehicleId = vehicle?.VehicleId ?? trip?.VehicleId ?? ""
            });

            // Tracking stops before the count key is cleared, so no late tick logs a zero.
            Tracker.Stop();
            timer?.Dispose();
            SecureStorage.Default.Remove(CountKey);
            SecureStorage.Default.Remove(CacheKey);
            SecureStorage.Default.Remove(ActiveKey);

            await Queue.FlushAsync(); // completes immediately when online; queued if offline
            Nav.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            msg = "Couldn't end trip. Try again.";
            System.Diagnostics.Debug.WriteLine($"[TripActive.End] {ex}");
            ending = false;
        }
    }

    private bool HandleHardwareBack()
    {
        if (askLeave) { InvokeAsync(() => { askLeave = false; StateHasChanged(); }); return true; }
        InvokeAsync(() => { askLeave = true; StateHasChanged(); });
        return true;
    }

    private async Task LeaveToHome()
    {
        askLeave = false;
        // Push whatever has been tapped since the last flush, so the count on the server
        // matches the screen the driver is walking away from.
        if (!cameraAlive) { try { await Flush(); } catch { } }
        Nav.NavigateTo("/home");
    }

    public void Dispose()
    {
        timer?.Dispose();
        if (BackNavigation.PageHandler == HandleHardwareBack) BackNavigation.PageHandler = null;
    }
}
