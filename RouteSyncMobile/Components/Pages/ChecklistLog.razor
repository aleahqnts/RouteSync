@page "/checklist-log/{TripId}"
@layout LoginLayout
@implements IDisposable
@inject SessionService Session
@inject DriverDataService Data
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (loading)
{
    <div class="log">
        <div class="log-header">
            <button class="back" @onclick="GoBack">&#8592;</button>
            <div class="log-title"><h1>Checklist Log</h1></div>
            <span class="spacer"></span>
        </div>
        <div class="sk sk-card" style="height:64px"></div>
        <div class="sk sk-card" style="height:150px; margin-top:12px;"></div>
        <div class="sk sk-card" style="height:150px; margin-top:12px;"></div>
        <div class="sk sk-card" style="height:150px; margin-top:12px;"></div>
    </div>
}
else if (checklist is null)
{
    <div class="log">
        <div class="log-header">
            <button class="back" @onclick="GoBack">&#8592;</button>
            <div class="log-title"><h1>Checklist Log</h1></div>
            <span class="spacer"></span>
        </div>
        <p class="empty">No checklist submitted for this trip yet.</p>
    </div>
}
else
{
    <div class="log">
        <div class="log-header">
            <button class="back" @onclick="GoBack">&#8592;</button>
            <div class="log-title">
                <h1>Checklist Log</h1>
                <p class="log-bus">@busLabel</p>
            </div>
            <span class="spacer"></span>
        </div>

        <div class="summary">
            <div>
                <p class="sum-status @StatusClass(checklist.ChecklistStatus)">@checklist.ChecklistStatus</p>
                <p class="sum-time">Submitted @checklist.SubmittedAt.ToString("MMM d, yyyy h:mm tt")</p>
            </div>
        </div>

        @foreach (var sec in Sections)
        {
            <h2 class="sec-title">@sec.Title</h2>
            <div class="sec-items">
                @{ var n = 0; }
                @foreach (var kv in sec.Items)
                {
                    n++;
                    <div class="log-item">
                        <span class="num">@n.</span>
                        <span class="label">@kv.Key</span>
                        @if (kv.Value == "Pass")
                        {
                            <span class="badge pass"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5l4 4 10-11" /></svg></span>
                        }
                        else
                        {
                            <span class="badge fail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 12h12" /></svg></span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    // Three outcomes: a clean pass, defects that still allowed the trip, and a
    // critical failure that did not.
    private static string StatusClass(string? status) => status switch
    {
        "Passed" => "ok",
        "Passed with Defects" => "warn",
        _ => "bad"
    };

    [Parameter] public string TripId { get; set; } = "";

    private bool loading = true;
    private BusChecklist? checklist;
    private string busLabel = "";

    // Empty sections are skipped. Current checklists no longer populate
    // passenger_systems, but older rows that contain it still render.
    private IEnumerable<(string Title, Dictionary<string, string> Items)> Sections =>
        new (string, Dictionary<string, string>)[]
        {
            ("Exterior Inspection", checklist!.ExteriorInspection ?? new()),
            ("Engine Compartment", checklist.EngineCompartment ?? new()),
            ("Interior Inspection", checklist.InteriorInspection ?? new()),
            ("Brake & Safety Systems", checklist.BrakeSafety ?? new()),
            ("Passenger & Fare Systems", checklist.PassengerSystems ?? new()),
        }.Where(s => s.Item2.Count > 0);

    // Steps back through history rather than navigating to a fixed page, because this is
    // reachable from both the home screen and the trip report.
    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    // Hardware back steps through history like the on-screen arrow, because this page is
    // reachable from more than one parent and a fixed target would strand the others.
    private bool HandleHardwareBack()
    {
        _ = GoBack();
        return true;
    }

    public void Dispose()
    {
        if (BackNavigation.PageHandler == HandleHardwareBack) BackNavigation.PageHandler = null;
    }

    protected override async Task OnInitializedAsync()
    {
        BackNavigation.PageHandler = HandleHardwareBack;
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/"); return; }

        try
        {
            var checklistTask = Data.GetChecklistAsync(TripId);
            var tripTask = Data.GetTripAsync(TripId);
            await Task.WhenAll(checklistTask, tripTask);

            checklist = checklistTask.Result;
            var trip = tripTask.Result;
            if (trip is not null)
            {
                var v = await Data.GetVehicleAsync(trip.VehicleId);
                busLabel = v is not null ? $"{v.VehicleId} ({v.PlateNumber})" : trip.VehicleId;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[ChecklistLog.Load] {ex}");
        }
        finally { loading = false; }
    }
}
