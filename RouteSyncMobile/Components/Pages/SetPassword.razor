@page "/set-password"
@layout LoginLayout
@using Microsoft.AspNetCore.Identity
@inject SessionService Session
@inject DriverDataService Data
@inject AuthApi Api
@inject NavigationManager Nav

<div class="login-bg">
    <img class="logo-img" src="images/routesync-mark.svg" alt="RouteSync" />
    <p class="app-name"><span class="n1">Route</span><span class="n2">Sync</span></p>

    <div class="card">
        <h1>Set Password</h1>
        <p class="hint">Create your own password to continue.</p>

        <div class="field">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg></span>
            <input type="@(showPwd ? "text" : "password")" placeholder="New password" autocomplete="new-password"
                   @bind="newPwd" @bind:event="oninput" />
            <button type="button" class="eye" @onclick="@(() => showPwd = !showPwd)">
                <EyeIcon Shown="@showPwd" />
            </button>
        </div>

        <ul class="pw-rules">
            <li class="@(Met(p => p.Length >= PasswordPolicy.MinLength))"><span class="dot"></span>@(PasswordPolicy.MinLength)+ characters</li>
            <li class="@(Met(p => p.Any(char.IsDigit)))"><span class="dot"></span>A number</li>
            <li class="@(Met(p => p.Any(char.IsUpper)))"><span class="dot"></span>Uppercase</li>
            <li class="@(Met(p => p.Any(char.IsLower)))"><span class="dot"></span>Lowercase</li>
        </ul>

        <div class="field">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg></span>
            <input type="@(showConfirm ? "text" : "password")" placeholder="Confirm new password" autocomplete="new-password"
                   @bind="confirmPwd" @bind:event="oninput" @onkeydown="OnKey" />
            <button type="button" class="eye" @onclick="@(() => showConfirm = !showConfirm)">
                <EyeIcon Shown="@showConfirm" />
            </button>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="message">@message</div>
        }

        <button class="btn-signin" @onclick="Save" disabled="@busy">
            @(busy ? "Saving…" : "Save Password")
        </button>
    </div>
</div>

@code {
    private string newPwd = "";
    private string confirmPwd = "";
    private bool busy;
    private bool showPwd;
    private bool showConfirm;
    private string? message;

    protected override void OnInitialized()
    {
        // Reachable only mid-session, so a cold open returns to sign-in.
        if (!Session.IsLoggedIn) Nav.NavigateTo("/");
    }

    // Drives the rule checklist. Purely on-screen guidance; the edge function is
    // what actually decides whether a password is acceptable.
    private string Met(Func<string, bool> rule) => rule(newPwd) ? "met" : "";

    private async Task Save()
    {
        message = null;
        var problem = PasswordPolicy.Problem(newPwd);
        if (problem is not null) { message = problem; return; }
        if (newPwd == AuthService.TemporaryPassword) { message = "Choose a password different from the temporary one."; return; }
        if (newPwd != confirmPwd) { message = "Passwords do not match."; return; }

        busy = true;
        try
        {
            // The change goes through the edge function, with the temporary password as
            // the current one. There is deliberately no offline path: a local success that
            // changed nothing would leave the driver still on the temporary password and
            // unaware of it.
            var r = await Api.ChangePasswordAsync(AuthService.TemporaryPassword, newPwd);
            if (r.Outcome == AuthApi.Outcome.Denied) { message = r.Message; return; }
            if (r.Outcome == AuthApi.Outcome.Unreachable)
            {
                message = "Cannot reach the server. Check your connection and try again.";
                return;
            }
            SecureStorage.Default.Remove("fw_must_change");
            Nav.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            message = "Update failed. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[SetPassword] {ex}");
        }
        finally { busy = false; }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Save();
    }
}
