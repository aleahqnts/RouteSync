@page "/forgot-password"
@layout LoginLayout
@inject AuthApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="login-bg">
    <img class="logo-img" src="images/fleetwise-logo.png" alt="RouteSync" />
    <p class="app-name"><span class="n1">Route</span><span class="n2">Sync</span></p>

    <div class="card">
        @if (step == Step.Email)
        {
            <h1>Reset Password</h1>
            <p class="hint">We will send a 6-digit code to your email.</p>

            <div class="field">
                <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg></span>
                <input type="email" placeholder="Email" autocomplete="username"
                       @bind="email" @bind:event="oninput" @onkeydown="OnKey" />
            </div>

            @if (!string.IsNullOrEmpty(message)) { <div class="message">@message</div> }

            <button class="btn-signin" @onclick="SendCode" disabled="@busy">
                @(busy ? "Sending…" : "Send Code")
            </button>
        }
        else if (step == Step.Code)
        {
            <h1>Enter Code</h1>
            @* An instruction, not a confirmation: saying a code WAS sent would reveal
               whether the address has an account. *@
            <p class="hint">Check @email. Code expires in 10 minutes.</p>

            @* One real field carries the code; the six cells only draw it. Android
               keyboards edit through the input method rather than raising key events,
               so a row of separate inputs cannot see a delete on an empty box or a
               clipboard insert. A single field leaves typing, deleting, pasting and
               one-time-code autofill to the browser, which handles all of them. *@
            <div class="code-boxes" @onclick="FocusCode">
                <input @ref="codeField" class="code-input" type="text" inputmode="numeric"
                       maxlength="@CodeLength" autocomplete="one-time-code"
                       @bind="Code" @bind:event="oninput" @onkeydown="OnCodeKey" />
                @for (var i = 0; i < CodeLength; i++)
                {
                    var slot = i;
                    <div class="code-cell @(slot == Code.Length ? "active" : "")">
                        @(slot < Code.Length ? Code[slot].ToString() : "")
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(message)) { <div class="message">@message</div> }
            @if (!string.IsNullOrEmpty(notice)) { <div class="notice">@notice</div> }

            <button class="btn-signin" @onclick="VerifyCode" disabled="@(busy || !CodeComplete)">
                @(busy ? "Checking…" : "Verify Code")
            </button>

            <div class="links">
                @if (resendIn > 0)
                {
                    <span class="wait">New code in @resendIn s</span>
                }
                else
                {
                    <a @onclick="SendCode">Send a new code</a>
                }
                <a @onclick="BackToEmail">Change email</a>
            </div>
        }
        else
        {
            <h1>New Password</h1>

            <div class="field">
                <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg></span>
                <input type="@(showPwd ? "text" : "password")" placeholder="New password" autocomplete="new-password"
                       @bind="newPwd" @bind:event="oninput" />
                <button type="button" class="eye" @onclick="@(() => showPwd = !showPwd)">
                    <EyeIcon Shown="@showPwd" />
                </button>
            </div>

            <ul class="pw-rules">
                <li class="@(Met(p => p.Length >= PasswordPolicy.MinLength))"><span class="dot"></span>@(PasswordPolicy.MinLength)+ characters</li>
                <li class="@(Met(p => p.Any(char.IsDigit)))"><span class="dot"></span>A number</li>
                <li class="@(Met(p => p.Any(char.IsUpper)))"><span class="dot"></span>Uppercase</li>
                <li class="@(Met(p => p.Any(char.IsLower)))"><span class="dot"></span>Lowercase</li>
            </ul>

            <div class="field">
                <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg></span>
                <input type="@(showConfirm ? "text" : "password")" placeholder="Confirm new password" autocomplete="new-password"
                       @bind="confirmPwd" @bind:event="oninput" @onkeydown="OnKey" />
                <button type="button" class="eye" @onclick="@(() => showConfirm = !showConfirm)">
                    <EyeIcon Shown="@showConfirm" />
                </button>
            </div>

            @if (!string.IsNullOrEmpty(message)) { <div class="message">@message</div> }

            <button class="btn-signin" @onclick="SavePassword" disabled="@busy">
                @(busy ? "Saving…" : "Save Password")
            </button>
        }

        <div class="links back">
            <a @onclick="BackToLogin">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    private enum Step { Email, Code, Password }

    private Step step = Step.Email;
    private const int CodeLength = 6;

    private string email = "";
    private string codeEntered = "";
    private ElementReference codeField;
    private string newPwd = "";
    private string confirmPwd = "";
    private string? resetToken;
    private string? message;
    private string? notice;
    private bool busy;
    private bool showPwd;
    private bool showConfirm;

    // Seconds left before another code may be asked for. Stops a frustrated driver
    // burning the three-per-quarter-hour server limit in as many taps. The server
    // limit is the real guard; this only keeps them from hitting it by accident.
    private const int ResendCooldownSeconds = 60;
    private int resendIn;
    private System.Threading.Timer? resendTimer;


    // Drives the rule checklist. Purely on-screen guidance; the edge function is
    // what actually decides whether a password is acceptable.
    private string Met(Func<string, bool> rule) => rule(newPwd) ? "met" : "";

    /// <summary>Digits only, never longer than the code itself.</summary>
    private string Code
    {
        get => codeEntered;
        set
        {
            var kept = new string((value ?? "").Where(char.IsDigit).ToArray());
            codeEntered = kept.Length > CodeLength ? kept[..CodeLength] : kept;
        }
    }

    private bool CodeComplete => Code.Length == CodeLength;

    private void ClearCode() => codeEntered = "";

    /// <summary>Tapping any cell puts the caret in the field behind them.</summary>
    private async Task FocusCode() => await codeField.FocusAsync();

    private async Task OnCodeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CodeComplete) await VerifyCode();
    }

    private async Task SendCode()
    {
        message = null;
        notice = null;
        var address = email.Trim();
        if (address.Length == 0 || !address.Contains('@'))
        {
            message = "Enter the email address on your account.";
            return;
        }

        busy = true;
        try
        {
            var r = await Api.RequestPasswordResetAsync(address);
            if (r.Outcome == AuthApi.Outcome.Unreachable)
            {
                message = "Cannot reach the server. Check your connection and try again.";
                return;
            }
            // A rejection here is a rate limit, never "no such account": the server
            // answers the same way for an address it has never seen, so the screen
            // moves on either way rather than confirming who has an account.
            if (r.Outcome == AuthApi.Outcome.Denied)
            {
                message = r.Message;
                return;
            }

            email = address;
            ClearCode();
            StartResendCooldown();
            notice = step == Step.Code ? "A new code is on its way." : null;
            step = Step.Code;
        }
        catch (Exception ex)
        {
            message = "Could not send the code. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[ForgotPassword.Send] {ex}");
        }
        finally { busy = false; }
    }

    private async Task VerifyCode()
    {
        message = null;
        notice = null;
        var code = Code;
        if (code.Length != CodeLength)
        {
            message = "Enter the 6-digit code from your email.";
            return;
        }

        busy = true;
        try
        {
            var r = await Api.VerifyResetCodeAsync(email, code);
            if (r.Outcome == AuthApi.Outcome.Unreachable)
            {
                message = "Cannot reach the server. Check your connection and try again.";
                return;
            }
            if (r.Outcome == AuthApi.Outcome.Denied)
            {
                message = r.Message;
                return;
            }

            resetToken = r.Token;
            step = Step.Password;
        }
        catch (Exception ex)
        {
            message = "Could not check the code. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[ForgotPassword.Verify] {ex}");
        }
        finally { busy = false; }
    }

    private async Task SavePassword()
    {
        message = null;
        if (resetToken is null) { BackToEmail(); return; }
        var problem = PasswordPolicy.Problem(newPwd);
        if (problem is not null) { message = problem; return; }
        if (newPwd == AuthService.TemporaryPassword)
        {
            message = "Choose a password different from the temporary one.";
            return;
        }
        if (newPwd != confirmPwd) { message = "Passwords do not match."; return; }

        busy = true;
        try
        {
            var r = await Api.CompletePasswordResetAsync(resetToken, newPwd);
            if (r.Outcome == AuthApi.Outcome.Unreachable)
            {
                message = "Cannot reach the server. Check your connection and try again.";
                return;
            }
            if (r.Outcome == AuthApi.Outcome.Denied)
            {
                // The token is spent or has timed out, so the code cannot be reused.
                message = r.Message;
                resetToken = null;
                return;
            }

            // No session is issued by the reset, so the driver signs in as normal.
            Nav.NavigateTo("/?reset=1");
        }
        catch (Exception ex)
        {
            message = "Could not save the password. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[ForgotPassword.Save] {ex}");
        }
        finally { busy = false; }
    }

    private void BackToEmail()
    {
        step = Step.Email;
        ClearCode();
        newPwd = "";
        confirmPwd = "";
        resetToken = null;
        message = null;
        notice = null;
    }

    private void BackToLogin() => Nav.NavigateTo("/");

    private void StartResendCooldown()
    {
        resendIn = ResendCooldownSeconds;
        resendTimer?.Dispose();
        resendTimer = new System.Threading.Timer(_ =>
        {
            // The timer fires off the UI thread, so the update is marshalled back.
            InvokeAsync(() =>
            {
                if (--resendIn <= 0)
                {
                    resendIn = 0;
                    resendTimer?.Dispose();
                    resendTimer = null;
                }
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    public void Dispose() => resendTimer?.Dispose();

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (step == Step.Email) await SendCode();
        else await SavePassword();
    }
}
