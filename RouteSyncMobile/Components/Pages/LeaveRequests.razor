@page "/leave"
@implements IDisposable
@inject SessionService Session
@inject DriverDataService Data
@inject NavigationManager Nav

@* Shown on the page the request lands on, so the confirmation and the request itself
   arrive together. *@
@if (toast is not null)
{
    <div class="lv-toast @(toastBad ? "lv-toast--bad" : "")" role="status">@toast</div>
}

<div class="lv">

    <div class="lv-header">
        <button class="back" @onclick="@(() => Nav.NavigateTo("/profile"))">&#8592;</button>
        <h1>My Leave Requests</h1>
        <span class="spacer"></span>
    </div>

    @if (loading)
    {
        <div class="sk sk-card" style="height:96px"></div>
        <div class="sk sk-card" style="height:96px"></div>
        <div class="sk sk-card" style="height:96px"></div>
    }
    else
    {
        @* What is left of each allowance. Pending days are already taken off, and named
           separately, or a request waiting on a decision reads as days still available. *@
        <div class="lv-balances">
            @foreach (var type in LeaveEntitlement.Types)
            {
                @* Days granted, not days left once the undecided ones are taken off. A
                   number that already has the pending days removed, shown above a line
                   naming those same days, is read as counting them twice. Filing still
                   counts them: what can be asked for and what has been agreed are
                   different questions. *@
                var used = LeaveEntitlement.Used(requests, type, DateTime.Today.Year);
                var left = Math.Max(0, LeaveEntitlement.DaysPerYear[type] - used.Approved);
                <div class="lv-bal">
                    <p class="lv-bal-n">@left<span class="lv-bal-of">/@LeaveEntitlement.DaysPerYear[type]</span></p>
                    <p class="lv-bal-l">@type</p>
                    @if (used.Pending > 0)
                    {
                        <p class="lv-bal-p">@used.Pending pending</p>
                    }
                </div>
            }
        </div>

        <button class="lv-add" @onclick="OpenForm">+ File a leave</button>

        @if (requests.Count == 0)
        {
            <p class="lv-empty">Nothing filed yet.</p>
        }
        else
        {
            @* Dates and outcome, and nothing else. What was asked for and what was said
               back are both paragraphs, and a paragraph in a list row squeezes the dates
               into a column down the left. They are read one request at a time, so they
               live behind the button below. *@
            @* The months a request was filed in, so a driver reading back through a year
               is not paging through one undivided list. Only months that hold something
               are offered: an empty month is not a place to go. *@
            @if (Months.Count > 1)
            {
                <div class="lv-months">
                    <button class="lv-month @(monthFilter is null ? "on" : "")"
                            @onclick="@(() => monthFilter = null)">All</button>
                    @foreach (var m in Months)
                    {
                        <button class="lv-month @(monthFilter == m ? "on" : "")"
                                @onclick="@(() => monthFilter = m)">@m.ToString("MMM yyyy")</button>
                    }
                </div>
            }

            <div class="lv-list">
                @foreach (var group in Grouped)
                {
                    var shut = collapsed.Contains(group.Key);

                    <button class="lv-group" @onclick="@(() => Toggle(group.Key))"
                            aria-expanded="@((!shut).ToString().ToLowerInvariant())">
                        <span class="lv-caret @(shut ? "shut" : "")" aria-hidden="true">&#9662;</span>
                        <span class="lv-group-m">@group.Key.ToString("MMMM yyyy")</span>
                        <span class="lv-group-n">@group.Count()</span>
                    </button>

                    @if (!shut)
                    {
                    @foreach (var r in group)
                    {
                    <div class="lv-row">
                        <div class="lv-row-top">
                            <span class="lv-span">@Span(r)</span>
                            <span class="lv-badge @Shown(r.Status).ToLowerInvariant()">@Shown(r.Status)</span>
                        </div>

                        @* Said only while the approval is part way through. The badge stays
                           Pending, because nothing has been granted and nothing refused, and
                           a status that moved and could move back would read as a decision.
                           This says what is happening without promising an outcome. *@
                        @if (string.Equals(r.Status, "AwaitingChange", StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="lv-checking">Being checked against your schedule.</p>
                        }

                        @* Granted leave the driver has asked to give back. Still granted:
                           the days are still theirs until a dispatcher says otherwise, and
                           the badge goes on saying Approved because that is what it is. *@
                        @if (r.WithdrawRequestedAt is not null)
                        {
                            <p class="lv-checking">
                                You asked to cancel this. Waiting on your dispatcher.
                            </p>
                        }

                        @* The kind of leave and what can be done about it on one line. Given
                           a line each, a request was a hundred pixels tall and four of them
                           filled a phone. *@
                        <div class="lv-row-foot">
                            <p class="lv-meta">@r.LeaveType · @LeaveEntitlement.Days(r) @(LeaveEntitlement.Days(r) == 1 ? "day" : "days")</p>

                            <div class="lv-row-actions">
                            <button class="lv-hist-btn" @onclick="@(() => openHistory = r.RequestId)">History</button>
                            @if (LeaveEntitlement.IsOpen(r.Status))
                            {
                                <button class="lv-cancel" @onclick="@(() => Cancel(r.RequestId))">Cancel</button>
                            }
                            else if (CanAskToCancel(r))
                            {
                                <button class="lv-cancel" @onclick="@(() => OpenWithdraw(r))">Ask to cancel</button>
                            }
                            </div>
                        </div>
                    </div>
                    }
                    }
                }

                @if (!Grouped.Any())
                {
                    <p class="lv-empty">Nothing filed that month.</p>
                }
            </div>
        }
    }
</div>

@* Everything about one request: what was asked for, what was decided, and when.
   Who decided it is not shown. The driver is told the outcome, and naming the operator
   turns a company decision into a personal one. *@
@if (openHistory is long historyId
     && requests.FirstOrDefault(r => r.RequestId == historyId) is LeaveRequest h)
{
    <div class="overlay" @onclick="CloseHistory">
        <div class="lv-modal" @onclick:stopPropagation="true">
            <div class="lv-modal-head">
                <h2>Request details</h2>
                <button class="lv-close" @onclick="CloseHistory" aria-label="Close">&times;</button>
            </div>

            <div class="lv-modal-body">
                <div class="lv-det-head">
                    <span class="lv-det-span">@Span(h)</span>
                    <span class="lv-badge @Shown(h.Status).ToLowerInvariant()">@Shown(h.Status)</span>
                </div>
                <p class="lv-det-meta">
                    @h.LeaveType · @LeaveEntitlement.Days(h) @(LeaveEntitlement.Days(h) == 1 ? "day" : "days")
                </p>

                @if (!string.IsNullOrWhiteSpace(h.Reason))
                {
                    <p class="lv-det-label">Your reason</p>
                    <p class="lv-det-text">@h.Reason</p>
                }

                <p class="lv-det-label">History</p>
                <ol class="lv-hist">
                    @foreach (var e in Story(h))
                    {
                        <li class="lv-hist-item">
                            <span class="lv-hist-dot @e.Dot"></span>
                            <span class="lv-hist-body">
                                <span class="lv-hist-action">@e.Action</span>
                                @if (e.At is DateTime at)
                                {
                                    <span class="lv-hist-when">@at.ToString("MMM d, yyyy h:mm tt")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(e.Note))
                                {
                                    <span class="lv-hist-note">@e.Note</span>
                                }
                            </span>
                        </li>
                    }
                </ol>
            </div>

            <div class="lv-modal-foot">
                <button class="psave" @onclick="CloseHistory">Close</button>
            </div>
        </div>
    </div>
}

@if (showForm)
{
    <div class="overlay" @onclick="CloseForm">
        <div class="lv-modal" @onclick:stopPropagation="true">
            <div class="lv-modal-head">
                <h2>File a leave</h2>
                <button class="lv-close" @onclick="CloseForm" aria-label="Close">&times;</button>
            </div>

            <div class="lv-modal-body">
                @* Dates first: what a driver comes here knowing. The type is a detail of
                   the days already chosen. *@
                <label>Start date</label>
                <input type="date" lang="en-US" data-picker-only inputmode="none"
                       class="@Bad(nameof(start))" @bind="start" @bind:after="Revalidate" />

                <label>End date</label>
                <input type="date" lang="en-US" data-picker-only inputmode="none"
                       class="@Bad(nameof(end))" @bind="end" @bind:after="Revalidate" />

                @* The digits inside a date field are written by the phone, in whatever
                   order its locale uses, and no markup here decides that. This says the
                   same dates in a form that cannot be read two ways. *@
                @if (end.Date >= start.Date)
                {
                    <p class="lv-dates-said">@Said</p>
                }

                <label>Type</label>
                <div class="lv-select-wrap">
                    <select class="@Bad(nameof(type))" @bind="type" @bind:after="Revalidate">
                        @foreach (var t in LeaveEntitlement.Types)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <span class="lv-select-arrow" aria-hidden="true">&#9662;</span>
                </div>

                <label>Reason</label>
                <input class="lv-reason-input" @bind="reason" maxlength="200" placeholder="Optional" />

                @if (problem is not null)
                {
                    <p class="err-msg">@problem</p>
                }
            </div>

            <div class="lv-modal-foot">
                <button class="lv-btn-ghost" @onclick="CloseForm">Cancel</button>
                <button class="psave" disabled="@sending" @onclick="Submit">
                    @(sending ? "Sending…" : "File request")
                </button>
            </div>
        </div>
    </div>
}

@* Asking for granted leave back. Its own dialog, because it asks for a reason the
   dispatcher will read and it is not the same act as withdrawing a request nobody has
   answered yet. *@
@if (withdrawing is not null)
{
    <div class="overlay" @onclick="CloseWithdraw">
        <div class="lv-modal" @onclick:stopPropagation="true">
            <div class="lv-modal-head">
                <h2>Ask to cancel leave</h2>
                <button class="lv-close" @onclick="CloseWithdraw" aria-label="Close">&times;</button>
            </div>

            <div class="lv-modal-body">
                <p class="lv-dates-said">@Span(withdrawing) · @withdrawing.LeaveType</p>

                <p class="lv-withdraw-note">
                    Your dispatcher has to agree, because the schedule was built around your
                    days off. Until then the leave stands and you are not scheduled to drive.
                </p>

                <label>Reason for cancelling</label>
                <input class="lv-reason-input" @bind="withdrawReason" maxlength="200"
                       placeholder="Required" />

                @if (withdrawProblem is not null)
                {
                    <p class="err-msg">@withdrawProblem</p>
                }
            </div>

            <div class="lv-modal-foot">
                <button class="lv-btn-ghost" @onclick="CloseWithdraw">Close</button>
                <button class="psave" disabled="@sending" @onclick="SubmitWithdraw">
                    @(sending ? "Sending…" : "Send request")
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>One thing that happened to a request.</summary>
    /// <remarks>
    /// Undated for the two that have not happened yet, which is what puts them last.
    /// </remarks>
    private sealed record Moment(DateTime? At, string Action, string Dot, string Note);

    /// <summary>
    /// What happened to a request, in the order it happened.
    /// </summary>
    /// <remarks>
    /// Built as a list and sorted rather than written out in the markup. Written out, the
    /// order was the order the code happened to check things in: a leave approved at noon
    /// and asked about that evening listed the asking above the approval, because asking
    /// is read off the same row and was checked first. A history out of order is not a
    /// history.
    ///
    /// The two waiting lines carry no time because they are about now, so they sort to
    /// the end where they belong.
    /// </remarks>
    private static List<Moment> Story(LeaveRequest h)
    {
        var done = new List<Moment>
        {
            new(h.FiledAt, "Filed", "filed", null),
        };

        var waiting = new List<Moment>();

        if (h.WithdrawRequestedAt is DateTime asked)
        {
            done.Add(new(asked, "You asked to cancel", "", h.WithdrawReason));

            // Accepting cancels the request, which the decision reports. Declining leaves
            // the leave standing, and only this says so.
            if (h.WithdrawAnsweredAt is DateTime answered
                && string.Equals(h.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                done.Add(new(answered, "Cancellation declined", "rejected", null));
            }
            else if (h.WithdrawAnsweredAt is null)
            {
                waiting.Add(new(null, "Waiting on your dispatcher", "", null));
            }
        }

        if (h.DecidedAt is DateTime decided && !LeaveEntitlement.IsOpen(h.Status))
        {
            // Carried whichever way it went. An approval that came with a condition on it
            // says so here, not only a refusal.
            done.Add(new(decided, Shown(h.Status), h.Status.ToLowerInvariant(), h.DecisionNote));
        }

        if (LeaveEntitlement.IsOpen(h.Status))
        {
            waiting.Add(new(null, "Awaiting a decision", "", null));
        }

        // OrderBy is stable, so two stamped the same second keep the order they were added.
        return done.OrderBy(e => e.At).Concat(waiting).ToList();
    }

    /// <summary>The word for a status, as the driver should read it.</summary>
    /// <remarks>
    /// A request held while the dispatcher clears the schedule is stored as
    /// AwaitingChange, and shown here as Pending. Nothing has been granted and nothing
    /// has been refused; from the driver's side the request is where it was, and a word
    /// that looks like an outcome would read as one.
    /// </remarks>
    private static string Shown(string status) =>
        string.Equals(status, "AwaitingChange", StringComparison.OrdinalIgnoreCase)
            ? "Pending"
            : status;

    private bool loading = true;
    private List<LeaveRequest> requests = new();

    private bool showForm, sending;

    private LeaveRequest? withdrawing;
    private string withdrawReason = "";
    private string? withdrawProblem;

    private long? openHistory;
    private DateTime? monthFilter;

    /// <summary>Months folded shut, so a long history reads as a list of months.</summary>
    private readonly HashSet<DateTime> collapsed = new();

    private void Toggle(DateTime month)
    {
        if (!collapsed.Remove(month)) collapsed.Add(month);
    }
    private string? toast;
    private bool toastBad;
    private CancellationTokenSource? toastCts;
    private string type = LeaveEntitlement.Vacation;
    private string reason = "";
    private DateTime start = DateTime.Today;
    private DateTime end = DateTime.Today;

    /// <summary>What is wrong with the form, or null when nothing is.</summary>
    private string? problem;

    /// <summary>Which field the problem belongs to, so it can be marked.</summary>
    private string? problemField;

    private string Bad(string field) =>
        problemField == field ? "field-bad" : "";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/"); return; }
        try { await Load(); }
        finally { loading = false; }

        _ = PollLoop(); // background: a decision made elsewhere lands without a tab change
    }

    private async Task Load()
    {
        try { requests = await Data.GetLeaveRequestsAsync(Session.CurrentUser!.UserId); }
        catch { requests = new(); }
    }

    /// <summary>The months that hold a request, newest first.</summary>
    private List<DateTime> Months =>
        requests.Select(r => new DateTime(r.StartDate.Year, r.StartDate.Month, 1))
                .Distinct()
                .OrderByDescending(m => m)
                .ToList();

    /// <summary>The requests on show, in months.</summary>
    /// <remarks>
    /// By the month the leave falls in rather than the month it was filed. A driver
    /// looking for last September's leave looks under September, whatever day they
    /// happened to ask for it.
    /// </remarks>
    private IEnumerable<IGrouping<DateTime, LeaveRequest>> Grouped =>
        requests
            .Where(r => monthFilter is null
                        || (r.StartDate.Year == monthFilter.Value.Year
                            && r.StartDate.Month == monthFilter.Value.Month))
            .OrderByDescending(r => r.StartDate)
            .ThenByDescending(r => r.RequestId)
            .GroupBy(r => new DateTime(r.StartDate.Year, r.StartDate.Month, 1));

    // Re-fetches every 15 seconds while the page is open. A decision is made on another
    // screen by another person, so a request left on show here goes stale on its own, and
    // the driver was having to leave the page and come back to see they had been answered.
    private readonly CancellationTokenSource pollCts = new();

    private async Task PollLoop()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(pollCts.Token))
            {
                // Not while a dialog is open. Replacing the list under a form being filled
                // in, or under a request being read, takes it away mid-sentence.
                if (showForm || openHistory is not null || withdrawing is not null) continue;

                try
                {
                    var fresh = await Data.GetLeaveRequestsAsync(Session.CurrentUser!.UserId);
                    await InvokeAsync(() =>
                    {
                        requests = fresh;
                        StateHasChanged();
                    });
                }
                catch { /* background blip: keep showing the last good list */ }
            }
        }
        catch (OperationCanceledException) { /* page closed */ }
    }

    public void Dispose()
    {
        pollCts.Cancel();
        pollCts.Dispose();
    }

    private void CloseHistory() => openHistory = null;

    private void OpenForm()
    {
        // Today, not a date three days out. A driver filing at short notice should not
        // have to correct the form before they can use it.
        start = DateTime.Today;
        end = DateTime.Today;
        type = LeaveEntitlement.Vacation;
        reason = "";
        problem = null;
        problemField = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    /// <summary>
    /// Names the first thing wrong with the form, and which field it is about.
    /// </summary>
    /// <remarks>
    /// Notice is not among these. Three days is what the company asks for and a request
    /// filed later still goes through, so the only refusals here are a form that cannot
    /// be read and an allowance that has run out.
    /// </remarks>
    private bool Validate()
    {
        problem = null;
        problemField = null;

        if (end.Date < start.Date)
        {
            problem = "The end date is before the start date.";
            problemField = nameof(end);
            return false;
        }

        if (!LeaveEntitlement.DaysPerYear.ContainsKey(type))
        {
            problem = "Choose a leave type.";
            problemField = nameof(type);
            return false;
        }

        // Days already asked for, of any type. Filing over them is not a second request,
        // it is the same days twice, and the balance is spent twice with it.
        var clash = requests.FirstOrDefault(r =>
            (LeaveEntitlement.IsOpen(r.Status)
             || string.Equals(r.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            && r.StartDate.Date <= end.Date
            && r.EndDate.Date >= start.Date);

        if (clash is not null)
        {
            problem = string.Equals(clash.Status, "Approved", StringComparison.OrdinalIgnoreCase)
                ? $"You already have approved {clash.LeaveType.ToLowerInvariant()} leave covering {Span(clash)}."
                : $"You already have a request covering {Span(clash)} awaiting a decision.";
            problemField = nameof(start);
            return false;
        }

        var days = (int)(end.Date - start.Date).TotalDays + 1;
        var left = LeaveEntitlement.Remaining(requests, type, start.Year);
        if (days > left)
        {
            problem = left == 0
                ? $"No {type.ToLowerInvariant()} leave left for {start.Year}."
                : $"That is {days} days and you have {left} left.";
            problemField = nameof(type);
            return false;
        }

        return true;
    }

    /// <summary>Clears a complaint once the field it was about has been changed.</summary>
    private void Revalidate()
    {
        if (problem is not null) Validate();
    }

    private async Task Submit()
    {
        if (!Validate()) return;

        sending = true;
        try
        {
            await Data.FileLeaveAsync(Session.CurrentUser!.UserId, type, start, end, reason);
            await Load();

            // The form has done its job, so it closes and the new request is there in the
            // list behind it, at the top, marked pending.
            showForm = false;
            reason = "";
            await Say("Leave request submitted for approval.");
        }
        catch (Exception ex)
        {
            // What the server actually said, rather than a guess about the network. A
            // request refused for its contents and one that never arrived are different
            // problems, and telling a driver to check their connection when the server
            // answered sends them looking in the wrong place.
            problem = ex.Message;
            problemField = null;
        }
        finally
        {
            sending = false;
        }
    }

    /// <summary>
    /// Whether granted leave can still be handed back.
    /// </summary>
    /// <remarks>
    /// Approved, not already asked about, and starting no earlier than the day now being
    /// worked. Today counts: a driver who called in sick this morning and then felt able
    /// to drive is the ordinary case, and the day is not spent until it ends.
    ///
    /// A leave that started before today is not offered. Part of it has been taken, and
    /// giving the whole thing back would erase days the driver actually had off. Handing
    /// part of a leave back is the dispatcher's, through Revoke.
    ///
    /// The database refuses the same cases rather than trusting this.
    /// </remarks>
    private static bool CanAskToCancel(LeaveRequest r) =>
        string.Equals(r.Status, "Approved", StringComparison.OrdinalIgnoreCase)
        && r.WithdrawRequestedAt is null
        && r.StartDate.Date >= PhTime.OperationalDay;

    private void OpenWithdraw(LeaveRequest r)
    {
        withdrawing = r;
        withdrawReason = "";
        withdrawProblem = null;
    }

    private void CloseWithdraw()
    {
        withdrawing = null;
        withdrawProblem = null;
    }

    private async Task SubmitWithdraw()
    {
        if (withdrawing is null) return;

        // Asked for, because the dispatcher has to weigh it and "no reason given" is not
        // something they can weigh.
        if (string.IsNullOrWhiteSpace(withdrawReason))
        {
            withdrawProblem = "Say why, so your dispatcher can decide.";
            return;
        }

        sending = true;
        try
        {
            await Data.RequestLeaveWithdrawalAsync(withdrawing.RequestId, withdrawReason.Trim());
            CloseWithdraw();
            await Load();
            await Say("Your dispatcher has been asked to cancel this leave.");
        }
        catch (Exception ex)
        {
            withdrawProblem = ex.Message;
        }
        finally
        {
            sending = false;
        }
    }

    private async Task Cancel(long requestId)
    {
        try
        {
            await Data.CancelLeaveAsync(requestId);
            await Load();
            await Say("Leave request cancelled.");
        }
        catch (Exception ex)
        {
            // Said here, on the page the button is on. It used to go to the message under
            // the filing form, which is not on screen when a request is being cancelled,
            // so a refusal reached the driver as nothing happening at all.
            await Say(ex.Message, bad: true);
        }
    }

    /// <summary>
    /// The chosen dates written out, so the order of the digits in the field above never
    /// matters.
    /// </summary>
    private string Said
    {
        get
        {
            var days = (int)(end.Date - start.Date).TotalDays + 1;
            var range = start.Date == end.Date
                ? start.ToString("MMMM d, yyyy")
                : $"{start:MMMM d} to {end:MMMM d, yyyy}";
            return $"{range} · {days} {(days == 1 ? "day" : "days")}";
        }
    }

    /// <summary>
    /// Says something briefly at the top of the page, and takes it away again.
    /// </summary>
    /// <remarks>
    /// The previous one is cancelled first, or two in quick succession leave the first
    /// timer to clear a message it did not write.
    /// </remarks>
    private async Task Say(string message, bool bad = false)
    {
        toastCts?.Cancel();
        var cts = new CancellationTokenSource();
        toastCts = cts;

        toast = message;
        toastBad = bad;
        StateHasChanged();

        try
        {
            // Something that went wrong is left up longer. A confirmation only needs to be
            // caught; a refusal has to be read.
            await Task.Delay(TimeSpan.FromSeconds(bad ? 6 : 4), cts.Token);
            toast = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* replaced by a newer one */ }
    }

    private static string Span(LeaveRequest r) =>
        r.StartDate.Date == r.EndDate.Date
            ? r.StartDate.ToString("MMM d, yyyy")
            : $"{r.StartDate:MMM d} to {r.EndDate:MMM d, yyyy}";
}
