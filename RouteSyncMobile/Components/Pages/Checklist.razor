@page "/checklist/{TripId}"
@layout LoginLayout
@implements IDisposable
@inject SessionService Session
@inject DriverDataService Data
@inject AuthApi Api
@inject NavigationManager Nav
@inject IPhotoCapture Camera
@inject InspectionPhotos Photos
@inject ChecklistDraft Draft

@if (loading)
{
    <div class="cl-loading">Loading...</div>
}
else if (loadFailed)
{
    <div class="cl-confirm">
        <h2>Checklist unavailable</h2>
        <p class="confirm-sub">
            The inspection list could not be loaded. Check your connection and try again.
        </p>
        <button class="btn-teal" @onclick="RetryLoad">Try Again</button>
        <button class="btn-plain" @onclick="@(() => Nav.NavigateTo("/home"))">Back to Home</button>
    </div>
}
else if (submitted)
{
    <div class="cl-confirm">
        @if (blocked)
        {
            <div class="confirm-check bad">
                <svg viewBox="0 0 24 24" fill="none" stroke="#d0494b" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><path d="M12 7v6" /><path d="M12 16.5v.5" /></svg>
            </div>
            <h2>Trip Blocked</h2>
            <p class="confirm-sub">
                This bus is out of service and cannot be driven. Your operator has been
                told. Wait on your home screen.
            </p>
        }
        else if (hasDefects)
        {
            <div class="confirm-check warn">
                <svg viewBox="0 0 24 24" fill="none" stroke="#d99b1a" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><path d="M12 7v6" /><path d="M12 16.5v.5" /></svg>
            </div>
            <h2>Checklist Submitted</h2>
            <p class="confirm-sub">
                Defects were reported and your operator will review them. Nothing critical
                failed, so you can start your trip.
            </p>
        }
        else
        {
            <div class="confirm-check">
                <svg viewBox="0 0 24 24" fill="none" stroke="#3aaf5d" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><path d="M7 12.5l3 3 6-7" /></svg>
            </div>
            <h2>Bus Checklist Submitted!</h2>
        }

        <div class="confirm-card">
            @foreach (var label in reportedIssues)
            {
                <div class="confirm-row">
                    <span>@label</span>
                    <span class="bad">&#10005;</span>
                </div>
            }
            @if (reportedIssues.Count == 0)
            {
                <p class="confirm-sub">All @sections.Sum(x => x.Items.Count) items passed.</p>
            }
        </div>
        <button class="btn-teal" @onclick="@(() => Nav.NavigateTo("/home"))">Back to Home</button>
    </div>
}
else
{
    <div class="cl">
        <div class="cl-header">
            <button class="back" @onclick="Back">&#8592;</button>
            <div class="cl-title">
                <h1>Bus Checklist</h1>
                <p class="cl-bus">@busLabel</p>
            </div>
            <span class="spacer"></span>
        </div>

        <div class="steps">
            @for (int i = 0; i < sections.Count; i++)
            {
                var done = i <= currentSection;
                <div class="step @(done ? "active" : "")">@(i + 1)</div>
                @if (i < sections.Count - 1)
                {
                    <div class="bar @(i < currentSection ? "active" : "")"></div>
                }
            }
        </div>

        <h2 class="section-title">@CurrentSection.Title</h2>

        <div class="items">
            @for (int i = 0; i < CurrentSection.Items.Count; i++)
            {
                var idx = i;
                var item = CurrentSection.Items[idx];
                <div class="item-row">
                    <div class="item">
                        <span class="num">@(idx + 1).</span>
                        <span class="label">
                            @item.Label
                            @if (item.IsCritical)
                            {
                                <span class="crit" title="Blocks the trip if it fails">Critical</span>
                            }
                        </span>
                        <div class="marks">
                            <button class="mark check @(item.Status == "Pass" ? "on" : "")" @onclick="@(() => SetStatus(idx, "Pass"))">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5l4 4 10-11" /></svg>
                            </button>
                            <button class="mark minus @(item.Status == "Fail" ? "on" : "")" @onclick="@(() => SetStatus(idx, "Fail"))">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 12h12" /></svg>
                            </button>
                        </div>
                    </div>

                    @* Offered only where there is something to document, and never opened
                       on its own. A fuel level below the mark needs no picture, and a
                       camera that appeared at every fault is a prompt drivers learn to
                       dismiss. *@
                    @if (item.Status == "Fail")
                    {
                        <div class="item-photo">
                            @if (thumbs.TryGetValue(item.ItemId, out var thumb))
                            {
                                <img class="ph-thumb" src="@thumb" alt="Photo of @item.Label" />
                            }
                            else if (photos.ContainsKey(item.ItemId))
                            {
                                @* The reference survived an interruption; the picture did
                                   not. It is still attached and still submitted. *@
                                <span class="ph-note">Photo attached</span>
                            }

                            @if (photos.ContainsKey(item.ItemId))
                            {
                                <button class="ph-btn" @onclick="@(() => TakePhoto(item))" disabled="@cameraBusy">Retake</button>
                                <button class="ph-btn ph-drop" @onclick="@(() => DropPhotoAsync(item))" disabled="@cameraBusy">Remove</button>
                            }
                            else if (uploadFailed.Contains(item.ItemId))
                            {
                                <span class="ph-fail">Photo not sent</span>
                                <button class="ph-btn" @onclick="@(() => TakePhoto(item))" disabled="@cameraBusy">Try Again</button>
                            }
                            else
                            {
                                <button class="ph-btn ph-add" @onclick="@(() => TakePhoto(item))" disabled="@cameraBusy">Add photo</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="cl-msg">@message</p>
        }

        <button class="btn-teal" @onclick="Next" disabled="@busy">
            @(IsLast ? "Submit Bus Checklist" : "Next")
        </button>

        @* An inspection covers the bus for the service day, so the second and later
           shifts on a bus already cleared today are offered a way past it rather than a
           second walk around the same bus. *@
        @if (canSkip)
        {
            <button class="btn-skip" @onclick="@(() => showSkipConfirm = true)" disabled="@busy">
                Skip Inspection
            </button>
        }
    </div>

    @* What the driver took, before anything is sent. A photograph of a thumb over the
       lens is worse than none, and they are still standing where they can take another. *@
    @if (pendingPreview is not null)
    {
        <div class="overlay">
            <div class="ua-modal ph-modal">
                <h2>Use this photo?</h2>
                <p class="ua-sub">@pendingItem?.Label</p>
                <img class="ph-preview" src="@pendingPreview" alt="Preview of the photo just taken" />

                <div class="ua-actions">
                    <button class="btn-cancel" @onclick="@(() => TakePhoto(pendingItem!))" disabled="@cameraBusy">Retake</button>
                    <button class="btn-confirm" @onclick="ConfirmPhoto" disabled="@cameraBusy">Use Photo</button>
                </div>
                <button class="btn-plain" @onclick="ClearPending" disabled="@cameraBusy">Cancel</button>
            </div>
        </div>
    }

    @if (showSkipConfirm)
    {
        <div class="overlay">
            <div class="ua-modal">
                <h2>This bus was already inspected today.</h2>
                <p class="ua-sub">Skip the inspection for this trip?</p>

                <div class="ua-actions">
                    <button class="btn-cancel" @onclick="@(() => showSkipConfirm = false)" disabled="@busy">Cancel</button>
                    <button class="btn-confirm" @onclick="Skip" disabled="@busy">Skip</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string TripId { get; set; } = "";

    private bool loading = true;
    private bool loadFailed;
    private bool busy;
    private bool submitted;
    private bool blocked;
    private bool hasDefects;
    // What failed, shown back to the driver so they know what was reported.
    private List<string> reportedIssues = new();
    private string? message;
    private int currentSection;
    private string busLabel = "";
    private Trip? trip;

    /// <summary>Whether this trip may stand on an inspection the bus already has.</summary>
    private bool canSkip;
    private bool showSkipConfirm;

    // Photographs already stored, by the item they belong to. The name is generated once
    // and kept, so retaking replaces the object rather than leaving the first behind.
    private readonly Dictionary<int, Guid> photos = new();

    // Thumbnails for the rows, held only in memory. They are not written to the draft:
    // an image is far too large for it, and losing the picture while keeping the
    // reference costs a thumbnail rather than a photograph.
    private readonly Dictionary<int, string> thumbs = new();

    // When each photograph was taken, by this device's clock. Not held in the draft: an
    // inspection resumed after an interruption falls back to the arrival time, which is
    // the same approximation by a different route.
    private readonly Dictionary<int, DateTimeOffset> takenAt = new();

    // The shot waiting to be confirmed, and the item it is for.
    private byte[]? pendingShot;
    private string? pendingPreview;
    private CItem? pendingItem;
    private DateTimeOffset pendingTakenAt;
    private bool cameraBusy;
    private readonly HashSet<int> uploadFailed = new();

    private Section CurrentSection => sections[currentSection];
    private bool IsLast => currentSection == sections.Count - 1;

    private List<Section> sections = new();

    protected override async Task OnInitializedAsync()
    {
        BackNavigation.PageHandler = HandleHardwareBack;
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/"); return; }

        trip = await Data.GetTripAsync(TripId);
        try
        {
            if (trip is not null)
            {
                var v = await Data.GetVehicleAsync(trip.VehicleId);
                busLabel = v is not null ? $"{v.VehicleId} ({v.PlateNumber})" : trip.VehicleId;
                await LoadSkipOfferAsync(v);
            }
            await LoadItemsAsync();

            // After the items, because the draft is matched against them.
            RestoreDraft();
        }
        finally { loading = false; }
    }

    /// <summary>Decides whether the inspection can be skipped for this trip.</summary>
    /// <remarks>
    /// The rule is one inspection per bus per service day, so the first shift of a bus in
    /// a day inspects it and the shifts after that may stand on what it found. The
    /// service day is what a night shift and the small hours after it share, and the next
    /// morning is a new day that asks for a fresh inspection.
    ///
    /// A grounded bus is never skippable. Being out of service, and the failed inspection
    /// that usually puts a bus there, are a separate gate on driving it at all, and an
    /// offer to skip past the paperwork must not look like a way around them.
    ///
    /// The offer is withheld when the question cannot be answered. Asking for an
    /// inspection that has already been done costs a driver some minutes, while skipping
    /// one on a guess costs a bus nobody has looked at.
    /// </remarks>
    private async Task LoadSkipOfferAsync(Vehicle? vehicle)
    {
        if (trip is null || vehicle?.OutOfService == true) return;

        try
        {
            // The bus, not this trip. An inspection belongs to whichever trip recorded it,
            // which for a later shift is somebody else's, so the answer comes from the
            // function that may look rather than from a read this key would be refused.
            var context = await Data.GetShiftStartContextAsync(trip.TripId);

            canSkip = context?.BusInspectedToday == true;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Checklist.SkipOffer] {ex}");
        }
    }

    /// <summary>
    /// Builds the form from the configured items.
    /// </summary>
    /// <remarks>
    /// There is deliberately no built-in fallback list. Which items are critical is
    /// the whole point of this screen, and inspecting against a stale copy of the
    /// rules could pass a bus that the current rules would have grounded. A driver
    /// who cannot reach the server is asked to retry instead.
    /// </remarks>
    private async Task LoadItemsAsync()
    {
        try
        {
            var items = await Data.GetChecklistItemsAsync();
            sections = items
                .GroupBy(i => i.SectionKey)
                .OrderBy(g => g.Min(i => i.SortOrder))
                .Select(g => new Section(
                    g.First().SectionTitle,
                    g.Key,
                    g.OrderBy(i => i.SortOrder).ToList()))
                .ToList();
            loadFailed = sections.Count == 0;
        }
        catch (Exception ex)
        {
            loadFailed = true;
            System.Diagnostics.Debug.WriteLine($"[Checklist.LoadItems] {ex}");
        }
    }

    private async Task RetryLoad()
    {
        loadFailed = false;
        loading = true;
        await LoadItemsAsync();
        loading = false;
    }

    private async Task SetStatus(int idx, string status)
    {
        var item = CurrentSection.Items[idx];
        item.Status = status;
        message = null;

        // An item marked Pass again has nothing to document, so the photograph taken for
        // it is removed at the moment the driver changes their mind. That is the only
        // cleanup that happens when it is needed: an inspection abandoned outright leaves
        // an object behind for the sweep.
        if (status == "Pass") await DropPhotoAsync(item);

        SaveDraft();
    }

    /// <summary>
    /// Opens the camera for a failed item and holds the result for confirmation.
    /// </summary>
    /// <remarks>
    /// Nothing is sent yet. The driver sees what they took and decides, because a
    /// photograph of a thumb over the lens is worse than none and they are still standing
    /// where they can take another.
    /// </remarks>
    private async Task TakePhoto(CItem item)
    {
        if (cameraBusy) return;
        cameraBusy = true;
        try
        {
            var jpeg = await Camera.CaptureAsync();
            if (jpeg is null) return;

            pendingShot = jpeg;
            pendingPreview = $"data:image/jpeg;base64,{Convert.ToBase64String(jpeg)}";
            pendingItem = item;
            pendingTakenAt = DateTimeOffset.UtcNow;
        }
        finally { cameraBusy = false; }
    }

    /// <summary>Sends the held photograph and attaches it to its item.</summary>
    /// <remarks>
    /// The upload happens here rather than at submit, while the driver is still standing
    /// at the fault and can take another. A failure is shown on the row: the inspection
    /// carries on without the photograph, because a reference to an object that is not
    /// there is worse than no reference.
    /// </remarks>
    private async Task ConfirmPhoto()
    {
        if (pendingShot is null || pendingItem is null) return;

        var item = pendingItem;
        var jpeg = pendingShot;
        var shotAt = pendingTakenAt;
        var driverId = Session.CurrentUser?.UserId ?? 0;

        ClearPending();
        cameraBusy = true;
        try
        {
            // An existing name is reused so a retake replaces the object it is replacing
            // on screen. A new one is minted only for the first photograph of an item.
            if (!photos.TryGetValue(item.ItemId, out var objectId))
                objectId = Guid.NewGuid();

            if (await Photos.UploadAsync(driverId, objectId, jpeg))
            {
                photos[item.ItemId] = objectId;
                takenAt[item.ItemId] = shotAt;
                thumbs[item.ItemId] = $"data:image/jpeg;base64,{Convert.ToBase64String(jpeg)}";
                uploadFailed.Remove(item.ItemId);
                SaveDraft();
            }
            else
            {
                uploadFailed.Add(item.ItemId);
            }
        }
        finally { cameraBusy = false; }
    }

    /// <summary>Takes back a photograph, removing the stored object with it.</summary>
    private async Task DropPhotoAsync(CItem item)
    {
        uploadFailed.Remove(item.ItemId);
        thumbs.Remove(item.ItemId);

        if (!photos.Remove(item.ItemId, out var objectId)) return;

        await Photos.DeleteAsync(Session.CurrentUser?.UserId ?? 0, objectId);
        SaveDraft();
    }

    private void ClearPending()
    {
        pendingShot = null;
        pendingPreview = null;
        pendingItem = null;
    }

    /// <summary>Writes the walk-around down so an interruption cannot erase it.</summary>
    private void SaveDraft()
    {
        var statuses = sections
            .SelectMany(s => s.Items)
            .Where(i => i.Status is not null)
            .ToDictionary(i => i.ItemId, i => i.Status!);

        Draft.Save(TripId, currentSection, statuses, photos);
    }

    /// <summary>
    /// Puts back a walk-around the operating system interrupted.
    /// </summary>
    /// <remarks>
    /// Statuses are matched by the configured item rather than by its wording, so an item
    /// reworded while the driver was in the camera still finds its answer. An item that
    /// has since been removed from the inspection is simply not found, which is the right
    /// outcome: it is no longer part of what is being asked.
    ///
    /// Thumbnails do not come back. The reference does, so the photograph is still
    /// attached and will still be submitted; the row says so without showing it.
    /// </remarks>
    private void RestoreDraft()
    {
        var saved = Draft.Load(TripId);
        if (saved is null) return;

        var byId = sections.SelectMany(s => s.Items).ToDictionary(i => i.ItemId);
        foreach (var (itemId, status) in saved.Statuses)
            if (byId.TryGetValue(itemId, out var item)) item.Status = status;

        foreach (var (itemId, objectId) in ChecklistDraft.PhotosOf(saved))
            if (byId.ContainsKey(itemId)) photos[itemId] = objectId;

        if (saved.Section >= 0 && saved.Section < sections.Count)
            currentSection = saved.Section;
    }

    private void Back()
    {
        if (currentSection > 0) { currentSection--; SaveDraft(); }
        else Nav.NavigateTo("/home");
    }

    // The hardware back button steps through the sections as well, so it cannot leave a
    // part-filled checklist from the middle of the form.
    public void Dispose()
    {
        if (BackNavigation.PageHandler == HandleHardwareBack) BackNavigation.PageHandler = null;
    }

    private bool HandleHardwareBack()
    {
        // A dialog on screen is what back closes, before the form underneath it. The
        // preview is discarded rather than kept, matching what backing out of a camera
        // means everywhere else.
        if (pendingShot is not null)
        {
            InvokeAsync(() => { ClearPending(); StateHasChanged(); });
            return true;
        }

        if (showSkipConfirm)
        {
            InvokeAsync(() => { showSkipConfirm = false; StateHasChanged(); });
            return true;
        }

        if (currentSection <= 0) return false; // let the route map take it to /home
        InvokeAsync(() => { currentSection--; StateHasChanged(); });
        return true;
    }

    private async Task Next()
    {
        if (CurrentSection.Items.Any(i => i.Status is null))
        {
            message = "Please mark every item before continuing.";
            return;
        }

        if (!IsLast)
        {
            currentSection++;
            message = null;
            SaveDraft();
            return;
        }

        await Submit();
    }

    private async Task Submit()
    {
        busy = true;
        try
        {
            // The outcome is the server's to decide. It holds the configured items, so it
            // knows which faults ground a bus, and it is the only side permitted to ground
            // one. What is computed here is for the screen alone.
            var results = sections
                .SelectMany(s => s.Items)
                .ToDictionary(i => i.Label, i => i.Status ?? "Fail");

            // Only photographs of items still marked Fail are offered. One taken for an
            // item the driver then passed has already been deleted, and naming it here
            // would ask the server to record evidence of a fault nobody is reporting.
            var stillFailing = sections
                .SelectMany(s => s.Items)
                .Where(i => i.Status != "Pass")
                .Select(i => i.ItemId)
                .ToHashSet();

            var attached = photos
                .Where(p => stillFailing.Contains(p.Key))
                .Select(p => new AuthApi.PhotoRef(
                    p.Key,
                    InspectionPhotos.KeyFor(Session.CurrentUser?.UserId ?? 0, p.Value),
                    takenAt.TryGetValue(p.Key, out var when) ? when : null))
                .ToList();

            var r = await Api.SubmitInspectionAsync(TripId, results, null, attached);

            if (r.Outcome == AuthApi.Outcome.Unreachable)
            {
                message = "Cannot reach the server. Check your connection and try again.";
                return;
            }
            if (r.Outcome == AuthApi.Outcome.Failed)
            {
                message = $"{r.Message} Tell your operator, and do not start the trip.";
                return;
            }
            if (r.Outcome == AuthApi.Outcome.Denied)
            {
                message = r.Message;
                return;
            }

            blocked = r.Blocked;
            hasDefects = !blocked && r.Failed.Count > 0;
            reportedIssues = r.Failed;

            // The draft has served its purpose. The photograph names go with it: they
            // existed to match an uploaded object to its item, and the server has just
            // recorded that.
            Draft.Clear();

            submitted = true;
        }
        catch (Exception ex)
        {
            message = "Submit failed. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[Checklist] {ex}");
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Records the skip and hands the driver back to their shift.</summary>
    /// <remarks>
    /// No confirmation screen of its own. There is nothing to report back from an
    /// inspection that was not carried out, and what the driver came here to do is start
    /// the shift waiting on the home screen.
    /// </remarks>
    private async Task Skip()
    {
        busy = true;
        message = null;
        try
        {
            await Data.SkipChecklistAsync(TripId, trip!.VehicleId, Session.CurrentUser!.UserId);

            // A skipped inspection reports nothing, so anything photographed before the
            // driver chose to skip is evidence for a report that will not be made. The
            // objects are removed with the draft rather than left for the sweep.
            foreach (var (_, objectId) in photos)
                await Photos.DeleteAsync(Session.CurrentUser!.UserId, objectId);
            Draft.Clear();

            Nav.NavigateTo("/home");
        }
        catch (HttpRequestException ex) when (ex.StatusCode is not null)
        {
            // The server answered and said no. Blaming the connection would send the
            // driver hunting for a signal they already have.
            showSkipConfirm = false;
            message = "The server wouldn't record the skip. Complete the checklist instead, and tell your operator.";
            System.Diagnostics.Debug.WriteLine($"[Checklist.Skip] refused: {ex.Message}");
        }
        catch (Exception ex)
        {
            showSkipConfirm = false;
            message = "Couldn't skip the inspection. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[Checklist.Skip] {ex}");
        }
        finally
        {
            busy = false;
        }
    }

    public class Section
    {
        public string Title { get; }
        public string Key { get; }
        public List<CItem> Items { get; }

        public Section(string title, string key, List<ChecklistItem> items)
        {
            Title = title;
            Key = key;
            Items = items.Select(i => new CItem(i.ItemId, i.Label, i.IsCritical)).ToList();
        }
    }

    public class CItem
    {
        // Carried from the configured item so a photograph can name what it is of, and so
        // the draft can key on something that survives the wording being changed.
        public int ItemId { get; }
        public string Label { get; }
        public bool IsCritical { get; }
        public string? Status { get; set; }

        public CItem(int itemId, string label, bool isCritical)
        {
            ItemId = itemId;
            Label = label;
            IsCritical = isCritical;
        }
    }
}
