@page "/"
@layout LoginLayout
@inject AuthService Auth
@inject SessionService Session
@inject DriverDataService Data
@inject MessageWatch Watch
@inject NavigationManager Nav

<div class="login-bg">
    <img class="logo-img" src="images/routesync-mark.svg" alt="RouteSync" />
    <p class="app-name"><span class="n1">Route</span><span class="n2">Sync</span></p>

    <div class="card">
        <h1>Sign In</h1>

        <div class="field">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg></span>
            <input type="email" placeholder="Email" autocomplete="username"
                   @bind="email" @bind:event="oninput" />
        </div>

        <div class="field">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg></span>
            <input type="@(showPwd ? "text" : "password")" placeholder="Password" autocomplete="current-password"
                   @bind="password" @bind:event="oninput" @onkeydown="OnKey" />
            <button type="button" class="eye" @onclick="@(() => showPwd = !showPwd)">
                <EyeIcon Shown="@showPwd" />
            </button>
        </div>

        <div class="forgot"><a @onclick="Forgot">Forgot Password?</a></div>

        @if (!string.IsNullOrEmpty(notice))
        {
            <div class="notice">@notice</div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="message">@message</div>
        }

        <button class="btn-signin" @onclick="SignIn" disabled="@busy">
            @(busy ? "Signing in…" : "Sign In")
        </button>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? message;
    private string? notice;
    private bool busy;
    private bool showPwd;

    protected override async Task OnInitializedAsync()
    {
        // The reset flow issues no session, so it lands back here and says so.
        if (new Uri(Nav.Uri).Query.Contains("reset=1"))
            notice = "Password updated. Sign in with your new password.";

        if (await Session.RestoreAsync())
        {
            Watch.Start(Session.CurrentUser!.UserId);
            // A driver still on the temporary password, after the app was killed part-way
            // through changing it, is sent to change it before anything else.
            if (await SecureStorage.Default.GetAsync("fw_must_change") == "1")
            {
                Nav.NavigateTo("/set-password");
                return;
            }
            // Mid-trip, sign-in returns to the counter rather than the home screen, which
            // is what makes the app survive the WebView restarting on suspend or a network
            // change.
            var active = await SecureStorage.Default.GetAsync("fw_active_trip");
            if (!string.IsNullOrEmpty(active)) Nav.NavigateTo($"/trip-active/{active}");
            else Nav.NavigateTo("/home");
        }
    }

    private async Task SignIn()
    {
        message = null;
        busy = true;
        try
        {
            var user = await Auth.ValidateAsync(email.Trim(), password);
            if (user is null)
            {
                message = "Invalid email or password.";
                return;
            }

            await Session.SetAsync(user);
            Watch.Start(user.UserId);
            try { await Data.StampLoginAsync(user.UserId); } catch { /* non-blocking */ }

            // A new driver on the shared temporary password is sent to set their own.
            if (password == AuthService.TemporaryPassword)
            {
                await SecureStorage.Default.SetAsync("fw_must_change", "1");
                Nav.NavigateTo("/set-password");
                return;
            }
            Nav.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            message = "Login failed. Check your connection and try again.";
            System.Diagnostics.Debug.WriteLine($"[Login] {ex}");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignIn();
    }

    private void Forgot() => Nav.NavigateTo("/forgot-password");
}
