@page "/notifications"
@implements IDisposable
@inject SessionService Session
@inject DriverDataService Data
@inject MessageWatch Watch
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (loading)
{
    <div class="page-skeleton">
        <div class="sk sk-line w50" style="height:24px; margin-bottom:20px"></div>
        <div class="sk sk-line w30"></div>
        <div class="sk sk-card"></div>
        <div class="sk sk-card"></div>
        <div class="sk sk-card"></div>
    </div>
}
else
{
    <div class="notif">
        <div class="nhead">
            <div class="nbar">
                <h1 class="ntitle">Notifications</h1>
                @if (UnreadCount > 0)
                {
                    <button class="nmark" @onclick="MarkAllRead" disabled="@markingAll">
                        @(markingAll ? "Marking…" : "Mark All Read")
                    </button>
                }
            </div>

            <div class="nchips" role="tablist" aria-label="Show">
                <button role="tab" class="nchip @(unreadOnly ? "" : "on")" aria-selected="@(!unreadOnly)"
                        @onclick="() => unreadOnly = false">All</button>
                <button role="tab" class="nchip @(unreadOnly ? "on" : "")" aria-selected="@unreadOnly"
                        @onclick="() => unreadOnly = true">
                    Unread
                    @if (UnreadCount > 0)
                    {
                        <span class="ncount">@(UnreadCount > 99 ? "99+" : UnreadCount.ToString())</span>
                    }
                </button>
            </div>
        </div>

        @if (!items.Any())
        {
            <div class="nempty">
                <div class="bao-disc"><BaoHead Face="sleepy" /></div>
                <p class="nempty-t">No messages yet</p>
                <p class="nempty-s">Messages from dispatch will show up here.</p>
            </div>
        }
        else if (unreadOnly && UnreadCount == 0)
        {
            <div class="nempty">
                <div class="bao-disc"><BaoHead /></div>
                <p class="nempty-t">All caught up</p>
                <p class="nempty-s">You have read every message.</p>
                <button class="nsee" @onclick="() => unreadOnly = false">See All Messages</button>
            </div>
        }
        else
        {
            @if (unreadOnly)
            {
                @foreach (var n in Pinned)
                {
                    <div class="npin" @key="n.MessageId" @onclick="() => Open(n)">
                        <div class="npin-head">
                            <span class="npin-tag">Urgent</span>
                            <span class="npin-scope">@ScopeLabel(n)</span>
                            <span class="npin-when">@When(n)</span>
                        </div>
                        <p class="npin-t">@n.Subject</p>
                        <p class="npin-p">@n.Body</p>
                        <button class="npin-ack" @onclick="() => Acknowledge(n)" @onclick:stopPropagation="true">Got It</button>
                    </div>
                }
            }

            @foreach (var g in Grouped)
            {
                <h2 class="ngroup">@g.Key</h2>
                <div class="nday">
                @foreach (var n in g)
                {
                    var unread = Watch.IsUnread(n);
                    <button class="nrow @(unread ? "unread" : "") @(IsHighPriority(n) ? "urgent" : "")"
                            @key="n.MessageId" @onclick="() => Open(n)">
                        <span class="nicon @AudClass(n)"><AudIcon Audience="@Aud(n)" /></span>
                        <span class="nbody">
                            <span class="nt">@n.Subject</span>
                            <span class="np">@n.Body</span>
                        </span>
                        <span class="nside">
                            <span class="nwhen">@When(n)</span>
                            @if (unread)
                            {
                                <span class="ndot" aria-label="Unread"></span>
                            }
                        </span>
                    </button>
                }
                </div>
            }

            @if (!unreadOnly)
            {
                @if (olderMore)
                {
                    <button class="nolder" @onclick="LoadOlder" disabled="@loadingOlder">
                        @(loadingOlder ? "Loading…" : "Show older messages")
                    </button>
                }
                else
                {
                    <p class="nend">That is everything</p>
                }
            }
        }
    </div>

    @if (open is not null)
    {
        <div class="nscrim" @onclick="Close"></div>
        <div class="nsheet" role="dialog" aria-modal="true" aria-labelledby="nsheet-title">
            <div class="ngrab"></div>
            <div class="nsheet-head">
                <span class="nicon @AudClass(open)"><AudIcon Audience="@Aud(open)" /></span>
                <div>
                    <p class="nsheet-scope">
                        @ScopeLabel(open)
                        @if (IsHighPriority(open))
                        {
                            <span class="npin-tag">Urgent</span>
                        }
                    </p>
                    <p class="nsheet-sent">@PhTime.Raw(open.CreatedAt).ToString("ddd, MMM d, yyyy · h:mm tt")</p>
                </div>
            </div>
            <h2 id="nsheet-title" class="nsheet-t">@open.Subject</h2>
            <p class="nsheet-b">@open.Body</p>
            <button class="nclose" @onclick="Close">Close</button>
        </div>
    }
}

@code {
    private bool loading = true;
    private List<MessageModel> items = new();

    private bool unreadOnly;
    private MessageModel? open;

    private bool olderMore = true;
    private bool loadingOlder;

    // Urgent messages still waiting are pinned above the Unread list, each with its own
    // acknowledgement, and left out of the day groups beneath it.
    private IEnumerable<MessageModel> Pinned =>
        items.Where(n => Watch.IsUnread(n) && IsHighPriority(n));

    private IEnumerable<IGrouping<string, MessageModel>> Grouped =>
        (unreadOnly ? items.Where(n => Watch.IsUnread(n) && !IsHighPriority(n)) : items)
            .GroupBy(n => Label(PhTime.Raw(n.CreatedAt)));

    private static string Aud(MessageModel n) => (n.TargetAudience ?? "").ToLowerInvariant();

    private int UnreadCount => items.Count(Watch.IsUnread);
    private bool markingAll;

    private async Task MarkAllRead()
    {
        markingAll = true;
        try { await Watch.MarkReadAsync(items); }
        finally { markingAll = false; }
    }

    // Opening a message is reading it.
    private async Task Open(MessageModel n)
    {
        open = n;
        BackNavigation.PageHandler = HandleHardwareBack;
        await Watch.MarkReadAsync(n);
    }

    private async Task Acknowledge(MessageModel n) => await Watch.MarkReadAsync(n);

    private void Close()
    {
        open = null;
        if (BackNavigation.PageHandler == HandleHardwareBack) BackNavigation.PageHandler = null;
    }

    // The back button closes an open message before it leaves the tab.
    private bool HandleHardwareBack()
    {
        if (open is null) return false;
        InvokeAsync(() => { Close(); StateHasChanged(); });
        return true;
    }

    private async Task LoadOlder()
    {
        loadingOlder = true;
        try
        {
            var (all, more) = await Data.GetOlderMessagesAsync(Session.CurrentUser!.UserId);
            items = all;
            olderMore = more;
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"[Notifications.Older] {ex}"); }
        finally { loadingOlder = false; }
    }

    /// <summary>
    /// Compact age for a message heading: minutes, then hours, then a clock time.
    /// </summary>
    /// <param name="withDate">
    /// Whether an older message also gives its date. The tab's group heading carries the
    /// date, so its rows leave it out; a popup stands alone and needs it.
    /// </param>
    public static string When(MessageModel n, bool withDate = false)
    {
        var t = PhTime.Raw(n.CreatedAt);
        var age = PhTime.Now - t;
        if (age < TimeSpan.FromMinutes(1)) return "now";
        if (age < TimeSpan.FromHours(1)) return $"{(int)age.TotalMinutes}m";
        if (age < TimeSpan.FromHours(24)) return $"{(int)age.TotalHours}h";
        return t.ToString(withDate ? "MMM d, h:mm tt" : "h:mm tt");
    }

    private static bool IsHighPriority(MessageModel n) =>
        string.Equals(n.Priority, "high", StringComparison.OrdinalIgnoreCase);

    private static string ScopeLabel(MessageModel n) => Aud(n) switch
    {
        "all"   => "Broadcast Message",
        "route" => "Route Message",
        _       => "Direct Message"
    };

    private static string AudClass(MessageModel n) => Aud(n) switch
    {
        "all"   => "aud-all",
        "route" => "aud-route",
        _       => "aud-driver"
    };

    private static string Label(DateTime d)
    {
        var dd = d.Date;
        if (dd == PhTime.Now.Date) return "Today";
        if (dd == PhTime.Now.Date.AddDays(-1)) return "Yesterday";
        return dd.ToString(dd.Year == PhTime.Now.Year ? "dddd, MMMM d" : "MMMM d, yyyy");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/"); return; }
        // The message watch has usually read them already, so the list shows at once.
        if (Data.PeekMessages(Session.CurrentUser!.UserId) is { } held)
        {
            items = held;
            loading = false;
        }
        try { items = await Data.GetMessagesAsync(Session.CurrentUser!.UserId); }
        catch (Exception ex)
        {
            items = new();
            System.Diagnostics.Debug.WriteLine($"[Notifications.Load] {ex}");
        }
        finally { loading = false; }
        Watch.Changed += OnWatchChanged;
        _ = PollLoop();             // background: new messages appear without pull-to-refresh
    }

    // The badge and the read marks belong to the watch, so the rows follow it.
    private void OnWatchChanged() => InvokeAsync(StateHasChanged);

    // Re-fetches every five seconds while the tab is open, so new messages appear on their
    // own. Each check asks only for messages newer than the newest held.
    private readonly CancellationTokenSource pollCts = new();

    private async Task PollLoop()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(pollCts.Token))
            {
                try
                {
                    var fresh = await Data.GetMessagesAsync(Session.CurrentUser!.UserId);
                    await InvokeAsync(() =>
                    {
                        items = fresh;
                        StateHasChanged();
                    });
                }
                catch { /* background blip: keep showing the last good list */ }
            }
        }
        catch (OperationCanceledException) { /* page closed */ }
    }

    private DotNetObjectReference<Notifications>? _ptrRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ptrRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ptr.set", _ptrRef);
        }
    }

    // A pull reads the whole list again, the one time it is read in full after the first.
    [JSInvokable] public async Task Refresh()
    {
        items = await Data.GetMessagesAsync(Session.CurrentUser!.UserId, full: true);
        await Watch.RefreshNow();
        StateHasChanged();
    }

    public void Dispose()
    {
        Watch.Changed -= OnWatchChanged;
        if (BackNavigation.PageHandler == HandleHardwareBack) BackNavigation.PageHandler = null;
        pollCts.Cancel();
        pollCts.Dispose();
        _ptrRef?.Dispose();
    }
}
