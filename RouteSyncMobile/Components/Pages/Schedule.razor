@page "/schedule"
@implements IDisposable
@using FleetWiseMobile.Models
@inject SessionService Session
@inject DriverDataService Data
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="cal">

    <div class="cal-header">
        <button class="back" @onclick="@(() => Nav.NavigateTo("/home"))">&#8592;</button>
        <h1>My Schedule</h1>
        <span class="spacer"></span>
    </div>

    @if (loading)
    {
        <div class="sk sk-card" style="height:64px"></div>
        <div class="sk sk-card" style="height:300px"></div>
        <div class="sk sk-card" style="height:120px"></div>
    }
    else
    {
        <div class="cal-card">

        @* The month, and the way to another one. Back is open because what happened is
           settled; forward stops at the last week the planner has built. *@
        <div class="cal-bar">
            <button class="cal-step" @onclick="PrevMonth" aria-label="Previous month">&#8249;</button>
            <div class="cal-month">
                <p class="cal-month-n">@month.ToString("MMMM yyyy")</p>
                <p class="cal-month-s">@Pattern</p>
            </div>
            <button class="cal-step" @onclick="NextMonth" disabled="@(!CanGoForward)"
                    aria-label="Next month">&#8250;</button>
        </div>

        <div class="cal-grid" role="grid">
            @foreach (var d in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
            {
                <span class="cal-dow">@d</span>
            }

            @* The blanks before the first, so the month starts under the right weekday. *@
            @for (var i = 0; i < LeadingBlanks; i++)
            {
                <span class="cal-pad"></span>
            }

            @for (var day = 1; day <= DateTime.DaysInMonth(month.Year, month.Month); day++)
            {
                var date = new DateTime(month.Year, month.Month, day);
                var shifts = ShiftsOn(date);
                var onLeave = OnLeave(date);
                var unplanned = !IsScheduled(date);

                <button class="cal-day @DayClass(date, shifts, onLeave, unplanned)"
                        style="@DayStyle(shifts, onLeave)"
                        @onclick="@(() => Select(date))"
                        aria-label="@AriaFor(date, shifts, onLeave, unplanned)">
                    <span class="cal-n">@day</span>
                    @if (shifts.Count > 2 && onLeave is null)
                    {
                        <span class="cal-many">@shifts.Count</span>
                    }
                    else if (shifts.Count == 2 && shifts[0] == shifts[1] && onLeave is null)
                    {
                        <span class="cal-many">2</span>
                    }
                </button>
            }
        </div>

        <div class="cal-legend">
            @foreach (var s in new[] { "Morning", "Afternoon", "Evening" })
            {
                <span class="cal-key"><i class="cal-swatch" style="background:@ShiftColour(s)"></i>@s</span>
            }
            <span class="cal-key"><i class="cal-swatch cal-swatch--leave"></i>Approved leave</span>
            <span class="cal-key"><i class="cal-swatch cal-swatch--rest"></i>Rest day</span>
            <span class="cal-key"><i class="cal-swatch cal-swatch--none"></i>Not scheduled yet</span>
        </div>

        </div>@* /cal-card *@

        @* The detail for whichever day is chosen, on the page rather than over it. *@
        <div class="cal-panel">
            <div class="cal-panel-head">
                <p class="cal-panel-d">@selected.ToString("dddd, MMMM d")</p>
                <span class="cal-panel-tag @PanelTagClass">@PanelTag</span>
            </div>

            @if (OnLeave(selected) is LeaveRequest lv)
            {
                <div class="cal-leave">
                    <p class="cal-leave-t">On @lv.LeaveType.ToLowerInvariant() leave</p>
                    <p class="cal-leave-s">Approved. You are not scheduled to drive.</p>
                </div>
            }
            else if (ShiftsOn(selected).Count == 0)
            {
                <p class="cal-none">
                    @(IsScheduled(selected)
                        ? "Rest day. You have no assignment."
                        : "This week has not been scheduled yet. Check again closer to the date.")
                </p>
            }
            else
            {
                @foreach (var t in TripsOn(selected))
                {
                    <div class="cal-trip">
                        <span class="cal-trip-bar" style="background:@ShiftColour(t.ShiftType)"></span>
                        <div class="cal-trip-body">
                            <p class="cal-trip-r">@RouteName(t.RouteId)</p>
                            <p class="cal-trip-s">@t.ShiftType shift · @TimeRange(t)</p>
                            <p class="cal-trip-m">
                                @t.VehicleId
                                <span class="cal-trip-st @TripStateClass(t)">@TripState(t)</span>
                            </p>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private bool loading = true;
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime selected = DateTime.Today;

    private List<Trip> trips = new();
    private List<LeaveRequest> leave = new();
    private HashSet<DateTime> scheduledWeeks = new();
    private readonly Dictionary<int, string> routeNames = new();

    // The three shifts the planner writes, and nothing else. Keeping the words identical
    // to ScheduleViewModel.Shifts is what stops the legend disagreeing with the board the
    // dispatcher built the month on.
    //
    // Read as the day runs: the light of the morning, the orange of the afternoon, the
    // dark of the evening. A driver picks the pattern out of the grid without consulting
    // the legend, which is the whole point of colouring it.
    private static string ShiftColour(string shift) => shift switch
    {
        "Morning" => "#E5DE44",
        "Afternoon" => "#EF810E",
        "Evening" => "#053752",
        _ => "#8896A2",
    };

    /// <summary>Ink that can be read on a given fill.</summary>
    /// <remarks>
    /// Two of the three shifts are light enough that white numbers disappear on them, so
    /// the ink follows the fill rather than being set once for every filled day.
    /// </remarks>
    private static string ShiftInk(string shift) => shift switch
    {
        "Morning" => DarkInk,
        "Afternoon" => DarkInk,
        _ => "#FFFFFF",
    };

    private const string DarkInk = "#001A26";

    /// <summary>Days with more shifts on them than a square can draw.</summary>
    /// <remarks>
    /// Outside the palette on purpose. The three shift colours are the palette, and a
    /// fourth state drawn in the darkest of them was indistinguishable from the evening,
    /// which is the one thing this must not be mistaken for. Slate says none of the
    /// above, which is what it means.
    /// </remarks>
    private const string ManyColour = "#64748B";

    private const string LeaveColour = "#2E8B57";

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _ = PollLoop();
    }

    /// <summary>
    /// Keeps the month current while it is on screen.
    /// </summary>
    /// <remarks>
    /// Slower than the tab pages poll, because a month is read rather than acted on and
    /// an approval or a roster change is not something a driver is waiting on the second
    /// of. The cost is three queries a tick against a month either side.
    ///
    /// A month that has finished is left alone. Nothing in it can change in a way that
    /// matters, and a driver reading back through the year is not asking to be kept up to
    /// date with it.
    /// </remarks>
    private readonly CancellationTokenSource pollCts = new();

    private async Task PollLoop()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(pollCts.Token))
            {
                if (loading || month < ThisMonth) continue;
                await InvokeAsync(async () =>
                {
                    await Load(silent: true);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { /* page closed */ }
    }

    private DotNetObjectReference<Schedule>? _ptrRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ptrRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ptr.set", _ptrRef);
        }
    }

    [JSInvokable] public async Task Refresh() { await Load(silent: true); StateHasChanged(); }

    public void Dispose()
    {
        pollCts.Cancel();
        pollCts.Dispose();
        _ptrRef?.Dispose();
    }

    /// <summary>Reads the month on show, and the days either side of it.</summary>
    /// <param name="silent">
    /// Leaves the grid on screen while the month is re-read. The skeleton belongs to
    /// opening the page and to changing month, where there is nothing to show yet; raised
    /// on a refresh it blanks a calendar the driver is looking at.
    /// </param>
    private async Task Load(bool silent = false)
    {
        if (!silent) loading = true;
        var uid = Session.CurrentUser!.UserId;

        // A month plus the days either side that share its first and last weeks, so a
        // shift on the Sunday of a week beginning in the previous month is still found.
        var from = MondayOf(month).AddDays(-7);
        var to = month.AddMonths(1).AddDays(6);

        try
        {
            var tripsTask = Data.GetTripsBetweenAsync(uid, from, to);
            var leaveTask = Data.GetApprovedLeaveBetweenAsync(uid, from, to);
            var weeksTask = Data.GetScheduledWeeksAsync(from, to);

            await Task.WhenAll(tripsTask, leaveTask, weeksTask);

            trips = tripsTask.Result;
            leave = leaveTask.Result;
            scheduledWeeks = weeksTask.Result;

            foreach (var id in trips.Select(t => t.RouteId).Distinct().Where(id => !routeNames.ContainsKey(id)))
            {
                try
                {
                    var r = await Data.GetRouteAsync(id);
                    if (r is not null) routeNames[id] = r.RouteName;
                }
                catch { /* falls back to "Route N" */ }
            }
        }
        catch
        {
            // A month that cannot be read is an empty month rather than a broken page.
            trips = new();
            leave = new();
            scheduledWeeks = new();
        }

        loading = false;
    }

    private static DateTime MondayOf(DateTime d) => d.Date.AddDays(-(((int)d.DayOfWeek + 6) % 7));

    private int LeadingBlanks => ((int)new DateTime(month.Year, month.Month, 1).DayOfWeek + 6) % 7;

    /// <summary>Whether the week a day belongs to has been built by the planner.</summary>
    private bool IsScheduled(DateTime d) => scheduledWeeks.Contains(MondayOf(d));

    private DateTime ThisMonth => new(DateTime.Today.Year, DateTime.Today.Month, 1);

    /// <summary>The furthest month ahead the calendar will open.</summary>
    /// <remarks>
    /// One. Rotation is decided a month at a time and the planner builds next month
    /// shortly before it starts, so the month after next is a guess however much of it
    /// happens to be in the database. A week that runs across the turn of the month can
    /// put rows in it without any of it being planned.
    /// </remarks>
    private DateTime FurthestMonth => ThisMonth.AddMonths(1);

    /// <summary>
    /// Whether there is a month ahead worth opening.
    /// </summary>
    /// <remarks>
    /// One bound, and it does not apply to going back: any month up to this one has
    /// happened or is happening, and a driver who stepped back to August has to be able
    /// to return.
    ///
    /// Next month opens whether or not it has been planned. Refusing it while it was
    /// empty was guarding against a blank grid being read as a month off, and the
    /// hatching answers that now: an unplanned month draws as unplanned rather than as
    /// free, so there is nothing left to protect the driver from.
    /// </remarks>
    private bool CanGoForward => month.AddMonths(1) <= FurthestMonth;

    private List<Trip> TripsOn(DateTime d) =>
        trips.Where(t => t.Date.Date == d.Date)
             .OrderBy(t => t.ShiftStartTime)
             .ToList();

    private List<string> ShiftsOn(DateTime d) =>
        TripsOn(d).Select(t => t.ShiftType).ToList();

    private LeaveRequest? OnLeave(DateTime d) =>
        leave.FirstOrDefault(l => LeaveEntitlement.CoversDay(l, d));

    /// <summary>
    /// What the month is, said rather than left to be inferred. A driver is on one shift
    /// for most of a month, so the grid is close to one colour and the legend earns its
    /// place only where a day departs from the pattern. Naming the pattern is what makes
    /// that day visible.
    /// </summary>
    private string Pattern
    {
        get
        {
            var mine = trips.Where(t => t.Date.Month == month.Month && t.Date.Year == month.Year).ToList();
            if (mine.Count == 0) return "No assignments";

            var byShift = mine.GroupBy(t => t.ShiftType).OrderByDescending(g => g.Count()).ToList();
            var days = mine.Select(t => t.Date.Date).Distinct().Count();
            var main = byShift[0].Key;

            return byShift.Count == 1
                ? $"{main} shift · {days} {(days == 1 ? "day" : "days")}"
                : $"Mostly {main.ToLowerInvariant()} shift · {days} {(days == 1 ? "day" : "days")}";
        }
    }

    private string DayClass(DateTime d, List<string> shifts, LeaveRequest? onLeave, bool unplanned)
    {
        var c = new List<string>();
        if (d.Date == DateTime.Today) c.Add("cal-today");
        if (d.Date == selected.Date) c.Add("cal-sel");
        if (onLeave is not null) c.Add("cal-leave-day");
        else if (shifts.Count == 0 && unplanned) c.Add("cal-unplanned");
        else if (shifts.Count == 0) c.Add("cal-rest");
        else
        {
            c.Add("cal-on");
            if (shifts.Count == 2 && shifts[0] != shifts[1]) c.Add("cal-split");
        }
        return string.Join(" ", c);
    }

    /// <summary>
    /// The fill for one day. Leave wins outright. Two different shifts split the square
    /// on the diagonal, which is the one case a dispatcher reaches by overriding a
    /// consecutive-shift warning. Three or more, or the same shift twice, take a single
    /// neutral fill and a count: a square this size cannot say more, and the panel below
    /// can say all of it.
    /// </summary>
    private string DayStyle(List<string> shifts, LeaveRequest? onLeave)
    {
        if (onLeave is not null) return $"background:{LeaveColour};color:#FFFFFF";
        if (shifts.Count == 0) return "";

        if (shifts.Count == 1)
            return $"background:{ShiftColour(shifts[0])};color:{ShiftInk(shifts[0])}";

        // Two different shifts split the square. No single ink reads on both halves when
        // one is the yellow of the morning and the other the dark of the evening, so the
        // number is dark and carries a halo. The halo comes from the split class.
        if (shifts.Count == 2 && shifts[0] != shifts[1])
            return $"background:linear-gradient(135deg,{ShiftColour(shifts[0])} 0 50%,{ShiftColour(shifts[1])} 50% 100%)"
                 + $";color:{DarkInk}";

        return $"background:{ManyColour};color:#FFFFFF";
    }

    private string AriaFor(DateTime d, List<string> shifts, LeaveRequest? onLeave, bool unplanned)
    {
        var day = d.ToString("MMMM d");
        if (onLeave is not null) return $"{day}, approved leave";
        if (shifts.Count > 0) return $"{day}, {string.Join(" and ", shifts.Distinct())} shift";
        return unplanned ? $"{day}, not scheduled yet" : $"{day}, rest day";
    }

    private string RouteName(int id) => routeNames.GetValueOrDefault(id, $"Route {id}");

    /// <summary>
    /// How a trip stands, as the driver should read it.
    /// </summary>
    /// <remarks>
    /// Worked out rather than read off the row. Nothing writes Missed to trip_status: the
    /// dashboard derives it from the shift having closed on a trip that never started,
    /// and a trip left unstarted keeps saying Not Yet Started in the column for ever. A
    /// calendar printing the column would tell a driver a shift last month is still
    /// waiting to depart.
    ///
    /// The dispatcher's readiness words are not repeated here. Pending and Assignment
    /// Issue describe whether a bus can be sent, which is dispatch's problem and says
    /// nothing to the driver whose day it is; both read as Scheduled.
    /// </remarks>
    private static string TripState(Trip t)
    {
        if (string.Equals(t.TripStatus, "Active", StringComparison.OrdinalIgnoreCase))
            return "In progress";

        if (string.Equals(t.TripStatus, "Completed", StringComparison.OrdinalIgnoreCase))
            return "Completed";

        return ShiftEndAt(t) < PhTime.Now ? "Missed" : "Scheduled";
    }

    private static string TripStateClass(Trip t) => TripState(t) switch
    {
        "In progress" => "cal-trip-st--live",
        "Completed" => "cal-trip-st--done",
        "Missed" => "cal-trip-st--missed",
        _ => "cal-trip-st--due",
    };

    /// <summary>
    /// When a shift closes. An end at or before its start runs past midnight, so it
    /// closes on the following day.
    /// </summary>
    private static DateTime ShiftEndAt(Trip t) =>
        t.Date.Date.Add(t.ShiftEndTime)
            .AddDays(t.ShiftEndTime <= t.ShiftStartTime ? 1 : 0);

    private static string TimeRange(Trip t) =>
        $"{DateTime.Today.Add(t.ShiftStartTime):h:mm tt} to {DateTime.Today.Add(t.ShiftEndTime):h:mm tt}";

    /// <summary>How the chosen day stands, in a word, beside its date.</summary>
    private string PanelTag
    {
        get
        {
            if (OnLeave(selected) is not null) return "On leave";

            var n = ShiftsOn(selected).Count;
            if (n > 0) return n == 1 ? "1 shift" : $"{n} shifts";

            return IsScheduled(selected) ? "Rest day" : "Not scheduled";
        }
    }

    private string PanelTagClass
    {
        get
        {
            if (OnLeave(selected) is not null) return "cal-panel-tag--leave";
            if (ShiftsOn(selected).Count > 0) return "cal-panel-tag--on";
            return IsScheduled(selected) ? "cal-panel-tag--rest" : "cal-panel-tag--none";
        }
    }

    private void Select(DateTime d) => selected = d;

    private async Task PrevMonth()
    {
        month = month.AddMonths(-1);
        selected = month;
        await Load();
    }

    private async Task NextMonth()
    {
        if (!CanGoForward) return;
        month = month.AddMonths(1);
        selected = month;
        await Load();
    }
}
