@page "/profile"
@implements IDisposable
@using Microsoft.AspNetCore.Identity
@inject SessionService Session
@inject DriverDataService Data
@inject AuthApi Api
@inject MessageWatch Watch
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (loading)
{
    <div class="page-skeleton">
        <div class="sk sk-card tall" style="height:170px"></div>
        <div class="sk sk-card" style="height:76px"></div>
        <div class="sk sk-card"></div>
        <div class="sk sk-card"></div>
    </div>
}
else if (user is null)
{
    <div class="profile"><p class="muted">Could not load profile.</p></div>
}
else
{
    <div class="profile">

        <div class="hero">
            <div class="hero-avatar">@Initials</div>
            <p class="hero-name">@Session.DisplayName</p>
            <div class="hero-tags">
                <span class="tag role">Driver</span>
                <span class="tag avail @(available ? "on" : "off")">
                    <span class="dot"></span>@(available ? "Available" : "Unavailable")
                </span>
            </div>
            <p class="hero-since">Driving with RouteSync since @user.CreatedAt.ToString("MMMM yyyy")</p>
        </div>

        <div class="stats">
            <div class="stat">
                <p class="stat-n">@tripsDone</p>
                <p class="stat-l">Trips</p>
            </div>
            <div class="stat mid">
                <p class="stat-n">@passengers.ToString("N0")</p>
                <p class="stat-l">Passengers</p>
            </div>
            <div class="stat">
                <p class="stat-n">@tripsThisMonth</p>
                <p class="stat-l">This month</p>
            </div>
        </div>

        <p class="psec">Account</p>
        <div class="pinfo">
            <div class="prow">
                <span class="pico blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
                <span class="pk">Email</span><span class="pv">@user.EmailAddress</span>
            </div>
            <div class="prow">
                <span class="pico green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
                <span class="pk">Status</span><span class="pv">@(user.AccountStatus ?? "—")</span>
            </div>
            <div class="prow">
                <span class="pico amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg></span>
                <span class="pk">Member since</span><span class="pv">@user.CreatedAt.ToString("MMM d, yyyy")</span>
            </div>
            @if (lastTripDate is not null)
            {
                <div class="prow">
                    <span class="pico teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                    <span class="pk">Last trip</span><span class="pv">@lastTripDate.Value.ToString("MMM d, yyyy")</span>
                </div>
            }
        </div>

        <p class="psec">Leave</p>

        @* What is left of each allowance. Pending days are already taken off, and named
           separately, or a request waiting on a decision reads as days still available. *@
        <div class="lv-balances">
            @foreach (var type in LeaveEntitlement.Types)
            {
                var used = LeaveEntitlement.Used(leaveRequests, type, DateTime.Today.Year);
                var left = LeaveEntitlement.Remaining(leaveRequests, type, DateTime.Today.Year);
                <div class="lv-bal">
                    <p class="lv-bal-n">@left<span class="lv-bal-of">/@LeaveEntitlement.DaysPerYear[type]</span></p>
                    <p class="lv-bal-l">@type</p>
                    @if (used.Pending > 0)
                    {
                        <p class="lv-bal-p">@used.Pending pending</p>
                    }
                </div>
            }
        </div>

        <button class="popt" @onclick="ToggleLeaveForm">
            <span class="popt-left">
                <span class="pico teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/><path d="M9 15l2 2 4-4"/></svg></span>
                <span>File leave</span>
            </span>
            <span class="chev @(showLeaveForm ? "open" : "")">&#8250;</span>
        </button>
        @if (showLeaveForm)
        {
            <div class="pform expanded">
                <label>Type</label>
                <select @bind="leaveType">
                    @foreach (var type in LeaveEntitlement.Types)
                    {
                        <option value="@type">@type</option>
                    }
                </select>

                <label>First day off</label>
                <input type="date" @bind="leaveStart" />

                <label>Last day off</label>
                <input type="date" @bind="leaveEnd" />

                <label>Reason</label>
                <input @bind="leaveReason" maxlength="200" placeholder="Optional" />

                @* Notice is stated, not enforced. Three days is what the company asks
                   for, and a request filed later than that still goes through. *@
                @if (LeaveDays > 0)
                {
                    <p class="lv-note">
                        @LeaveDays @(LeaveDays == 1 ? "day" : "days"), filed @NoticeText.
                    </p>
                }

                @if (leaveMsg is not null)
                {
                    <p class="@(leaveOk ? "ok-msg" : "err-msg")">@leaveMsg</p>
                }

                <button class="psave" disabled="@(filingLeave || LeaveDays <= 0)" @onclick="FileLeave">
                    @(filingLeave ? "Sending…" : "File request")
                </button>
            </div>
        }

        @if (leaveRequests.Count > 0)
        {
            <div class="lv-list">
                @foreach (var r in leaveRequests.Take(showAllLeave ? leaveRequests.Count : 3))
                {
                    <div class="lv-row">
                        <span class="lv-badge @r.Status.ToLowerInvariant()">@r.Status</span>
                        <span class="lv-when">
                            <span class="lv-span">@Span(r)</span>
                            <span class="lv-meta">@r.LeaveType · @LeaveEntitlement.Days(r) @(LeaveEntitlement.Days(r) == 1 ? "day" : "days")</span>
                            @if (!string.IsNullOrWhiteSpace(r.DecisionNote))
                            {
                                <span class="lv-reason">@r.DecisionNote</span>
                            }
                        </span>
                        @if (string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="lv-cancel" @onclick="@(() => CancelLeave(r.RequestId))">Withdraw</button>
                        }
                    </div>
                }
                @if (leaveRequests.Count > 3)
                {
                    <button class="lv-more" @onclick="@(() => showAllLeave = !showAllLeave)">
                        @(showAllLeave ? "Show fewer" : $"Show all {leaveRequests.Count}")
                    </button>
                }
            </div>
        }

        <p class="psec">Settings</p>

        <button class="popt" @onclick="@(() => { showInfoForm = !showInfoForm; if (showInfoForm) showPwdForm = false; })">
            <span class="popt-left">
                <span class="pico teal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/></svg></span>
                <span>Personal Information</span>
            </span>
            <span class="chev @(showInfoForm ? "open" : "")">&#8250;</span>
        </button>
        @if (showInfoForm)
        {
            <div class="pform expanded">
                <label>Contact number</label>
                <input value="@contact" @oninput="OnContactInput" inputmode="numeric" maxlength="13" placeholder="0917 123 4567" />
                @if (contact.Length > 0 && !PhoneValid(contact))
                {
                    <p class="err-msg">Format: 09XX XXX XXXX</p>
                }
                <label>Address</label>
                <input @bind="address" placeholder="Home address" />
                <label>Emergency contact name</label>
                <input @bind="emName" placeholder="Full name" />
                <label>Emergency contact number</label>
                <input value="@emNumber" @oninput="OnEmNumberInput" inputmode="numeric" maxlength="13" placeholder="0917 123 4567" />
                @if (emNumber.Length > 0 && !PhoneValid(emNumber))
                {
                    <p class="err-msg">Format: 09XX XXX XXXX</p>
                }

                @if (!string.IsNullOrEmpty(profileMsg))
                {
                    <p class="@(profileOk ? "ok-msg" : "err-msg")">@profileMsg</p>
                }
                <button class="psave" @onclick="SaveProfile" disabled="@savingProfile">
                    @(savingProfile ? "Saving..." : "Save Changes")
                </button>
            </div>
        }

        <button class="popt" @onclick="@(() => { showPwdForm = !showPwdForm; if (showPwdForm) showInfoForm = false; })">
            <span class="popt-left">
                <span class="pico navy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
                <span>Change Password</span>
            </span>
            <span class="chev @(showPwdForm ? "open" : "")">&#8250;</span>
        </button>
        @if (showPwdForm)
        {
            <div class="pform expanded">
                <div class="pw-row">
                    <input type="@(showCur ? "text" : "password")" @bind="curPwd" @bind:event="oninput" placeholder="Current password" />
                    <button type="button" class="eye" @onclick="@(() => showCur = !showCur)">
                        <EyeIcon Shown="@showCur" />
                    </button>
                </div>
                <div class="pw-row">
                    <input type="@(showNew ? "text" : "password")" @bind="newPwd" @bind:event="oninput" placeholder="New password" />
                    <button type="button" class="eye" @onclick="@(() => showNew = !showNew)">
                        <EyeIcon Shown="@showNew" />
                    </button>
                </div>
                @* Bound on oninput above, so these fill in as the driver types rather
                   than waiting for the field to lose focus. *@
                <ul class="pw-rules">
                    <li class="@(Met(p => p.Length >= PasswordPolicy.MinLength))"><span class="dot"></span>@(PasswordPolicy.MinLength)+ characters</li>
                    <li class="@(Met(p => p.Any(char.IsDigit)))"><span class="dot"></span>A number</li>
                    <li class="@(Met(p => p.Any(char.IsUpper)))"><span class="dot"></span>Uppercase</li>
                    <li class="@(Met(p => p.Any(char.IsLower)))"><span class="dot"></span>Lowercase</li>
                </ul>
                <div class="pw-row">
                    <input type="@(showConfirm ? "text" : "password")" @bind="confirmPwd" @bind:event="oninput" placeholder="Confirm new password" />
                    <button type="button" class="eye" @onclick="@(() => showConfirm = !showConfirm)">
                        <EyeIcon Shown="@showConfirm" />
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(pwdMsg))
                {
                    <p class="@(pwdOk ? "ok-msg" : "err-msg")">@pwdMsg</p>
                }
                <button class="psave" @onclick="ChangePassword" disabled="@savingPwd">
                    @(savingPwd ? "Updating..." : "Update Password")
                </button>
            </div>
        }

        <button class="plogout" @onclick="@(() => showLogoutConfirm = true)">Log out</button>

        <p class="pver">RouteSync Driver</p>
    </div>

    @if (showLogoutConfirm)
    {
        <div class="overlay">
            <div class="ua-modal">
                <h2>Log out?</h2>
                <p class="lo-sub">You'll stop receiving assignments and messages until you log back in.</p>
                <div class="lo-actions">
                    <button class="lo-cancel" @onclick="@(() => showLogoutConfirm = false)">Cancel</button>
                    <button class="lo-confirm" @onclick="Logout">Log out</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool loading = true;
    private UserModel? user;

    private bool available;
    private int tripsDone, tripsThisMonth, passengers;
    private DateTime? lastTripDate;

    private string contact = "", address = "", emName = "", emNumber = "";
    private bool savingProfile, profileOk;
    private string? profileMsg;

    private string curPwd = "", newPwd = "", confirmPwd = "";
    private bool showCur, showNew, showConfirm;

    // Drives the rule checklist. Purely on-screen guidance; the edge function is
    // what actually decides whether a password is acceptable.
    private string Met(Func<string, bool> rule) => rule(newPwd) ? "met" : "";
    private bool savingPwd, pwdOk;
    private bool showPwdForm, showInfoForm, showLogoutConfirm;

    private List<LeaveRequest> leaveRequests = new();
    private bool showLeaveForm, showAllLeave, filingLeave, leaveOk;
    private string leaveType = LeaveEntitlement.Vacation;
    private string leaveReason = "";
    private string? leaveMsg;
    private DateTime leaveStart = DateTime.Today.AddDays(3);
    private DateTime leaveEnd = DateTime.Today.AddDays(3);

    /// <summary>Days the request covers, or zero when the dates make no sense.</summary>
    private int LeaveDays =>
        leaveEnd.Date < leaveStart.Date ? 0 : (int)(leaveEnd.Date - leaveStart.Date).TotalDays + 1;

    /// <summary>
    /// How much notice this carries, said plainly. The company asks for three days and
    /// does not require them, so this reports rather than warns.
    /// </summary>
    private string NoticeText => (leaveStart.Date - DateTime.Today).Days switch
    {
        < 0 => "for a day already past",
        0 => "for today",
        1 => "1 day ahead",
        var d => $"{d} days ahead"
    };

    private static string Span(LeaveRequest r) =>
        r.StartDate.Date == r.EndDate.Date
            ? r.StartDate.ToString("MMM d, yyyy")
            : $"{r.StartDate:MMM d} to {r.EndDate:MMM d, yyyy}";

    private void ToggleLeaveForm()
    {
        showLeaveForm = !showLeaveForm;
        if (showLeaveForm) { showInfoForm = false; showPwdForm = false; }
        leaveMsg = null;
    }

    private async Task FileLeave()
    {
        if (LeaveDays <= 0) return;

        // Days already spoken for include the ones still waiting, so a driver cannot
        // file past the allowance while earlier requests are undecided. This is the one
        // thing refused here: the notice rules are advice and are not.
        var left = LeaveEntitlement.Remaining(leaveRequests, leaveType, leaveStart.Year);
        if (LeaveDays > left)
        {
            leaveOk = false;
            leaveMsg = left == 0
                ? $"No {leaveType.ToLowerInvariant()} leave left this year."
                : $"That is {LeaveDays} days and you have {left} left.";
            return;
        }

        filingLeave = true;
        leaveMsg = null;
        try
        {
            await Data.FileLeaveAsync(
                Session.CurrentUser!.UserId, leaveType, leaveStart, leaveEnd, leaveReason);

            leaveRequests = await Data.GetLeaveRequestsAsync(Session.CurrentUser!.UserId);
            leaveOk = true;
            leaveMsg = "Filed. You will be told when it is decided.";
            leaveReason = "";
        }
        catch
        {
            leaveOk = false;
            leaveMsg = "That could not be sent. Check your connection and try again.";
        }
        finally
        {
            filingLeave = false;
        }
    }

    private async Task CancelLeave(long requestId)
    {
        try
        {
            await Data.CancelLeaveAsync(requestId);
            leaveRequests = await Data.GetLeaveRequestsAsync(Session.CurrentUser!.UserId);
        }
        catch
        {
            leaveOk = false;
            leaveMsg = "That could not be withdrawn. Try again.";
        }
    }
    private string? pwdMsg;

    private string Initials
    {
        get
        {
            var parts = (Session.DisplayName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "D",
                1 => parts[0][..1].ToUpper(),
                _ => $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/"); return; }

        await LoadUser();
        loading = false;
    }

    private async Task LoadUser()
    {
        var uid = Session.CurrentUser!.UserId;
        user = await Data.GetUserAsync(uid);
        if (user is not null)
        {
            contact = FormatPhone(Digits(user.ContactNumber));
            address = user.Address ?? "";
            emName = user.EmergencyContactName ?? "";
            emNumber = FormatPhone(Digits(user.EmergencyContactNumber));
        }

        // The driver's actual record: completed trips, passengers served, and this
        // month's runs. A failed read shows zeros rather than blocking the page.
        try
        {
            available = await Data.GetAvailabilityAsync(uid) == "Available";
            var trips = await Data.GetTripsForDriverAsync(uid);
            var done = trips.Where(t => t.TripStatus == "Completed").ToList();
            tripsDone = done.Count;
            passengers = done.Sum(t => t.TotalBoarded);
            tripsThisMonth = done.Count(t => t.Date.Year == DateTime.Today.Year && t.Date.Month == DateTime.Today.Month);
            lastTripDate = done.OrderByDescending(t => t.Date).FirstOrDefault()?.Date;
            leaveRequests = await Data.GetLeaveRequestsAsync(uid);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Profile.Stats] {ex}");
        }
    }

    private DotNetObjectReference<Profile>? _ptrRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ptrRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ptr.set", _ptrRef);
        }
    }
    [JSInvokable] public async Task Refresh() { await LoadUser(); StateHasChanged(); }
    public void Dispose() => _ptrRef?.Dispose();

    private async Task SaveProfile()
    {
        profileMsg = null;
        if (contact.Length > 0 && !PhoneValid(contact)) { profileMsg = "Contact number must be 09XX XXX XXXX."; profileOk = false; return; }
        if (emNumber.Length > 0 && !PhoneValid(emNumber)) { profileMsg = "Emergency number must be 09XX XXX XXXX."; profileOk = false; return; }

        savingProfile = true;
        try
        {
            await Data.UpdateProfileAsync(user!.UserId, Nz(contact), Nz(address), Nz(emName), Nz(emNumber));
            profileMsg = "Changes saved."; profileOk = true;
        }
        catch (Exception ex)
        {
            profileMsg = "Save failed. Check your connection.";
            System.Diagnostics.Debug.WriteLine($"[Profile.Save] {ex}");
        }
        finally { savingProfile = false; }
    }

    private async Task ChangePassword()
    {
        pwdMsg = null;
        var problem = PasswordPolicy.Problem(newPwd);
        if (problem is not null) { pwdMsg = problem; pwdOk = false; return; }
        if (newPwd != confirmPwd) { pwdMsg = "New passwords do not match."; pwdOk = false; return; }

        savingPwd = true;
        try
        {
            // The change-password edge function verifies and hashes server-side, and is
            // the only password writer this app has. There is no offline path.
            var r = await Api.ChangePasswordAsync(curPwd, newPwd);
            if (r.Outcome == AuthApi.Outcome.Denied)
            {
                pwdMsg = r.Message ?? "Current password is incorrect."; pwdOk = false; return;
            }
            if (r.Outcome == AuthApi.Outcome.Unreachable)
            {
                pwdMsg = "Cannot reach the server. Check your connection and try again."; pwdOk = false; return;
            }
            curPwd = newPwd = confirmPwd = "";
            pwdMsg = "Password updated."; pwdOk = true;
        }
        catch (Exception ex)
        {
            pwdMsg = "Update failed. Check your connection."; pwdOk = false;
            System.Diagnostics.Debug.WriteLine($"[Profile.Pwd] {ex}");
        }
        finally { savingPwd = false; }
    }

    private static string? Nz(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private void OnContactInput(ChangeEventArgs e) => contact = FormatPhone(Digits(e.Value?.ToString()));
    private void OnEmNumberInput(ChangeEventArgs e) => emNumber = FormatPhone(Digits(e.Value?.ToString()));

    private static string Digits(string? s)
    {
        var d = new string((s ?? "").Where(char.IsDigit).ToArray());
        return d.Length > 11 ? d[..11] : d;
    }

    // Formatted as 09XX XXX XXXX, in groups of four, three and four.
    private static string FormatPhone(string digits)
        => digits.Length <= 4 ? digits
         : digits.Length <= 7 ? $"{digits[..4]} {digits[4..]}"
         : $"{digits[..4]} {digits[4..7]} {digits[7..]}";

    private static bool PhoneValid(string formatted)
    {
        var d = new string(formatted.Where(char.IsDigit).ToArray());
        return d.Length == 11 && d.StartsWith("09");
    }

    private void Logout()
    {
        Watch.Stop();
        Session.Logout();
        Nav.NavigateTo("/");
    }
}
