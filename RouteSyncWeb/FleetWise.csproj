<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-FleetWise-e1d7bb4e-794c-4567-9243-d1c2d17706df</UserSecretsId>
  </PropertyGroup>

  <!--
    The RouteSync suite's version, read from the nearest vX.Y.Z git tag at build time
    by MinVer. A tagged commit builds as its release; a commit after it builds as a preview of
    the next minor release, such as 1.3.0-alpha.0.4, carrying the commit it was built from.
    The tag has to be in the checkout: a shallow clone has none and builds as 0.0.0.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="postgrest-csharp" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="supabase-csharp" Version="0.16.2" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
