@model FleetWise.Models.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="bg-wrapper">
    <div class="card">

        @* Left Panel *@
        <div class="left-panel">
            <div class="left-content">
                <img src="~/images/fleetwise-logo.png" alt="RouteSync" class="logo" />
                <div class="brand-name">
                    <span class="brand-fleet">Route</span><span class="brand-wise">Sync</span>
                </div>
                <p class="brand-sub">Operator Dashboard</p>
                <p class="tagline">Every Route Answered While It Runs</p>
            </div>
        </div>

        @* Right Panel *@
        <div class="right-panel">
            <h1 class="step-title">Reset Password</h1>
            <p class="step-hint">We will send a 6-digit code to your email.</p>

            <form asp-action="ForgotPassword" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()
                @* Only a whole-form error belongs here. Field errors show under their own field,
                   and asking for them here painted an empty panel. *@
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="error-message">
                        @Html.ValidationSummary(true)
                    </div>
                }

                <div class="input-group">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="M3 7l9 6 9-6" />
                        </svg>
                    </span>
                    <input asp-for="Email" class="input-field" placeholder="Email" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>

                <button type="submit" class="sign-in-btn">Send Code</button>

                <div class="forgot-password" style="text-align:center;margin-top:16px;">
                    <a asp-action="Index" asp-controller="Home">Back to sign in</a>
                </div>
            </form>
        </div>

    </div>
</div>
