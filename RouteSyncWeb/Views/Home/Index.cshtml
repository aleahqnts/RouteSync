@model FleetWise.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="bg-wrapper">
    <div class="card">

        @* Left Panel *@
        <div class="left-panel">
            <div class="left-content">
                <img src="~/images/fleetwise-logo.png" alt="FleetWise Logo" class="logo" />
                <div class="brand-name">
                    <span class="brand-fleet">Route</span><span class="brand-wise">Sync</span>
                </div>
                <p class="brand-sub">Operator Dashboard</p>
                <p class="tagline">Drive Your Fleet with Intelligence</p>
            </div>
        </div>

        @* Right Panel *@
        <div class="right-panel">
            <h1 class="sign-in-title">Sign In</h1>

            <form asp-action="Index" asp-controller="Home" method="post">
                @if (TempData["ResetDone"] is string resetDone)
                {
                    <div class="success-message">@resetDone</div>
                }
                @* Only a whole-form error belongs here. Field errors show under their own field,
                   and asking for them here painted an empty panel. *@
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="error-message">
                        @Html.ValidationSummary(true)
                    </div>
                }

                <div class="input-group">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <input asp-for="Email" class="input-field" placeholder="Email" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>

                <div class="input-group">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input asp-for="Password" class="input-field" placeholder="Password" autocomplete="current-password" />
                    <button type="button" class="eye" data-for="Password" aria-label="Show password">
                        <svg class="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg class="i-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7c2 0 3.8.6 5.3 1.5M22 12s-3.5 7-10 7c-2 0-3.8-.6-5.3-1.5" /><path d="M3 3l18 18" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>

                <div class="forgot-password">
                    <a asp-action="ForgotPassword" asp-controller="Home">Forgot Password?</a>
                </div>

                <button type="submit" class="sign-in-btn">Sign In</button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/password-ui.js" asp-append-version="true"></script>
}
