@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string action = "Index")
        => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction,     action,     StringComparison.OrdinalIgnoreCase);
}

@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Security.Claims
@using System.Globalization
@using FleetWise.Services
@inject NavCounts NavCounts

@*
    Icon helper. Each icon is a self-contained inline SVG that draws with the current
    colour, so it follows the link's own state without needing its own rules.
*@
@functions {
    public static IHtmlContent NavIcon(string name)
    {
        var svgMap = new System.Collections.Generic.Dictionary<string, string>
        {
            ["dashboard"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <rect x='3' y='3' width='7' height='7' rx='1'/>
                    <rect x='14' y='3' width='7' height='7' rx='1'/>
                    <rect x='3' y='14' width='7' height='7' rx='1'/>
                    <rect x='14' y='14' width='7' height='7' rx='1'/>
                  </svg>",

            ["map"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M12 2C8.686 2 6 4.686 6 8c0 4.418 6 12 6 12s6-7.582 6-12c0-3.314-2.686-6-6-6z'/>
                    <circle cx='12' cy='8' r='2'/>
                  </svg>",

            ["vehicles"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M5 17H3V9l2.5-4h11L19 9v8h-2'/>
                    <circle cx='7.5' cy='17' r='1.5'/>
                    <circle cx='16.5' cy='17' r='1.5'/>
                    <path d='M5 9h14'/>
                  </svg>",

            ["dispatch"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <circle cx='12' cy='12' r='9'/>
                    <circle cx='12' cy='12' r='1' fill='currentColor'/>
                    <path d='M12 3v3M12 18v3M3 12h3M18 12h3'/>
                    <path d='M12 12l4-4'/>
                  </svg>",


            ["reports"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/>
                    <polyline points='14 2 14 8 20 8'/>
                    <line x1='8' y1='13' x2='16' y2='13'/>
                    <line x1='8' y1='17' x2='13' y2='17'/>
                  </svg>",

            ["users"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/>
                    <circle cx='9' cy='7' r='4'/>
                    <path d='M23 21v-2a4 4 0 0 0-3-3.87'/>
                    <path d='M16 3.13a4 4 0 0 1 0 7.75'/>
                  </svg>",

            ["requests"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z'/>
                    <path d='M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2'/>
                    <polyline points='9 13 11 15 15 11'/>
                  </svg>",

            ["audit"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/>
                    <polyline points='9 12 11 14 15 10'/>
                  </svg>"
        };

        return svgMap.TryGetValue(name, out var svg)
            ? new HtmlString(svg)
            : HtmlString.Empty;
    }
}

@{
    // Perm = the web_permissions key that unlocks this link. Fleet Map + Dispatch are the
    // route-operations screens, both gated by "routes".
    var navItems = new[]
    {
        new { Label = "Dashboard", Short = "Home",     Controller = "Dashboard", Action = "Index", IconKey = "dashboard", Perm = "dashboard" },
        new { Label = "Fleet Map", Short = "Map",      Controller = "FleetMap",  Action = "Index", IconKey = "map",       Perm = "routes"    },
        new { Label = "Vehicles",  Short = "Vehicles", Controller = "Vehicles",  Action = "Index", IconKey = "vehicles",  Perm = "vehicles"  },
        new { Label = "Dispatch",  Short = "Dispatch", Controller = "Dispatch",  Action = "Index", IconKey = "dispatch",  Perm = "routes"    },
        new { Label = "Reports",   Short = "Reports",  Controller = "Reports",   Action = "Index", IconKey = "reports",   Perm = "reports"   },
        new { Label = "Users",     Short = "Users",    Controller = "Users",     Action = "Index", IconKey = "users",     Perm = "users"     },
        // Deciding who is off is not the same job as managing accounts, so it carries its
        // own permission rather than riding on "users".
        new { Label = "Requests",  Short = "Requests", Controller = "Requests",  Action = "Index", IconKey = "requests",  Perm = "requests"  },
        // Its own permission, deliberately not folded into "users": reading the trail is a
        // separate decision from managing accounts. No role has it until it is granted.
        new { Label = "Audit Log", Short = "Audit",    Controller = "Audit",     Action = "Index", IconKey = "audit",     Perm = "audit"     },
    };

    // What each tab is holding. Read once for the page and handed to both the rail and
    // the phone bar below, which draw the same eight destinations.
    var badges = await NavCounts.ReadAsync();

    FleetWise.Services.NavBadge BadgeFor(string controller) => controller switch
    {
        "Dispatch" => badges.Dispatch,
        "Requests" => badges.Requests,
        "Vehicles" => badges.Vehicles,
        _ => FleetWise.Services.NavBadge.None,
    };

    // The key the script below writes back into, and the reason a tab with nothing on it
    // still carries an empty marker: it has somewhere to put a count that arrives later.
    string BadgeKey(string controller) => controller switch
    {
        "Dispatch" => "dispatch",
        "Requests" => "requests",
        "Vehicles" => "vehicles",
        _ => null,
    };
}

<aside class="fw-sidebar" id="fwSidebar">

    @* Logo *@
    <div class="fw-sidebar__logo">
        <a asp-controller="Dashboard" asp-action="Index" class="fw-sidebar__logo-link">
            <img src="~/images/fleetwise-logo.png" alt="FleetWise" class="fw-sidebar__logo-img" />
            <span class="fw-sidebar__logo-text"><b>Route</b><strong>Sync</strong></span>
        </a>
        
    </div>

    <hr class="fw-sidebar__divider" />

    @* Navigation *@
    <nav class="fw-sidebar__nav" aria-label="Main navigation">
        <ul class="fw-sidebar__list">
            @foreach (var item in navItems)
            {
                // Only render links the signed-in role is permitted to see.
                if (!User.HasClaim("perm", item.Perm)) { continue; }
                var active = IsActive(item.Controller, item.Action);
                var key = BadgeKey(item.Controller);
                var badge = BadgeFor(item.Controller);
                <li class="fw-sidebar__item">
                    <a asp-controller="@item.Controller"
                       asp-action="@item.Action"
                       class="fw-sidebar__link @(active ? "fw-sidebar__link--active" : "")"
                       aria-current="@(active ? "page" : null)">
                        <span class="fw-sidebar__icon" aria-hidden="true">
                            @NavIcon(item.IconKey)
                        </span>
                        <span class="fw-sidebar__label">@item.Label</span>
                        @* Last in the row, so that opening the rail leaves it beside the
                           name. Collapsed there is no name to be beside and the stylesheet
                           puts it back on the icon's corner, which is the only thing
                           showing and the thing a dispatcher reads from across the room. *@
                        @if (key is not null)
                        {
                            <span class="fw-sidebar__badge @(badge.Urgent ? "fw-sidebar__badge--urgent" : "")"
                                  data-badge="@key" hidden="@(badge.Count == 0 ? "hidden" : null)">@badge.Count</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </nav>

    @* User profile *@
    <div class="fw-sidebar__profile">
        <img src="~/images/user-avatar.png" alt="User avatar" class="fw-sidebar__avatar" />
        <div class="fw-sidebar__profile-info">
            <span class="fw-sidebar__profile-name">@User.Identity?.Name</span>
            <span class="fw-sidebar__profile-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
        </div>
        <div class="fw-sidebar__logout">
            <button type="button" class="fw-sidebar__logout-btn" data-signout title="Logout">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </button>
        </div>
    </div>

</aside>

@*
    Touch navigation.

    The rail above opens on hover to show what its icons mean, which a finger
    cannot do. This is the same destinations as a bar across the foot of the
    screen, and only one of the two is ever present: see the (hover: none) query
    in sidebar.css.

    Four destinations sit in the bar and the rest live behind More, along with
    the account and the way out. Which four depends on what the signed-in role
    may see, so the split is worked out here rather than written down twice.
*@
@{
    var touchItems = navItems.Where(i => User.HasClaim("perm", i.Perm)).ToList();

    // Order of use for someone standing at a terminal, not the order of the rail.
    var barOrder = new[] { "Dashboard", "Dispatch", "FleetMap", "Vehicles" };
    var barItems = touchItems.Where(i => barOrder.Contains(i.Controller))
                             .OrderBy(i => Array.IndexOf(barOrder, i.Controller))
                             .ToList();
    var moreItems = touchItems.Except(barItems).ToList();

    // What the sheet is hiding. Requests lives behind the More button on a phone, so
    // without a mark on it an urgent sick call is one tap out of sight.
    var behind = moreItems.Select(m => BadgeFor(m.Controller)).ToList();
    var behindCount = behind.Sum(x => x.Count);
    var behindUrgent = behind.Any(x => x.Urgent);
}

<nav class="fw-bar" id="fwBar" aria-label="Main navigation">
    @{ var half = (barItems.Count + 1) / 2; }

    @for (int i = 0; i < barItems.Count; i++)
    {
        if (i == half)
        {
            <button type="button" class="fw-bar__more" id="fwMoreBtn"
                    aria-expanded="false" aria-controls="fwSheet" aria-label="More">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <span class="fw-bar__badge @(behindUrgent ? "fw-bar__badge--urgent" : "")"
                      data-badge-sum hidden="@(behindCount == 0 ? "hidden" : null)">@behindCount</span>
            </button>
        }

        var item = barItems[i];
        var active = IsActive(item.Controller, item.Action);
        var barKey = BadgeKey(item.Controller);
        var barBadge = BadgeFor(item.Controller);
        <a asp-controller="@item.Controller" asp-action="@item.Action"
           class="fw-bar__link @(active ? "fw-bar__link--active" : "")"
           aria-current="@(active ? "page" : null)">
            <span class="fw-bar__icon" aria-hidden="true">
                @NavIcon(item.IconKey)
                @if (barKey is not null)
                {
                    <span class="fw-bar__badge @(barBadge.Urgent ? "fw-bar__badge--urgent" : "")"
                          data-badge="@barKey" hidden="@(barBadge.Count == 0 ? "hidden" : null)">@barBadge.Count</span>
                }
            </span>
            <span class="fw-bar__label">@item.Short</span>
        </a>
    }
</nav>

<div class="fw-sheet-backdrop" id="fwSheetBackdrop"></div>

<div class="fw-sheet" id="fwSheet" role="dialog" aria-modal="true" aria-label="More">
    <div class="fw-sheet__grip"></div>

    @* Who is signed in, as a heading rather than a card. The button that ends the
       session used to sit here, which put the one destructive control in the sheet
       under the thumb that opened it. *@
    <div class="fw-sheet__account">
        <span class="fw-sheet__who">
            <span class="fw-sheet__name">@User.Identity?.Name</span>
            <span class="fw-sheet__role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
        </span>
    </div>

    <ul class="fw-sheet__list">
        @foreach (var item in moreItems)
        {
            var active = IsActive(item.Controller, item.Action);
            <li>
                <a asp-controller="@item.Controller" asp-action="@item.Action"
                   class="fw-sheet__link @(active ? "fw-sheet__link--active" : "")"
                   aria-current="@(active ? "page" : null)" tabindex="-1">
                    <span class="fw-sheet__icon" aria-hidden="true">@NavIcon(item.IconKey)</span>
                    @item.Label
                    @{ var sheetKey = BadgeKey(item.Controller); var sheetBadge = BadgeFor(item.Controller); }
                    @if (sheetKey is not null)
                    {
                        <span class="fw-sheet__badge @(sheetBadge.Urgent ? "fw-sheet__badge--urgent" : "")"
                              data-badge="@sheetKey" hidden="@(sheetBadge.Count == 0 ? "hidden" : null)">@sheetBadge.Count</span>
                    }
                </a>
            </li>
        }
    </ul>

    @* Past everything the sheet is opened for, so it is reached deliberately. *@
    <div class="fw-sheet__signout">
        <button type="button" class="fw-sheet__logout" data-signout>Sign out</button>
    </div>
</div>

@* Ending a session is one tap from the rail and one from the sheet, and puts a
   dispatcher back at the login screen mid-shift. Both ask first. The form lives
   here so there is one of it however the question was reached. *@
<div class="fw-confirm" id="fwSignOut" data-dialog-close="fwCloseSignOut"
     role="dialog" aria-modal="true" aria-labelledby="fwSignOutTitle">
    <div class="fw-confirm__box">
        <h2 class="fw-confirm__title" id="fwSignOutTitle">Sign out?</h2>
        <p class="fw-confirm__text">You will need to sign in again to get back to the board.</p>
        <div class="fw-confirm__actions">
            <button type="button" class="fw-confirm__cancel" id="fwSignOutCancel">Cancel</button>
            <form asp-controller="Home" asp-action="Logout" method="post">
                <button type="submit" class="fw-confirm__go">Sign out</button>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var dialog = document.getElementById('fwSignOut');
        if (!dialog) return;

        function open() { dialog.classList.add('fw-confirm--open'); }
        function close() { dialog.classList.remove('fw-confirm--open'); }

        document.querySelectorAll('[data-signout]').forEach(function (btn) {
            btn.addEventListener('click', open);
        });

        document.getElementById('fwSignOutCancel').addEventListener('click', close);
        dialog.addEventListener('click', function (e) { if (e.target === dialog) close(); });

        // Anything this sitting left in the tab goes with the sitting. The planner keeps
        // unsaved weeks in session storage so that moving between them does not lose
        // them, and that storage outlives the cookie: whoever signs in next in this tab
        // is otherwise handed a week they never touched.
        dialog.querySelector('form').addEventListener('submit', function () {
            try {
                Object.keys(sessionStorage)
                    .filter(function (k) { return k.indexOf('sch_draft_') === 0; })
                    .forEach(function (k) { sessionStorage.removeItem(k); });
            } catch (e) { /* private browsing */ }
        });

        // Named for dialog-stack.js, which closes the frontmost dialog on Escape.
        window.fwCloseSignOut = close;
    })();

    // Badges.
    //
    // The rail is drawn on every page, so a dispatcher reading the dashboard learns that
    // Requests is holding something without going to look. The first numbers come with
    // the page; this keeps them current while it is left open.
    //
    // A tab the role cannot open is not in the answer at all, so nothing here has to
    // decide who may see what.
    (function () {
        var marks = document.querySelectorAll('[data-badge]');
        if (!marks.length) return;

        function paint(el, count, urgent) {
            el.textContent = count;
            el.hidden = count === 0;
            el.classList.toggle('fw-sidebar__badge--urgent',
                urgent && el.classList.contains('fw-sidebar__badge'));
            el.classList.toggle('fw-bar__badge--urgent',
                urgent && el.classList.contains('fw-bar__badge'));
            el.classList.toggle('fw-sheet__badge--urgent',
                urgent && el.classList.contains('fw-sheet__badge'));
        }

        async function read() {
            var res = await fetch('/Nav/Badges', { headers: { 'X-Requested-With': 'fetch' } });
            if (!res.ok) return;
            var data = await res.json();

            marks.forEach(function (el) {
                var b = data[el.dataset.badge];
                if (b) paint(el, b.count, b.urgent);
            });

            // The sheet's own total, so the button that opens it says how much is inside.
            document.querySelectorAll('[data-badge-sum]').forEach(function (el) {
                var inside = document.querySelectorAll('#fwSheet [data-badge]');
                var total = 0, urgent = false;
                inside.forEach(function (one) {
                    var b = data[one.dataset.badge];
                    if (!b) return;
                    total += b.count;
                    urgent = urgent || b.urgent;
                });
                paint(el, total, urgent);
            });
        }

        function refresh() { read().catch(function () { /* the numbers on screen stand */ }); }

        // What is left for the poll to catch is a change made somewhere this page cannot
        // see: a driver filing a sick call from their own app, or another dispatcher on
        // another board. Asking more often costs the database nothing extra, since the
        // count itself is held for longer than the gap between two askings.
        //
        // Not while the tab is in the background: a rail nobody is looking at does not
        // need counting, and a phone left on a desk would poll all day.
        setInterval(function () {
            if (document.hidden) return;
            refresh();
        }, 15000);

        // Coming back to a tab that was left is arriving at it. Nothing was counted while
        // it was away, so the numbers on it are as old as the moment it was put down, and
        // sitting through the rest of a poll to learn that is what makes a badge look
        // stuck.
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) refresh();
        });

        // Read again whenever this page writes something.
        //
        // Anything a dispatcher does here can change what the rail is counting, and being
        // made to wait out a poll to be told about their own action is the whole of what
        // makes a badge feel broken. Hung on fetch rather than on each of the places that
        // write, because those are spread over every board and the list of them is not
        // stable; a page that submits a form navigates instead, and comes back counted.
        //
        // Only writes, and only writes that were accepted. The reading below is itself a
        // GET, so nothing here can set itself going.
        var afterWrite = null;
        var sent = window.fetch;

        window.fetch = function (input, init) {
            var how = (init && init.method)
                || (input && typeof input === 'object' && input.method)
                || 'GET';

            var answer = sent.apply(this, arguments);
            how = String(how).toUpperCase();
            if (how === 'GET' || how === 'HEAD') return answer;

            // A branch of its own, so what the caller does with the answer is untouched.
            answer.then(function (res) {
                if (!res || !res.ok) return;

                // Several writes in a row are one change as far as the rail is concerned,
                // and the server needs the moment it takes to have finished with them.
                clearTimeout(afterWrite);
                afterWrite = setTimeout(refresh, 400);
            }).catch(function () { /* the caller answers for its own failure */ });

            return answer;
        };
    })();
</script>
