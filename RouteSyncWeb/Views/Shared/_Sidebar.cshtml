@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string action = "Index")
        => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction,     action,     StringComparison.OrdinalIgnoreCase);
}

@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Security.Claims
@using System.Globalization

@*
    Icon helper. Each icon is a self-contained inline SVG that draws with the current
    colour, so it follows the link's own state without needing its own rules.
*@
@functions {
    public static IHtmlContent NavIcon(string name)
    {
        var svgMap = new System.Collections.Generic.Dictionary<string, string>
        {
            ["dashboard"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <rect x='3' y='3' width='7' height='7' rx='1'/>
                    <rect x='14' y='3' width='7' height='7' rx='1'/>
                    <rect x='3' y='14' width='7' height='7' rx='1'/>
                    <rect x='14' y='14' width='7' height='7' rx='1'/>
                  </svg>",

            ["map"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M12 2C8.686 2 6 4.686 6 8c0 4.418 6 12 6 12s6-7.582 6-12c0-3.314-2.686-6-6-6z'/>
                    <circle cx='12' cy='8' r='2'/>
                  </svg>",

            ["vehicles"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M5 17H3V9l2.5-4h11L19 9v8h-2'/>
                    <circle cx='7.5' cy='17' r='1.5'/>
                    <circle cx='16.5' cy='17' r='1.5'/>
                    <path d='M5 9h14'/>
                  </svg>",

            ["dispatch"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <circle cx='12' cy='12' r='9'/>
                    <circle cx='12' cy='12' r='1' fill='currentColor'/>
                    <path d='M12 3v3M12 18v3M3 12h3M18 12h3'/>
                    <path d='M12 12l4-4'/>
                  </svg>",


            ["reports"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/>
                    <polyline points='14 2 14 8 20 8'/>
                    <line x1='8' y1='13' x2='16' y2='13'/>
                    <line x1='8' y1='17' x2='13' y2='17'/>
                  </svg>",

            ["users"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/>
                    <circle cx='9' cy='7' r='4'/>
                    <path d='M23 21v-2a4 4 0 0 0-3-3.87'/>
                    <path d='M16 3.13a4 4 0 0 1 0 7.75'/>
                  </svg>",

            ["audit"] =
                @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'
                      stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                    <path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/>
                    <polyline points='9 12 11 14 15 10'/>
                  </svg>"
        };

        return svgMap.TryGetValue(name, out var svg)
            ? new HtmlString(svg)
            : HtmlString.Empty;
    }
}

@{
    // Perm = the web_permissions key that unlocks this link. Fleet Map + Dispatch are the
    // route-operations screens, both gated by "routes".
    var navItems = new[]
    {
        new { Label = "Dashboard", Short = "Home",     Controller = "Dashboard", Action = "Index", IconKey = "dashboard", Perm = "dashboard" },
        new { Label = "Fleet Map", Short = "Map",      Controller = "FleetMap",  Action = "Index", IconKey = "map",       Perm = "routes"    },
        new { Label = "Vehicles",  Short = "Vehicles", Controller = "Vehicles",  Action = "Index", IconKey = "vehicles",  Perm = "vehicles"  },
        new { Label = "Dispatch",  Short = "Dispatch", Controller = "Dispatch",  Action = "Index", IconKey = "dispatch",  Perm = "routes"    },
        new { Label = "Reports",   Short = "Reports",  Controller = "Reports",   Action = "Index", IconKey = "reports",   Perm = "reports"   },
        new { Label = "Users",     Short = "Users",    Controller = "Users",     Action = "Index", IconKey = "users",     Perm = "users"     },
        // Its own permission, deliberately not folded into "users": reading the trail is a
        // separate decision from managing accounts. No role has it until it is granted.
        new { Label = "Audit Log", Short = "Audit",    Controller = "Audit",     Action = "Index", IconKey = "audit",     Perm = "audit"     },
    };
}

<aside class="fw-sidebar" id="fwSidebar">

    @* Logo *@
    <div class="fw-sidebar__logo">
        <a asp-controller="Dashboard" asp-action="Index" class="fw-sidebar__logo-link">
            <img src="~/images/fleetwise-logo.png" alt="FleetWise" class="fw-sidebar__logo-img" />
            <span class="fw-sidebar__logo-text"><b>Route</b><strong>Sync</strong></span>
        </a>
        
    </div>

    <hr class="fw-sidebar__divider" />

    @* Navigation *@
    <nav class="fw-sidebar__nav" aria-label="Main navigation">
        <ul class="fw-sidebar__list">
            @foreach (var item in navItems)
            {
                // Only render links the signed-in role is permitted to see.
                if (!User.HasClaim("perm", item.Perm)) { continue; }
                var active = IsActive(item.Controller, item.Action);
                <li class="fw-sidebar__item">
                    <a asp-controller="@item.Controller"
                       asp-action="@item.Action"
                       class="fw-sidebar__link @(active ? "fw-sidebar__link--active" : "")"
                       aria-current="@(active ? "page" : null)">
                        <span class="fw-sidebar__icon" aria-hidden="true">
                            @NavIcon(item.IconKey)
                        </span>
                        <span class="fw-sidebar__label">@item.Label</span>
                    </a>
                </li>
            }
        </ul>
    </nav>

    @* User profile *@
    <div class="fw-sidebar__profile">
        <img src="~/images/user-avatar.png" alt="User avatar" class="fw-sidebar__avatar" />
        <div class="fw-sidebar__profile-info">
            <span class="fw-sidebar__profile-name">@User.Identity?.Name</span>
            <span class="fw-sidebar__profile-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
        </div>
        <div class="fw-sidebar__logout">
            <button type="button" class="fw-sidebar__logout-btn" data-signout title="Logout">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </button>
        </div>
    </div>

</aside>

@*
    Touch navigation.

    The rail above opens on hover to show what its icons mean, which a finger
    cannot do. This is the same destinations as a bar across the foot of the
    screen, and only one of the two is ever present: see the (hover: none) query
    in sidebar.css.

    Four destinations sit in the bar and the rest live behind More, along with
    the account and the way out. Which four depends on what the signed-in role
    may see, so the split is worked out here rather than written down twice.
*@
@{
    var touchItems = navItems.Where(i => User.HasClaim("perm", i.Perm)).ToList();

    // Order of use for someone standing at a terminal, not the order of the rail.
    var barOrder = new[] { "Dashboard", "Dispatch", "FleetMap", "Vehicles" };
    var barItems = touchItems.Where(i => barOrder.Contains(i.Controller))
                             .OrderBy(i => Array.IndexOf(barOrder, i.Controller))
                             .ToList();
    var moreItems = touchItems.Except(barItems).ToList();
}

<nav class="fw-bar" id="fwBar" aria-label="Main navigation">
    @{ var half = (barItems.Count + 1) / 2; }

    @for (int i = 0; i < barItems.Count; i++)
    {
        if (i == half)
        {
            <button type="button" class="fw-bar__more" id="fwMoreBtn"
                    aria-expanded="false" aria-controls="fwSheet" aria-label="More">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
            </button>
        }

        var item = barItems[i];
        var active = IsActive(item.Controller, item.Action);
        <a asp-controller="@item.Controller" asp-action="@item.Action"
           class="fw-bar__link @(active ? "fw-bar__link--active" : "")"
           aria-current="@(active ? "page" : null)">
            <span class="fw-bar__icon" aria-hidden="true">@NavIcon(item.IconKey)</span>
            <span class="fw-bar__label">@item.Short</span>
        </a>
    }
</nav>

<div class="fw-sheet-backdrop" id="fwSheetBackdrop"></div>

<div class="fw-sheet" id="fwSheet" role="dialog" aria-modal="true" aria-label="More">
    <div class="fw-sheet__grip"></div>

    @* Who is signed in, as a heading rather than a card. The button that ends the
       session used to sit here, which put the one destructive control in the sheet
       under the thumb that opened it. *@
    <div class="fw-sheet__account">
        <span class="fw-sheet__who">
            <span class="fw-sheet__name">@User.Identity?.Name</span>
            <span class="fw-sheet__role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
        </span>
    </div>

    <ul class="fw-sheet__list">
        @foreach (var item in moreItems)
        {
            var active = IsActive(item.Controller, item.Action);
            <li>
                <a asp-controller="@item.Controller" asp-action="@item.Action"
                   class="fw-sheet__link @(active ? "fw-sheet__link--active" : "")"
                   aria-current="@(active ? "page" : null)" tabindex="-1">
                    <span class="fw-sheet__icon" aria-hidden="true">@NavIcon(item.IconKey)</span>
                    @item.Label
                </a>
            </li>
        }
    </ul>

    @* Past everything the sheet is opened for, so it is reached deliberately. *@
    <div class="fw-sheet__signout">
        <button type="button" class="fw-sheet__logout" data-signout>Sign out</button>
    </div>
</div>

@* Ending a session is one tap from the rail and one from the sheet, and puts a
   dispatcher back at the login screen mid-shift. Both ask first. The form lives
   here so there is one of it however the question was reached. *@
<div class="fw-confirm" id="fwSignOut" data-dialog-close="fwCloseSignOut"
     role="dialog" aria-modal="true" aria-labelledby="fwSignOutTitle">
    <div class="fw-confirm__box">
        <h2 class="fw-confirm__title" id="fwSignOutTitle">Sign out?</h2>
        <p class="fw-confirm__text">You will need to sign in again to get back to the board.</p>
        <div class="fw-confirm__actions">
            <button type="button" class="fw-confirm__cancel" id="fwSignOutCancel">Cancel</button>
            <form asp-controller="Home" asp-action="Logout" method="post">
                <button type="submit" class="fw-confirm__go">Sign out</button>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var dialog = document.getElementById('fwSignOut');
        if (!dialog) return;

        function open() { dialog.classList.add('fw-confirm--open'); }
        function close() { dialog.classList.remove('fw-confirm--open'); }

        document.querySelectorAll('[data-signout]').forEach(function (btn) {
            btn.addEventListener('click', open);
        });

        document.getElementById('fwSignOutCancel').addEventListener('click', close);
        dialog.addEventListener('click', function (e) { if (e.target === dialog) close(); });

        // Named for dialog-stack.js, which closes the frontmost dialog on Escape.
        window.fwCloseSignOut = close;
    })();
</script>
