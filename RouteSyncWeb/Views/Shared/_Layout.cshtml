<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RouteSync</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/barlow-semi-condensed@@5.0.13/600.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/barlow-semi-condensed@@5.0.13/700.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FleetWise.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    @* The sidebar is on every page, so its styles are loaded with the layout that draws it. *@
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    @* Each page links its own stylesheet here, ahead of the markup that needs it. *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="app-layout">

        <div class="app-body">

            @* SIDEBAR *@
            @await Html.PartialAsync("_Sidebar")

            @* MAIN AREA *@
            <div class="main-area">

                <header class="topbar">
                    <div class="container-fluid d-flex align-items-center gap-5">
                        <span class="rs-bar-title">@ViewData["Title"]</span>
                        @if (IsSectionDefined("TopbarContent"))
                        {
                            @await RenderSectionAsync("TopbarContent", required: false)
                        }
                        <div>
                            @* optional user/profile/actions *@
                        </div>
                    </div>
                </header>

                @* PAGE CONTENT *@
                <main class="main-content">
                    @RenderBody()
                </main>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dialog-stack.js" asp-append-version="true"></script>
    <script src="~/js/mobile-nav.js" asp-append-version="true"></script>
    <script src="~/js/responsive-tables.js" asp-append-version="true"></script>
    <script src="~/js/filter-sheet.js" asp-append-version="true"></script>
    @if (IsSectionDefined("Scripts"))
    {
        @await RenderSectionAsync("Scripts", required: false)
    }

</body>
</html>
