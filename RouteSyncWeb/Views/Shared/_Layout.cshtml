<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The tab carries the product name alone on every page; the page's own title is shown in its top bar. *@
    <title>RouteSync</title>
    <script type="importmap" nonce="@CspNonce.Value"></script>
    @* Wires the handlers the pages name in data-on attributes. In the head, so it is
       already watching when the body is parsed. *@
    <script src="~/js/data-on.js" asp-append-version="true"></script>
    @* Writes times on the Philippine clock. In the head, so a page script can use it as
       it runs. *@
    <script src="~/js/rs-time.js" asp-append-version="true"></script>
    @* Light or dark, settled before anything is drawn. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    @* Served from this site rather than a font CDN: on a weak mobile signal a second host
       costs its own DNS, TCP and TLS round trips before the first glyph. The Latin files are
       preloaded so headings are not drawn first in a fallback face. *@
    <link rel="preload" href="/lib/poppins/files/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/lib/poppins/files/poppins-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/poppins/poppins.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FleetWise.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    @* The sidebar is on every page, so its styles are loaded with the layout that draws it. *@
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    @* Each page links its own stylesheet here, ahead of the markup that needs it. *@
    @await RenderSectionAsync("Styles", required: false)
    @* Chrome and Edge start building a navigation page in the background once the pointer
       rests on its link (or a finger touches it), so the click lands on a finished page.
       Navigation links only: every one is a plain GET page, and signing out is a POST form,
       which is never prerendered. Other browsers ignore this block. *@
    <script type="speculationrules" nonce="@CspNonce.Value">
    {
        "prerender": [{
            "where": { "and": [
                { "selector_matches": ".fw-sidebar__link, .fw-bar__link, .fw-sheet__link, .fw-sidebar__logo-link" },
                { "not": { "selector_matches": "[aria-current=page]" } }
            ] },
            "eagerness": "moderate"
        }]
    }
    </script>
</head>
<body>

    <div class="app-layout">

        <div class="app-body">

            @* SIDEBAR *@
            @await Html.PartialAsync("_Sidebar")

            @* MAIN AREA *@
            <div class="main-area">

                <header class="topbar">
                    <div class="container-fluid d-flex align-items-center gap-5">
                        <span class="rs-bar-title">@ViewData["Title"]</span>
                        @if (IsSectionDefined("TopbarContent"))
                        {
                            @await RenderSectionAsync("TopbarContent", required: false)
                        }
                        <div>
                            @* optional user/profile/actions *@
                        </div>
                    </div>
                </header>

                @* PAGE CONTENT *@
                <main class="main-content">
                    @RenderBody()
                </main>

            </div>

        </div>

    </div>

    @* No jQuery: nothing on the site uses it. Bootstrap's script is loaded only by the
       pages whose dialogs need it, in their own Scripts section, so every other page
       is spared parsing it on a phone. *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/table-sort.js" asp-append-version="true"></script>
    <script src="~/js/dialog-stack.js" asp-append-version="true"></script>
    <script src="~/js/mobile-nav.js" asp-append-version="true"></script>
    <script src="~/js/responsive-tables.js" asp-append-version="true"></script>
    <script src="~/js/filter-sheet.js" asp-append-version="true"></script>
    <script src="~/js/sticky-head.js" asp-append-version="true"></script>
    @if (IsSectionDefined("Scripts"))
    {
        @await RenderSectionAsync("Scripts", required: false)
    }

</body>
</html>
