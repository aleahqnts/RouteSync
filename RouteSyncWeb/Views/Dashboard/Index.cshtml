@model FleetWise.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@* PAGE TITLE + REFRESH *@
<div class="db-title-row">
    <h2 class="db-title">Dashboard</h2>
    <div class="db-title-tools">
        <span class="db-date-badge">@Model.Today.ToString("ddd, dd MMM yyyy")</span>
        <button class="db-btn-refresh" id="dbRefreshBtn" data-on="click:dbRefreshNow" title="Refresh this page only">
            <span class="db-refresh-ico"><svg class="rs-ico-refresh" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4" />
                <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4" />
            </svg></span> Refresh
        </button>
        <span class="db-updated" id="dbUpdated" title="Auto-refreshes every 5 seconds"></span>
    </div>
</div>

@* LIVE REGION (swapped by AJAX refresh) *@
<div id="dbStats">

@* chart data carried here so refresh can update the chart without reloading the page *@
<script type="application/json" id="dbChartData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { bars = Model.ChartData, usual = Model.ChartUsual, now = Model.ChartNowIndex }))</script>

@* STAT CARDS *@
<div class="db-stat-grid">

    <div class="db-stat-card">
        <div class="db-stat-header">
            <span class="db-stat-icon db-stat-icon--green">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <rect x="1" y="3" width="15" height="13" rx="2" />
                    <path d="M16 8h4l3 3v5h-7V8z" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
            </span>
            <span class="db-stat-label">Active Trips</span>
        </div>
        <div class="db-stat-value" id="dbActiveTrips">@Model.ActiveTrips</div>
    </div>

    <a href="/Vehicles?status=Flagged" class="db-stat-card db-stat-card--click" style="text-decoration:none;color:inherit;" title="View flagged vehicles">
        <div class="db-stat-header">
            <span class="db-stat-icon db-stat-icon--red">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
            </span>
            <span class="db-stat-label">Flagged Vehicles</span>
        </div>
        <div class="db-stat-value" id="dbFlagged">@Model.FlaggedVehicles</div>
    </a>

    <div class="db-stat-card db-stat-card--click" data-on="click:dbToggleBreakdown" title="Click for per-trip breakdown">
        <div class="db-stat-header">
            <span class="db-stat-icon db-stat-icon--blue">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                </svg>
            </span>
            <span class="db-stat-label">Total Boarded</span>
            <span class="db-stat-chevron" id="dbPaxChevron">&#9656;</span>
        </div>
        <div class="db-stat-value" id="dbBoarded">@Model.TotalPassengers</div>
        @{
            // Rendered whatever the figure, and hidden while it is zero, so a refresh has
            // somewhere to write the new one. Created on demand it would have to be built
            // in two places that could drift apart.
            var paxUp = Model.PassengerDelta >= 0;
        }
        <div class="db-stat-delta @(paxUp ? "db-stat-delta--up" : "db-stat-delta--down")"
             id="dbBoardedDelta" style="@(Model.PassengerDelta == 0 ? "display:none;" : "")">
            @Html.Raw(paxUp ? "&#x2B06;" : "&#x2B07;") @(paxUp ? "+" : "")@Model.PassengerDelta vs yesterday
        </div>
    </div>

    <div class="db-stat-card">
        <div class="db-stat-header">
            <span class="db-stat-icon db-stat-icon--pink">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </span>
            <span class="db-stat-label">Total Revenue</span>
        </div>
        <div class="db-stat-value" id="dbRevenue">&#8369;@Model.TotalRevenue.ToString("N0")</div>
        @{
            var revUp = Model.RevenueDelta >= 0;
        }
        <div class="db-stat-delta @(revUp ? "db-stat-delta--up" : "db-stat-delta--down")"
             id="dbRevenueDelta" style="@(Model.RevenueDelta == 0 ? "display:none;" : "")">
            @Html.Raw(revUp ? "&#x2B06;" : "&#x2B07;") &#8369;@(revUp ? "+" : "")@Model.RevenueDelta.ToString("N0") vs yesterday
        </div>
    </div>

</div>

@* TOTAL PASSENGERS MODAL (opened by the card) *@
<div class="db-modal-overlay" id="dbBreakdown" style="display:none;" data-on="click:dbBreakdownBackdrop">
    <div class="db-modal">
        @{
            // Only trips that carried passengers. A trip yet to start contributes nothing.
            var boardedRows = Model.ActiveTripBreakdown.Where(r => r.Passengers > 0).ToList();
        }
        <div class="db-modal-head">
            <div>
                <div class="db-modal-title">Total Boarded Breakdown</div>
                <div class="db-modal-sub" id="dbBreakdownSub">Trips with boarding (@boardedRows.Count) &bull; @Model.TotalPassengers boarded</div>
            </div>
            <button class="db-modal-close" data-on="click:dbCloseModal" aria-label="Close">&times;</button>
        </div>
        <div class="db-modal-body" id="dbBreakdownBody">
            @if (boardedRows.Count == 0)
            {
                <div class="db-breakdown-empty">No boarded trips this service day yet.</div>
            }
            else
            {
                <table class="db-breakdown-table rs-cards" data-sort>
                    <thead>
                        <tr><th>Trip</th><th>Route</th><th>Vehicle</th><th>Shift</th><th>Status</th><th class="db-num">Boarded</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in boardedRows)
                        {
                            <tr>
                                <td class="db-bk-trip">@row.TripId</td>
                                <td class="db-bk-meta">@row.RouteName</td>
                                <td class="db-bk-meta">@row.VehicleId</td>
                                <td class="db-bk-meta">@row.ShiftType</td>
                                <td class="db-bk-meta">@row.Status</td>
                                <td class="db-num"><strong>@row.Passengers</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

</div>@* /#dbStats *@

@* MIDDLE ROW: Chart + Map *@
<div class="db-mid-grid">

    @* Passenger Demand Chart *@
    <div class="db-card db-card--chart">
        <div class="db-card-header">
            <span class="db-card-icon db-card-icon--teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </span>
            <span class="db-card-title">Passengers Boarded by Hour</span>
            <span class="db-badge db-badge--teal">@Model.SelectedRouteName</span>
            @* Each entry shows or hides its series on the chart. *@
            <div class="db-chart-legend">
                <button type="button" class="db-legend-item" data-series="0" aria-pressed="true"
                        title="Show or hide today's boardings">
                    <span class="db-legend-swatch" style="background:#4AADA8;"></span>
                    <span class="db-legend-text">Today</span>
                </button>
                <button type="button" class="db-legend-item" data-series="1" aria-pressed="true"
                        title="The average for each hour over the last four @(Model.Today.ToString("dddd"))s. Show or hide.">
                    <span class="db-legend-line"></span>
                    <span class="db-legend-text">@Model.Today.ToString("dddd") average</span>
                </button>
            </div>
        </div>
        <canvas id="demandChart" class="db-chart-canvas"></canvas>
    </div>

    @* Fleet Map *@
    <div class="db-card db-card--map">
        <div class="db-card-header">
            <span class="db-card-icon db-card-icon--green">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
                    <line x1="9" y1="3" x2="9" y2="18" />
                    <line x1="15" y1="6" x2="15" y2="21" />
                </svg>
            </span>
            <span class="db-card-title">Fleet Map</span>
        </div>
        <a class="db-map-link" href="@Url.Action("Index", "FleetMap")" aria-label="Open Fleet Map">
            <div id="dashFleetMap" class="db-map-leaflet"></div>
            <div class="db-map-legend">
                <div class="db-map-legend-title">Routes</div>
                <div id="dashMapLegend"></div>
            </div>
            <div class="db-map-overlay"><span class="db-map-more">Show more &rarr;</span></div>
        </a>
    </div>

    </div>


    @* Chart.js *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js" integrity="sha384-dug+JxfBvklEQdJ4AYuBBAIScUz0bVN73xpy273gcAwHjb3qI0fXmuYNaNfdyYJG" crossorigin="anonymous"></script>
    <script nonce="@CspNonce.Value">
        // What this page's controls run, by the names in their data-on attributes. The content
        // security policy refuses onclick and its kin; see wwwroot/js/data-on.js.
        rsOn({
            dbRefreshNow:        function () { dbRefresh(true); },
            dbToggleBreakdown:   function () { dbToggleBreakdown(); },
            dbBreakdownBackdrop: function (event) { if (event.target === this) dbCloseModal(); },
            dbCloseModal:        function () { dbCloseModal(); }
        });

        // Hour labels from the view model; the figures are read from the live region so a
        // refresh can update the chart without a reload.
        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));

        function dbReadHourly() {
            try {
                const d = JSON.parse(document.getElementById('dbChartData').textContent) || {};
                return { bars: d.bars || [], usual: d.usual || null, now: d.now ?? -1 };
            } catch (e) { return { bars: [], usual: null, now: -1 }; }
        }

        // The service day is read in shifts, so the shifts are drawn behind the bars, each
        // named along the top. Hours still to come are faded. Drawn before the grid, so the
        // grid lines run unbroken across all of it.
        const dbShifts = [
            { name: 'Morning', from: 0, to: 8, fill: 'rgba(74,173,168,0.06)' },
            { name: 'Afternoon', from: 8, to: 16, fill: 'rgba(59,130,246,0.05)' },
            { name: 'Evening', from: 16, to: 24, fill: 'rgba(124,58,237,0.05)' },
        ];

        const dbShiftBandPlugin = {
            id: 'dbShiftBand',
            beforeDraw(chart) {
                const { ctx, chartArea: area, scales: { x } } = chart;
                const half = (x.getPixelForValue(1) - x.getPixelForValue(0)) / 2;
                const left = i => Math.max(area.left, x.getPixelForValue(i) - half);
                const right = i => Math.min(area.right, x.getPixelForValue(i - 1) + half);

                ctx.save();
                dbShifts.forEach(s => {
                    ctx.fillStyle = s.fill;
                    ctx.fillRect(left(s.from), area.top, right(s.to) - left(s.from), area.bottom - area.top);
                    ctx.font = '600 11px Segoe UI';
                    ctx.textBaseline = 'top';
                    ctx.textAlign = 'center';
                    ctx.fillStyle = '#9AA5B4';
                    ctx.fillText(s.name, (left(s.from) + right(s.to)) / 2, area.top + 4);
                });

                const now = dbReadHourly().now;
                if (now >= 0 && now < chartLabels.length - 1) {
                    const from = left(now + 1);
                    ctx.fillStyle = 'rgba(255,255,255,0.55)';
                    ctx.fillRect(from, area.top + 20, area.right - from, area.bottom - area.top - 20);
                }
                ctx.restore();
            }
        };

        // The top of the axis clears the tallest bar or average figure by about a quarter,
        // rounded to a whole five, which leaves room for the shift names. Only series in
        // view are measured, so switching off a large average brings today's bars up to a
        // readable height.
        function dbYMax(d) {
            const m = Math.max(0,
                ...(dbSeriesOff[0] ? [] : d.bars.filter(v => v != null)),
                ...(dbSeriesOff[1] ? [] : (d.usual || [])));
            return m <= 0 ? 10 : Math.ceil((m * 1.25) / 5) * 5;
        }

        const dbAverageLabel = '@Model.Today.ToString("dddd") average';

        // Series the viewer has switched off, by dataset index. Kept across refreshes, so the
        // next reading does not switch one back on.
        const dbSeriesOff = { 0: false, 1: false };

        const dbFirst = dbReadHourly();
        const ctx = document.getElementById('demandChart').getContext('2d');
        // An hour still to come has no figure for today, and with the average hidden it
        // has nothing to show at all. The tooltip is then left undrawn rather than drawn
        // empty; reading a title from no items threw, and left the last tooltip frozen
        // on the chart.
        const dbNoEmptyTipPlugin = {
            id: 'dbNoEmptyTip',
            beforeTooltipDraw: (chart, args) => args.tooltip.dataPoints.length > 0
        };

        window.demandChart = new Chart(ctx, {
            plugins: [dbShiftBandPlugin, dbNoEmptyTipPlugin],
            data: {
                labels: chartLabels,
                datasets: [{
                    type: 'bar',
                    label: 'Boarded',
                    data: dbFirst.bars,
                    backgroundColor: '#4AADA8',
                    hoverBackgroundColor: '#3D9490',
                    borderRadius: 4,
                    maxBarThickness: 22,
                    order: 2
                }, {
                    type: 'line',
                    label: dbAverageLabel,
                    data: dbFirst.usual || [],
                    borderColor: '#94A3B8',
                    borderWidth: 1.8,
                    borderDash: [5, 4],
                    pointRadius: 0,
                    pointHoverRadius: 4,
                    pointHitRadius: 12,
                    // Follows the points without overshooting them, so the line never dips
                    // below zero or rises above a peak it only passes through.
                    cubicInterpolationMode: 'monotone',
                    fill: false,
                    hidden: !dbFirst.usual || dbSeriesOff[1],
                    order: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false, axis: 'x' },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        filter: item => item.raw != null,
                        callbacks: {
                            title: items => {
                                if (!items.length) return '';
                                const i = items[0].dataIndex;
                                return chartLabels[i] + ' to ' + chartLabels[(i + 1) % chartLabels.length];
                            },
                            label: item => (item.datasetIndex === 1 ? dbAverageLabel + ': ' : 'Boarded: ') + item.parsed.y
                        }
                    }
                },
                scales: {
                    x: {
                        title: { display: true, text: 'Hour of day (PHT)', color: '#9AA5B4', font: { size: 11, family: 'Segoe UI' } },
                        grid: { display: false },
                        ticks: { font: { size: 11, family: 'Segoe UI' }, color: '#9AA5B4' }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: dbYMax(dbFirst),
                        title: { display: true, text: 'Passengers', color: '#9AA5B4', font: { size: 11, family: 'Segoe UI' } },
                        ticks: { precision: 0, font: { size: 11, family: 'Segoe UI' }, color: '#9AA5B4' },
                        grid: { color: '#F0F0F0' }
                    }
                }
            }
        });

        // The average has nothing to show until there is history, so its entry is disabled
        // until then rather than toggling a line that is not there.
        function dbLegendState(hasAverage) {
            document.querySelectorAll('.db-legend-item').forEach(b => {
                const i = +b.dataset.series;
                b.disabled = i === 1 && !hasAverage;
                b.setAttribute('aria-pressed', String(!dbSeriesOff[i] && !b.disabled));
            });
        }

        document.querySelectorAll('.db-legend-item').forEach(b => {
            b.addEventListener('click', () => {
                const i = +b.dataset.series;
                dbSeriesOff[i] = !dbSeriesOff[i];
                dbUpdateChart();
            });
        });
        dbLegendState(!!dbFirst.usual);

        function dbUpdateChart() {
            const d = dbReadHourly();
            const c = window.demandChart;
            c.data.datasets[0].data = d.bars;
            c.data.datasets[1].data = d.usual || [];
            c.data.datasets[0].hidden = dbSeriesOff[0];
            c.data.datasets[1].hidden = !d.usual || dbSeriesOff[1];
            dbLegendState(!!d.usual);
            c.options.scales.y.suggestedMax = dbYMax(d);
            c.update();
        }

        // Total Passengers modal.
        function dbToggleBreakdown() {
        const m = document.getElementById('dbBreakdown');
        if (m) m.style.display = 'flex';
        }
        function dbCloseModal() {
        const m = document.getElementById('dbBreakdown');
        if (m) m.style.display = 'none';
        }
        document.addEventListener('keydown', e => { if (e.key === 'Escape') dbCloseModal(); });

        // AJAX refresh (manual button + silent 30s poll).
        let dbBusy = false;
        function dbStamp() {
        const at = rsTime.now();
        const el = document.getElementById('dbUpdated');
        if (el) el.textContent = 'Updated ' + at;

        // A phone has no room for a line that only carries a time, so the button
        // that refreshes the page says how old it is instead.
        const btn = document.getElementById('dbRefreshBtn');
        if (btn) btn.title = 'Updated ' + at + '. Auto-refreshes every 5 seconds.';
        }
        // Only the figures are fetched. Replacing the whole block meant re-rendering the
        // page, sending the markup for cards, a chart frame and a map that never change,
        // and rebuilding a DOM the browser had already drawn. Writing the values in place
        // also leaves the modal, its scroll position and any open state alone, which the
        // old refresh had to put back afterwards.
        const dbPeso = new Intl.NumberFormat('en-PH', { maximumFractionDigits: 0 });

        function dbSet(id, text) {
            const el = document.getElementById(id);
            if (el) el.textContent = text;
        }

        // Hidden rather than removed while a figure matches yesterday's, so the element
        // is still there to write to when it stops matching.
        function dbDelta(id, value, peso) {
            const el = document.getElementById(id);
            if (!el) return;
            if (!value) { el.style.display = 'none'; return; }
            const up = value >= 0;
            el.style.display = '';
            el.className = 'db-stat-delta ' + (up ? 'db-stat-delta--up' : 'db-stat-delta--down');
            el.textContent = (up ? '⬆ ' : '⬇ ') + (peso ? '₱' : '') +
                (up ? '+' : '') + dbPeso.format(value) + ' vs yesterday';
        }

        function dbBreakdown(rows, boarded) {
            dbSet('dbBreakdownSub',
                'Trips with boarding (' + rows.length + ') • ' + boarded + ' boarded');
            const body = document.getElementById('dbBreakdownBody');
            if (!body) return;
            if (!rows.length) {
                body.innerHTML = '<div class="db-breakdown-empty">No boarded trips this service day yet.</div>';
                return;
            }
            const cells = r => '<td class="db-bk-trip">' + dbEscape(r.tripId) + '</td>' +
                [r.routeName, r.vehicleId, r.shiftType, r.status]
                    .map(v => '<td class="db-bk-meta">' + dbEscape(v) + '</td>').join('') +
                '<td class="db-num"><strong>' + r.passengers + '</strong></td>';
            body.innerHTML =
                '<table class="db-breakdown-table rs-cards" data-sort><thead><tr>' +
                '<th>Trip</th><th>Route</th><th>Vehicle</th><th>Shift</th><th>Status</th>' +
                '<th class="db-num">Boarded</th></tr></thead><tbody>' +
                rows.map(r => '<tr>' + cells(r) + '</tr>').join('') +
                '</tbody></table>';
        }

        // The figures are names and identifiers out of the database, so they are written
        // as text rather than trusted as markup.
        function dbEscape(v) {
            const d = document.createElement('span');
            d.textContent = v == null ? '' : v;
            return d.innerHTML;
        }

        // The hourly chart is the largest part of each refresh and moves the least, so it is
        // asked for once a minute, or at once when refreshed by hand, while the cards keep
        // the five-second pace. Counted from the page load, which drew it.
        const dbChartEvery = 60000;
        let dbChartAt = Date.now();

        async function dbRefresh(manual) {
            if (dbBusy) return;
            dbBusy = true;
            const btn = document.getElementById('dbRefreshBtn');
            if (manual && btn) btn.classList.add('spinning');
            try {
                const url = new URL('@Url.Action("Stats", "Dashboard")', window.location.origin);
                const route = new URLSearchParams(window.location.search).get('routeId');
                if (route) url.searchParams.set('routeId', route);
                const withChart = manual || Date.now() - dbChartAt >= dbChartEvery;
                if (!withChart) url.searchParams.set('chart', 'false');
                // Figures are shared between viewers for a few seconds; a refresh asked for
                // by hand reads past that.
                if (manual) url.searchParams.set('fresh', 'true');

                const res = await fetch(url, {
                    cache: 'no-store',
                    headers: { 'X-Requested-With': 'fetch' },
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const d = await res.json();

                dbSet('dbActiveTrips', d.activeTrips);
                dbSet('dbFlagged', d.flaggedVehicles);
                dbSet('dbBoarded', d.totalPassengers);
                dbSet('dbRevenue', '₱' + dbPeso.format(d.totalRevenue));
                dbDelta('dbBoardedDelta', d.passengerDelta, false);
                dbDelta('dbRevenueDelta', d.revenueDelta, true);
                dbBreakdown(d.breakdown || [], d.totalPassengers);

                if (d.chartData) {
                    const chart = document.getElementById('dbChartData');
                    if (chart) chart.textContent = JSON.stringify(d.chartData);
                    dbUpdateChart();
                    dbChartAt = Date.now();
                }
                dbStamp();
            } catch (e) {
                console.warn('dashboard refresh failed', e);
            } finally {
                dbBusy = false;
                if (btn) btn.classList.remove('spinning');
            }
        }

        // Five seconds, the rate the counter phones write at. Nothing here changes faster
        // than that, so asking more often would only cost. The chart rides along once a
        // minute, as set above. The map beside it moves on its
        // own two-second clock, set in dashboard-fleetmap.js.
        setInterval(() => {
            if (document.hidden) return;
            dbRefresh(false);
        }, 5000);
        dbStamp();

        // Filter form helper.
        // Re-submits the filter form whenever the route dropdown changes.
        document.getElementById('routeSelect').addEventListener('change', function () {
        document.getElementById('filterForm').submit();
        });
    </script>

    @* Fleet Map preview (same live data as the Fleet Map page) *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH" crossorigin="anonymous"></script>
    <script src="~/js/route-motion.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-fleetmap.js" asp-append-version="true"></script>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

    @section TopbarContent {
        @* One form, which sends the route on every submission. *@
        <button type="button" class="rs-filter-toggle" data-filter-toggle="dbFilters"
                aria-expanded="false" aria-controls="dbFilters">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 5h18M6 12h12M10 19h4" />
            </svg>
            Filters
        </button>

        <form id="filterForm" method="get" action="@Url.Action("Index", "Dashboard")" style="display:contents;">

            <div class="db-topfilters rs-filters" id="dbFilters">
            <div class="db-route-wrap">
                <span class="db-route-label">Route:</span>
                <div class="db-route-select-wrap">
                    <select id="routeSelect" name="routeId" class="db-route-select">
                        <option value="">All Routes</option>
                        @foreach (var route in Model.Routes)
                        {
                            if (route.Selected)
                            {
                                <option value="@route.Value" selected>@route.Text</option>
                            }
                            else
                            {
                                <option value="@route.Value">@route.Text</option>
                            }
                        }
                    </select>
                    <span class="db-select-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </span>
                </div>
            </div>
            </div>

        </form>
    }
