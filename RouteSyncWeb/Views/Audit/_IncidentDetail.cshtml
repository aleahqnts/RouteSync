@model SecurityIncidentDetailViewModel
@using FleetWise.Services
@{
    var row = Model.Row;
    var i = row.Incident;
    var entries = Model.Entries;

    // What to look for, per rule. An incident says something unusual happened; this is
    // what turns that into a decision.
    var why = i.Rule switch
    {
        "failed_signins_address" =>
            "Ten or more failed sign-ins from one address within fifteen minutes. Many drivers can share one address on mobile data, so check whether the attempts name one account or many.",
        "failed_signins_account" =>
            "More failed sign-ins against this account than the sign-in lock allows in an hour, or twenty within a day. Somebody may be spacing out guesses to stay under the lock.",
        "signin_after_failures" =>
            "Three or more failed sign-ins for this account, then a successful one within the hour. Compare the addresses: a success from somewhere the failures did not come from, or that the owner does not use, may mean the password was guessed.",
        "pages_refused" =>
            "This user was turned away from pages their role cannot open ten or more times within ten minutes.",
        "counter_refused" =>
            "A counter phone was refused its passcode five or more times within fifteen minutes. Usually a phone set up with the wrong passcode; otherwise, somebody guessing it.",
        "reset_codes_failing" =>
            "Five or more wrong or already used password reset codes for this account within an hour.",
        _ => "",
    };

    string When(DateTimeOffset t) => PhClock.ToPh(t).ToString("MMM d, h:mm:ss tt");
}

<div class="modal-header">
    <div>
        <h5 class="modal-title" id="siModalTitle">@row.Title</h5>
        <div class="si-detail-subject">@row.Subject</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="si-facts">
        <div><dt>Entries</dt><dd>@i.EventCount</dd></div>
        <div><dt>First</dt><dd>@When(i.FirstSeenAt)</dd></div>
        <div><dt>Last</dt><dd>@When(i.LastSeenAt)</dd></div>
        <div><dt>Raised</dt><dd>@When(i.DetectedAt)</dd></div>
    </dl>

    @if (why.Length > 0)
    {
        <p class="si-why">@why</p>
    }

    @if (entries is null)
    {
        <p class="au-empty">The entries behind this incident could not be loaded. Try again in a moment.</p>
    }
    else
    {
        <div class="si-entries-wrap">
            <table class="au-table si-entries">
                <thead>
                    <tr>
                        <th style="width:150px">When</th>
                        <th style="width:130px">Address</th>
                        <th>What happened</th>
                        <th style="width:90px">Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in entries)
                    {
                        <tr>
                            <td class="au-when">@When(e.OccurredAt)</td>
                            <td class="si-ip">@(e.Ip ?? "Not recorded")</td>
                            <td>@(e.Summary ?? e.Action)</td>
                            <td>
                                <span class="au-pill @(e.Outcome == "denied" ? "au-pill--denied" : "au-pill--ok")">
                                    @(e.Outcome == "denied" ? "Refused" : "Allowed")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (entries.Count < i.EventCount)
        {
            <p class="si-note">Showing the first @entries.Count of @i.EventCount entries.</p>
        }
    }

    <p class="si-note">
        <a href="@Model.SearchUrl">Search the audit log around this</a>.
        A wider search by text, so it can include entries that are not part of this incident.
    </p>
</div>

<div class="modal-footer si-review">
    @if (!i.NeedsReview)
    {
        <p class="si-reviewed-note">
            Reviewed by @i.ReviewedBy on @When(i.ReviewedAt!.Value).
            @if (!string.IsNullOrWhiteSpace(i.ReviewNote))
            {
                <span class="si-review-quote">"@i.ReviewNote"</span>
            }
        </p>
    }
    else if (!row.CanReview)
    {
        <p class="si-reviewed-note">
            This incident is about your own account, so somebody else has to review it.
        </p>
    }
    else
    {
        <form method="post" action="@Url.Action("ReviewIncident", "Audit")" class="si-review-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@i.IncidentId" />
            @* What this reviewer was shown. Entries gathered after this point are
               activity they did not see, and return the incident to needing review. *@
            <input type="hidden" name="seen" value="@i.EventCount" />

            @if (i.ReviewedAt is not null)
            {
                <p class="si-reviewed-note">
                    Reviewed by @i.ReviewedBy on @When(i.ReviewedAt.Value), and has had new activity since.
                </p>
            }

            <label for="siNote" class="si-note-label">Note (optional)</label>
            <textarea id="siNote" name="note" maxlength="500" rows="2" class="au-input si-note-input"
                      placeholder="What you checked, or what you did about it"></textarea>

            <div class="si-review-actions">
                <button type="button" class="au-btn au-btn--outline" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="au-btn au-btn--primary">Mark reviewed</button>
            </div>
        </form>
    }
</div>
