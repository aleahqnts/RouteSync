@model ProfilePageViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var saved = TempData["ProfileSaved"] as string;

    static string StatusClass(string status) => status switch
    {
        "Approved" => "pf-badge--ok",
        "Rejected" => "pf-badge--bad",
        "Cancelled" => "pf-badge--idle",
        _ => "pf-badge--wait",
    };

    static string Tone(string status) => status switch
    {
        "Approved" => "ok",
        "Rejected" => "bad",
        "Cancelled" => "idle",
        _ => "wait",
    };

    // The days a request covers, for the date block: one day, a run inside one month,
    // or only the first day when the run crosses into the next month.
    static string Days(LeaveRequest r) =>
        r.StartDate.Date == r.EndDate.Date || r.StartDate.Month != r.EndDate.Month || r.StartDate.Year != r.EndDate.Year
            ? r.StartDate.Day.ToString()
            : $"{r.StartDate.Day}–{r.EndDate.Day}";

    static string StatusLabel(string status) =>
        status == "AwaitingChange" ? "Pending" : status;

    static string Span(LeaveRequest r) =>
        r.StartDate.Date == r.EndDate.Date
            ? r.StartDate.ToString("MMM d, yyyy")
            : r.StartDate.Year == r.EndDate.Year
                ? $"{r.StartDate:MMM d} – {r.EndDate:MMM d, yyyy}"
                : $"{r.StartDate:MMM d, yyyy} – {r.EndDate:MMM d, yyyy}";
}

@* Held at the top while the page scrolls, so whose profile this is stays in view. *@
<div class="pf-sticky">
    <h2 class="pf-title">My Profile</h2>

    <section class="pf-card pf-hero">
        <div class="pf-avatar" aria-hidden="true">@Model.Initials</div>
        <div class="pf-hero-text">
            <div class="pf-hero-name">@Model.FullName</div>
            <div class="pf-hero-tags">
                <span class="pf-badge pf-badge--role">@Model.Role</span>
                <span class="pf-badge @(Model.Status == "Activated" ? "pf-badge--ok" : "pf-badge--idle")">@Model.Status</span>
            </div>
            <div class="pf-hero-since">With RouteSync since @Model.MemberSince.ToString("MMMM yyyy")</div>
        </div>
    </section>
</div>

@if (!string.IsNullOrEmpty(saved))
{
    <div class="pf-flash" role="status">@saved</div>
}

@* What this person has done lately, in place of a driver's trip counts. *@
<div class="pf-stats">
    <div class="pf-card pf-stat">
        <span class="pf-ico pf-ico--teal" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>
        </span>
        <span class="pf-stat-text">
            <span class="pf-stat-n" title="@Model.ActionsThisMonth?.ToString("N0")">@(Model.ActionsThisMonth is int a ? FleetWise.Services.Figures.Compact(a) : "—")</span>
            <span class="pf-stat-l">Actions this month</span>
        </span>
    </div>
    <div class="pf-card pf-stat">
        <span class="pf-ico pf-ico--blue" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 9h18M8 3v4M16 3v4" /><path d="M9 15l2 2 4-4" /></svg>
        </span>
        <span class="pf-stat-text">
            <span class="pf-stat-n" title="@Model.DecisionsThisMonth?.ToString("N0")">@(Model.DecisionsThisMonth is int d ? FleetWise.Services.Figures.Compact(d) : "—")</span>
            <span class="pf-stat-l">Leave decisions this month</span>
        </span>
    </div>
    <div class="pf-card pf-stat">
        <span class="pf-ico pf-ico--amber" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 9h18M8 3v4M16 3v4" /></svg>
        </span>
        <span class="pf-stat-text">
            <span class="pf-stat-n" title="@Model.LeaveDaysTaken.ToString("N0")">@FleetWise.Services.Figures.Compact(Model.LeaveDaysTaken)</span>
            <span class="pf-stat-l">Leave days taken in @Model.Year</span>
        </span>
    </div>
</div>

<div class="pf-cols">

    <div class="pf-col">

        <section class="pf-card">
            <h3 class="pf-card-title">Account</h3>
            <div class="pf-info">
                <div class="pf-row">
                    <span class="pf-ico pf-ico--blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg></span>
                    <span class="pf-k">Email</span><span class="pf-v">@Model.Email</span>
                </div>
                <div class="pf-row">
                    <span class="pf-ico pf-ico--navy" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /></svg></span>
                    <span class="pf-k">Role</span><span class="pf-v">@Model.Role</span>
                </div>
                <div class="pf-row">
                    <span class="pf-ico pf-ico--green" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5 5-6" /></svg></span>
                    <span class="pf-k">Status</span><span class="pf-v">@Model.Status</span>
                </div>
                <div class="pf-row">
                    <span class="pf-ico pf-ico--amber" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 9h18M8 3v4M16 3v4" /></svg></span>
                    <span class="pf-k">Member since</span><span class="pf-v">@Model.MemberSince.ToString("MMM d, yyyy")</span>
                </div>
                <div class="pf-row">
                    <span class="pf-ico pf-ico--teal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
                    <span class="pf-k">Last sign-in</span><span class="pf-v">@(Model.LastSignIn?.ToString("MMM d, yyyy h:mm tt") ?? "Never")</span>
                </div>
            </div>
        </section>

        <section class="pf-card">
            <h3 class="pf-card-title">Personal details</h3>
            <form class="pf-form" data-profile-form action="@Url.Action("SaveDetails", "Profile")" novalidate>
                @Html.AntiForgeryToken()
                <div class="pf-row3">
                    <label class="pf-field">
                        <span class="pf-label">First name</span>
                        <input type="text" name="FirstName" value="@Model.FirstName" maxlength="50" autocomplete="given-name" required />
                        <span class="pf-err" data-err="firstName"></span>
                    </label>
                    <label class="pf-field">
                        <span class="pf-label">Middle name <em>(optional)</em></span>
                        <input type="text" name="MiddleName" value="@Model.MiddleName" maxlength="50" autocomplete="additional-name" />
                        <span class="pf-err" data-err="middleName"></span>
                    </label>
                    <label class="pf-field">
                        <span class="pf-label">Last name</span>
                        <input type="text" name="LastName" value="@Model.LastName" maxlength="50" autocomplete="family-name" required />
                        <span class="pf-err" data-err="lastName"></span>
                    </label>
                </div>
                <div class="pf-row2">
                    <label class="pf-field">
                        <span class="pf-label">Contact number</span>
                        <input type="tel" name="ContactNumber" value="@Model.ContactNumber" placeholder="09XX XXX XXXX" data-phone inputmode="numeric" autocomplete="tel" />
                        <span class="pf-err" data-err="contactNumber"></span>
                    </label>
                    <label class="pf-field">
                        <span class="pf-label">Address</span>
                        <input type="text" name="Address" value="@Model.Address" maxlength="200" placeholder="Home address" autocomplete="street-address" />
                        <span class="pf-err" data-err="address"></span>
                    </label>
                </div>
                <div class="pf-row2">
                    <label class="pf-field">
                        <span class="pf-label">Emergency contact name</span>
                        <input type="text" name="EmergencyContactName" value="@Model.EmergencyContactName" maxlength="100" />
                        <span class="pf-err" data-err="emergencyContactName"></span>
                    </label>
                    <label class="pf-field">
                        <span class="pf-label">Emergency contact number</span>
                        <input type="tel" name="EmergencyContactNumber" value="@Model.EmergencyContactNumber" placeholder="09XX XXX XXXX" data-phone inputmode="numeric" />
                        <span class="pf-err" data-err="emergencyContactNumber"></span>
                    </label>
                </div>
                <p class="pf-err pf-err--form" data-err="form"></p>
                <div class="pf-actions">
                    <button type="submit" class="pf-btn pf-btn--primary">Save details</button>
                </div>
            </form>
        </section>

        <section class="pf-card">
            <h3 class="pf-card-title">Change password</h3>
            <form class="pf-form" data-profile-form action="@Url.Action("ChangePassword", "Profile")" novalidate>
                @Html.AntiForgeryToken()
                <div class="pf-field">
                        <label class="pf-label" for="CurrentPassword">Current password</label>
                        <span class="pf-pw">
                            <input type="password" id="CurrentPassword" name="CurrentPassword" autocomplete="current-password" />
                            <button type="button" class="eye" data-for="CurrentPassword" aria-label="Show password">
                            <svg class="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="i-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7c2 0 3.8.6 5.3 1.5M22 12s-3.5 7-10 7c-2 0-3.8-.6-5.3-1.5" /><path d="M3 3l18 18" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                        </span>
                        <span class="pf-err" data-err="currentPassword"></span>
                    </div>
                <div class="pf-row2">
                    <div class="pf-field">
                        <label class="pf-label" for="NewPassword">New password</label>
                        <span class="pf-pw">
                            <input type="password" id="NewPassword" name="NewPassword" autocomplete="new-password" />
                            <button type="button" class="eye" data-for="NewPassword" aria-label="Show password">
                            <svg class="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="i-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7c2 0 3.8.6 5.3 1.5M22 12s-3.5 7-10 7c-2 0-3.8-.6-5.3-1.5" /><path d="M3 3l18 18" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                        </span>
                        <span class="pf-err" data-err="newPassword"></span>
                    </div>
                    <div class="pf-field">
                        <label class="pf-label" for="ConfirmPassword">Confirm new password</label>
                        <span class="pf-pw">
                            <input type="password" id="ConfirmPassword" name="ConfirmPassword" autocomplete="new-password" />
                            <button type="button" class="eye" data-for="ConfirmPassword" aria-label="Show password">
                            <svg class="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="i-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7c2 0 3.8.6 5.3 1.5M22 12s-3.5 7-10 7c-2 0-3.8-.6-5.3-1.5" /><path d="M3 3l18 18" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                        </span>
                        <span class="pf-err" data-err="confirmPassword"></span>
                    </div>
                </div>
                @* The same live checklist as the change and reset pages, driven by
                   password-ui.js from the same policy. *@
                <ul class="pw-rules" id="pwRules" data-min="@FleetWise.Services.PasswordPolicy.MinLength">
                    <li data-rule="len"><span class="dot"></span>@(FleetWise.Services.PasswordPolicy.MinLength)+ characters</li>
                    <li data-rule="digit"><span class="dot"></span>A number</li>
                    <li data-rule="upper"><span class="dot"></span>Uppercase</li>
                    <li data-rule="lower"><span class="dot"></span>Lowercase</li>
                </ul>
                <p class="pf-err pf-err--form" data-err="form"></p>
                <div class="pf-actions">
                    <button type="submit" class="pf-btn pf-btn--primary">Change password</button>
                </div>
            </form>
        </section>

    </div>

    <div class="pf-col">

        @* What is left of each allowance. Pending days are named separately, as on the
           driver app, or a request waiting on a decision reads as days still available. *@
        <section class="pf-card">
            <h3 class="pf-card-title">Leave credits <span class="pf-card-sub">@Model.Year</span></h3>
            <div class="pf-credits">
                @foreach (var b in Model.Balances)
                {
                    <div class="pf-credit">
                        <span class="pf-credit-n">@b.Left<span class="pf-credit-of">/@b.OfYear</span></span>
                        <span class="pf-credit-l">@b.Type</span>
                        @if (b.Pending > 0)
                        {
                            <span class="pf-credit-p">@b.Pending pending</span>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="pf-card">
            <div class="pf-card-head">
                <h3 class="pf-card-title">My leave requests</h3>
                <button type="button" class="pf-btn pf-btn--primary pf-btn--sm" data-leave-toggle aria-expanded="false" aria-controls="pfLeaveForm">File leave</button>
            </div>

            <form id="pfLeaveForm" class="pf-form pf-leave-form" data-profile-form action="@Url.Action("FileLeave", "Profile")" hidden novalidate>
                @Html.AntiForgeryToken()
                <div class="pf-row3">
                    <label class="pf-field">
                        <span class="pf-label">Type</span>
                        <select name="LeaveType">
                            @foreach (var t in LeaveEntitlement.Types)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                        <span class="pf-err" data-err="leaveType"></span>
                    </label>
                    <label class="pf-field">
                        <span class="pf-label">From</span>
                        <input type="date" name="StartDate" value="@Model.Today.ToString("yyyy-MM-dd")" min="@Model.Earliest.ToString("yyyy-MM-dd")" data-leave-start />
                        <span class="pf-err" data-err="startDate"></span>
                    </label>
                    <label class="pf-field">
                        <span class="pf-label">To</span>
                        <input type="date" name="EndDate" value="@Model.Today.ToString("yyyy-MM-dd")" min="@Model.Earliest.ToString("yyyy-MM-dd")" data-leave-end />
                        <span class="pf-err" data-err="endDate"></span>
                    </label>
                </div>
                <label class="pf-field">
                    <span class="pf-label">Reason <em>(optional)</em></span>
                    <textarea name="Reason" rows="2" maxlength="500"></textarea>
                    <span class="pf-err" data-err="reason"></span>
                </label>
                <p class="pf-err pf-err--form" data-err="form"></p>
                <div class="pf-actions">
                    <button type="button" class="pf-btn pf-btn--ghost" data-leave-toggle>Cancel</button>
                    <button type="submit" class="pf-btn pf-btn--primary">Submit request</button>
                </div>
            </form>

            @if (Model.Requests.Count == 0)
            {
                <p class="pf-empty pf-leave-empty">You have not filed any leave. Requests you file show here with their answer.</p>
            }
            else
            {
                <ul class="pf-leave-list">
                    @foreach (var r in Model.Requests)
                    {
                        var open = LeaveEntitlement.IsOpen(r.Status);
                        var approved = r.Status == "Approved";
                        var canAsk = approved && r.WithdrawRequestedAt is null && r.StartDate.Date >= Model.Today;
                        var chip = approved && r.WithdrawRequestedAt is not null
                            ? (r.WithdrawAnsweredAt is null ? "Cancel asked" : "Cancel refused")
                            : null;
                        var days = LeaveEntitlement.Days(r);

                        var dayText = Days(r);

                        <li class="pf-leave pf-leave--@Tone(r.Status)">
                            <div class="pf-leave-date" aria-hidden="true">
                                <span class="pf-leave-mon">@r.StartDate.ToString("MMM")</span>
                                <span class="pf-leave-day @(dayText.Length > 2 ? "pf-leave-day--run" : "")">@dayText</span>
                            </div>
                            <div class="pf-leave-main">
                                <div class="pf-leave-top">
                                    <span class="pf-leave-type">@r.LeaveType</span>
                                    <span class="pf-badge @StatusClass(r.Status)">@StatusLabel(r.Status)</span>
                                    @if (chip is not null)
                                    {
                                        <span class="pf-badge pf-badge--idle">@chip</span>
                                    }
                                </div>
                                <div class="pf-leave-span">@Span(r) &middot; @days @(days == 1 ? "day" : "days")</div>
                                @if (!string.IsNullOrWhiteSpace(r.Reason))
                                {
                                    <div class="pf-leave-note"><span class="pf-leave-label">Reason</span>@r.Reason</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(r.DecisionNote))
                                {
                                    <div class="pf-leave-reply"><span class="pf-leave-label">Answer</span>@r.DecisionNote</div>
                                }
                                @if (r.RevokedDates?.Count > 0)
                                {
                                    var n = r.RevokedDates.Count;
                                    var taken = $"{n} {(n == 1 ? "day was" : "days were")} taken back"
                                        + (string.IsNullOrWhiteSpace(r.RevokeNote) ? "" : $": {r.RevokeNote}");
                                    <div class="pf-leave-reply"><span class="pf-leave-label">Changed</span>@taken</div>
                                }
                            </div>

                            @if (open)
                            {
                                <form class="pf-leave-act" data-profile-form data-confirm="Cancel this request?"
                                      action="@Url.Action("CancelLeave", "Profile", new { requestId = r.RequestId })">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="pf-btn pf-btn--ghost pf-btn--sm">Cancel request</button>
                                    <p class="pf-err" data-err="form"></p>
                                </form>
                            }
                            else if (canAsk)
                            {
                                <details class="pf-leave-act">
                                    <summary class="pf-btn pf-btn--ghost pf-btn--sm">Ask to cancel</summary>
                                    <form class="pf-form pf-ask" data-profile-form
                                          action="@Url.Action("AskToCancel", "Profile", new { requestId = r.RequestId })">
                                        @Html.AntiForgeryToken()
                                        <label class="pf-field">
                                            <span class="pf-label">Why should this leave be cancelled?</span>
                                            <input type="text" name="reason" maxlength="500" />
                                            <span class="pf-err" data-err="withdrawReason"></span>
                                        </label>
                                        <p class="pf-err pf-err--form" data-err="form"></p>
                                        <button type="submit" class="pf-btn pf-btn--primary pf-btn--sm">Send</button>
                                    </form>
                                </details>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="pf-card">
            <h3 class="pf-card-title">Recent activity</h3>
            @if (Model.Recent.Count == 0)
            {
                <p class="pf-empty">Nothing recorded yet.</p>
            }
            else
            {
                <ul class="pf-activity">
                    @foreach (var e in Model.Recent)
                    {
                        <li>
                            <span class="pf-activity-what">@e.Summary</span>
                            <span class="pf-activity-when">@FleetWise.Services.PhClock.ToPh(e.OccurredAt).ToString("MMM d, h:mm tt")</span>
                        </li>
                    }
                </ul>
            }
        </section>

    </div>
</div>

@* Which release this is, for a bug report or a screenshot. Outside the columns, so it
   centres under the whole page rather than under the first column. *@
<p class="pf-version">RouteSync @FleetWise.Services.AppVersion.Text</p>

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/password-ui.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
