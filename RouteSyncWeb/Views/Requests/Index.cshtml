@model LeaveQueueViewModel
@{
    ViewData["Title"] = "Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tabs = new[] { "Pending", "Approved", "Rejected", "All" };

    // Drivers with something in the list being shown, so the filter offers names that
    // will actually match rather than the whole roster.
    var driversShown = Model.Rows
        .GroupBy(r => r.DriverId)
        .Select(g => new { Id = g.Key, Name = g.First().DriverName })
        .OrderBy(d => d.Name)
        .ToList();

    string TypeClass(string t) => t?.ToLowerInvariant() switch
    {
        "vacation" => "rq-badge--vacation",
        "sick" => "rq-badge--sick",
        "emergency" => "rq-badge--emergency",
        _ => "rq-badge--default"
    };

    string StatusClass(string s) => s?.ToLowerInvariant() switch
    {
        "approved" => "rq-badge--approved",
        "rejected" => "rq-badge--rejected",
        "cancelled" => "rq-badge--cancelled",
        _ => "rq-badge--pending"
    };
}

@* Everything that says what is being looked at, held while the list moves. *@
<div class="rq-sticky-head" data-sticky-head>

    <h2 class="rq-title">Requests</h2>

    @* One row, the way the other boards lay their controls out: what is being looked at
       on the left, what narrows it on the right. *@
    <div class="rq-toolbar">

        <div class="rq-tabs" role="group" aria-label="Filter by status">
            @foreach (var tab in tabs)
            {
                var on = string.Equals(Model.Status, tab, StringComparison.OrdinalIgnoreCase);
                <a class="rq-tab @(on ? "rq-tab--on" : "")"
                   href="@Url.Action("Index", new { status = tab })"
                   aria-current="@(on ? "page" : null)">@tab</a>
            }
        </div>

        @* Narrowing within the status already chosen. Applied to the rows on the page
           rather than by asking the server again, so the list answers on each keystroke
           and a half-typed name never costs a round trip.

           The labels are for the phone, where these fold into a sheet that names each
           field down the left. On a desk the placeholder and the resting value of a
           select say the same thing in less room. *@
        <div class="rq-filters rs-filters" id="rqFilters" data-filter-stay>
            <div class="rq-filter">
                <label for="rqSearch">Search</label>
                <span class="rq-search-wrap">
                    <span class="rq-search-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                             stroke="#9AA5B4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                    </span>
                    <input type="search" id="rqSearch" class="rq-input rq-search-input" autocomplete="off"
                           placeholder="Search driver, ID or reason" aria-label="Search requests" />
                </span>
            </div>

            <div class="rq-filter">
                <label for="rqType">Type</label>
                <select id="rqType" class="rq-input">
                    <option value="">All types</option>
                    @foreach (var t in LeaveEntitlement.Types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="rq-filter">
                <label for="rqDriver">Driver</label>
                <select id="rqDriver" class="rq-input">
                    <option value="">All drivers</option>
                    @foreach (var d in driversShown)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>

            <div class="rq-filter-actions">
                <button type="button" class="rq-btn rq-btn--outline" id="rqClear">Clear</button>
            </div>
        </div>

        @* A queue somebody else is adding to. The list is replaced in place, so a search
           being typed and a filter already chosen both survive it. *@
        <div class="rq-toolbar-end">
            <span id="rqPendingWrap">
                @if (Model.PendingCount > 0)
                {
                    <span class="rq-waiting">@Model.PendingCount Pending</span>
                }
            </span>
            <span class="rq-updated" id="rqUpdated" title="Checks for newly filed requests every 30 seconds"></span>
            <button type="button" class="rq-btn rq-btn--outline rq-btn--icon rq-refresh"
                    onclick="rqRefresh(true)" title="Load newly filed requests without losing your filters">
                <span class="rq-refresh-ico"><svg class="rs-ico-refresh" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4" />
                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4" />
                </svg></span> Refresh
            </button>
        </div>

    </div>

</div>

<div class="rq-card">
    <div class="rq-card-header" data-sticky-card>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z" />
            <path d="M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2" />
            <polyline points="9 13 11 15 15 11" />
        </svg>
        <span>Leave requests</span>
        <span class="rq-count" id="rqCount"></span>

        @* Shown only on a phone, where the title row above is not drawn: the app bar
           already says which page this is. The count of what is waiting still has to be
           somewhere, so it moves onto the card heading, which is the page heading in
           effect. *@
        <span class="rq-inline-pending" id="rqPendingInline">
            @if (Model.PendingCount > 0)
            {
                <span class="rq-waiting">@Model.PendingCount Pending</span>
            }
        </span>
    </div>

    <div class="rq-table-wrap rs-list-wrap">
        <table class="rq-table rs-cards rs-list">
            <thead>
                <tr>
                    <th>Driver</th>
                    <th>Type</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Days</th>
                    <th>Reason</th>
                    <th>Filed</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="rqRows">
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="rq-empty">
                            @(string.Equals(Model.Status, "Pending", StringComparison.OrdinalIgnoreCase)
                                ? "Nothing waiting on a decision."
                                : "No requests to show.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model.Rows)
                    {
                        var pending = string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase);

                        <tr data-request="@r.RequestId"
                            data-driver="@r.DriverId"
                            data-type="@r.LeaveType"
                            data-find="@($"{r.DriverName} {r.DriverId} {r.LeaveType} {r.Status} {r.Reason}".ToLowerInvariant())">

                            <td data-label="Driver">
                                <span class="rq-driver">@r.DriverName</span>
                                <span class="rq-driver-id">@r.DriverId</span>
                            </td>

                            <td data-label="Type"><span class="rq-badge @TypeClass(r.LeaveType)">@r.LeaveType</span></td>

                            <td data-label="Start"><span class="rq-date">@r.Start</span></td>
                            <td data-label="End"><span class="rq-date">@r.End</span></td>
                            <td data-label="Days"><span class="rq-days-n">@r.Days</span></td>

                            <td data-label="Reason">
                                @if (string.IsNullOrWhiteSpace(r.Reason))
                                {
                                    <span class="rq-blank">None given</span>
                                }
                                else
                                {
                                    <span class="rq-reason">@r.Reason</span>
                                }
                            </td>

                            <td data-label="Filed"><span class="rq-filed">@r.Filed</span></td>

                            @* What has been granted so far, out of the allowance. Days on
                               other requests still undecided are marked beside it, because
                               approving this one without noticing them is how an allowance
                               is overdrawn. *@
                            <td data-label="Balance">
                                <span class="rq-balance"
                                      title="@r.LeaveType.ToLowerInvariant() days granted so far this year">@r.RemainingOfType of @r.EntitlementOfType</span>
                                @if (r.OtherPendingDays > 0)
                                {
                                    <span class="rq-balance-pending"
                                          title="Days of the same leave on other requests still awaiting a decision">+@r.OtherPendingDays awaiting</span>
                                }
                            </td>

                            @* A decision that came with a note carries it here, on the word
                               it explains, rather than as a second line under the buttons. *@
                            <td data-label="Status">
                                <span class="rq-badge @StatusClass(r.Status)"
                                      title="@(pending ? null : r.DecisionNote)">@r.Status</span>
                            </td>

                            <td data-label="Actions">
                                <div class="rq-actions">
                                    @if (pending)
                                    {
                                        <button type="button" class="rq-btn rq-btn--approve"
                                                onclick="rqDecide(@r.RequestId, 'Approved')">Approve</button>
                                        <button type="button" class="rq-btn rq-btn--reject"
                                                onclick="rqDecide(@r.RequestId, 'Rejected')">Reject</button>
                                    }
                                    <button type="button" class="rq-btn rq-btn--history"
                                            onclick="rqHistory(@r.RequestId)">History</button>
                                </div>
                            </td>
                        </tr>
                    }
                }

                @* Shown when the filters match none of the rows on the page, which is a
                   different thing from the queue being empty. *@
                <tr id="rqNoMatch" hidden>
                    <td colspan="10" class="rq-empty">No request matches these filters.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@* What happened to each request, written out with the row it belongs to and shown when
   asked for. Rendered here rather than fetched, because it is already on the page. *@
<div id="rqHistoryModal" class="rq-overlay" style="display:none;" data-dialog-close="rqHistoryClose"
     role="dialog" aria-modal="true" aria-labelledby="rqHistoryTitle">
    <div class="rq-box">
        <div class="rq-box-head">
            <h3 class="rq-box-title" id="rqHistoryTitle">Request history</h3>
            <button type="button" class="rq-box-close" onclick="rqHistoryClose()" aria-label="Close">&times;</button>
        </div>
        <div id="rqHistoryBody"></div>
    </div>
</div>

<div id="rqTemplates" hidden>
    @foreach (var r in Model.Rows)
    {
        <template id="rqHistory-@r.RequestId">
            <p class="rq-hist-who">@r.DriverName · @r.Span</p>
            <ol class="rq-hist">
                @foreach (var e in r.History)
                {
                    <li class="rq-hist-item">
                        <span class="rq-hist-dot rq-hist-dot--@e.Action.ToLowerInvariant()"></span>
                        <span class="rq-hist-body">
                            <span class="rq-hist-action">@e.Action</span>
                            <span class="rq-hist-when">@e.When</span>
                            <span class="rq-hist-by">by @e.By</span>
                            @if (!string.IsNullOrWhiteSpace(e.Note))
                            {
                                <span class="rq-hist-note">@e.Note</span>
                            }
                        </span>
                    </li>
                }
            </ol>
        </template>
    }
</div>

@* Rejecting without saying why leaves the driver with a decision and no reason for it,
   so the note is asked for there and offered on an approval. *@
<div id="rqDecideModal" class="rq-overlay" style="display:none;" data-dialog-close="rqCancel"
     role="dialog" aria-modal="true" aria-labelledby="rqDecideTitle">
    <div class="rq-box">
        <h3 class="rq-box-title" id="rqDecideTitle">Approve leave</h3>
        <p class="rq-box-desc" id="rqDecideDesc"></p>
        <p id="rqDecideError" class="rq-box-error" style="display:none;"></p>

        <label class="rq-box-label" for="rqDecideNote">Note</label>
        <textarea id="rqDecideNote" class="rq-box-note" rows="3" maxlength="300"></textarea>

        <div class="rq-box-actions">
            <button type="button" class="rq-btn rq-btn--outline" onclick="rqCancel()">Cancel</button>
            <button type="button" class="rq-btn rq-btn--primary" id="rqDecideGo">Confirm</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    (function () {
        let pending = null;   // { id, decision }

        const modal = document.getElementById('rqDecideModal');
        const title = document.getElementById('rqDecideTitle');
        const desc = document.getElementById('rqDecideDesc');
        const note = document.getElementById('rqDecideNote');
        const err = document.getElementById('rqDecideError');
        const go = document.getElementById('rqDecideGo');

        const rows = document.getElementById('rqRows');
        const search = document.getElementById('rqSearch');
        const typeSel = document.getElementById('rqType');
        const driverSel = document.getElementById('rqDriver');
        const countEl = document.getElementById('rqCount');

        // ---- Filtering ---------------------------------------------------------------
        //
        // Over the rows already rendered. The status tabs decide what the server sends;
        // these three narrow what is shown, and answer as the search is typed.

        function rqApplyFilters() {
            const q = search.value.trim().toLowerCase();
            const type = typeSel.value;
            const driver = driverSel.value;

            let shown = 0, total = 0;

            rows.querySelectorAll('tr[data-request]').forEach(function (tr) {
                total++;
                const ok = (!q || tr.dataset.find.includes(q))
                        && (!type || tr.dataset.type === type)
                        && (!driver || tr.dataset.driver === driver);
                tr.hidden = !ok;
                if (ok) shown++;
            });

            const noMatch = document.getElementById('rqNoMatch');
            if (noMatch) noMatch.hidden = !(total > 0 && shown === 0);

            countEl.textContent = total === 0 ? ''
                : shown === total ? total + (total === 1 ? ' request' : ' requests')
                : shown + ' of ' + total;
        }

        // The list of drivers comes from the rows, so it is rebuilt whenever they are.
        // A driver whose last request has just been decided away keeps their place in the
        // list while they are the one being filtered on, or the page would clear a filter
        // the operator set.
        function rqFillDrivers() {
            const seen = new Map();
            rows.querySelectorAll('tr[data-request]').forEach(function (tr) {
                const name = tr.querySelector('.rq-driver');
                if (name) seen.set(tr.dataset.driver, name.textContent);
            });

            const chosen = driverSel.value;
            if (chosen && !seen.has(chosen)) {
                const kept = driverSel.querySelector('option[value="' + chosen + '"]');
                if (kept) seen.set(chosen, kept.textContent);
            }

            const options = [...seen.entries()].sort(function (a, b) { return a[1].localeCompare(b[1]); });
            driverSel.replaceChildren();

            const all = document.createElement('option');
            all.value = '';
            all.textContent = 'All drivers';
            driverSel.appendChild(all);

            options.forEach(function (pair) {
                const opt = document.createElement('option');
                opt.value = pair[0];
                opt.textContent = pair[1];   // a driver's name is data, not markup
                driverSel.appendChild(opt);
            });

            driverSel.value = chosen;
        }

        search.addEventListener('input', rqApplyFilters);
        typeSel.addEventListener('change', rqApplyFilters);
        driverSel.addEventListener('change', rqApplyFilters);

        document.getElementById('rqClear').addEventListener('click', function () {
            search.value = '';
            typeSel.value = '';
            driverSel.value = '';
            rqApplyFilters();
            search.focus();
        });

        rqApplyFilters();

        // ---- Refresh -----------------------------------------------------------------
        //
        // Re-fetches this same url, so the status tab comes along, and swaps only the rows
        // and the counts. The filters sit outside what is replaced, which is what lets a
        // half-typed search survive both the button and the poll behind it.

        let busy = false;

        function rqStamp() {
            const el = document.getElementById('rqUpdated');
            if (el) el.textContent = 'Updated ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        window.rqRefresh = async function (manual) {
            if (busy) return;
            busy = true;

            // One of the two is on screen, depending on the width. Marking both is
            // cheaper than working out which.
            const spinners = document.querySelectorAll('.rq-refresh');
            if (manual) spinners.forEach(function (b) { b.classList.add('spinning'); });

            try {
                const res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'fetch' } });
                const doc = new DOMParser().parseFromString(await res.text(), 'text/html');

                ['rqRows', 'rqTemplates', 'rqPendingWrap', 'rqPendingInline'].forEach(function (id) {
                    const fresh = doc.getElementById(id);
                    const cur = document.getElementById(id);
                    if (fresh && cur) cur.innerHTML = fresh.innerHTML;
                });

                rqFillDrivers();
                rqApplyFilters();
                rqStamp();
            } catch (e) {
                console.warn('requests refresh failed', e);
            } finally {
                busy = false;
                spinners.forEach(function (b) { b.classList.remove('spinning'); });
            }
        };

        // Not while a dialog is open. Replacing the rows underneath a decision being
        // written would pull the request out from under it.
        setInterval(function () {
            if (document.hidden) return;
            if (modal.style.display === 'flex') return;
            if (histModal.style.display === 'flex') return;
            rqRefresh(false);
        }, 30000);

        rqStamp();

        // ---- Deciding ----------------------------------------------------------------

        window.rqDecide = function (id, decision) {
            const row = document.querySelector('[data-request="' + id + '"]');
            const who = row ? row.querySelector('.rq-driver').textContent : 'this driver';
            const span = row
                ? row.querySelector('[data-label="Start"]').textContent.trim()
                    + ' to ' + row.querySelector('[data-label="End"]').textContent.trim()
                : '';

            pending = { id, decision };
            title.textContent = decision === 'Approved' ? 'Approve leave' : 'Reject leave';
            desc.textContent = span ? who + ' · ' + span : who;
            note.value = '';
            err.style.display = 'none';
            go.textContent = decision === 'Approved' ? 'Approve' : 'Reject';
            go.classList.toggle('rq-btn--reject', decision === 'Rejected');
            // Reopening is a fresh attempt. Left disabled by a previous one, the dialog
            // opens with a button that cannot be pressed and nothing saying why.
            go.disabled = false;
            modal.style.display = 'flex';
            note.focus();
        };

        const histModal = document.getElementById('rqHistoryModal');
        const histBody = document.getElementById('rqHistoryBody');

        window.rqHistory = function (id) {
            const tpl = document.getElementById('rqHistory-' + id);
            if (!tpl) return;
            histBody.replaceChildren(tpl.content.cloneNode(true));
            histModal.style.display = 'flex';
        };

        window.rqHistoryClose = function () { histModal.style.display = 'none'; };

        histModal.addEventListener('click', function (e) {
            if (e.target === histModal) rqHistoryClose();
        });

        window.rqCancel = function () {
            modal.style.display = 'none';
            pending = null;
        };

        go.addEventListener('click', async function () {
            if (!pending) return;

            // A rejection the driver cannot account for is worse than no answer, and they
            // are told the outcome either way.
            if (pending.decision === 'Rejected' && !note.value.trim()) {
                err.textContent = 'Say why this was rejected. The driver is told the reason.';
                err.style.display = 'block';
                return;
            }

            go.disabled = true;
            try {
                const body = new URLSearchParams({
                    requestId: pending.id,
                    decision: pending.decision,
                    note: note.value.trim()
                });
                const res = await fetch('/Requests/Decide', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body
                });
                if (!res.ok) {
                    // A refusal answers with a sentence; a crash answers with a page of
                    // HTML, which is no use in a dialog box.
                    const said = (await res.text() || '').trim();
                    throw new Error(
                        said && said.length < 300 && said[0] !== '<'
                            ? said
                            : 'The server could not save that (' + res.status + '). Try again.');
                }
                // The decision is stored; the list catches up on its own rather than
                // taking the whole page down and putting the filters back to nothing.
                rqCancel();
                await rqRefresh(true);
            } catch (e) {
                err.textContent = e.message || 'That could not be saved. Try again.';
                err.style.display = 'block';
                go.disabled = false;
            }
        });
    })();
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
}

@section TopbarContent {
    @* The reload, beside the filters, which is where a phone keeps the controls of the
       page it is on. The copy in the title row is the desktop one and is not drawn here. *@
    <button type="button" class="rs-filter-toggle rq-refresh rq-refresh--bar"
            onclick="rqRefresh(true)" title="Load newly filed requests"
            aria-label="Refresh">
        <span class="rq-refresh-ico"><svg class="rs-ico-refresh" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4" />
            <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4" />
        </svg></span>
    </button>
    <button type="button" class="rs-filter-toggle" data-filter-toggle="rqFilters"
            aria-expanded="false" aria-controls="rqFilters">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18M6 12h12M10 19h4" />
        </svg>
        Filters
    </button>
}
