@model LeaveQueueViewModel
@{
    ViewData["Title"] = "Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tabs = new[] { "Pending", "Approved", "Rejected", "Cancelled", "Revoked", "All" };

    // Drivers with something in the list being shown, so the filter offers names that
    // will actually match rather than the whole roster.
    var driversShown = Model.Rows
        .GroupBy(r => r.DriverId)
        .Select(g => new { Id = g.Key, Name = g.First().DriverName })
        .OrderBy(d => d.Name)
        .ToList();

    string TypeClass(string t) => t?.ToLowerInvariant() switch
    {
        "vacation" => "rq-badge--vacation",
        "sick" => "rq-badge--sick",
        "emergency" => "rq-badge--emergency",
        _ => "rq-badge--default"
    };

    string StatusClass(string s) => s?.ToLowerInvariant() switch
    {
        "approved" => "rq-badge--approved",
        "rejected" => "rq-badge--rejected",
        "cancelled" => "rq-badge--cancelled",
        "awaitingchange" => "rq-badge--held",
        _ => "rq-badge--pending"
    };

    // The stored word is one token because the column is checked against a list. What is
    // read here is a sentence.
    string StatusLabel(string s) =>
        string.Equals(s, "AwaitingChange", StringComparison.OrdinalIgnoreCase)
            ? "Awaiting schedule change"
            : s;
}

@* Everything that says what is being looked at, held while the list moves. *@
<div class="rq-sticky-head" data-sticky-head>

    @* The heading, and on its right the state of the queue. The heading had a line of
       its own with nothing else on it, while the controls below wrapped onto a second
       line for want of the room. *@
    <div class="rq-titlerow">

        <h2 class="rq-title">Requests</h2>

        @* A queue somebody else is adding to. The list is replaced in place, so a search
           being typed and a filter already chosen both survive it. *@
        <div class="rq-toolbar-end">
            <span id="rqPendingWrap">
                @if (Model.PendingCount > 0)
                {
                    <span class="rq-waiting">@Model.PendingCount Pending</span>
                }
            </span>
            <span class="rq-updated" id="rqUpdated" title="Checks for newly filed requests every 30 seconds"></span>
            <button type="button" class="rq-btn rq-btn--outline rq-btn--icon rq-refresh"
                    onclick="rqRefresh(true)" title="Load newly filed requests without losing your filters">
                <span class="rq-refresh-ico"><svg class="rs-ico-refresh" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4" />
                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4" />
                </svg></span> Refresh
            </button>
        </div>

    </div>

    @* One row, the way the other boards lay their controls out: what is being looked at
       on the left, what narrows it on the right. *@
    <div class="rq-toolbar">

        @* The pills, and on a phone the reload beside them. A wrapper that lays nothing
           out on a desk, where the pills are a toolbar item on their own and the reload
           belongs with the rest of the controls at the far end of the row. *@
        <div class="rq-tabrow">

            <div class="rq-tabs" role="group" aria-label="Filter by status">
                @foreach (var tab in tabs)
                {
                    var on = string.Equals(Model.Status, tab, StringComparison.OrdinalIgnoreCase);
                    <a class="rq-tab @(on ? "rq-tab--on" : "")"
                       href="@Url.Action("Index", new { status = tab })"
                       aria-current="@(on ? "page" : null)">@tab</a>
                }
            </div>

            @* Drawn only on a phone. The desktop reload is the one in the row's far end,
               which carries a word beside the mark and the time of the last check. *@
            <button type="button" class="rq-btn rq-btn--outline rq-refresh rq-refresh--pills"
                    onclick="rqRefresh(true)" title="Load newly filed requests"
                    aria-label="Refresh">
                <span class="rq-refresh-ico"><svg class="rs-ico-refresh" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4" />
                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4" />
                </svg></span>
            </button>

        </div>

        @* Narrowing within the status already chosen. Applied to the rows on the page
           rather than by asking the server again, so the list answers on each keystroke
           and a half-typed name never costs a round trip.

           The labels are for the phone, where these fold into a sheet that names each
           field down the left. On a desk the placeholder and the resting value of a
           select say the same thing in less room. *@
        <div class="rq-filters rs-filters" id="rqFilters" data-filter-stay>
            <div class="rq-filter">
                <label for="rqSearch">Search</label>
                <span class="rq-search-wrap">
                    <span class="rq-search-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                             stroke="#9AA5B4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                    </span>
                    <input type="search" id="rqSearch" class="rq-input rq-search-input" autocomplete="off"
                           placeholder="Search driver, ID or reason" aria-label="Search requests" />
                </span>
            </div>

            <div class="rq-filter">
                <label for="rqType">Type</label>
                <select id="rqType" class="rq-input">
                    <option value="">All types</option>
                    @foreach (var t in LeaveEntitlement.Types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="rq-filter">
                <label for="rqDriver">Driver</label>
                <select id="rqDriver" class="rq-input">
                    <option value="">All drivers</option>
                    @foreach (var d in driversShown)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>

            <div class="rq-filter-actions">
                <button type="button" class="rq-btn rq-btn--outline" id="rqClear">Clear</button>
            </div>
        </div>


    </div>

</div>

@* The page could only speak from inside the decision dialog, so anything that went
   wrong on a row had nowhere to be said. *@
<div id="rqToast" class="rq-toast" role="status" hidden></div>

<div class="rq-card">
    <div class="rq-card-header" data-sticky-card>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z" />
            <path d="M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2" />
            <polyline points="9 13 11 15 15 11" />
        </svg>
        <span>Leave requests</span>
        <span class="rq-count" id="rqCount"></span>

        @* Shown only on a phone, where the title row above is not drawn: the app bar
           already says which page this is. The count of what is waiting still has to be
           somewhere, so it moves onto the card heading, which is the page heading in
           effect. *@
        <span class="rq-inline-pending" id="rqPendingInline">
            @if (Model.PendingCount > 0)
            {
                <span class="rq-waiting">@Model.PendingCount Pending</span>
            }
        </span>
    </div>

    <div class="rq-table-wrap rs-list-wrap">
        <table class="rq-table rs-cards rs-list">
            <thead>
                <tr>
                    <th>Driver</th>
                    <th>Type</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Days</th>
                    <th>Reason</th>
                    <th>Filed</th>
                    <th>Balance after</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="rqRows">
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="rq-empty">
                            @(string.Equals(Model.Status, "Pending", StringComparison.OrdinalIgnoreCase)
                                ? "Nothing waiting on a decision."
                                : "No requests to show.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model.Rows)
                    {
                        var pending = string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase);
                        var held = string.Equals(r.Status, "AwaitingChange", StringComparison.OrdinalIgnoreCase);

                        <tr data-request="@r.RequestId"
                            data-driver="@r.DriverId"
                            data-type="@r.LeaveType"
                            data-find="@($"{r.DriverName} {r.DriverId} {r.LeaveType} {r.Status} {r.Reason}".ToLowerInvariant())">

                            <td data-label="Driver">
                                <span class="rq-driver">@r.DriverName</span>
                                <span class="rq-driver-id">@r.DriverId</span>
                            </td>

                            <td data-label="Type">
                                <span class="rq-badge @TypeClass(r.LeaveType)">@r.LeaveType</span>
                                @* Both dates as one phrase, for the phone. The columns
                                   either side of this one are not drawn there. *@
                                <span class="rq-span">@r.Span</span>
                            </td>

                            <td data-label="Start"><span class="rq-date">@r.Start</span></td>
                            <td data-label="End"><span class="rq-date">@r.End</span></td>
                            <td data-label="Days"><span class="rq-days-n">@r.Days</span></td>

                            <td data-label="Reason">
                                @if (string.IsNullOrWhiteSpace(r.Reason))
                                {
                                    <span class="rq-blank">None given</span>
                                }
                                else
                                {
                                    <span class="rq-reason">@r.Reason</span>
                                }
                            </td>

                            <td data-label="Filed"><span class="rq-filed">@r.Filed</span></td>

                            @* What the allowance stands at once this request is counted.
                               Days on other requests still undecided are marked beside it,
                               because approving this one without noticing them is how an
                               allowance is overdrawn. *@
                            <td data-label="Balance after" class="rq-c-balance">
                                <span class="rq-balance"
                                      title="@r.LeaveType.ToLowerInvariant() days left after this request">@r.BalanceAfter of @r.EntitlementOfType</span>
                                @if (r.OtherPendingDays > 0)
                                {
                                    <span class="rq-balance-pending"
                                          title="Days of the same leave on other requests still awaiting a decision">+@r.OtherPendingDays awaiting</span>
                                }
                            </td>

                            @* A decision that came with a note carries it here, on the word
                               it explains, rather than as a second line under the buttons. *@
                            <td data-label="Status">
                                <span class="rq-badge @StatusClass(r.Status)"
                                      title="@(pending || held ? null : r.DecisionNote)">@StatusLabel(r.Status)</span>
                                @* Approved leave with days pulled out of it still reads as
                                   approved, because most of it is. This says the rest. *@
                                @if (r.RevokedCount > 0)
                                {
                                    <span class="rq-revoked"
                                          title="Days of this leave taken back by dispatch">@r.RevokedCount revoked</span>
                                }
                                @* Granted leave the driver has asked to give back. Still
                                   approved, because it is, until this is answered. *@
                                @if (r.WithdrawAsked)
                                {
                                    <span class="rq-asked"
                                          title="@($"Asked {r.WithdrawAskedWhen}: {r.WithdrawReason}")">Cancellation asked</span>
                                }
                            </td>

                            <td data-label="Actions">
                                <div class="rq-actions">
                                    @if (pending)
                                    {
                                        <button type="button" class="rq-btn rq-btn--approve"
                                                onclick="rqDecide(@r.RequestId, 'Approved')">Approve</button>
                                        <button type="button" class="rq-btn rq-btn--reject"
                                                onclick="rqDecide(@r.RequestId, 'Rejected')">Reject</button>
                                    }
                                    else if (held)
                                    {
                                        @* The approval was begun. This runs the check again
                                           against the schedule as it now stands. *@
                                        <button type="button" class="rq-btn rq-btn--approve"
                                                onclick="rqDecide(@r.RequestId, 'Approved')">Continue approval</button>
                                        <button type="button" class="rq-btn rq-btn--reject"
                                                onclick="rqDecide(@r.RequestId, 'Rejected')">Reject</button>
                                        <button type="button" class="rq-btn rq-btn--outline"
                                                onclick="rqRelease(@r.RequestId)"
                                                title="Put this back in the queue without deciding it">Back to queue</button>
                                    }
                                    @* Only where there is something left to take back.
                                       Leave already in the past offers nothing. *@
                                    @* Answering the driver comes before taking days off
                                       them: both end in the leave changing, and only one of
                                       them was asked for. *@
                                    @if (r.WithdrawAsked)
                                    {
                                        <button type="button" class="rq-btn rq-btn--approve"
                                                onclick="rqWithdrawal(@r.RequestId, true)">Cancel the leave</button>
                                        <button type="button" class="rq-btn rq-btn--outline"
                                                onclick="rqWithdrawal(@r.RequestId, false)">Keep the leave</button>
                                    }
                                    else if (r.RevokableDays.Count > 0)
                                    {
                                        <button type="button" class="rq-btn rq-btn--reject"
                                                onclick="rqRevoke(@r.RequestId)">Revoke</button>
                                    }
                                    <button type="button" class="rq-btn rq-btn--history"
                                            onclick="rqHistory(@r.RequestId)">History</button>
                                </div>
                            </td>
                        </tr>
                    }
                }

                @* Shown when the filters match none of the rows on the page, which is a
                   different thing from the queue being empty. *@
                <tr id="rqNoMatch" hidden>
                    <td colspan="10" class="rq-empty">No request matches these filters.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@* What happened to each request, written out with the row it belongs to and shown when
   asked for. Rendered here rather than fetched, because it is already on the page. *@
@* Answering a driver who asked for their granted leave back. *@
<div id="rqAskModal" class="rq-overlay" style="display:none;" data-dialog-close="rqAskClose"
     role="dialog" aria-modal="true" aria-labelledby="rqAskTitle">
    <div class="rq-box">
        <div class="rq-box-head">
            <h3 class="rq-box-title" id="rqAskTitle">Cancel this leave</h3>
            <button type="button" class="rq-box-close" onclick="rqAskClose()" aria-label="Close">&times;</button>
        </div>

        <p class="rq-box-desc" id="rqAskWho"></p>

        @* The driver's own words, as a quotation. Run together with the dispatcher's note
           below it, there was no telling which of the two anybody had written. *@
        <div class="rq-quote">
            <p class="rq-quote-l">The driver's reason</p>
            <p class="rq-quote-t" id="rqAskReason"></p>
            <p class="rq-quote-w" id="rqAskWhen"></p>
        </div>

        @* Cancelling frees the days and staffs nobody. The schedule was built around the
           absence, so this says plainly what is left to do. *@
        <p id="rqAskWarn" class="rq-warn" style="display:none;">
            These days will have no driver assigned. Check the schedule once this is done.
        </p>

        <p id="rqAskError" class="rq-box-error" style="display:none;"></p>

        <label class="rq-box-label" for="rqAskNote">Your reply to the driver</label>
        <textarea id="rqAskNote" class="rq-box-note" rows="3" maxlength="300"
                  placeholder="Optional"></textarea>

        <div class="rq-box-actions">
            <button type="button" class="rq-btn rq-btn--outline" onclick="rqAskClose()">Close</button>
            <button type="button" class="rq-btn rq-btn--primary" id="rqAskGo">Confirm</button>
        </div>
    </div>
</div>

@* Taking back leave already granted. Its own dialog rather than the decision one,
   because it asks a different question: not whether, but which days. *@
<div id="rqRevokeModal" class="rq-overlay" style="display:none;" data-dialog-close="rqRevokeClose"
     role="dialog" aria-modal="true" aria-labelledby="rqRevokeTitle">
    <div class="rq-box">
        <div class="rq-box-head">
            <h3 class="rq-box-title" id="rqRevokeTitle">Revoke leave</h3>
            <button type="button" class="rq-box-close" onclick="rqRevokeClose()" aria-label="Close">&times;</button>
        </div>

        <div id="rqRevokeBody"></div>

        <p id="rqRevokeError" class="rq-box-error" style="display:none;"></p>

        <label class="rq-box-label" for="rqRevokeNote">Reason</label>
        <textarea id="rqRevokeNote" class="rq-box-note" rows="3" maxlength="300"
                  placeholder="The driver is told this."></textarea>

        <div class="rq-box-actions">
            <button type="button" class="rq-btn rq-btn--outline" onclick="rqRevokeClose()">Cancel</button>
            <button type="button" class="rq-btn rq-btn--reject" id="rqRevokeGo">Revoke</button>
        </div>
    </div>
</div>

<div id="rqHistoryModal" class="rq-overlay" style="display:none;" data-dialog-close="rqHistoryClose"
     role="dialog" aria-modal="true" aria-labelledby="rqHistoryTitle">
    <div class="rq-box">
        <div class="rq-box-head">
            <h3 class="rq-box-title" id="rqHistoryTitle">Request history</h3>
            <button type="button" class="rq-box-close" onclick="rqHistoryClose()" aria-label="Close">&times;</button>
        </div>
        <div id="rqHistoryBody"></div>
    </div>
</div>

<div id="rqTemplates" hidden>
    @foreach (var r in Model.Rows)
    {
        @if (r.RevokableDays.Count > 0)
        {
            <template id="rqRevokeDays-@r.RequestId">
                <p class="rq-box-desc">@r.DriverName · @r.Span</p>
                <p class="rq-revoke-hint">
                    Leave every day ticked to take the whole leave back, or untick the days
                    the driver keeps.
                </p>
                <ul class="rq-daylist">
                    @foreach (var d in r.RevokableDays)
                    {
                        <li>
                            <label class="rq-day">
                                <input type="checkbox" value="@d.Iso" checked />
                                <span>@d.Label</span>
                            </label>
                        </li>
                    }
                </ul>
            </template>
        }

        <template id="rqHistory-@r.RequestId">
            <p class="rq-hist-who">@r.DriverName · @r.Span</p>
            <ol class="rq-hist">
                @foreach (var e in r.History)
                {
                    <li class="rq-hist-item">
                        <span class="rq-hist-dot rq-hist-dot--@e.Action.ToLowerInvariant()"></span>
                        <span class="rq-hist-body">
                            <span class="rq-hist-action">@e.Action</span>
                            <span class="rq-hist-when">@e.When</span>
                            @if (!string.IsNullOrEmpty(e.By))
                            {
                                <span class="rq-hist-by">by @e.By</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(e.Note))
                            {
                                <span class="rq-hist-note">@e.Note</span>
                            }
                        </span>
                    </li>
                }
            </ol>
        </template>
    }
</div>

@* Rejecting without saying why leaves the driver with a decision and no reason for it,
   so the note is asked for there and offered on an approval. *@
<div id="rqDecideModal" class="rq-overlay" style="display:none;" data-dialog-close="rqCancel"
     role="dialog" aria-modal="true" aria-labelledby="rqDecideTitle">
    <div class="rq-box">
        <h3 class="rq-box-title" id="rqDecideTitle">Approve leave</h3>
        <p class="rq-box-desc" id="rqDecideDesc"></p>
        <p id="rqDecideError" class="rq-box-error" style="display:none;"></p>

        @* What is standing in the way, when an approval cannot complete. Each shift links
           into the planner at the week it belongs to, so clearing it is one press away
           rather than a date to remember and find.

           The planner requires the routes permission. A role without it still sees which
           shifts are in the way, listed as plain text, since a link would only bounce
           off the planner and be recorded as a denied attempt. A role that holds it is
           offered a cover for each shift instead, and approves once they are saved. *@
        <div id="rqBlocking" class="rq-blocking" style="display:none;"
             data-planner="@(User.HasClaim("perm", "routes") ? "/Schedule" : null)"
             data-covers="@(User.HasClaim("perm", "routes") ? "true" : null)">
            @* Why the approval is held. A notice rather than an error: nothing failed, and the
               shifts below are what to do about it. *@
            <p class="rq-blocking-lead" id="rqBlockingLead" role="status"><i class="ti ti-alert-triangle" aria-hidden="true"></i><span id="rqBlockingLeadText"></span></p>
            <p class="rq-blocking-t" id="rqBlockingTitle">Clear these shifts before approving</p>
            <ul class="rq-blocking-list" id="rqBlockingList"></ul>
            <div class="rq-covers" id="rqCovers" hidden></div>
            <p class="visually-hidden" id="rqCoversLive" aria-live="polite"></p>
            <p class="rq-blocking-s" id="rqBlockingNote">
                This request is held until they are cleared. The driver still sees it as
                pending.
            </p>
        </div>

        <label class="rq-box-label" for="rqDecideNote">Note</label>
        <textarea id="rqDecideNote" class="rq-box-note" rows="3" maxlength="300"></textarea>

        <div class="rq-box-actions">
            <button type="button" class="rq-btn rq-btn--outline" onclick="rqCancel()">Cancel</button>
            <button type="button" class="rq-btn rq-btn--primary" id="rqDecideGo">Confirm</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script src="~/js/candidate-list.js" asp-append-version="true"></script>
<script>
    (function () {
        let pending = null;   // { id, decision }

        const modal = document.getElementById('rqDecideModal');
        const title = document.getElementById('rqDecideTitle');
        const desc = document.getElementById('rqDecideDesc');
        const note = document.getElementById('rqDecideNote');
        const err = document.getElementById('rqDecideError');
        const go = document.getElementById('rqDecideGo');

        const rows = document.getElementById('rqRows');
        const search = document.getElementById('rqSearch');
        const typeSel = document.getElementById('rqType');
        const driverSel = document.getElementById('rqDriver');
        const countEl = document.getElementById('rqCount');

        // ---- Filtering ---------------------------------------------------------------
        //
        // Over the rows already rendered. The status tabs decide what the server sends;
        // these three narrow what is shown, and answer as the search is typed.

        function rqApplyFilters() {
            const q = search.value.trim().toLowerCase();
            const type = typeSel.value;
            const driver = driverSel.value;

            let shown = 0, total = 0;

            rows.querySelectorAll('tr[data-request]').forEach(function (tr) {
                total++;
                const ok = (!q || tr.dataset.find.includes(q))
                        && (!type || tr.dataset.type === type)
                        && (!driver || tr.dataset.driver === driver);
                tr.hidden = !ok;
                if (ok) shown++;
            });

            const noMatch = document.getElementById('rqNoMatch');
            if (noMatch) noMatch.hidden = !(total > 0 && shown === 0);

            countEl.textContent = total === 0 ? ''
                : shown === total ? total + (total === 1 ? ' request' : ' requests')
                : shown + ' of ' + total;
        }

        // The list of drivers comes from the rows, so it is rebuilt whenever they are.
        // A driver whose last request has just been decided away keeps their place in the
        // list while they are the one being filtered on, or the page would clear a filter
        // the operator set.
        function rqFillDrivers() {
            const seen = new Map();
            rows.querySelectorAll('tr[data-request]').forEach(function (tr) {
                const name = tr.querySelector('.rq-driver');
                if (name) seen.set(tr.dataset.driver, name.textContent);
            });

            const chosen = driverSel.value;
            if (chosen && !seen.has(chosen)) {
                const kept = driverSel.querySelector('option[value="' + chosen + '"]');
                if (kept) seen.set(chosen, kept.textContent);
            }

            const options = [...seen.entries()].sort(function (a, b) { return a[1].localeCompare(b[1]); });
            driverSel.replaceChildren();

            const all = document.createElement('option');
            all.value = '';
            all.textContent = 'All drivers';
            driverSel.appendChild(all);

            options.forEach(function (pair) {
                const opt = document.createElement('option');
                opt.value = pair[0];
                opt.textContent = pair[1];   // a driver's name is data, not markup
                driverSel.appendChild(opt);
            });

            driverSel.value = chosen;
        }

        search.addEventListener('input', rqApplyFilters);
        typeSel.addEventListener('change', rqApplyFilters);
        driverSel.addEventListener('change', rqApplyFilters);

        document.getElementById('rqClear').addEventListener('click', function () {
            search.value = '';
            typeSel.value = '';
            driverSel.value = '';
            rqApplyFilters();
            search.focus();
        });

        rqApplyFilters();

        // ---- Refresh -----------------------------------------------------------------
        //
        // Re-fetches this same url, so the status tab comes along, and swaps only the rows
        // and the counts. The filters sit outside what is replaced, which is what lets a
        // half-typed search survive both the button and the poll behind it.

        let busy = false;

        function rqStamp() {
            const el = document.getElementById('rqUpdated');
            if (el) el.textContent = 'Updated ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        window.rqRefresh = async function (manual) {
            if (busy) return;
            busy = true;

            // One of the two is on screen, depending on the width. Marking both is
            // cheaper than working out which.
            const spinners = document.querySelectorAll('.rq-refresh');
            if (manual) spinners.forEach(function (b) { b.classList.add('spinning'); });

            // A queue this size comes back in a few tens of milliseconds, which is faster
            // than the mark can be seen to turn. On a phone the turning mark is the whole
            // of the answer, because the stamp saying when it last looked is not drawn
            // there, so a press that finishes too quickly reads as a press that did
            // nothing. Held long enough to be seen, and only when a person asked.
            const startedAt = Date.now();

            try {
                const res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'fetch' } });
                const doc = new DOMParser().parseFromString(await res.text(), 'text/html');

                ['rqRows', 'rqTemplates', 'rqPendingWrap', 'rqPendingInline'].forEach(function (id) {
                    const fresh = doc.getElementById(id);
                    const cur = document.getElementById(id);
                    if (fresh && cur) cur.innerHTML = fresh.innerHTML;
                });

                rqFillDrivers();
                rqApplyFilters();
                rqStamp();
            } catch (e) {
                console.warn('requests refresh failed', e);
            } finally {
                const spun = Date.now() - startedAt;
                if (manual && spun < 450)
                    await new Promise(function (go) { setTimeout(go, 450 - spun); });

                busy = false;
                spinners.forEach(function (b) { b.classList.remove('spinning'); });
            }
        };

        // Not while a dialog is open. Replacing the rows underneath a decision being
        // written would pull the request out from under it.
        setInterval(function () {
            if (document.hidden) return;
            if (modal.style.display === 'flex') return;
            if (histModal.style.display === 'flex') return;
            if (revModal.style.display === 'flex') return;
            if (askModal.style.display === 'flex') return;
            rqRefresh(false);
        }, 30000);

        rqStamp();

        // ---- Deciding ----------------------------------------------------------------

        window.rqDecide = function (id, decision) {
            const row = document.querySelector('[data-request="' + id + '"]');
            const who = row ? row.querySelector('.rq-driver').textContent : 'this driver';
            const span = row
                ? row.querySelector('[data-label="Start"]').textContent.trim()
                    + ' to ' + row.querySelector('[data-label="End"]').textContent.trim()
                : '';

            pending = { id, decision };
            title.textContent = decision === 'Approved' ? 'Approve leave' : 'Reject leave';
            desc.textContent = span ? who + ' · ' + span : who;
            note.value = '';
            err.style.display = 'none';
            document.getElementById('rqBlocking').style.display = 'none';
            rqResetCovers();
            go.textContent = decision === 'Approved' ? 'Approve' : 'Reject';
            go.classList.toggle('rq-btn--reject', decision === 'Rejected');
            // Reopening is a fresh attempt. Left disabled by a previous one, the dialog
            // opens with a button that cannot be pressed and nothing saying why.
            go.disabled = false;
            modal.style.display = 'flex';
            note.focus();
        };

        const histModal = document.getElementById('rqHistoryModal');
        const histBody = document.getElementById('rqHistoryBody');

        window.rqHistory = function (id) {
            const tpl = document.getElementById('rqHistory-' + id);
            if (!tpl) return;
            histBody.replaceChildren(tpl.content.cloneNode(true));
            histModal.style.display = 'flex';
        };

        window.rqHistoryClose = function () { histModal.style.display = 'none'; };

        // ---- Revoking ----------------------------------------------------------------

        const revModal = document.getElementById('rqRevokeModal');
        const revBody = document.getElementById('rqRevokeBody');
        const revNote = document.getElementById('rqRevokeNote');
        const revErr = document.getElementById('rqRevokeError');
        const revGo = document.getElementById('rqRevokeGo');
        let revoking = null;

        window.rqRevoke = function (id) {
            const tpl = document.getElementById('rqRevokeDays-' + id);
            if (!tpl) return;

            revoking = id;
            revBody.replaceChildren(tpl.content.cloneNode(true));
            revNote.value = '';
            revErr.style.display = 'none';
            revGo.disabled = false;
            revModal.style.display = 'flex';
            revNote.focus();
        };

        window.rqRevokeClose = function () {
            revModal.style.display = 'none';
            revoking = null;
        };

        revModal.addEventListener('click', function (e) {
            if (e.target === revModal) rqRevokeClose();
        });

        revGo.addEventListener('click', async function () {
            if (revoking === null) return;

            const ticked = [...revBody.querySelectorAll('input[type=checkbox]:checked')]
                .map(function (b) { return b.value; });

            if (!ticked.length) {
                revErr.textContent = 'Tick at least one day to revoke.';
                revErr.style.display = 'block';
                return;
            }

            if (!revNote.value.trim()) {
                revErr.textContent = 'Say why this leave was revoked. The driver is told the reason.';
                revErr.style.display = 'block';
                return;
            }

            revGo.disabled = true;
            try {
                const res = await fetch('/Requests/Revoke', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams({
                        requestId: revoking,
                        dates: ticked.join(','),
                        note: revNote.value.trim()
                    })
                });
                if (!res.ok) {
                    const said = (await res.text() || '').trim();
                    throw new Error(
                        said && said.length < 300 && said[0] !== '<'
                            ? said
                            : 'The server could not save that (' + res.status + '). Try again.');
                }
                rqRevokeClose();
                await rqRefresh(true);
            } catch (e) {
                revErr.textContent = e.message || 'That could not be saved. Try again.';
                revErr.style.display = 'block';
                revGo.disabled = false;
            }
        });

        histModal.addEventListener('click', function (e) {
            if (e.target === histModal) rqHistoryClose();
        });

        window.rqCancel = function () {
            modal.style.display = 'none';
            pending = null;
        };

        let rqToastTimer = null;

        window.rqToast = function (text, bad) {
            const el = document.getElementById('rqToast');
            el.textContent = text;
            el.classList.toggle('rq-toast--bad', !!bad);
            el.hidden = false;
            clearTimeout(rqToastTimer);
            rqToastTimer = setTimeout(function () { el.hidden = true; }, 4000);
        };

        function rqShowBlocking(message, shifts) {
            err.style.display = 'none';
            document.getElementById('rqBlockingLeadText').textContent = message;

            const box = document.getElementById('rqBlocking');
            const planner = box.dataset.planner;
            const list = document.getElementById('rqBlockingList');
            list.replaceChildren();

            shifts.forEach(function (s) {
                const li = document.createElement('li');
                const label = s.date + ', ' + s.shift + ' shift';
                if (planner) {
                    const a = document.createElement('a');
                    a.href = planner + '?start=' + encodeURIComponent(s.week);
                    a.textContent = label;
                    li.appendChild(a);
                } else {
                    li.textContent = label;
                }
                list.appendChild(li);
            });

            box.style.display = 'block';
        }

        // ---- Covering the shifts in the way ------------------------------------------
        //
        // Offered only to a role that can change the schedule. Each shift is one row with
        // the driver the rules suggest and why. Change opens that shift's list of the drivers
        // who could take it at no cost worth a confirm, one list open at a time.
        //
        // A driver chosen by hand, or a shift left for now, is the dispatcher's and is never
        // replaced. The shifts not touched are ranked again around those choices, and say
        // so. Whatever is sent is checked again on the server before it is saved.

        const blockingBox = document.getElementById('rqBlocking');
        const coversEl = document.getElementById('rqCovers');
        const coversLive = document.getElementById('rqCoversLive');
        const blockingTitle = document.getElementById('rqBlockingTitle');
        const blockingNote = document.getElementById('rqBlockingNote');
        const blockingTitleText = blockingTitle.textContent;
        const blockingNoteText = blockingNote.textContent;
        const decideBox = modal.querySelector('.rq-box');
        let coversShown = false;
        let coverRows = [];          // one per shift, in date order
        let coverNames = new Map();  // driver ID to name, for a chosen driver no longer listed
        let coverSeq = 0;            // the latest ranking asked for; older answers are dropped
        let coverTimer = null;
        let coverDirty = null;       // the row picked from and not yet ranked around
        let coverRerank = null;      // the ranking under way, if any

        function rqResetCovers() {
            coversShown = false;
            coverRows = [];
            coverNames = new Map();
            coverSeq++;
            clearTimeout(coverTimer);
            coverDirty = null;
            coverRerank = null;
            coversEl.replaceChildren();
            coversEl.hidden = true;
            coversLive.textContent = '';
            blockingBox.classList.remove('rq-blocking--covers');
            decideBox.classList.remove('rq-box--wide');
            document.getElementById('rqBlockingList').hidden = false;
            blockingTitle.textContent = blockingTitleText;
            blockingNote.textContent = blockingNoteText;
        }

        // Names, reasons and dates are data, so they are always set as text.
        function rqEl(tag, className, text) {
            const node = document.createElement(tag);
            if (className) node.className = className;
            if (text != null) node.textContent = text;
            return node;
        }

        // A figure stays on the line of the word after it, so a reason never breaks as
        // "30" above "days".
        function rqKeepFigures(text) {
            return String(text).replace(/(\d) /g, '$1\u00A0');
        }

        function rqCost(text) {
            const line = rqEl('span', 'rq-cover-cost');
            const icon = rqEl('i', 'ti ti-alert-triangle');
            icon.setAttribute('aria-hidden', 'true');
            line.append(icon, rqEl('span', null, text));
            return line;
        }

        function rqShiftLabel(s) {
            return s.date + ', ' + s.shift + ' shift';
        }

        function rqCandidateOf(row, driverId) {
            return row.s.candidates.find(function (c) { return c.driverId === driverId; }) || null;
        }

        // A driver is chosen and the rules, as last asked, have no objection to them.
        function rqCoverReady(row) {
            return row.choice > 0 && !row.s.pinnedProblem && !!rqCandidateOf(row, row.choice);
        }

        function rqCoverButton() {
            if (!coversShown) return;
            const ready = coverRows.filter(rqCoverReady).length;
            // With nobody chosen anywhere, pressing it only checks again. With a shift still
            // uncovered, the covers are saved and the request stays held, so it does not
            // promise an approval.
            go.textContent = ready === 0
                ? 'Approve'
                : (ready === 1 ? 'Cover 1 shift' : 'Cover ' + ready + ' shifts')
                    + (ready === coverRows.length ? ' and approve' : '');
        }

        // What a row says: who covers the shift and why, or why nobody does. With its list
        // open, only who, since the list below says the rest.
        function rqRenderCover(row) {
            const s = row.s;
            row.who.replaceChildren();

            if (row.choice > 0) {
                const c = rqCandidateOf(row, row.choice);
                const line = rqEl('span', 'rq-cover-nameline');
                line.appendChild(rqEl('span', 'rq-cover-name',
                    c ? c.name : (coverNames.get(row.choice) || 'Driver ' + row.choice)));
                if (c && s.candidates[0] === c) line.appendChild(rqEl('span', 'rsc-best', 'Best match'));
                row.who.appendChild(line);

                if (!row.open && c && !s.pinnedProblem) {
                    row.who.appendChild(rqEl('span', 'rq-cover-why', rqKeepFigures(c.sentence || c.reason)));
                    if (c.tier === 2 && c.warning) row.who.appendChild(rqEl('span', 'rq-cover-why', c.warning));
                } else if (!row.open) {
                    row.who.appendChild(rqCost(s.pinnedProblem || 'No longer free for this shift.'));
                }
            } else if (row.choice === 0) {
                row.who.appendChild(rqEl('span', 'rq-cover-name rq-cover-name--none', 'Left for now'));
                if (!row.open) {
                    row.who.appendChild(rqEl('span', 'rq-cover-why', 'Nobody takes this shift yet, so the request stays held.'));
                }
            } else {
                row.who.appendChild(rqCost(s.shortfall || 'No driver can take this shift without a cost.'));
                const planner = rqEl('a', 'rq-cover-planner', 'Cover it in the planner');
                planner.href = '/Schedule?start=' + encodeURIComponent(s.week);
                row.who.appendChild(planner);
            }

            if (row.updated) {
                row.who.appendChild(rqEl('span', 'rq-cover-updated', 'Updated after your pick on ' + row.updated));
            }

            row.change.hidden = row.choice === null && s.candidates.length === 0;
            row.change.textContent = row.open ? 'Done' : row.choice === 0 ? 'Choose' : 'Change';
            row.change.setAttribute('aria-expanded', row.open ? 'true' : 'false');
            row.leave.hidden = row.choice === 0;
        }

        function rqOpenCover(row, moveFocus) {
            coverRows.forEach(function (r) { if (r !== row && r.open) rqCloseCover(r, false); });

            const s = row.s;
            const lost = row.choice > 0 && !rqCandidateOf(row, row.choice);

            row.open = true;
            row.listWrap.hidden = false;
            row.list = RsCandidateList.create(row.listHost, {
                kind: 'driver',
                label: 'Cover for ' + rqShiftLabel(s),
                items: s.candidates.map(function (c) {
                    return {
                        id: c.driverId, name: c.name, tier: c.tier, rank: c.rank,
                        warning: c.warning, reason: c.reason, facts: c.facts
                    };
                }),
                // A chosen driver the rules no longer offer stays in sight, with why.
                current: lost
                    ? {
                        id: row.choice,
                        name: coverNames.get(row.choice) || 'Driver ' + row.choice,
                        problem: s.pinnedProblem || 'No longer free for this shift.'
                    }
                    : null,
                selected: row.choice > 0 ? row.choice : null,
                shortfall: s.candidates.length ? null : s.shortfall,
                limit: 3,
                onChange: function (id) { rqPickCover(row, Number(id)); }
            });

            rqRenderCover(row);
            if (moveFocus) row.list.focus();
        }

        function rqCloseCover(row, returnFocus) {
            row.open = false;
            row.listWrap.hidden = true;
            row.listHost.replaceChildren();
            row.list = null;
            rqRenderCover(row);
            if (returnFocus) row.change.focus();
        }

        function rqPickCover(row, driverId) {
            row.choice = driverId;
            row.touched = true;
            row.updated = null;

            const c = driverId > 0 ? rqCandidateOf(row, driverId) : null;
            if (c) coverNames.set(c.driverId, c.name);
            // A problem found with the previous choice is not this one's.
            row.s = Object.assign({}, row.s, { pinned: driverId, pinnedProblem: null });

            rqRenderCover(row);
            rqCoverButton();

            // Ranked once the dispatcher settles, not on every arrow key through the list.
            clearTimeout(coverTimer);
            coverDirty = row;
            coverTimer = setTimeout(function () {
                const picked = coverDirty;
                coverDirty = null;
                if (picked) rqStartRerank(picked);
            }, 300);
        }

        function rqStartRerank(changed) {
            const run = rqRerankCovers(changed).finally(function () {
                if (coverRerank === run) coverRerank = null;
            });
            coverRerank = run;
            return run;
        }

        // Asks for the ranking again with every choice pinned, and moves the shifts nobody
        // has touched to what it now suggests. Answers how many of those changed.
        async function rqRerankCovers(changed) {
            if (!pending || !coversShown) return 0;
            const seq = ++coverSeq;

            const params = new URLSearchParams({ requestId: pending.id });
            coverRows.forEach(function (r) {
                if (r.touched) params.append('pin', r.s.tripId + ':' + r.choice);
            });

            let shifts;
            try {
                const res = await fetch('/Requests/CoverOptions?' + params.toString(),
                                        { headers: { 'X-Requested-With': 'fetch' } });
                if (!res.ok || res.redirected) return 0;
                shifts = (await res.json()).shifts || [];
            } catch (e) {
                return 0;
            }

            if (seq !== coverSeq || !coversShown) return 0;

            const fresh = new Map(shifts.map(function (s) { return [s.tripId, s]; }));
            let updated = 0;

            coverRows.forEach(function (r) {
                const s = fresh.get(r.s.tripId);
                if (!s) return;
                s.candidates.forEach(function (c) { coverNames.set(c.driverId, c.name); });
                r.s = s;

                if (!r.touched) {
                    const next = s.suggested == null ? null : s.suggested;
                    if (next !== r.choice) {
                        r.choice = next;
                        r.updated = changed.s.date;
                        updated++;

                        // Opened before the answer came, its list is built again around the
                        // new suggestion, keeping focus in it only if it was there.
                        if (r.open) {
                            rqOpenCover(r, r.listWrap.contains(document.activeElement));
                            return;
                        }
                    }
                }

                // Any other open list is left as it is, so focus stays where it was put.
                rqRenderCover(r);
            });

            rqCoverButton();
            if (updated) {
                coversLive.textContent = (updated === 1 ? '1 shift' : updated + ' shifts')
                    + ' updated after your pick on ' + changed.s.date + '.';
            }
            return updated;
        }

        // Finishes any ranking still to come. Answers how many untouched shifts it changed.
        async function rqFlushCovers() {
            clearTimeout(coverTimer);
            let updated = 0;
            if (coverRerank) updated += await coverRerank;
            if (coverDirty) {
                const picked = coverDirty;
                coverDirty = null;
                updated += await rqStartRerank(picked);
            }
            return updated;
        }

        function rqCoverRow(s) {
            const row = {
                s: s,
                choice: s.suggested == null ? null : s.suggested,
                touched: false,
                open: false,
                updated: null,
                list: null
            };

            row.el = rqEl('div', 'rq-cover');

            const head = rqEl('div', 'rq-cover-head');
            const when = rqEl('span', 'rq-cover-when', rqShiftLabel(s));
            when.id = 'rqCoverWhen-' + s.tripId;
            const where = rqEl('a', 'rq-cover-where', s.window + ', ' + s.route + ', ' + s.vehicleId);
            where.href = '/Schedule?start=' + encodeURIComponent(s.week);
            head.append(when, where);

            const line = rqEl('div', 'rq-cover-line');
            row.who = rqEl('div', 'rq-cover-who');
            row.change = rqEl('button', 'rq-cover-change');
            row.change.type = 'button';
            row.change.setAttribute('aria-controls', 'rqCoverList-' + s.tripId);
            row.change.setAttribute('aria-describedby', when.id);
            row.change.addEventListener('click', function () {
                if (row.open) rqCloseCover(row, true);
                else rqOpenCover(row, true);
            });
            line.append(row.who, row.change);

            row.listWrap = rqEl('div', 'rq-cover-list');
            row.listWrap.id = 'rqCoverList-' + s.tripId;
            row.listWrap.hidden = true;
            row.listHost = rqEl('div');
            row.leave = rqEl('button', 'rq-cover-leave', 'Leave for now');
            row.leave.type = 'button';
            row.leave.setAttribute('aria-describedby', when.id);
            row.leave.addEventListener('click', function () {
                rqPickCover(row, 0);
                rqCloseCover(row, true);
            });
            row.listWrap.append(row.listHost, row.leave);

            row.el.append(head, line, row.listWrap);
            return row;
        }

        // Replaces the plain list with a cover for each shift. Answers false, leaving the
        // plain list as it was, when covers are not offered or could not be fetched.
        async function rqShowCovers(id) {
            rqResetCovers();
            if (!blockingBox.dataset.covers) return false;

            let shifts;
            try {
                const res = await fetch('/Requests/CoverOptions?requestId=' + encodeURIComponent(id),
                                        { headers: { 'X-Requested-With': 'fetch' } });
                if (!res.ok || res.redirected) return false;
                shifts = (await res.json()).shifts || [];
            } catch (e) {
                return false;
            }

            if (!shifts.length) return false;

            coverRows = shifts.map(function (s) {
                s.candidates.forEach(function (c) { coverNames.set(c.driverId, c.name); });
                return rqCoverRow(s);
            });
            coverRows.forEach(function (row) {
                coversEl.appendChild(row.el);
                rqRenderCover(row);
            });

            blockingTitle.textContent = 'Choose who covers each shift';
            blockingNote.textContent = 'Each driver chosen is sent their new shift. Leave a shift '
                + 'for now and this request stays held.';
            document.getElementById('rqBlockingList').hidden = true;
            blockingBox.classList.add('rq-blocking--covers');
            decideBox.classList.add('rq-box--wide');
            coversEl.hidden = false;
            blockingBox.style.display = 'block';
            coversShown = true;
            rqCoverButton();
            return true;
        }

        async function rqCoverAndApprove() {
            const id = pending.id;
            go.disabled = true;

            // A pick still being ranked around is finished first. When that moves a shift the
            // dispatcher has not seen since, nothing is sent: the change is shown, and the
            // next press sends what is on screen.
            if (await rqFlushCovers() > 0) {
                go.disabled = false;
                return;
            }
            if (!pending || pending.id !== id) return;

            const covers = coverRows.filter(rqCoverReady).map(function (r) {
                return { tripId: r.s.tripId, driverId: r.choice };
            });

            try {
                const res = await fetch('/Requests/CoverAndApprove', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ requestId: id, covers: covers, note: note.value.trim() })
                });

                // Something is still in the way: a shift left for now, or a cover that could
                // not be saved. Whatever did save stays saved, and what is left is listed.
                if (res.status === 409) {
                    const said = await res.json();
                    const covered = said.covered || 0;

                    rqShowBlocking((covered ? covered + (covered === 1 ? ' shift was covered. ' : ' shifts were covered. ') : '')
                        + said.message, said.blocking || []);
                    if (!await rqShowCovers(id)) go.textContent = 'Approve';

                    // A cover that could not be saved is a failure and reads as one. What is
                    // still in the way is said by the notice above the shifts.
                    const failures = said.failures || [];
                    err.replaceChildren();
                    failures.forEach(function (text) {
                        const line = document.createElement('div');
                        line.textContent = text;
                        err.appendChild(line);
                    });
                    err.style.display = failures.length ? 'block' : 'none';

                    go.disabled = false;
                    await rqRefresh(true);
                    return;
                }

                if (!res.ok || res.redirected) {
                    const said = res.redirected ? '' : (await res.text() || '').trim();
                    throw new Error(
                        said && said.length < 300 && said[0] !== '<'
                            ? said
                            : 'The server could not save that (' + res.status + '). Try again.');
                }

                let covered = 0;
                try { covered = (await res.json()).covered || 0; } catch (e) { }

                rqCancel();
                await rqRefresh(true);
                rqToast(covered
                    ? 'Leave approved. ' + covered + (covered === 1 ? ' shift' : ' shifts') + ' covered.'
                    : 'Leave approved.');
            } catch (e) {
                err.textContent = e.message || 'That could not be saved. Try again.';
                err.style.display = 'block';
                go.disabled = false;
            }
        }

        // ---- Answering a driver's cancellation ---------------------------------------

        const askModal = document.getElementById('rqAskModal');
        const askWarn = document.getElementById('rqAskWarn');
        const askNote = document.getElementById('rqAskNote');
        const askErr = document.getElementById('rqAskError');
        const askGo = document.getElementById('rqAskGo');
        let answering = null;   // { id, accept }

        window.rqWithdrawal = function (id, accept) {
            const row = document.querySelector('[data-request="' + id + '"]');
            const who = row ? row.querySelector('.rq-driver').textContent : 'this driver';
            const chip = row ? row.querySelector('.rq-asked') : null;
            const span = row
                ? ' · ' + row.querySelector('[data-label="Start"]').textContent.trim()
                    + ' to ' + row.querySelector('[data-label="End"]').textContent.trim()
                : '';

            answering = { id, accept };

            document.getElementById('rqAskTitle').textContent =
                accept ? 'Cancel this leave' : 'Keep this leave';

            // The chip carries the asking as "Asked <when>: <reason>". Split so the two
            // are shown as what they are rather than as one run of text.
            const said = chip ? (chip.getAttribute('title') || '') : '';
            const at = said.indexOf(': ');

            document.getElementById('rqAskWho').textContent = who + span;
            document.getElementById('rqAskReason').textContent =
                at === -1 ? (said || 'No reason given.') : said.slice(at + 2);
            document.getElementById('rqAskWhen').textContent =
                at === -1 ? '' : said.slice(0, at);

            askWarn.style.display = accept ? 'block' : 'none';
            askNote.value = '';
            askErr.style.display = 'none';
            askGo.textContent = accept ? 'Cancel the leave' : 'Keep the leave';
            askGo.classList.toggle('rq-btn--reject', !!accept);
            askGo.disabled = false;
            askModal.style.display = 'flex';
            askNote.focus();
        };

        window.rqAskClose = function () {
            askModal.style.display = 'none';
            answering = null;
        };

        askModal.addEventListener('click', function (e) {
            if (e.target === askModal) rqAskClose();
        });

        askGo.addEventListener('click', async function () {
            if (!answering) return;

            askGo.disabled = true;
            try {
                const res = await fetch('/Requests/AnswerWithdrawal', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams({
                        requestId: answering.id,
                        accept: answering.accept ? 'true' : 'false',
                        note: askNote.value.trim()
                    })
                });
                if (!res.ok) {
                    const said = (await res.text() || '').trim();
                    throw new Error(
                        said && said.length < 300 && said[0] !== '<'
                            ? said
                            : 'The server could not save that (' + res.status + '). Try again.');
                }

                // The days are free and nobody is on them. Said after the fact rather than
                // in the dialog, because it is a thing to go and do next.
                let staffing = null;
                try { staffing = (await res.json()).staffing; } catch (e) { }

                rqAskClose();
                await rqRefresh(true);
                if (staffing) rqToast(staffing);
            } catch (e) {
                askErr.textContent = e.message || 'That could not be saved. Try again.';
                askErr.style.display = 'block';
                askGo.disabled = false;
            }
        });

        // Gives up on an approval without deciding the request, so it goes back to the
        // queue instead of sitting held with nobody looking at it.
        window.rqRelease = async function (id) {
            try {
                const res = await fetch('/Requests/ReleaseHold', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams({ requestId: id })
                });
                if (!res.ok) throw new Error();
                await rqRefresh(true);
            } catch (e) {
                rqToast('That could not be put back. Try again.', true);
            }
        };

        go.addEventListener('click', async function () {
            if (!pending) return;

            // A rejection the driver cannot account for is worse than no answer, and they
            // are told the outcome either way.
            if (pending.decision === 'Rejected' && !note.value.trim()) {
                err.textContent = 'Say why this was rejected. The driver is told the reason.';
                err.style.display = 'block';
                return;
            }

            if (pending.decision === 'Approved' && coversShown) {
                await rqCoverAndApprove();
                return;
            }

            go.disabled = true;
            try {
                const id = pending.id;
                const body = new URLSearchParams({
                    requestId: pending.id,
                    decision: pending.decision,
                    note: note.value.trim()
                });
                const res = await fetch('/Requests/Decide', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body
                });
                // The approval cannot complete yet: the driver is still booked on days
                // the leave covers. The request is held, and what is in the way is listed
                // here rather than left for the dispatcher to go looking for.
                if (res.status === 409) {
                    const said = await res.json();
                    rqShowBlocking(said.message, said.blocking || []);
                    await rqShowCovers(id);
                    go.disabled = false;
                    // The row now reads as held, so the list is brought up to date.
                    await rqRefresh(true);
                    return;
                }

                if (!res.ok) {
                    // A refusal answers with a sentence; a crash answers with a page of
                    // HTML, which is no use in a dialog box.
                    const said = (await res.text() || '').trim();
                    throw new Error(
                        said && said.length < 300 && said[0] !== '<'
                            ? said
                            : 'The server could not save that (' + res.status + '). Try again.');
                }
                // The decision is stored; the list catches up on its own rather than
                // taking the whole page down and putting the filters back to nothing.
                rqCancel();
                await rqRefresh(true);
            } catch (e) {
                err.textContent = e.message || 'That could not be saved. Try again.';
                err.style.display = 'block';
                go.disabled = false;
            }
        });
    })();
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/candidates.css" asp-append-version="true" />
}

@section TopbarContent {
    <button type="button" class="rs-filter-toggle" data-filter-toggle="rqFilters"
            aria-expanded="false" aria-controls="rqFilters">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18M6 12h12M10 19h4" />
        </svg>
        Filters
    </button>
}
