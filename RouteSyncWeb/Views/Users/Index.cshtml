@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roles = ViewBag.Roles as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedRole = ViewBag.SelectedRole as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

@* PAGE TITLE *@
<h2 class="us-title">User Management</h2>

@if (TempData["Success"] is string successMsg)
{
    <div class="us-alert us-alert--success" role="alert">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="us-alert us-alert--error" role="alert">@errorMsg</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="us-alert us-alert--error" role="alert">Please correct the highlighted fields.</div>
}

@* TOOLBAR *@
<div class="us-toolbar">
    <div class="us-actions">
        <button type="button" class="us-btn us-btn--primary" data-bs-toggle="modal" data-bs-target="#addUserModal"><span class="us-btn-ico" aria-hidden="true">+</span><span class="us-btn-txt">&nbsp;Add User</span></button>
        <button type="button" class="us-btn us-btn--outline us-btn--dashed" data-bs-toggle="modal" data-bs-target="#manageRolesModal">Manage Roles</button>
    </div>

    <form method="get" class="us-search-form">
        <input type="hidden" name="role" value="@selectedRole" />
        <div class="us-search-wrap">
            <span class="us-search-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                     stroke="#9AA5B4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </span>
            <input type="text" name="search" value="@searchTerm" class="us-search-input" placeholder="Search by ID, name or email" />
        </div>
    </form>
</div>

@* USERS TABLE CARD *@
<div class="us-card">
    <div class="us-card-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <line x1="10" y1="9" x2="8" y2="9" />
        </svg>
        <span>User Information</span>
    </div>

    <div class="us-table-wrap rs-list-wrap">
        <table class="us-table rs-cards rs-list">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                <tr>
                    <td colspan="6" class="us-table-loading">
                        <div class="us-spinner"></div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_AddUserModal", (AddUserViewModel)ViewBag.AddUserModel)
@await Html.PartialAsync("_EditUserModal", (EditUserViewModel)ViewBag.EditUserModel)
@await Html.PartialAsync("_ManageRolesModal", (RoleFormViewModel)ViewBag.RoleFormModel)

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Auto-reopen the relevant modal after a failed POST
        const openModal = '@(ViewBag.OpenModal ?? "")';
        const modalIds = { AddUser: 'addUserModal', EditUser: 'editUserModal', ManageRoles: 'manageRolesModal' };
        if (modalIds[openModal]) {
            new bootstrap.Modal(document.getElementById(modalIds[openModal])).show();
        }

        // Password reset, confirmed in two steps inside the edit user modal.
        function resetPasswordConfirmUi() {
            document.getElementById('rpDefault').hidden = false;
            document.getElementById('rpConfirm').hidden = true;
        }

        document.getElementById('rpShowConfirm').addEventListener('click', function () {
            document.getElementById('rpUserId').value = document.getElementById('euUserId').value;
            document.getElementById('rpDefault').hidden = true;
            document.getElementById('rpConfirm').hidden = false;
        });

        document.getElementById('rpCancel').addEventListener('click', resetPasswordConfirmUi);

        // Edit user, with the fields populated from the clicked row's data attributes.
        document.getElementById('editUserModal').addEventListener('show.bs.modal', function (event) {
            resetPasswordConfirmUi();

            const btn = event.relatedTarget;
            if (!btn) return;

            document.getElementById('euUserId').value = btn.dataset.userId;
            document.getElementById('euFirstName').value = btn.dataset.firstName;
            document.getElementById('euMiddleName').value = btn.dataset.middleName ?? '';
            document.getElementById('euLastName').value = btn.dataset.lastName;
            document.getElementById('euEmail').value = btn.dataset.email;
            document.getElementById('euRoleId').value = btn.dataset.roleId;
            document.getElementById('euAccountStatus').value = btn.dataset.accountStatus;
        });

        // Manage roles, switching the right-hand pane to the selected role.
        const WEB_PERMISSION_KEYS = ['dashboard', 'routes', 'vehicles', 'reports', 'users', 'audit'];
        const MOBILE_PERMISSION_KEYS = ['tracking', 'messages', 'checklist'];

        function applyRolePermissions(webPerms, mobilePerms) {
            WEB_PERMISSION_KEYS.forEach(k => document.getElementById('perm_web_' + k).checked = !!webPerms[k]);
            MOBILE_PERMISSION_KEYS.forEach(k => document.getElementById('perm_mobile_' + k).checked = !!mobilePerms[k]);
        }

        // Load the user table rows in the background so the page itself renders instantly
        loadUserRows();

        document.querySelectorAll('.us-role-item').forEach(function (item) {
            item.addEventListener('click', function () {
                document.querySelectorAll('.us-role-item').forEach(i => i.classList.remove('us-role-item--active'));
                item.classList.add('us-role-item--active');

                const form = document.getElementById('roleForm');
                const roleId = item.dataset.roleId;

                if (roleId) {
                    document.getElementById('roleFormRoleId').value = roleId;
                    form.action = '@Url.Action("UpdateRole", "Users")';
                    document.getElementById('roleFormName').value = item.dataset.roleName;
                    applyRolePermissions(JSON.parse(item.dataset.webPerms || '{}'), JSON.parse(item.dataset.mobilePerms || '{}'));
                } else {
                    document.getElementById('roleFormRoleId').value = '';
                    form.action = '@Url.Action("CreateRole", "Users")';
                    document.getElementById('roleFormName').value = '';
                    applyRolePermissions({}, {});
                }
            });
        });
    });

    /** The filters as they stand, rather than as the address bar last left them. */
    function currentUserQuery() {
        const params = new URLSearchParams();
        const role = document.querySelector('#usFilters select[name="role"]');
        const search = document.querySelector('.us-search-input');
        if (role && role.value) params.set('role', role.value);
        if (search && search.value.trim()) params.set('search', search.value.trim());
        const query = params.toString();
        return query ? '?' + query : '';
    }

    function loadUserRows() {
        const tbody = document.getElementById('usersTableBody');
        fetch('@Url.Action("UserRows", "Users")' + currentUserQuery())
            .then(function (response) { return response.text(); })
            .then(function (html) { tbody.innerHTML = html; })
            .catch(function () {
                tbody.innerHTML = '<tr><td colspan="6" class="us-empty">Failed to load users.</td></tr>';
            });
    }

    // Searching used to mean submitting the form and reloading the page, which on a
    // phone closes the keyboard on every attempt. The rows are fetched on their own
    // anyway, so the box asks for them again as the name is typed.
    document.addEventListener('DOMContentLoaded', function () {
        const box = document.querySelector('.us-search-input');
        const form = document.querySelector('.us-search-form');
        if (!box) return;

        let pending;
        box.addEventListener('input', function () {
            clearTimeout(pending);
            pending = setTimeout(loadUserRows, 200);
        });

        if (form) form.addEventListener('submit', function (e) {
            e.preventDefault();
            clearTimeout(pending);
            loadUserRows();
        });
    });
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

@section TopbarContent {
    <button type="button" class="rs-filter-toggle" data-filter-toggle="usFilters"
            aria-expanded="false" aria-controls="usFilters">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18M6 12h12M10 19h4" />
        </svg>
        Filters
    </button>

    <form method="get" class="us-role-filter rs-filters" id="usFilters">
        <input type="hidden" name="search" value="@searchTerm" />
        @* Label and control are one row of the panel, so they are wrapped as one.
           The wrapper is display:contents on a desk and lays out nothing. *@
        <div class="us-filter">
        <label class="us-role-filter-label">Roles:</label>
        <div class="us-select-wrap">
            <select name="role" class="us-select" onchange="loadUserRows()">
                <option value="">All Roles</option>
                @foreach (var r in roles)
                {
                    <option value="@r.Value" selected="@(r.Value == selectedRole)">@r.Text</option>
                }
            </select>
            <span class="us-select-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </span>
        </div>
        </div>
    </form>
}
