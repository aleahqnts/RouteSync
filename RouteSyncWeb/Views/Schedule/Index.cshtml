@model FleetWise.ViewModels.ScheduleViewModel
@{
    ViewData["Title"] = "Edit Schedule";
    string CellKey(int routeId, string shift, DateTime day) => $"{routeId}|{shift}|{day:yyyy-MM-dd}";

    // The identifier prints in a column of its own, so the numbers can be read down
    // the list rather than hunted for after names of every length. A native option
    // cannot be laid out, so the padding is the text itself, in a space that does not
    // collapse, and the select is set in a monospace face to hold the column steady.
    var driverNameWidth = Model.Drivers.Count == 0 ? 0 : Model.Drivers.Max(d => d.DriverName.Length);

    // No mention of leave or availability here. Both are answers to "on which day", and
    // one option is shown in every day of the row, so the note is written per cell in
    // script below rather than baked into the label.
    string DriverLabel(string name, int id) =>
        name
        + new string(' ', Math.Max(0, driverNameWidth - name.Length) + 2)
        + id;
}

<div class="sch-wrap">

    @* Held at the top of the screen. The week being planned, the way to another week and
       the way to save are wanted at every point of a grid several screens long. *@
    <div class="sch-sticky-top" id="schStickyTop">

    @* Toolbar *@
    <div class="sch-toolbar">
        <a class="sch-btn-ghost" href="/Dispatch">&#8592; Back to Dispatch</a>
        <div class="sch-week-nav">
            <a class="sch-btn-ghost" href="/Schedule?start=@Model.PrevWeekStart">&#8249; Prev</a>
            <span class="sch-week-label">@Model.WeekStart.ToString("MMM d") – @Model.WeekEnd.ToString("MMM d, yyyy")</span>
            <a class="sch-btn-ghost" href="/Schedule?start=@Model.NextWeekStart">Next &#8250;</a>
        </div>
        @* Next week is last week with edits, which is why the rotation is monthly.
           Fills the blanks in the week on screen and writes nothing until Save. *@
        @if (!Model.WeekClosed)
        {
            <button type="button" class="sch-btn-ghost" id="sch-copy" onclick="schCopyLastWeek()">
                Copy last week
            </button>
        }
        <div class="sch-pick">
            <label>Week starting</label>
            <input type="date" id="sch-start" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
            <button class="sch-btn-ghost" onclick="schGoWeek()">Go</button>
        </div>
        @* A week whose every shift has finished is a record, not a plan. The controls that
           would write to it are withheld rather than left to be refused on use. *@
        @if (Model.WeekClosed)
        {
            <span class="sch-closed-note" title="Shifts are open to editing until they finish">
                This week has finished. It can be read but not changed.
            </span>
        }
        else
        {
            <button class="sch-btn-save" id="sch-save" onclick="schSave()">Save Schedule</button>
        }
    </div>

    <div class="sch-days" id="schDays" role="tablist" aria-label="Day of the week">
        @for (int dayIndex = 0; dayIndex < Model.Days.Count; dayIndex++)
        {
            var day = Model.Days[dayIndex];
            <button type="button" class="sch-day-chip" role="tab" data-day="@dayIndex"
                    aria-selected="false">
                <span class="sch-chip-name">@day.ToString("ddd")</span>
                <span class="sch-chip-num">@day.ToString("d MMM")</span>
            </button>
        }
        <button type="button" class="sch-day-chip sch-day-chip--all" role="tab" data-day="all"
                aria-selected="false">All</button>
    </div>

    </div>@* /sch-sticky-top *@

    @* Shown when a week is opened on edits that were made and never saved. *@
    <div class="sch-draft" id="schDraft" hidden>
        <span class="sch-draft-ico" aria-hidden="true">&#9998;</span>
        <span id="schDraftText"></span>
        <button type="button" class="sch-draft-drop" onclick="schDiscardDraft()">Discard them</button>
    </div>

    <p class="sch-hint">
        Each shift requires both a vehicle and a driver. Use <strong>+ Add bus</strong> to
        run more than one bus on the same shift. Trips already under way are locked.
        Conflicts are reported when the schedule is saved.
    </p>

    @foreach (var route in Model.Routes)
    {
        <div class="sch-card">
            <div class="sch-card-head">@route.RouteName</div>
            <div class="sch-table-scroll">
                <table class="sch-table">
                    <thead>
                        <tr>
                            <th class="sch-shift-col">Shift</th>
                            @for (int dayIndex = 0; dayIndex < Model.Days.Count; dayIndex++)
                            {
                                var day = Model.Days[dayIndex];
                                <th data-sch-day="@dayIndex"
                                    class="@(day.Date == DateTime.Today ? "sch-today" : "")">
                                    <div class="sch-day-name">@day.ToString("ddd")</div>
                                    <div class="sch-day-num">@day.ToString("MMM d")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    @foreach (var shift in Model.Shifts)
                    {
                        // lanes = most buses on any single day this shift (>=1)
                        var laneCount = 1;
                        foreach (var day in Model.Days)
                        {
                            if (Model.Cells.TryGetValue(CellKey(route.RouteId, shift, day), out var lst))
                                laneCount = Math.Max(laneCount, lst.Count);
                        }

                        <tbody class="sch-shift-body" data-route="@route.RouteId" data-shift="@shift">
                            @for (var lane = 0; lane < laneCount; lane++)
                            {
                                <tr>
                                    @if (lane == 0)
                                    {
                                        <td class="sch-shift-col" rowspan="@laneCount">
                                            <div class="sch-shift-name">@shift</div>
                                            @if (!Model.WeekClosed)
                                            {
                                                <button type="button" class="sch-add-bus" onclick="schAddBus(this)">+ Add bus</button>
                                            }
                                        </td>
                                    }
                                    @for (int dayIndex = 0; dayIndex < Model.Days.Count; dayIndex++)
                                    {
                                        var day = Model.Days[dayIndex];
                                        Model.Cells.TryGetValue(CellKey(route.RouteId, shift, day), out var lst);
                                        var cell = lst != null && lane < lst.Count ? lst[lane] : null;

                                        @* A finished shift is drawn read-only whether or not it holds a
                                           trip. An empty picker over one reads as a slot still to fill,
                                           and filling it is refused on save. *@
                                        var slotClosed = Model.SlotClosed(shift, day);
                                        var locked = cell?.Locked == true || (cell == null && slotClosed);
                                        <td class="sch-cell-td" data-sch-day="@dayIndex">
                                            @* Marked apart from a lane that is merely under way, because
                                               the two answer differently when a week is filled from another
                                               one: a finished shift wants nothing, a running trip is a slot
                                               already taken. *@
                                            @if (locked && cell != null)
                                            {
                                                <div class="sch-locked @(slotClosed ? "sch-locked--closed" : "")"
                                                     data-shift="@shift" data-date="@day.ToString("yyyy-MM-dd")"
                                                     data-veh="@cell.VehicleId" data-drv="@cell.DriverId">
                                                    <span class="sch-lock-badge">@cell.StatusLabel</span>
                                                    <span class="sch-lock-txt">@cell.VehicleId · @(Model.Drivers.FirstOrDefault(d => d.DriverId == cell.DriverId)?.DriverName ?? "—")</span>
                                                </div>
                                            }
                                            else if (locked)
                                            {
                                                <div class="sch-locked sch-locked--closed sch-locked--empty"
                                                     data-shift="@shift" data-date="@day.ToString("yyyy-MM-dd")">
                                                    <span class="sch-lock-txt">Not run</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="sch-cell" data-route="@route.RouteId" data-shift="@shift" data-date="@day.ToString("yyyy-MM-dd")" data-tripid="@(cell?.TripId ?? "")">
                                                    @* One that cannot be booked appears only where this slot already
                                                       holds it, marked, so the slot still reads true. *@
                                                    <select class="sch-sel sch-veh">
                                                        <option value="">Vehicle…</option>
                                                        @foreach (var v in Model.Vehicles.Where(v => v.Offered || cell?.VehicleId == v.VehicleId))
                                                        {
                                                            <option value="@v.VehicleId" selected="@(cell?.VehicleId == v.VehicleId)">@v.VehicleId · @v.PlateNumber@(v.Offered ? "" : " (unavailable)")</option>
                                                        }
                                                    </select>
                                                    <select class="sch-sel sch-drv rs-id-list">
                                                        <option value="">Driver…</option>
                                                        @foreach (var dr in Model.Drivers)
                                                        {
                                                            <option value="@dr.DriverId" selected="@(cell != null && cell.DriverId == dr.DriverId)">@DriverLabel(dr.DriverName, dr.DriverId)</option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        </div>
    }

    @* Save toast *@
    <div id="sch-toast" class="sch-toast">
        <span class="sch-toast-ico">&#10003;</span> <span class="sch-toast-txt">Schedule saved</span>
    </div>

    @* Conflict popup *@
    @* Movable, and it does not take the page while it is up. The grid is what the list
       is about, and a box fixed over the middle of it meant reading a line, closing the
       box to find the cells, then opening it again for the next line. *@
    <div id="sch-conflict-modal" class="sch-modal-overlay sch-modal-overlay--free" style="display:none;">
        <div class="sch-modal">
            <div class="sch-modal-head" title="Drag to move">
                <span class="sch-modal-ico">&#9888;</span>
                <h3 id="sch-conflict-title">Schedule Conflicts</h3>
                @* Says the box can be taken hold of. Without it the only sign was a cursor
                   nobody looks for. *@
                <span class="sch-modal-grab" aria-hidden="true">&#8942;&#8942;</span>
            </div>
            <p id="sch-conflict-sub" class="sch-modal-sub">Review the highlighted cells before saving.</p>
            <ul id="sch-conflict-list" class="sch-modal-list"></ul>
            <div class="sch-modal-actions">
                <button class="sch-modal-btn" onclick="schCloseConflicts()">Back</button>
                <button id="sch-override-btn" class="sch-modal-btn sch-modal-btn-override" style="display:none;" onclick="schConfirmOverride()">Save Anyway</button>
            </div>
        </div>
    </div>

    @* Asked the moment a driver who is away is chosen for a cell. *@
    <div id="sch-away-modal" class="sch-modal-overlay" style="display:none;">
        <div class="sch-modal">
            <div class="sch-modal-head">
                <span class="sch-modal-ico">&#9888;</span>
                <h3>Driver Is Away</h3>
            </div>
            <p id="sch-away-text" class="sch-modal-sub"></p>
            <div class="sch-modal-actions">
                <button class="sch-modal-btn" onclick="schCancelAway()">Choose Another</button>
                <button class="sch-modal-btn sch-modal-btn-override" onclick="schConfirmAway()">Assign Anyway</button>
            </div>
        </div>
    </div>

    @* Override confirmation (second modal) *@
    <div id="sch-override-modal" class="sch-modal-overlay" style="display:none;">
        <div class="sch-modal">
            <div class="sch-modal-head">
                <span class="sch-modal-ico">&#9888;</span>
                <h3>Confirm Override</h3>
            </div>
            <p class="sch-modal-sub">The following conflicts were found. Proceed only if this assignment is intended.</p>
            <ul id="sch-override-list" class="sch-modal-list"></ul>
            <div class="sch-modal-actions">
                <button class="sch-modal-btn" onclick="schCancelOverride()">Cancel</button>
                <button class="sch-modal-btn sch-modal-btn-override" onclick="schSave(true)">Save Anyway</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
}

<script>
    const SCH_WEEK_START = '@Model.WeekStart.ToString("yyyy-MM-dd")';
    const SCH_WEEK_END   = '@Model.WeekEnd.ToString("yyyy-MM-dd")';
    const SCH_PREV_WEEK  = '@Model.PrevWeekStart';
    const SCH_DAYS = [@Html.Raw(string.Join(",", Model.Days.Select(d => $"'{d:yyyy-MM-dd}'")))];
    // Data, not markup. These used to be HTML strings glued together with Html.Raw, which
    // switches Razor's encoding OFF - so a driver named `"><script>...` (a dispatcher can
    // create one) escaped the option tag and ran in the next admin's session. JSON keeps
    // the values as values; the options are built through the DOM below, where a name is
    // always text and never markup. JsonSerializer escapes < > & by default, so nothing
    // here can close this script tag either.
    const SCH_VEHICLES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Vehicles.Where(v => v.Offered).Select(v => new { id = v.VehicleId, label = $"{v.VehicleId} · {v.PlateNumber}" })));
    const SCH_DRIVERS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Drivers.Select(d => new { id = d.DriverId, label = DriverLabel(d.DriverName, d.DriverId) })));
    // Names on their own, for the sentences below. The label above is padded out into
    // columns and carries the identifier, which reads as a name and a number in a warning.
    const SCH_DRIVER_NAMES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Drivers.ToDictionary(d => d.DriverId.ToString(), d => d.DriverName)));
    // Which days of this week each driver has leave for, and of what kind.
    const SCH_LEAVE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeaveDays));
    // Drivers who have said they cannot work. The flag carries no date, so it is read
    // against the day below and no other.
    const SCH_UNAVAILABLE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Drivers.Where(d => !d.Offered).Select(d => d.DriverId.ToString())));
    const SCH_TODAY = '@(Model.TodayInWeek ?? "")';

    /* The height of the block held at the top, written where the stylesheet can read it,
       so every route heading knows what to come to rest under.
       Measured rather than written down: the toolbar wraps onto a second line on a narrow
       window, and a figure typed into the stylesheet would be wrong the moment it did. */
    (function () {
        const top = document.getElementById('schStickyTop');
        if (!top) return;

        function measure() {
            document.documentElement.style.setProperty(
                '--sch-top', top.getBoundingClientRect().height + 'px');
        }

        measure();
        if (window.ResizeObserver) new ResizeObserver(measure).observe(top);
        window.addEventListener('resize', measure);
    })();

    // Why a driver cannot take a shift on a given day, or an empty string when they can.
    //
    // Leave carries its dates, so it is asked about the day the cell sits on. The
    // availability flag carries none: it says a driver cannot work now, which is a
    // statement about today and about no other day of the week.
    function schAwayNote(driverId, date) {
        const days = SCH_LEAVE[driverId];
        const type = days && days[date];
        if (type) return 'on ' + type.toLowerCase() + ' leave';
        if (date === SCH_TODAY && SCH_UNAVAILABLE.indexOf(String(driverId)) !== -1)
            return 'unable to drive';
        return '';
    }

    // Writes that note into every driver list, one cell at a time.
    //
    // The same driver reads differently in two cells of the same row, so the note cannot
    // be part of the option as it is built. The label it was made with is kept on the
    // option and rewritten from, or a second pass would append a note to a note.
    //
    // A closed select shows the text of whatever is selected, so a cell already holding a
    // driver who is away says so without being opened, and the cell is marked besides.
    function schMarkAway() {
        document.querySelectorAll('.sch-cell').forEach(function (cell) {
            const sel = cell.querySelector('.sch-drv');
            if (!sel) return;
            const date = cell.dataset.date;

            Array.from(sel.options).forEach(function (opt) {
                if (!opt.value) return;
                if (opt.dataset.base === undefined) opt.dataset.base = opt.textContent;
                const note = schAwayNote(opt.value, date);
                // Spaced with the same character the identifier column is padded with,
                // which does not collapse the way a run of ordinary spaces would.
                opt.textContent = note
                    ? opt.dataset.base + '\u00a0\u00a0(' + note + ')'
                    : opt.dataset.base;
            });

            cell.classList.toggle('sch-away', !!(sel.value && schAwayNote(sel.value, date)));
        });
    }

    function schDriverName(id) {
        return SCH_DRIVER_NAMES[id] || 'This driver';
    }

    // One <select>, built from the data above. textContent, never innerHTML.
    function schBuildSelect(cls, placeholder, items) {
        const sel = document.createElement('select');
        sel.className = 'sch-sel ' + cls + (cls === 'sch-drv' ? ' rs-id-list' : '');
        const blank = document.createElement('option');
        blank.value = '';
        blank.textContent = placeholder;
        sel.appendChild(blank);
        items.forEach(function (it) {
            const opt = document.createElement('option');
            opt.value = it.id;
            opt.textContent = it.label;
            sel.appendChild(opt);
        });
        return sel;
    }

    // Edits held between weeks.
    //
    // Prev, Next and the date picker are links: they load the page again, and everything
    // entered and not yet saved went with it, silently. A week's worth of work can be
    // twenty pickers, and losing it to a mis-click on Next is not a thing anyone should
    // have to be careful about.
    //
    // Kept per week, so moving between two half-planned weeks keeps both. Kept for the tab
    // rather than the browser: this is a draft of what is on screen, not a second copy of
    // the schedule, and a draft that outlives the sitting would be restored days later
    // over a week somebody else has since saved.
    let schRestoring = false;

    function schDraftKey() { return 'sch_draft_' + SCH_WEEK_START; }

    /* Every cell that has been touched, and where it sits. Lanes are counted over all of
       them in the order they are drawn, so a lane added by + Add bus is found again. */
    function schSaveDraft() {
        if (schRestoring) return;

        const lanes = {};
        const out = [];

        document.querySelectorAll('.sch-cell').forEach(function (cell) {
            const slot = cell.dataset.route + '|' + cell.dataset.shift + '|' + cell.dataset.date;
            lanes[slot] = (lanes[slot] === undefined ? 0 : lanes[slot] + 1);
            if (!cell.classList.contains('sch-dirty')) return;

            out.push({
                r: cell.dataset.route,
                s: cell.dataset.shift,
                d: cell.dataset.date,
                lane: lanes[slot],
                veh: cell.querySelector('.sch-veh').value,
                drv: cell.querySelector('.sch-drv').value
            });
        });

        // A tab that refuses storage is a tab without drafts, not a tab that stops working.
        try {
            if (out.length) sessionStorage.setItem(schDraftKey(), JSON.stringify(out));
            else sessionStorage.removeItem(schDraftKey());
        } catch (e) { /* private browsing, or the quota */ }
    }

    function schLanesFor(route, shift, date) {
        return document.querySelectorAll(
            '.sch-cell[data-route="' + route + '"][data-shift="' + shift + '"][data-date="' + date + '"]');
    }

    function schDiscardDraft() {
        try { sessionStorage.removeItem(schDraftKey()); } catch (e) { }
        window.location.reload();
    }

    /* Put back where they were. A bus or a driver that has since stopped being on offer is
       left out rather than forced in, and the count says how many. */
    function schRestoreDraft() {
        let saved = null;
        try { saved = JSON.parse(sessionStorage.getItem(schDraftKey()) || 'null'); }
        catch (e) { return; }
        if (!Array.isArray(saved) || !saved.length) return;

        schRestoring = true;
        let put = 0, lost = 0;

        saved.forEach(function (c) {
            const tbody = document.querySelector(
                '.sch-shift-body[data-route="' + c.r + '"][data-shift="' + c.s + '"]');
            if (!tbody) { lost++; return; }

            let list = schLanesFor(c.r, c.s, c.d);
            let guard = 0;
            while (list.length <= c.lane && guard++ < 20) {
                schAddLane(tbody);
                list = schLanesFor(c.r, c.s, c.d);
            }

            const cell = list[c.lane];
            if (!cell) { lost++; return; }

            const veh = cell.querySelector('.sch-veh');
            const drv = cell.querySelector('.sch-drv');
            const has = function (sel, value) {
                return !value || Array.prototype.some.call(sel.options, function (o) { return o.value === value; });
            };
            if (!has(veh, c.veh) || !has(drv, c.drv)) { lost++; return; }

            veh.value = c.veh;
            drv.value = c.drv;
            veh.dataset.prev = veh.value;
            drv.dataset.prev = drv.value;
            cell.classList.add('sch-dirty');
            put++;
        });

        schRestoring = false;
        schNarrowChoices();
        schMarkAway();

        if (!put && !lost) return;

        const bar = document.getElementById('schDraft');
        document.getElementById('schDraftText').textContent =
            (put === 1 ? '1 unsaved change' : put + ' unsaved changes') + ' from earlier restored.'
            + (lost ? ' ' + lost + (lost === 1 ? ' could not be put back.' : ' could not be put back.') : '')
            + ' Nothing is written until you save.';
        bar.hidden = false;
    }

    let schToastTimer = null;

    function schToast(text, ms) {
        const t = document.getElementById('sch-toast');
        t.querySelector('.sch-toast-txt').textContent = text;
        t.classList.add('show');
        clearTimeout(schToastTimer);
        schToastTimer = setTimeout(() => t.classList.remove('show'), ms || 2600);
    }

    // show save toast once after the post-save reload
    if (sessionStorage.getItem('sch_saved')) {
        const said = sessionStorage.getItem('sch_saved');
        sessionStorage.removeItem('sch_saved');
        // A save that left slots alone because their shift finished says so, and holds the
        // line long enough to be read: the grid it comes back to has changed under the
        // planner and the reason is not visible in it.
        const plain = said === '1';
        window.addEventListener('DOMContentLoaded',
            () => schToast(plain ? 'Schedule saved' : 'Schedule saved. ' + said, plain ? undefined : 6500));
    }

    function schGoWeek() {
        const v = document.getElementById('sch-start').value;
        if (v) window.location.href = '/Schedule?start=' + v;
    }

    function schWireCell(cell) {
        cell.querySelectorAll('.sch-sel').forEach(function (sel) {
            sel.dataset.prev = sel.value;
            sel.addEventListener('change', function () {
                cell.classList.add('sch-dirty');

                // Asked here rather than at save. The dispatcher has this cell in front of
                // them and the rest of the list still open; hearing it at the end of the
                // week's planning means going back to find which cell it was about.
                if (sel.classList.contains('sch-drv') && sel.value) {
                    const note = schAwayNote(sel.value, cell.dataset.date);
                    if (note) { schAskAway(sel, cell.dataset.date, note); return; }
                }

                sel.dataset.prev = sel.value;
                schNarrowChoices();
                schMarkAway();
                schSaveDraft();

                // The list on screen was worked out from the grid as it was. Changing a
                // cell answers one of its lines or invalidates another, and neither is
                // known until the next save, so it is taken down rather than left saying
                // something that may no longer be true.
                schCloseConflicts();
            });
        });
    }

    // The list waiting on an answer, so declining can put back what it held.
    let schAwaySel = null;

    function schAskAway(sel, date, note) {
        schAwaySel = sel;
        document.getElementById('sch-away-text').textContent =
            schDriverName(sel.value) + ' is ' + note + ' on ' + schFmtDate(date)
            + '. Assign them to this shift anyway?';
        document.getElementById('sch-away-modal').style.display = 'flex';
    }

    function schCancelAway() {
        if (schAwaySel) schAwaySel.value = schAwaySel.dataset.prev || '';
        schCloseAway();
        schSaveDraft();
    }

    function schConfirmAway() {
        if (schAwaySel) schAwaySel.dataset.prev = schAwaySel.value;
        schCloseAway();
        schSaveDraft();
    }

    function schCloseAway() {
        document.getElementById('sch-away-modal').style.display = 'none';
        schAwaySel = null;
        schNarrowChoices();
        schMarkAway();
    }

    // A bus is in one place at a time and so is a driver, so once a slot on a given day
    // and shift holds one, no other slot that day and shift offers it. That covers every
    // route at once: two routes running the same shift cannot share a bus either.
    //
    // A lane that has started is not editable but still occupies what it holds, so it is
    // read as well. Withdrawing a choice that cannot be made leaves back-to-back shifts as
    // the only conflict a dispatcher can still create, which is the only one worth an
    // override, since a driver working two in a row is possible and a bus in two places
    // is not.
    function schNarrowChoices() {
        const groups = {};
        document.querySelectorAll('.sch-cell, .sch-locked').forEach(el => {
            const key = el.dataset.shift + '|' + el.dataset.date;
            (groups[key] ??= []).push(el);
        });

        Object.values(groups).forEach(function (els) {
            [['sch-veh', 'veh'], ['sch-drv', 'drv']].forEach(function (pair) {
                const [cls, lockedAttr] = pair;

                // What this shift and day already holds, and which select holds it.
                const taken = new Map();
                els.forEach(function (el) {
                    if (el.classList.contains('sch-locked')) {
                        const held = el.dataset[lockedAttr];
                        if (held) taken.set(held, null);   // null = held by a locked lane
                        return;
                    }
                    const sel = el.querySelector('.' + cls);
                    if (sel && sel.value) taken.set(sel.value, sel);
                });

                els.forEach(function (el) {
                    const sel = el.querySelector('.' + cls);
                    if (!sel) return;
                    Array.from(sel.options).forEach(function (opt) {
                        // Its own choice stays; the blank stays; anything held elsewhere goes.
                        const elsewhere = opt.value && taken.has(opt.value) && taken.get(opt.value) !== sel;
                        opt.hidden = elsewhere;
                        opt.disabled = elsewhere;
                    });
                });
            });
        });
    }

    document.querySelectorAll('.sch-cell').forEach(schWireCell);
    schNarrowChoices();
    schMarkAway();

    // Add a new bus lane (empty row) to a shift, across all 7 days.
    // Showing one day at a time.
    //
    // Seven days of vehicle and driver pickers do not fit across a phone, and the
    // week is not what someone standing at a terminal is looking at. The grid keeps
    // its shape and every cell stays in the page, so saving still sends the whole
    // week; the other six columns are only hidden from view.
    //
    // The rule lives in a stylesheet gated on width, so choosing a day changes
    // nothing on a screen wide enough to show all seven.
    let schDay = 'all';

    function schApplyDay() {
        document.querySelectorAll('[data-sch-day]').forEach(el => {
            el.classList.toggle('sch-day-off',
                schDay !== 'all' && el.dataset.schDay !== String(schDay));
        });
        document.querySelectorAll('.sch-day-chip').forEach(chip => {
            const on = chip.dataset.day === String(schDay);
            chip.classList.toggle('sch-day-chip--on', on);
            chip.setAttribute('aria-selected', on ? 'true' : 'false');
        });
    }

    function schSetDay(day) {
        schDay = day;
        schApplyDay();
    }

    (function () {
        const bar = document.getElementById('schDays');
        if (!bar) return;
        bar.addEventListener('click', e => {
            const chip = e.target.closest('.sch-day-chip');
            if (chip) schSetDay(chip.dataset.day === 'all' ? 'all' : Number(chip.dataset.day));
        });

        // Opens on the whole week. The columns keep the width that makes a day
        // readable and the grid scrolls sideways, so the week is there to be
        // moved through rather than chosen between. A chip still narrows it to
        // one day for anyone who would rather not scroll.
        schSetDay('all');
    })();

    function schAddBus(btn) {
        schAddLane(btn.closest('.sch-shift-body'));
    }

    function schAddLane(tbody) {
        const route = tbody.dataset.route;
        const shift = tbody.dataset.shift;

        const tr = document.createElement('tr');
        SCH_DAYS.forEach((date, dayIndex) => {
            const td = document.createElement('td');
            td.className = 'sch-cell-td';
            td.dataset.schDay = dayIndex;
            const cell = document.createElement('div');
            cell.className = 'sch-cell';
            cell.dataset.route = route;
            cell.dataset.shift = shift;
            cell.dataset.date = date;
            cell.dataset.tripid = '';
            cell.appendChild(schBuildSelect('sch-veh', 'Vehicle…', SCH_VEHICLES));
            cell.appendChild(schBuildSelect('sch-drv', 'Driver…', SCH_DRIVERS));
            schWireCell(cell);
            td.appendChild(cell);
            tr.appendChild(td);
        });
        tbody.appendChild(tr);
        schApplyDay();
        schNarrowChoices();
        schMarkAway();

        // grow the sticky shift-label rowspan to cover the new lane
        const labelCell = tbody.querySelector('.sch-shift-col');
        labelCell.rowSpan = (parseInt(labelCell.rowSpan) || 1) + 1;
    }

    // Fill this week from the one before it.
    //
    // Four routes across three shifts and seven days is eighty-four slots entered by
    // hand, and next week is mostly last week with edits. Pulling rather than pushing:
    // the button sits in the week it fills, so what arrives is in front of the planner
    // rather than in a week they have to go and find.
    //
    // Blanks only. A slot already holding a bus and a driver is left alone, and a lane
    // that has started is not editable at all. Nothing is written here either: the grid
    // stays a draft until Save, so the planner reads what arrived, sees whatever it
    // clashes with, and decides.
    async function schCopyLastWeek() {
        const btn = document.getElementById('sch-copy');
        btn.disabled = true;
        try {
            const res = await fetch('/Schedule/Week?start=' + encodeURIComponent(SCH_PREV_WEEK));
            if (!res.ok) throw new Error('HTTP ' + res.status);
            schPasteWeek(await res.json());
        } catch (e) {
            schToast('Last week could not be read. Try again.', 4200);
        } finally {
            btn.disabled = false;
        }
    }

    function schPasteWeek(src) {
        const cells = src.cells || [];
        if (!cells.length) {
            schToast('Last week has no trips to copy.', 4200);
            return;
        }

        // Two reasons a slot is passed over, counted apart because they ask different
        // things of the planner. A shift that has finished wants nothing. A bus or driver
        // that can no longer be booked leaves a hole somebody has to fill.
        let filled = 0, kept = 0, skipped = 0, finished = 0;

        cells.forEach(c => {
            const tbody = document.querySelector(
                '.sch-shift-body[data-route="' + c.routeId + '"][data-shift="' + c.shift + '"]');
            // A route that has since been removed has no row to fill.
            if (!tbody) { skipped++; return; }

            // Last week may have run more buses on this shift than this week has lanes
            // for, so the lanes it needs are added the same way the button adds them.
            while (tbody.querySelectorAll(':scope > tr').length <= c.lane) schAddLane(tbody);

            const row = tbody.querySelectorAll(':scope > tr')[c.lane];
            const td = row.querySelectorAll('.sch-cell-td')[c.dayIndex];
            if (!td) { skipped++; return; }

            // Both a finished shift and a lane under way render as a locked block with no
            // pickers in it, and they mean different things here. A finished shift asks
            // nothing of the planner; a running trip is a slot already taken.
            const cell = td.querySelector('.sch-cell');
            if (!cell) {
                if (td.querySelector('.sch-locked--closed')) finished++; else kept++;
                return;
            }

            const veh = cell.querySelector('.sch-veh');
            const drv = cell.querySelector('.sch-drv');
            if (veh.value && drv.value) { kept++; return; }

            // A bus grounded since last week, or a driver off the roster, is not on the
            // list at all. The slot is left empty rather than holding something that is
            // not on offer, and the planner is told the count. A driver who is away is
            // still placed and then marked: last week is not the week this lands in.
            const has = (sel, val) => Array.prototype.some.call(sel.options, o => o.value === val);
            if (!has(veh, c.vehicleId) || !has(drv, String(c.driverId))) { skipped++; return; }

            veh.value = c.vehicleId;
            drv.value = String(c.driverId);
            // Set in script, so what each list now holds is recorded here. Otherwise
            // declining a later change would put back the blank this replaced.
            veh.dataset.prev = veh.value;
            drv.dataset.prev = drv.value;
            cell.classList.add('sch-dirty');
            filled++;
        });

        schNarrowChoices();
        schMarkAway();
        schSaveDraft();

        // A silent bulk edit is unnerving, and the count is how the planner checks it did
        // what they meant.
        const parts = [];
        parts.push(filled === 1 ? 'Filled 1 slot from last week.'
                                : 'Filled ' + filled + ' slots from last week.');
        if (kept) parts.push(kept + (kept === 1 ? ' slot already set was' : ' slots already set were') + ' left alone.');
        if (finished) parts.push(finished + (finished === 1 ? ' shift had' : ' shifts had') + ' already finished.');
        if (skipped) parts.push(skipped + (skipped === 1 ? ' could not be placed.' : ' could not be placed.'));

        // Nothing landed, and the reason decides what to say. Naming buses and drivers when
        // the week had simply gone sends the planner looking for a fleet problem that is
        // not there.
        const nothing = filled === 0 && kept === 0;
        schToast(
            nothing && skipped && !finished
                ? 'Nothing could be placed. Those buses and drivers are no longer available.'
                : nothing && finished && !skipped
                ? 'Nothing was filled. Every shift in this week has already finished.'
                : parts.join(' '),
            5200);
    }

    const SHIFT_ADJ = { 'Morning': 'Afternoon', 'Afternoon': 'Evening' }; // back-to-back pairs
    const SCH_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    function schFmtDate(iso) {
        const [y, m, d] = iso.split('-').map(Number);
        return `${SCH_MONTHS[m - 1]} ${d}, ${y}`;
    }

    let schLastConflicts = [];   // remembered for the override confirmation modal

    // When the panel last finished being dragged. A drag that happens to start on one of
    // its lines must not also be read as pressing that line, which would take the panel
    // away in the middle of moving it. A time rather than a flag, because a drag does not
    // always end in a click and a flag left standing would swallow the next real one.
    let schPanelDraggedAt = 0;

    // A conflict is { text, els }: what is wrong, and the cells it is about.
    //
    // The two used to travel separately, a list of sentences and a set of cells marked
    // red, and a week copied forward can raise five at once. Five sentences over eleven
    // red cells says which cells are wrong and nothing about which sentence goes with
    // which, so each one has to be worked out from the shift and the date in its wording.
    // Numbering them puts the same figure on the line and on the cells it names.

    /* Two conflicts saying the same thing are one conflict over more cells. */
    function schMergeConflicts(list) {
        const byText = new Map();
        (list || []).forEach(function (c) {
            const found = byText.get(c.text);
            if (!found) {
                byText.set(c.text, { text: c.text, els: (c.els || []).slice() });
                return;
            }
            (c.els || []).forEach(function (el) {
                if (found.els.indexOf(el) === -1) found.els.push(el);
            });
        });
        return [...byText.values()];
    }

    function schClearConflictMarks() {
        document.querySelectorAll('.sch-cell').forEach(function (cell) {
            cell.classList.remove('sch-conflict', 'sch-cell--found');
            const tags = cell.querySelector('.sch-conflict-ns');
            if (tags) tags.remove();
        });
    }

    /* A cell can break more than one rule, and each figure it earns gets a circle of its
       own. Written into one as a list of figures they read as a single number. */
    function schMarkCell(el, number) {
        el.classList.add('sch-conflict');

        let box = el.querySelector('.sch-conflict-ns');
        if (!box) {
            box = document.createElement('span');
            box.className = 'sch-conflict-ns';
            el.appendChild(box);
        }

        if (box.querySelector('[data-n="' + number + '"]')) return;

        const dot = document.createElement('span');
        dot.className = 'sch-conflict-n';
        dot.dataset.n = number;
        dot.textContent = number;
        box.appendChild(dot);
    }

    /* Takes the reader to the first cell a line is about, and holds it long enough to be
       found. The list is over the grid, so it closes on the way. */
    /* Brings a cell into view past everything pinned over it.

       scrollIntoView cannot do this. Vertically it knows nothing about the app bar, the
       toolbar block or the route heading held above the grid, so centring a cell drops it
       under them the moment the page cannot scroll far enough to centre anything, which
       is most of the first and last card. Sideways it centres inside the card's own
       scroller, and a cell in one of the early columns then ends up beneath the shift
       column pinned to the left edge.

       Both offsets are worked out here instead. The two custom properties are read off
       the cell, which inherits whatever the layout resolved them to rather than what this
       file might assume. */
    function schRevealCell(el) {
        const style = getComputedStyle(el);
        const px = function (name) { return parseFloat(style.getPropertyValue(name)) || 0; };
        const GAP = 20;

        // Sideways, inside the card, clear of the shift column pinned over the left.
        const scroller = el.closest('.sch-table-scroll');
        if (scroller) {
            const pinned = scroller.querySelector('.sch-shift-col');
            const pad = (pinned ? pinned.getBoundingClientRect().width : 0) + GAP;
            const cell = el.getBoundingClientRect();
            const box = scroller.getBoundingClientRect();

            let byX = 0;
            if (cell.left < box.left + pad) byX = cell.left - (box.left + pad);
            else if (cell.right > box.right - GAP) byX = cell.right - (box.right - GAP);

            if (byX) scroller.scrollTo({ left: scroller.scrollLeft + byX, behavior: 'smooth' });
        }

        // Down the page, clear of the bar, the toolbar and this card's own heading.
        const card = el.closest('.sch-card');
        const head = card ? card.querySelector('.sch-card-head') : null;

        const cover = px('--rs-bar') + px('--sch-top')
                    + (head ? head.getBoundingClientRect().height : 0);

        const want = el.getBoundingClientRect().top + window.scrollY - cover - GAP;
        window.scrollTo({ top: Math.max(0, want), behavior: 'smooth' });
    }

    function schGoToConflict(item) {
        const el = (item.els || [])[0];
        if (!el) return;

        // Left open on a desk. It is a note beside the grid, not over it, and numbering
        // the lines is only worth anything if they can be worked through one after
        // another; closing it meant saving again to see what was left. On a phone the
        // same panel covers the page, so there it has to get out of the way.
        if (window.matchMedia('(max-width: 599px)').matches) schCloseConflicts();

        schRevealCell(el);

        (item.els || []).forEach(function (cell) {
            cell.classList.add('sch-cell--found');
            setTimeout(function () { cell.classList.remove('sch-cell--found'); }, 2000);
        });
    }

    /* One numbered line per conflict, in either list. */
    function schFillConflictList(ul, items) {
        ul.replaceChildren();
        items.forEach(function (item, i) {
            const li = document.createElement('li');

            const badge = document.createElement('span');
            badge.className = 'sch-modal-n';
            badge.textContent = i + 1;

            const text = document.createElement('span');
            text.textContent = item.text;   // a conflict line is data, not markup

            li.append(badge, text);

            if ((item.els || []).length) {
                li.className = 'sch-modal-item--go';
                li.title = 'Show this on the grid';
                li.addEventListener('click', function () {
                    if (Date.now() - schPanelDraggedAt < 250) return;
                    schGoToConflict(item);
                });
            }

            ul.appendChild(li);
        });
    }

    // allowOverride = soft scheduling rule (double-booking / back-to-back) the dispatcher
    // may force past. Partial slots (missing bus/driver) pass false -> no override offered.
    function schShowConflicts(conflicts, allowOverride, title, sub) {
        const items = schMergeConflicts(conflicts);
        schLastConflicts = items;

        schClearConflictMarks();
        items.forEach(function (item, i) {
            (item.els || []).forEach(function (el) { schMarkCell(el, i + 1); });
        });

        const anyCells = items.some(function (item) { return (item.els || []).length; });

        document.getElementById('sch-conflict-title').textContent = title || 'Schedule Conflicts';
        document.getElementById('sch-conflict-sub').textContent = sub
            || (anyCells
                ? 'Each line is numbered on the cells it is about. Tap a line to find them.'
                : 'Review the highlighted cells before saving.');

        schFillConflictList(document.getElementById('sch-conflict-list'), items);

        document.getElementById('sch-override-btn').style.display = allowOverride ? '' : 'none';
        document.getElementById('sch-conflict-modal').style.display = 'flex';
    }
    function schCloseConflicts() {
        document.getElementById('sch-conflict-modal').style.display = 'none';
    }

    /* Dragged, and left wherever it was put. Reopening it in the middle of the grid again
       would undo the move on every save.

       Taken hold of anywhere on the box that is not itself a control: the heading, the
       line under it, the space around the list. Restricted to the heading it was a strip
       of about twenty pixels, and a grab that missed it landed on a line instead, which
       reads as pressing that line. */
    (function () {
        const box = document.querySelector('#sch-conflict-modal .sch-modal');
        const grip = box;
        let x = 0, y = 0, fromX = 0, fromY = 0, holding = false, moved = false, rest = null;

        /* Where the box would sit with no offset on it. Taken once, before a drag, because
           the rect read during one already carries the offset being worked out from it. */
        function measure() {
            const r = box.getBoundingClientRect();
            rest = { left: r.left - x, top: r.top - y, w: r.width, h: r.height };
        }

        // Followed on the window rather than by capturing the pointer. Capture retargets
        // the click that ends the press onto whatever holds it, so with the whole box
        // holding it, pressing a line stopped reaching that line.
        function follow(e) {
            if (!holding) return;

            const toX = e.clientX - fromX;
            const toY = e.clientY - fromY;

            // A few pixels of travel is a hand resting, not a move.
            if (Math.abs(toX - x) + Math.abs(toY - y) > 3) moved = true;

            x = toX;
            y = toY;
            place();
        }

        function drop() {
            if (!holding) return;
            holding = false;
            // Read by the lines, which are pressed and dragged from alike.
            if (moved) schPanelDraggedAt = Date.now();
            window.removeEventListener('pointermove', follow);
            window.removeEventListener('pointerup', drop);
            window.removeEventListener('pointercancel', drop);
        }

        grip.addEventListener('pointerdown', function (e) {
            // Not on a phone. There the panel is the bottom sheet every other dialog is,
            // there is nowhere to move it to, and a drag would fight the scroll.
            if (window.matchMedia('(max-width: 599px)').matches) return;
            // Only the primary button, and never a text selection dragged out of the title.
            if (e.button !== 0) return;
            // A button is pressed, not dragged.
            if (e.target.closest('button, a, input, select, textarea')) return;

            holding = true;
            moved = false;
            measure();
            fromX = e.clientX - x;
            fromY = e.clientY - y;

            window.addEventListener('pointermove', follow);
            window.addEventListener('pointerup', drop);
            window.addEventListener('pointercancel', drop);
            e.preventDefault();
        });

        /* Held inside the window. A box dragged past an edge cannot be dragged back,
           because the heading it is dragged by has gone with it. */
        function place() {
            if (!rest) measure();

            const lowX = 8 - rest.left;
            const highX = window.innerWidth - rest.w - 8 - rest.left;
            const lowY = 8 - rest.top;
            const highY = window.innerHeight - rest.h - 8 - rest.top;

            x = Math.max(lowX, Math.min(x, Math.max(lowX, highX)));
            y = Math.max(lowY, Math.min(y, Math.max(lowY, highY)));

            box.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
        }

        // A window made smaller can leave it outside, so it is pulled back in.
        window.addEventListener('resize', function () {
            if (document.getElementById('sch-conflict-modal').style.display !== 'flex') return;
            measure();
            place();
        });

    })();
    // Step 1 -> 2: leave the conflict list, ask for explicit confirmation.
    function schConfirmOverride() {
        document.getElementById('sch-conflict-modal').style.display = 'none';
        schFillConflictList(document.getElementById('sch-override-list'), schLastConflicts || []);
        document.getElementById('sch-override-modal').style.display = 'flex';
    }
    function schCancelOverride() {
        document.getElementById('sch-override-modal').style.display = 'none';
    }

    // force = dispatcher confirmed override -> skip the client-side block and tell the
    // server to ignore conflicts too.
    function schSave(force) {
        document.getElementById('sch-override-modal').style.display = 'none';
        const btn = document.getElementById('sch-save');
        const cells = [];        // payload for server
        const filled = [];       // {el, route, shift, date, veh, drv}
        const found = [];        // {text, els}, paired so each line can be numbered
        // The same shape, for what cannot be booked at all rather than what merely wants
        // confirming. Kept apart so Save Anyway never reaches it.
        const blocked = [];
        const partials = [];

        // reset marks + gather
        let partial = false;
        schClearConflictMarks();
        document.querySelectorAll('.sch-cell').forEach(c => {
            const veh = c.querySelector('.sch-veh').value;
            const drv = c.querySelector('.sch-drv').value;
            if (veh && drv) {
                // dirty = changed this session. An untouched persisted cell is already-decided
                // history (incl. an override already saved) -> must not re-trigger the modal.
                const rec = { el: c, route: c.dataset.route, shift: c.dataset.shift, date: c.dataset.date, veh, drv,
                              dirty: c.classList.contains('sch-dirty') };
                filled.push(rec);
                cells.push({ tripId: c.dataset.tripid || null, routeId: parseInt(c.dataset.route),
                             shift: c.dataset.shift, date: c.dataset.date, vehicleId: veh, driverId: parseInt(drv) });
            } else if ((veh && !drv) || (!veh && drv)) {
                partial = true; partials.push(c);
            }
        });
        if (partial) {
            // Data integrity, not a scheduling rule -> never overridable.
            schShowConflicts([{ text: 'Each assigned shift requires both a vehicle and a driver.',
                                els: partials }],
                             false, 'Incomplete Assignment',
                             'Complete or clear the highlighted cells, then save again.');
            return;
        }

        // same shift + day: duplicate driver / vehicle.
        const byDayShift = {};
        filled.forEach(r => { (byDayShift[r.date + '|' + r.shift] ??= []).push(r); });
        Object.values(byDayShift).forEach(group => {
            ['drv', 'veh'].forEach(field => {
                const seen = {};
                group.forEach(r => (seen[r[field]] ??= []).push(r));
                Object.values(seen).forEach(dups => {
                    // Skip if every colliding cell is untouched (already decided).
                    if (dups.length > 1 && dups.some(r => r.dirty)) {
                        const what = field === 'drv' ? 'driver' : 'bus';
                        const cannot = field === 'drv'
                            ? 'One driver cannot run two buses.'
                            : 'One bus cannot run two routes.';
                        // Blocked, not warned about. Two routes on the same shift is the
                        // usual way in: the same driver on Route 1 and Route 2 Morning is
                        // one person in two places, which no override makes true.
                        blocked.push({
                            text: `This ${what} is already booked for the ${dups[0].shift} shift on `
                                + `${schFmtDate(dups[0].date)}, on another route. ${cannot}`,
                            els: dups.map(r => r.el)
                        });
                    }
                });
            });
        });

        // same driver: back-to-back shifts, and the morning-to-evening spread.
        const byDriver = {};
        filled.forEach(r => { (byDriver[r.drv] ??= []).push(r); });
        Object.values(byDriver).forEach(list => {
            const map = {}; // date|shift -> rec
            list.forEach(r => map[r.date + '|' + r.shift] = r);
            list.forEach(r => {
                const next = SHIFT_ADJ[r.shift];
                if (next && map[r.date + '|' + next] && (r.dirty || map[r.date + '|' + next].dirty)) {
                    found.push({
                        text: `This driver is assigned to consecutive ${r.shift} and ${next} shifts on ${schFmtDate(r.date)}.`,
                        els: [r.el, map[r.date + '|' + next].el]
                    });
                }
                // Morning and Evening on the same day. Not adjacent, so the map above
                // never paired them, and a fourteen hour spread went unreported.
                if (r.shift === 'Morning' && map[r.date + '|Evening']
                    && (r.dirty || map[r.date + '|Evening'].dirty)) {
                    found.push({
                        text: `This driver is assigned to both the Morning and Evening shifts on `
                            + `${schFmtDate(r.date)}, which spans fourteen hours.`,
                        els: [r.el, map[r.date + '|Evening'].el]
                    });
                }
                // Evening -> next-day Morning
                if (r.shift === 'Evening') {
                    const tomo = new Date(r.date); tomo.setDate(tomo.getDate() + 1);
                    const tk = tomo.toISOString().slice(0, 10) + '|Morning';
                    if (map[tk] && (r.dirty || map[tk].dirty)) {
                        found.push({
                            text: `This driver finishes the Evening shift on ${schFmtDate(r.date)} and starts the Morning shift the next day.`,
                            els: [r.el, map[tk].el]
                        });
                    }
                }
            });
        });

        // A driver away on the day their cell sits in. Named here as well as by the
        // server, so a cell changed after the leave was approved is reported without
        // waiting for the round trip. Changed cells only, like every other rule here: one
        // already saved has been decided.
        filled.forEach(r => {
            if (!r.dirty) return;
            const note = schAwayNote(r.drv, r.date);
            if (!note) return;

            // Approved leave the server refuses outright; reporting it as forceable here
            // only to be refused on the round trip reads as the save being broken. The
            // availability flag stays a warning, as it does on the server.
            const bucket = note.indexOf('leave') === -1 ? found : blocked;
            bucket.push({
                text: `${schDriverName(r.drv)} is ${note} on ${schFmtDate(r.date)}.`
                    + (bucket === blocked ? ' Revoke the leave first, or book another driver.' : ''),
                els: [r.el]
            });
        });

        // Both kinds in one list, refusals first. Reported in two passes the dispatcher
        // fixed what could not be booked, saved, met the warnings, and worked through a
        // queue that never showed them how much was left.
        //
        // Warnings are left out once they have been confirmed: Save Anyway answered them,
        // and repeating them beside a refusal reads as the confirmation not having taken.
        const soft = force ? [] : found;

        if (blocked.length || soft.length) {
            schShowConflicts(
                blocked.concat(soft),
                // Forceable only when nothing in the list is a refusal.
                blocked.length === 0,
                blocked.length ? 'Assignment Unavailable' : 'Schedule Conflicts',
                blocked.length
                    ? 'The numbered lines mark the cells. The first '
                      + (blocked.length === 1 ? 'one cannot' : blocked.length + ' cannot')
                      + ' be booked at all and must be changed before this week can be saved.'
                    : null);
            return;
        }

        // Absent on a week whose shifts have all finished, which offers no Save at all.
        if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
        fetch('/Schedule/Save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cells, weekStart: SCH_WEEK_START, weekEnd: SCH_WEEK_END, override: !!force })
        }).then(async res => {
            if (!res.ok) {
                // 409 carries { conflicts: [{ message, cells:[{routeId,shift,date}] }] } and
                // may be forced past. Anything else is a refusal or a fault, and says why.
                let data = null;
                try { data = await res.json(); } catch { /* an error page, not JSON */ }

                // Anything carrying cells is marked in the grid, whatever the status. The
                // status only decides whether it can be forced past: a 409 is a booking
                // rule, a 400 is a bus or a driver that cannot take the work at all.
                if (data && Array.isArray(data.conflicts) && data.conflicts.length) {
                    const reported = data.conflicts.map(cf => {
                        const els = [];
                        (cf.cells || []).forEach(ref => {
                            document.querySelectorAll(
                                `.sch-cell[data-route="${ref.routeId}"][data-shift="${ref.shift}"][data-date="${ref.date}"]`
                            ).forEach(el => els.push(el));
                        });
                        return { text: cf.message, els };
                    });
                    const overridable = res.status === 409;
                    schShowConflicts(
                        reported, overridable,
                        overridable ? 'Schedule Conflicts' : 'Assignment Unavailable',
                        overridable
                            ? null
                            : 'The following assignments cannot be booked. Each line is numbered on the cells it is about.');
                } else {
                    // A bare string body is still a reason worth reading; a page that is not
                    // JSON at all leaves only the status, which beats saying nothing.
                    const reason = (data && data.message)
                        || (typeof data === 'string' && data)
                        || `The server answered ${res.status} ${res.statusText || ''}`.trim() + '.';
                    schShowConflicts([{ text: reason, els: [] }], false, 'Save Failed',
                        'This cannot be overridden. Correct the issue below, then save again.');
                }
                return;
            }
            // Written, so the draft of it has nothing left to hold.
            try { sessionStorage.removeItem(schDraftKey()); } catch (e) { }

            // A save can come back having left some slots alone, where their shift finished
            // while the week sat open. The reload is what puts those cells right; the
            // message is what says why they changed.
            let note = null;
            try { const d = await res.json(); if (d && d.reload && d.message) note = d.message; }
            catch { /* an empty 200, which is the ordinary case */ }

            sessionStorage.setItem('sch_saved', note || '1'); // survive the reload -> show toast
            window.location.reload();
        }).catch(err => schShowConflicts(
              [{ text: 'The server could not be reached: ' + err.message, els: [] }], false,
              'Save Failed', 'Check your connection, then save again.'))
          .finally(() => { if (btn) { btn.disabled = false; btn.textContent = 'Save Schedule'; } });
    }

    // Last, because putting a draft back can add lanes, and adding one reads the day
    // filter and the option lists set up above.
    schRestoreDraft();
</script>
