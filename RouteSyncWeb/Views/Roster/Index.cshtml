@model FleetWise.ViewModels.RosterViewModel
@using FleetWise.Services
@{
    ViewData["Title"] = "Roster";

    var shifts = RosterRules.Shifts;
    var disabled = Model.ReadOnly ? "disabled" : null;

    // By route as well as bus and shift: a bus moved to another route shows on both cards, and
    // its crew belongs only to the card of the route they were rostered on.
    FleetWise.ViewModels.RosterSeatInput? CrewAt(int routeId, string vehicleId, string shift) => Model.Seats
        .FirstOrDefault(s => s.Kind == RosterRules.Crew && s.RouteId == routeId && s.Shift == shift
                          && string.Equals(s.VehicleId, vehicleId, StringComparison.OrdinalIgnoreCase));

    string StatusClass(string status) => status switch
    {
        "Published" => "ro-chip--published",
        "Draft" => "ro-chip--draft",
        _ => "ro-chip--none",
    };
}

<div class="ro-wrap" id="roPage"
     data-month="@Model.MonthKey" data-version="@Model.Version" data-status="@Model.Status"
     data-readonly="@(Model.ReadOnly ? "true" : "false")"
     data-held="@string.Join(",", Model.Held)">

    @* Held at the top the way every board holds its controls. *@
    <div class="ro-sticky" data-sticky-head>
        <div class="ro-titlerow">
            <h1 class="ro-title">Roster</h1>
            <span class="ro-chip @StatusClass(Model.Status)">@Model.Status</span>
            @* Saved after it was published: the trips on the board still follow the
               roster as it was published, until it is published again. *@
            <span class="ro-chip ro-chip--draft" id="roUnpublished" hidden="@(!Model.ChangedSincePublish)">Changes not published</span>
            <span class="ro-saved" id="roSaved">@Model.SavedLine</span>
            @if (Model.PublishedLine is not null)
            {
                <span class="ro-saved">@Model.PublishedLine</span>
            }
            <span class="ro-month">@Model.Month.ToString("MMMM yyyy")</span>
        </div>

        <div class="ro-toolbar">
            <a class="ro-btn ro-btn--ghost" href="/Schedule">&#8592; Back to Edit Schedule</a>
            <a class="ro-btn ro-btn--ghost" href="/Roster?month=@Model.PrevMonthKey">&#8249; @Model.Month.AddMonths(-1).ToString("MMM")</a>
            <a class="ro-btn ro-btn--ghost" href="/Roster?month=@Model.NextMonthKey">@Model.Month.AddMonths(1).ToString("MMM") &#8250;</a>
            <span class="ro-toolbar-gap"></span>
            @if (Model.ReadOnly)
            {
                <span class="ro-note">This month is over. Its roster can be read but not changed.</span>
            }
            else
            {
                <span class="ro-dirty" id="roDirty" hidden>Unsaved changes</span>
                @if (Model.HasPreviousRoster && Model.Status != "Published")
                {
                    <button type="button" class="ro-btn ro-btn--ghost" id="roGenerate"
                            data-previous="@Model.Month.AddMonths(-1).ToString("MMMM")">Generate from @Model.Month.AddMonths(-1).ToString("MMM")</button>
                }
                @* Clears drivers and buses that can no longer be on the roster, then fills the empty
                   places by rule. Changes the page only; Undo puts it back as it was. *@
                <button type="button" class="ro-btn ro-btn--ghost" id="roAutoFill">Auto-fill</button>
                <button type="button" class="ro-btn ro-btn--ghost" id="roUndoFill" hidden>Undo auto-fill</button>
                @* What the last auto-fill changed, in a dialog that can be opened as often as needed. *@
                <button type="button" class="ro-btn ro-btn--ghost" id="roSeeChanges" hidden
                        aria-haspopup="dialog" aria-controls="roChangesBox">
                    See changes <span class="ro-changes-n" id="roChangesCount"></span>
                </button>
                <button type="button" class="ro-btn ro-btn--ghost" id="roSuggest">Suggest rest days</button>
                <button type="button" class="ro-btn ro-btn--primary" id="roSave">Save roster</button>
                @* Shown once there is a saved roster to publish. *@
                <button type="button" class="ro-btn ro-btn--dark" id="roPublish" hidden="@(Model.Version == 0)">
                    @(Model.Status == "Published" ? "Publish changes" : "Publish")
                </button>
            }
        </div>

        @* Somebody else saved this month since the page was drawn. Stays up until the page
           is reloaded, because until then every save from here would be refused. *@
        <div class="ro-banner ro-banner--moved" id="roMoved" hidden>
            <span id="roMovedText"></span>
            <button type="button" class="ro-btn ro-btn--ghost" onclick="location.reload()">Reload</button>
        </div>
    </div>

    <p class="ro-hint">
        Assign a driver and rest day to each bus shift, and floaters to cover rest days. Shifts
        rotate each month. Auto-fill completes empty places and marks its choices for review.
    </p>

    @* What stands between this roster and a save. Asked of the server as the page is
       edited, and asked again when it is saved. *@
    <div class="ro-problems" id="roProblems" hidden>
        <p class="ro-problems-t">Fix these before saving</p>
        <ul id="roProblemList"></ul>
    </div>

    @* What publishing the roster as it stands would leave empty, worked out by the same plan
       a publish runs, leave and all, and asked again after every edit. A save is not blocked
       by it: a roster with known gaps is still better than none. *@
    <div class="ro-wouldleave" id="roWouldLeave" hidden>
        <p class="ro-wouldleave-t">If published as it stands, these would be left unfilled</p>
        <ul id="roWouldLeaveList"></ul>
    </div>

    @* What the last publish left for a person: slots nobody was free for, and slots kept
       empty on purpose. Only days still to come, since a past gap is nothing to act on. *@
    @if (Model.Gaps.Count > 0 || Model.Skips.Count > 0)
    {
        <section class="ro-card" id="roPublished">
            @if (Model.Gaps.Count > 0)
            {
                <h2 class="ro-card-title">Unfilled slots <span class="ro-count">@Model.Gaps.Count</span></h2>
                <p class="ro-empty">Nobody on the roster was free for these when it was published.</p>
                <ul class="ro-slots">
                    @foreach (var g in Model.Gaps)
                    {
                        <li class="ro-slot" data-date="@g.Date" data-vehicle="@g.VehicleId" data-shift="@g.Shift"
                            data-label="@($"{g.DateLabel}, {g.Shift} shift, {g.VehicleId}")">
                            <div class="ro-slot-main">
                                <span class="ro-slot-when">@g.DateLabel · @g.Shift</span>
                                <span class="ro-slot-bus">@g.VehicleId@(string.IsNullOrEmpty(g.RouteName) ? "" : $" · {g.RouteName}")</span>
                                <span class="ro-slot-why">@g.Reason</span>
                            </div>
                            @if (!Model.ReadOnly)
                            {
                                <div class="ro-slot-actions">
                                    @if (Model.CanFillGaps)
                                    {
                                        <button type="button" class="ro-btn ro-btn--ghost ro-fill">Find a driver</button>
                                    }
                                    <button type="button" class="ro-btn ro-btn--ghost ro-notrunning">Bus not running</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }

            @if (Model.Skips.Count > 0)
            {
                <h2 class="ro-card-title ro-card-title--next">Skipped slots <span class="ro-count">@Model.Skips.Count</span></h2>
                <p class="ro-empty">A publish never fills these. Restore one to let the next publish fill it.</p>
                <ul class="ro-slots">
                    @foreach (var s in Model.Skips)
                    {
                        <li class="ro-slot" data-date="@s.Date" data-vehicle="@s.VehicleId" data-shift="@s.Shift">
                            <div class="ro-slot-main">
                                <span class="ro-slot-when">@s.DateLabel · @s.Shift</span>
                                <span class="ro-slot-bus">@s.VehicleId</span>
                                <span class="ro-slot-why">@s.Reason</span>
                            </div>
                            @if (!Model.ReadOnly)
                            {
                                <div class="ro-slot-actions">
                                    <button type="button" class="ro-btn ro-btn--ghost ro-restore">Restore</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }

    @if (Model.UnroutedBuses.Count > 0)
    {
        <p class="ro-note ro-note--block">
            @(Model.UnroutedBuses.Count == 1 ? "1 bus has" : $"{Model.UnroutedBuses.Count} buses have") no home route
            and cannot be rostered: @string.Join(", ", Model.UnroutedBuses).
            @(Model.UnroutedBuses.Count == 1 ? "Give it a route" : "Give them a route") on the Vehicles page.
        </p>
    }

    @foreach (var route in Model.Routes)
    {
        var floaters = Model.Seats.Where(s => s.Kind == RosterRules.Floater && s.RouteId == route.RouteId).ToList();

        <section class="ro-card ro-route" data-route="@route.RouteId">
            @* Held at the top while the route's own rows are read, and pushed off by the next
               route. Pressing the name folds the route away. *@
            <div class="ro-card-head">
                <h2 class="ro-card-title">
                    <button type="button" class="ro-route-toggle" aria-expanded="true" aria-controls="roRouteBody-@route.RouteId">
                        <span class="ro-chev" aria-hidden="true"></span>
                        @route.RouteName
                    </button>
                </h2>
                @* Crew resting over floaters working, for each day of the week. A red day is a
                   rest day nobody is free to cover, every week. *@
                <div class="ro-strip" id="roStrip-@route.RouteId" aria-label="Rest day cover"></div>
            </div>

            <div class="ro-card-body" id="roRouteBody-@route.RouteId">
            <p class="ro-short" id="roShort-@route.RouteId" hidden></p>

            <div class="ro-section-t">Buses</div>
            @if (route.Buses.Count == 0)
            {
                <p class="ro-empty">No buses are based on this route.</p>
            }

            @foreach (var bus in route.Buses)
            {
                <div class="ro-bus" data-vehicle="@bus.VehicleId">
                    <div class="ro-bus-id">
                        <span class="ro-bus-name">@bus.VehicleId</span>
                        <span class="ro-bus-plate">@bus.PlateNumber</span>
                        @if (bus.Warning is not null)
                        {
                            <span class="ro-bus-warn">@bus.Warning</span>
                        }
                    </div>

                    @foreach (var shift in shifts)
                    {
                        var seat = CrewAt(route.RouteId, bus.VehicleId, shift);
                        var runs = seat is not null;

                        <div class="ro-seat @(seat?.Suggested is null ? "" : "ro-suggested")" data-shift="@shift" data-suggested="@seat?.Suggested"
                             data-marked-driver="@(RosterRules.MarkIsAboutDriver(seat?.Suggested) ? "true" : null)">
                            <div class="ro-seat-head">
                                <label class="ro-runs">
                                    <input type="checkbox" class="ro-runs-box" checked="@runs" disabled="@disabled" />
                                    @shift
                                </label>
                                @if (seat?.Suggested is not null)
                                {
                                    <button type="button" class="ro-why" title="@seat.Suggested" aria-haspopup="dialog" aria-label="Auto-fill: @seat.Suggested">Auto-fill</button>
                                }
                            </div>
                            <select class="ro-input ro-driver" aria-label="@bus.VehicleId @shift driver" hidden="@(!runs)" disabled="@disabled">
                                <option value="">Choose a driver</option>
                                @foreach (var d in Model.Drivers)
                                {
                                    <option value="@d.DriverId" selected="@(seat?.DriverId == d.DriverId)">@d.Label</option>
                                }
                            </select>
                            <select class="ro-input ro-rest" aria-label="@bus.VehicleId @shift rest day" hidden="@(!runs)" disabled="@disabled">
                                <option value="">Rest day</option>
                                @foreach (var day in RosterRules.Weekdays)
                                {
                                    <option value="@day" selected="@(seat?.RestWeekday == day)">Rests @RosterRules.DayName(day)</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            }

            <div class="ro-section-t">Floaters</div>
            <div class="ro-floaters">
                @foreach (var f in floaters)
                {
                    <div class="ro-floater @(f.Suggested is null ? "" : "ro-suggested")" data-suggested="@f.Suggested"
                         data-marked-driver="@(RosterRules.MarkIsAboutDriver(f.Suggested) ? "true" : null)">
                        <select class="ro-input ro-driver" aria-label="Floater" disabled="@disabled">
                            <option value="">Choose a driver</option>
                            @foreach (var d in Model.Drivers)
                            {
                                <option value="@d.DriverId" selected="@(f.DriverId == d.DriverId)">@d.Label</option>
                            }
                        </select>
                        <select class="ro-input ro-home" aria-label="Home shift" disabled="@disabled">
                            @foreach (var shift in shifts)
                            {
                                <option value="@shift" selected="@(f.Shift == shift)">Home shift @shift</option>
                            }
                        </select>
                        <select class="ro-input ro-rest" aria-label="Rest day" disabled="@disabled">
                            <option value="">Rest day</option>
                            @foreach (var day in RosterRules.Weekdays)
                            {
                                <option value="@day" selected="@(f.RestWeekday == day)">Rests @RosterRules.DayName(day)</option>
                            }
                        </select>
                        @if (f.Suggested is not null)
                        {
                            <button type="button" class="ro-why" title="@f.Suggested" aria-haspopup="dialog" aria-label="Auto-fill: @f.Suggested">Auto-fill</button>
                        }
                        @if (!Model.ReadOnly)
                        {
                            <button type="button" class="ro-btn ro-btn--ghost ro-remove">Remove</button>
                        }
                    </div>
                }
            </div>
            @if (!Model.ReadOnly)
            {
                <button type="button" class="ro-btn ro-btn--ghost ro-add-floater">+ Add floater</button>
            }
            </div>
        </section>
    }

    <section class="ro-card">
        <h2 class="ro-card-title">Unplaced drivers</h2>
        @* The shortfall against the people there are to fill it. More drivers short than
           unplaced means the roster cannot be completed from the drivers on the books.
           Pressing a name holds that driver back: auto-fill and the suggestions pass them
           over, while one-off cover and placing them by hand still can. *@
        <p class="ro-short" id="roHeadcount" hidden></p>
        <p class="ro-empty" id="roUnplacedNone" hidden>Every active driver has a place.</p>
        <ul class="ro-unplaced" id="roUnplaced"></ul>
    </section>
</div>

@* A new floater row, with every driver and nothing chosen. *@
<template id="roFloaterTemplate">
    <div class="ro-floater">
        <select class="ro-input ro-driver" aria-label="Floater">
            <option value="">Choose a driver</option>
            @foreach (var d in Model.Drivers.Where(d => d.Active))
            {
                <option value="@d.DriverId">@d.Label</option>
            }
        </select>
        <select class="ro-input ro-home" aria-label="Home shift">
            @foreach (var shift in shifts)
            {
                <option value="@shift">Home shift @shift</option>
            }
        </select>
        <select class="ro-input ro-rest" aria-label="Rest day">
            <option value="">Rest day</option>
            @foreach (var day in RosterRules.Weekdays)
            {
                <option value="@day">Rests @RosterRules.DayName(day)</option>
            }
        </select>
        <button type="button" class="ro-btn ro-btn--ghost ro-remove">Remove</button>
    </div>
</template>

@* What auto-fill and Suggest rest days changed: a line for each marked place, which stays
   marked until the roster is published, then what no place is left to mark, which the page
   keeps only until it reloads.

   Movable, and it does not take the page while it is up, as the Schedule's conflict list
   does. The roster behind it is what the list is about, and a box fixed over the middle of
   it meant reading a line, closing the box to find the place, then opening it again for the
   next line. Pressing a line finds its place. *@
<div class="ro-overlay ro-overlay--free" id="roChangesBox" hidden role="dialog" aria-modal="false" aria-labelledby="roChangesTitle">
    <div class="ro-box ro-box--wide">
        <div class="ro-box-head" title="Drag to move">
            <h3 class="ro-box-title" id="roChangesTitle">Suggested changes</h3>
            @* Says the box can be taken hold of, which a cursor alone does not. *@
            <span class="ro-box-grab" aria-hidden="true">&#8942;&#8942;</span>
        </div>
        <p class="ro-box-desc">Press a line to find its place on the roster. Marked places stay marked until the roster is published, and nothing is saved until you save it.</p>
        <div class="ro-changes-scroll" id="roChangesScroll">
            <ul class="ro-changes" id="roChangesList"></ul>
            <p class="ro-changes-sub" id="roChangesOtherTitle" hidden>Also changed</p>
            <ul class="ro-report" id="roChangesOther" hidden></ul>
            <p class="ro-changes-lost" id="roChangesLost" hidden>What auto-fill took off the roster is not listed once the page has reloaded.</p>
        </div>
        <p class="visually-hidden" id="roChangesLive" aria-live="polite"></p>
        <div class="ro-box-actions ro-box-actions--single">
            <button type="button" class="ro-btn ro-btn--primary" id="roChangesClose">Close</button>
        </div>
    </div>
</div>

<div class="ro-overlay" id="roConfirm" hidden role="dialog" aria-modal="true" aria-labelledby="roConfirmTitle">
    <div class="ro-box">
        <h3 class="ro-box-title" id="roConfirmTitle"></h3>
        <p class="ro-box-desc" id="roConfirmDesc"></p>
        <div class="ro-box-actions">
            <button type="button" class="ro-btn ro-btn--ghost" id="roConfirmNo">Cancel</button>
            <button type="button" class="ro-btn ro-btn--primary" id="roConfirmYes"></button>
        </div>
    </div>
</div>

@* Publishing: what it would write, then what it wrote. *@
<div class="ro-overlay" id="roPublishBox" hidden role="dialog" aria-modal="true" aria-labelledby="roPublishTitle">
    <div class="ro-box ro-box--wide">
        <h3 class="ro-box-title" id="roPublishTitle">Publish @Model.Month.ToString("MMMM")</h3>
        <p class="ro-box-desc" id="roPublishLead">Working out what publishing writes&#8230;</p>
        <ul class="ro-report" id="roPublishLines"></ul>
        <p class="ro-box-error" id="roPublishError" hidden></p>
        <div class="ro-box-actions">
            <button type="button" class="ro-btn ro-btn--ghost" id="roPublishNo">Cancel</button>
            <button type="button" class="ro-btn ro-btn--dark" id="roPublishYes" disabled>Publish</button>
        </div>
    </div>
</div>

@* Filling a gap: the drivers who could take it, ranked. *@
<div class="ro-overlay" id="roFillBox" hidden role="dialog" aria-modal="true" aria-labelledby="roFillTitle">
    <div class="ro-box ro-box--wide">
        <h3 class="ro-box-title" id="roFillTitle">Find a driver</h3>
        <p class="ro-box-desc" id="roFillSlot"></p>
        <p class="ro-fill-wait" id="roFillWait" hidden>Finding who is free&#8230;</p>
        <div class="ro-fill-list" id="roFillList"></div>
        <p class="ro-fill-cost" id="roFillCost" hidden></p>
        <p class="ro-box-error" id="roFillError" hidden></p>
        <div class="ro-box-actions">
            <button type="button" class="ro-btn ro-btn--ghost" id="roFillNo">Cancel</button>
            <button type="button" class="ro-btn ro-btn--ghost" id="roFillSkip" hidden>Bus not running</button>
            <button type="button" class="ro-btn ro-btn--primary" id="roFillYes" disabled>Assign</button>
        </div>
    </div>
</div>

<div class="ro-toast" id="roToast" role="status" hidden></div>

@Html.AntiForgeryToken()

<script src="~/js/candidate-list.js" asp-append-version="true"></script>
<script>
    (function () {
        const page = document.getElementById('roPage');
        const readOnly = page.dataset.readonly === 'true';
        let version = Number(page.dataset.version);
        let dirty = false;
        let checkTimer = null;
        let checkSeq = 0;

        // Drivers held back from auto-fill and the suggestions, saved with the roster.
        const held = new Set((page.dataset.held || '').split(',').filter(Boolean).map(Number));

        function heldList() {
            return Array.from(held);
        }

        // ---- The roster as it stands on the page ------------------------------------

        function numberOrNull(value) {
            return value === '' || value == null ? null : Number(value);
        }

        function readSeats() {
            const seats = [];
            page.querySelectorAll('.ro-card[data-route]').forEach(function (card) {
                const routeId = Number(card.dataset.route);

                card.querySelectorAll('.ro-bus').forEach(function (bus) {
                    bus.querySelectorAll('.ro-seat').forEach(function (seat) {
                        if (!seat.querySelector('.ro-runs-box').checked) return;
                        seats.push({
                            driverId: numberOrNull(seat.querySelector('.ro-driver').value),
                            kind: 'Crew',
                            routeId: routeId,
                            vehicleId: bus.dataset.vehicle,
                            shift: seat.dataset.shift,
                            restWeekday: numberOrNull(seat.querySelector('.ro-rest').value),
                            suggested: seat.dataset.suggested || null,
                            aboutDriver: seat.dataset.markedDriver === 'true'
                        });
                    });
                });

                card.querySelectorAll('.ro-floater').forEach(function (row) {
                    seats.push({
                        driverId: numberOrNull(row.querySelector('.ro-driver').value),
                        kind: 'Floater',
                        routeId: routeId,
                        vehicleId: null,
                        shift: row.querySelector('.ro-home').value,
                        restWeekday: numberOrNull(row.querySelector('.ro-rest').value),
                        suggested: row.dataset.suggested || null,
                        aboutDriver: row.dataset.markedDriver === 'true'
                    });
                });
            });
            return seats;
        }

        // ---- What the server says about it ----------------------------------------------

        function showProblems(problems) {
            const box = document.getElementById('roProblems');
            const list = document.getElementById('roProblemList');
            list.replaceChildren();
            problems.forEach(function (p) {
                const li = document.createElement('li');
                li.textContent = p;
                list.appendChild(li);
            });
            box.hidden = problems.length === 0;
        }

        function showRoute(r) {
            const strip = document.getElementById('roStrip-' + r.routeId);
            if (strip) {
                strip.replaceChildren();
                r.strip.forEach(function (d) {
                    const chip = document.createElement('span');
                    chip.className = 'ro-day' + (d.short ? ' ro-day--short' : '');
                    chip.textContent = d.day + ' ' + d.resting + '/' + d.covering;
                    chip.title = d.dayName + ': ' + d.resting + (d.resting === 1 ? ' crew driver rests, ' : ' crew drivers rest, ')
                        + d.covering + (d.covering === 1 ? ' floater is working' : ' floaters are working')
                        + (d.short ? '. A rest day goes uncovered every week.' : '');
                    strip.appendChild(chip);
                });
            }

            const note = document.getElementById('roShort-' + r.routeId);
            if (note) {
                const parts = [];
                if (r.unfilledSeats > 0)
                    parts.push(r.unfilledSeats === 1 ? '1 bus shift has no driver.'
                        : r.unfilledSeats + ' bus shifts have no driver.');
                // A guide for staffing the route, not a promise the rest days are covered.
                if (r.floatersMissing > 0)
                    parts.push(r.crewSeats + ' bus ' + (r.crewSeats === 1 ? 'shift usually takes ' : 'shifts usually take ')
                        + r.floatersNeeded + ' ' + (r.floatersNeeded === 1 ? 'floater' : 'floaters')
                        + ', and this route has ' + r.floaters + '.');
                // Enough floaters, badly arranged: the case a count of floaters cannot see.
                if (r.restDaysCollide)
                    parts.push('Enough floaters, but the rest days leave ' + uncoveredText(r.uncovered)
                        + ' uncovered every week. Try Suggest rest days.');
                else if (r.gapsPerWeek > 0)
                    parts.push('Every week nobody can cover ' + uncoveredText(r.uncovered) + '.');
                note.textContent = parts.join(' ');
                note.hidden = parts.length === 0;
            }
        }

        // "V001 Morning on Wednesday", for up to three; past that, a count.
        function uncoveredText(list) {
            const items = (list || []).map(function (u) { return u.vehicleId + ' ' + u.shift + ' on ' + u.dayName; });
            if (items.length === 0) return 'a rest day';
            if (items.length > 3) return items.length + ' rest days';
            if (items.length === 1) return items[0];
            return items.slice(0, -1).join(', ') + ' and ' + items[items.length - 1];
        }

        // "Oct 7, 14, 21, 28" rather than the month on every date.
        function dateRun(dates) {
            let month = null;
            return (dates || []).map(function (d) {
                const parts = d.split(' ');
                if (parts[0] === month) return parts[1];
                month = parts[0];
                return d;
            }).join(', ');
        }

        function showWouldLeave(lines) {
            const box = document.getElementById('roWouldLeave');
            const list = document.getElementById('roWouldLeaveList');
            list.replaceChildren();
            (lines || []).forEach(function (g) {
                const li = document.createElement('li');
                li.textContent = g.vehicleId + ' ' + g.shift + (g.routeName ? ', ' + g.routeName : '')
                    + ', ' + dateRun(g.dates) + ': ' + g.reason + '.';
                list.appendChild(li);
            });
            box.hidden = readOnly || (lines || []).length === 0;
        }

        // A held-back driver is crossed out where they stand. Said in words as well, since a
        // line through a name is not read out.
        function paintHeld(chip) {
            const isHeld = held.has(Number(chip.dataset.driver));
            chip.setAttribute('aria-pressed', isHeld ? 'true' : 'false');
            chip.setAttribute('aria-label', chip.dataset.name + (isHeld ? ', held back from auto-fill' : ''));
            chip.title = isHeld
                ? 'Held back: auto-fill and the suggestions pass them over. Press to release.'
                : 'Press to hold back from auto-fill and the suggestions.';
        }

        function showUnplaced(drivers) {
            const list = document.getElementById('roUnplaced');
            list.replaceChildren();

            // A hold on a driver since placed on the roster no longer means anything.
            const unplaced = new Set(drivers.map(function (d) { return d.driverId; }));
            Array.from(held).forEach(function (id) { if (!unplaced.has(id)) held.delete(id); });

            drivers.forEach(function (d) {
                const li = document.createElement('li');
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'ro-unplaced-chip';
                chip.dataset.driver = String(d.driverId);
                chip.dataset.name = d.name;
                chip.textContent = d.name + ' (' + d.driverId + ')';
                chip.disabled = readOnly;
                paintHeld(chip);
                li.appendChild(chip);
                list.appendChild(li);
            });
            document.getElementById('roUnplacedNone').hidden = drivers.length > 0;
        }

        document.getElementById('roUnplaced').addEventListener('click', function (e) {
            const chip = e.target.closest('.ro-unplaced-chip');
            if (!chip || readOnly) return;
            const id = Number(chip.dataset.driver);
            if (held.has(id)) held.delete(id); else held.add(id);
            paintHeld(chip);
            changed();
        });

        async function check() {
            const seq = ++checkSeq;
            try {
                const res = await fetch('/Roster/Check', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ month: page.dataset.month, seats: readSeats(), held: heldList() })
                });
                if (!res.ok || res.redirected) return;
                const said = await res.json();
                // An answer to an older edit is not shown over a newer one.
                if (seq !== checkSeq) return;
                showProblems(said.problems || []);
                (said.routes || []).forEach(showRoute);
                showWouldLeave(said.wouldLeave || []);
                showUnplaced(said.unplaced || []);

                const short = (said.routes || []).reduce(function (n, r) { return n + r.driversShort; }, 0);
                const unplaced = said.unplaced || [];
                const free = unplaced.filter(function (d) { return !held.has(d.driverId); }).length;
                const back = unplaced.length - free;
                const headcount = document.getElementById('roHeadcount');
                headcount.textContent = 'The routes need ' + short + ' more ' + (short === 1 ? 'driver' : 'drivers')
                    + ' and ' + (free === 0 ? 'none are' : free === 1 ? 'only 1 is' : 'only ' + free + ' are') + ' unplaced'
                    + (back > 0 ? ' and not held back.' : '.');
                headcount.hidden = short <= free;
            } catch (e) {
                console.warn('roster check failed', e);
            }
        }

        function changed() {
            countChanges();
            if (readOnly) return;
            dirty = true;
            const note = document.getElementById('roDirty');
            if (note) note.hidden = false;
            clearTimeout(checkTimer);
            checkTimer = setTimeout(check, 350);
        }

        // ---- Editing ----------------------------------------------------------------------

        page.addEventListener('change', function (e) {
            if (e.target.classList.contains('ro-runs-box')) {
                const seat = e.target.closest('.ro-seat');
                seat.querySelectorAll('select').forEach(function (s) { s.hidden = !e.target.checked; });
            }
            // A place a person has changed is theirs, not auto-fill's.
            const place = e.target.closest('.ro-seat, .ro-floater');
            if (place) markSuggested(place, null);
            changed();
        });

        page.addEventListener('click', function (e) {
            const add = e.target.closest('.ro-add-floater');
            if (add) {
                const card = add.closest('.ro-card');
                const row = document.getElementById('roFloaterTemplate').content.firstElementChild.cloneNode(true);
                card.querySelector('.ro-floaters').appendChild(row);
                row.querySelector('.ro-driver').focus();
                changed();
                return;
            }

            const remove = e.target.closest('.ro-remove');
            if (remove) {
                remove.closest('.ro-floater').remove();
                changed();
            }
        });

        window.addEventListener('beforeunload', function (e) {
            if (!dirty) return;
            e.preventDefault();
            e.returnValue = '';
        });

        let toastTimer = null;
        function toast(text) {
            const el = document.getElementById('roToast');
            el.textContent = text;
            el.hidden = false;
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function () { el.hidden = true; }, Math.max(4000, text.length * 60));
        }

        // ---- Auto-fill --------------------------------------------------------------------------

        // Marks a place as auto-fill's, with why, or takes the mark off. aboutDriver says the
        // mark is about who is in the place, not only its rest day, so See changes can offer
        // to empty it.
        function markSuggested(place, text, aboutDriver) {
            let chip = place.querySelector('.ro-why');
            if (!text) {
                delete place.dataset.suggested;
                delete place.dataset.markedDriver;
                place.classList.remove('ro-suggested');
                if (chip) chip.remove();
                return;
            }
            place.dataset.suggested = text;
            if (aboutDriver) place.dataset.markedDriver = 'true';
            else delete place.dataset.markedDriver;
            place.classList.add('ro-suggested');
            if (!chip) {
                chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'ro-why';
                chip.textContent = 'Suggested';
                const head = place.querySelector('.ro-seat-head');
                if (head) head.appendChild(chip);
                else place.insertBefore(chip, place.querySelector('.ro-remove'));
            }
            chip.title = text;
            chip.setAttribute('aria-haspopup', 'dialog');
            chip.setAttribute('aria-label', 'Suggested: ' + text);
        }

        // Sets a list to a value, borrowing the option from a bus's list when this one lacks it:
        // a new floater row lists active drivers only, and undoing may put back one who is not.
        function setSelect(select, value) {
            const v = value == null ? '' : String(value);
            if (v && !Array.prototype.some.call(select.options, function (o) { return o.value === v; })) {
                const donor = page.querySelector('.ro-bus .ro-driver option[value="' + v + '"]');
                if (donor) select.appendChild(donor.cloneNode(true));
            }
            select.value = v;
        }

        // Draws a whole roster onto the page: ticks, drivers, rest days, floater rows and marks.
        // Answers whether every place found somewhere to be drawn.
        function applySeats(seats) {
            let shown = 0;
            page.querySelectorAll('.ro-card[data-route]').forEach(function (card) {
                const routeId = Number(card.dataset.route);

                card.querySelectorAll('.ro-bus').forEach(function (bus) {
                    bus.querySelectorAll('.ro-seat').forEach(function (el) {
                        const s = seats.find(function (x) {
                            return x.kind === 'Crew' && x.routeId === routeId && x.shift === el.dataset.shift
                                && (x.vehicleId || '').toUpperCase() === bus.dataset.vehicle.toUpperCase();
                        });
                        el.querySelector('.ro-runs-box').checked = !!s;
                        el.querySelectorAll('select').forEach(function (sel) { sel.hidden = !s; });
                        setSelect(el.querySelector('.ro-driver'), s ? s.driverId : null);
                        setSelect(el.querySelector('.ro-rest'), s ? s.restWeekday : null);
                        markSuggested(el, s ? s.suggested : null, !!s && s.aboutDriver);
                        if (s) shown++;
                    });
                });

                const list = card.querySelector('.ro-floaters');
                list.replaceChildren();
                seats.filter(function (x) { return x.kind === 'Floater' && x.routeId === routeId; }).forEach(function (s) {
                    const row = document.getElementById('roFloaterTemplate').content.firstElementChild.cloneNode(true);
                    setSelect(row.querySelector('.ro-driver'), s.driverId);
                    row.querySelector('.ro-home').value = s.shift;
                    setSelect(row.querySelector('.ro-rest'), s.restWeekday);
                    list.appendChild(row);
                    markSuggested(row, s.suggested, s.aboutDriver);
                    shown++;
                });
            });
            return shown === seats.length;
        }

        // ---- What auto-fill changed ------------------------------------------------------------
        //
        // Built from the marks on the page each time it opens, so it is right after a reload
        // too. What auto-fill took off the roster has no place left to carry a mark, so it is
        // kept only for as long as the page is.

        const seeChangesBtn = document.getElementById('roSeeChanges');
        const changesBox = document.getElementById('roChangesBox');
        const changesList = document.getElementById('roChangesList');
        const changesLive = document.getElementById('roChangesLive');
        let unmarkedNotes = [];
        let unmarkedKnown = false;      // whether this page has seen what auto-fill took off
        let changeLines = new Map();    // a marked place to its line in the dialog
        let changesOpener = null;

        function make(tag, className, text) {
            const node = document.createElement(tag);
            if (className) node.className = className;
            if (text != null) node.textContent = text;
            return node;
        }

        function markedPlaces() {
            return Array.prototype.slice.call(page.querySelectorAll('.ro-seat.ro-suggested, .ro-floater.ro-suggested'));
        }

        // Keeps what no mark says, from an auto-fill on this page or the Generate before it.
        function keepUnmarked(notes) {
            unmarkedNotes = notes || [];
            unmarkedKnown = true;
            countChanges();
        }

        function countChanges() {
            if (!seeChangesBtn) return;
            const n = markedPlaces().length + unmarkedNotes.length;
            seeChangesBtn.hidden = n === 0;
            document.getElementById('roChangesCount').textContent = n;

            // The list stays open while the roster behind it is edited, so it follows.
            if (!changesBox.hidden) renderChanges();
        }

        function placeLabel(place) {
            if (place.classList.contains('ro-seat')) {
                return place.closest('.ro-bus').dataset.vehicle + ', ' + place.dataset.shift + ' shift';
            }
            const route = place.closest('.ro-card').querySelector('.ro-route-toggle');
            return (route ? route.textContent.trim() + ' ' : '') + 'floater';
        }

        function driverIn(place) {
            const select = place.querySelector('.ro-driver');
            return select && select.value ? select.options[select.selectedIndex].textContent.trim() : '';
        }

        function renderChanges() {
            changesList.replaceChildren();
            changeLines = new Map();

            const places = markedPlaces();
            places.forEach(function (place, i) {
                const line = make('li', 'ro-change');
                line.tabIndex = -1;

                // The line is the way to its place: pressed, the roster behind scrolls to it.
                const main = make('button', 'ro-change-main');
                main.type = 'button';
                main.title = 'Show this place on the roster';
                const where = make('span', 'ro-change-place', placeLabel(place));
                where.id = 'roChangePlace-' + i;
                const driver = driverIn(place);
                main.append(
                    where,
                    make('span', 'ro-change-driver' + (driver ? '' : ' ro-change-driver--none'), driver || 'Empty'),
                    make('span', 'ro-change-why', place.dataset.suggested));
                main.addEventListener('click', function () {
                    if (Date.now() - changesDraggedAt < 250) return;
                    goToPlace(place);
                });
                line.appendChild(main);

                // Only a place auto-fill chose the driver for. A mark that only set a rest day
                // sits on a driver a person chose.
                if (!readOnly && driver && place.dataset.markedDriver === 'true') {
                    const clear = make('button', 'ro-btn ro-btn--ghost ro-change-clear', 'Clear');
                    clear.type = 'button';
                    clear.setAttribute('aria-describedby', where.id);
                    clear.addEventListener('click', function () { clearPlace(place, i); });
                    line.appendChild(clear);
                }

                changesList.appendChild(line);
                changeLines.set(place, line);
            });

            if (!places.length) changesList.appendChild(make('li', 'ro-change ro-change--none', 'No place is marked.'));

            const other = document.getElementById('roChangesOther');
            other.replaceChildren();
            unmarkedNotes.forEach(function (note) { other.appendChild(make('li', null, note)); });
            other.hidden = unmarkedNotes.length === 0;
            document.getElementById('roChangesOtherTitle').hidden = unmarkedNotes.length === 0;
            document.getElementById('roChangesLost').hidden = unmarkedKnown;
        }

        // Empties a place auto-fill chose the driver for, as a person choosing nobody would.
        function clearPlace(place, index) {
            const label = placeLabel(place);
            place.querySelector('.ro-driver').value = '';
            markSuggested(place, null);
            changed();
            renderChanges();
            changesLive.textContent = 'Emptied ' + label + '.';

            // Focus goes to the line that took this one's place, or to Close when none is left.
            const lines = changesList.querySelectorAll('.ro-change[tabindex]');
            const next = lines[Math.min(index, lines.length - 1)];
            (next || document.getElementById('roChangesClose')).focus();
        }

        // Brings a marked place into view and lights it for a moment. Its route is unfolded
        // first if it was folded away, since a place in a closed route cannot be shown.
        function goToPlace(place) {
            // On a phone the list covers the roster, so it steps aside to show the place.
            if (window.matchMedia('(max-width: 599px)').matches) closeChanges();

            const card = place.closest('.ro-card[data-route]');
            if (card && card.classList.contains('ro-route--folded')) {
                setFolded(card, false);
                rememberFolded(foldedRoutes().filter(function (id) { return id !== card.dataset.route; }));
            }

            place.scrollIntoView({ behavior: 'smooth', block: 'center' });
            place.classList.add('ro-found');
            setTimeout(function () { place.classList.remove('ro-found'); }, 2000);
        }

        // Opens the list, at a place's own line when one is given.
        function openChanges(place, opener) {
            changesOpener = opener;
            renderChanges();
            changesBox.hidden = false;

            const line = place ? changeLines.get(place) : null;
            if (line) {
                line.classList.add('ro-change--here');
                line.scrollIntoView({ block: 'nearest' });
                line.focus();
            } else {
                document.getElementById('roChangesScroll').scrollTop = 0;
                document.getElementById('roChangesClose').focus();
            }
        }

        function closeChanges() {
            if (changesBox.hidden) return;
            changesBox.hidden = true;
            changesLive.textContent = '';

            // Back to what opened it, unless a Clear has taken that mark away.
            const back = changesOpener && document.body.contains(changesOpener) ? changesOpener
                : seeChangesBtn && !seeChangesBtn.hidden ? seeChangesBtn : null;
            changesOpener = null;
            if (back) back.focus();
        }

        if (seeChangesBtn) {
            seeChangesBtn.addEventListener('click', function () { openChanges(null, seeChangesBtn); });
        }
        document.getElementById('roChangesClose').addEventListener('click', closeChanges);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeChanges(); });

        /* Dragged, and left wherever it was put, as the Schedule's conflict list is.

           Taken hold of anywhere on the box that is not itself a control: the heading, the
           line under it, the space around the list. Followed on the window rather than by
           capturing the pointer, since capture retargets the click that ends a press onto
           whatever holds it, and a line pressed would stop reaching that line. */
        let changesDraggedAt = 0;

        (function () {
            const box = changesBox.querySelector('.ro-box');
            let x = 0, y = 0, fromX = 0, fromY = 0, holding = false, moved = false, rest = null;

            // Where the box would sit with no offset on it, taken before a drag, because a
            // rect read during one already carries the offset being worked out from it.
            function measure() {
                const r = box.getBoundingClientRect();
                rest = { left: r.left - x, top: r.top - y, w: r.width, h: r.height };
            }

            // Held inside the window. A box dragged past an edge could not be dragged back.
            function place() {
                if (!rest) measure();
                const lowX = 8 - rest.left;
                const highX = window.innerWidth - rest.w - 8 - rest.left;
                const lowY = 8 - rest.top;
                const highY = window.innerHeight - rest.h - 8 - rest.top;
                x = Math.max(lowX, Math.min(x, Math.max(lowX, highX)));
                y = Math.max(lowY, Math.min(y, Math.max(lowY, highY)));
                box.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
            }

            function follow(e) {
                if (!holding) return;
                const toX = e.clientX - fromX;
                const toY = e.clientY - fromY;
                // A few pixels of travel is a hand resting, not a move.
                if (Math.abs(toX - x) + Math.abs(toY - y) > 3) moved = true;
                x = toX;
                y = toY;
                place();
            }

            function drop() {
                if (!holding) return;
                holding = false;
                if (moved) changesDraggedAt = Date.now();
                window.removeEventListener('pointermove', follow);
                window.removeEventListener('pointerup', drop);
                window.removeEventListener('pointercancel', drop);
            }

            box.addEventListener('pointerdown', function (e) {
                // Not on a phone, where the list takes the whole screen and a drag would fight
                // the scroll.
                if (window.matchMedia('(max-width: 599px)').matches) return;
                if (e.button !== 0) return;
                // A button is pressed, not dragged.
                if (e.target.closest('button, a, input, select, textarea')) return;

                holding = true;
                moved = false;
                measure();
                fromX = e.clientX - x;
                fromY = e.clientY - y;

                window.addEventListener('pointermove', follow);
                window.addEventListener('pointerup', drop);
                window.addEventListener('pointercancel', drop);
                e.preventDefault();
            });

            // A window made smaller can leave it outside, so it is pulled back in.
            window.addEventListener('resize', function () {
                if (changesBox.hidden) return;
                measure();
                place();
            });
        })();

        const autoFillBtn = document.getElementById('roAutoFill');
        const undoFillBtn = document.getElementById('roUndoFill');
        let beforeFill = null;
        let beforeUnmarked = null;   // what See changes knew before the fill, for Undo to put back

        if (autoFillBtn) {
            autoFillBtn.addEventListener('click', async function () {
                autoFillBtn.disabled = true;
                try {
                    const before = readSeats();
                    const res = await fetch('/Roster/AutoFill', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ seats: before, held: heldList() })
                    });
                    if (!res.ok || res.redirected) throw new Error();
                    const result = await res.json();

                    if (!result.changed) {
                        toast((result.notes || [])[0] || 'Nothing to change.');
                        return;
                    }

                    if (!applySeats(result.seats || [])) {
                        applySeats(before);
                        toast('Auto-fill moved a place this page cannot show. Reload the page and try again.');
                        return;
                    }

                    beforeFill = before;
                    beforeUnmarked = { notes: unmarkedNotes, known: unmarkedKnown };
                    undoFillBtn.hidden = false;
                    keepUnmarked(result.unmarked);
                    changed();
                    toast('Auto-fill updated the roster. Marked places show its choices; See changes lists them all.');
                } catch (e) {
                    toast('Auto-fill could not run. Try again.');
                } finally {
                    autoFillBtn.disabled = false;
                }
            });

            undoFillBtn.addEventListener('click', function () {
                if (!beforeFill) return;
                applySeats(beforeFill);
                beforeFill = null;
                undoFillBtn.hidden = true;
                unmarkedNotes = beforeUnmarked ? beforeUnmarked.notes : [];
                unmarkedKnown = beforeUnmarked ? beforeUnmarked.known : false;
                beforeUnmarked = null;
                changed();
                toast('Auto-fill undone.');
            });
        }

        // A mark opens See changes at its own place's line. Its tooltip still says why on a desk.
        page.addEventListener('click', function (e) {
            const why = e.target.closest('.ro-why');
            if (!why) return;
            const place = why.closest('.ro-seat, .ro-floater');
            if (place && place.dataset.suggested) openChanges(place, why);
        });

        // ---- Suggest rest days --------------------------------------------------------------

        // Least disruption first: a spare driver as a floater, then the fewest rest days moved,
        // and only then that the route needs another floater. Each change carries a mark, so
        // See changes lists who moved and why.
        async function suggest() {
            try {
                const before = readSeats();
                const res = await fetch('/Roster/Suggest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ seats: before, held: heldList() })
                });
                if (!res.ok || res.redirected) throw new Error();
                const result = await res.json();
                const unmarked = result.unmarked || [];

                // Kept beside what auto-fill left, once each, rather than in its place.
                if (unmarked.length)
                    keepUnmarked(Array.from(new Set(unmarkedNotes.concat(unmarked))));

                if (!result.changed) {
                    toast(unmarked[0] || (result.notes || [])[0] || 'Nothing to change.');
                    return;
                }

                if (!applySeats(result.seats || [])) {
                    applySeats(before);
                    toast('The suggestion moved a place this page cannot show. Reload the page and try again.');
                    return;
                }

                changed();

                const parts = [];
                if (result.added) parts.push(result.added === 1 ? 'added 1 spare driver as a floater' : 'added ' + result.added + ' spare drivers as floaters');
                if (result.moved) parts.push(result.moved === 1 ? 'moved 1 rest day' : 'moved ' + result.moved + ' rest days');
                toast((parts.length ? 'Suggested: ' + parts.join(' and ') + '. ' : 'Rest days set where they were missing. ')
                    + (result.gapsLeft ? 'Some rest days still cannot be covered; See changes says where.'
                                       : 'Marked places show what changed. Look them over, then save.'));
            } catch (e) {
                toast('Rest days could not be suggested. Try again.');
            }
        }

        // ---- Asking first ----------------------------------------------------------------------

        const confirmBox = document.getElementById('roConfirm');
        let answer = null;

        function ask(title, desc, yes) {
            document.getElementById('roConfirmTitle').textContent = title;
            document.getElementById('roConfirmDesc').textContent = desc;
            document.getElementById('roConfirmYes').textContent = yes;
            confirmBox.hidden = false;
            return new Promise(function (resolve) { answer = resolve; });
        }

        function answered(value) {
            confirmBox.hidden = true;
            if (answer) { const a = answer; answer = null; a(value); }
        }

        document.getElementById('roConfirmNo').addEventListener('click', function () { answered(false); });
        document.getElementById('roConfirmYes').addEventListener('click', function () { answered(true); });
        confirmBox.addEventListener('click', function (e) { if (e.target === confirmBox) answered(false); });

        const suggestBtn = document.getElementById('roSuggest');
        if (suggestBtn) {
            suggestBtn.addEventListener('click', async function () {
                const anyChosen = readSeats().some(function (s) { return s.restWeekday != null; });
                if (anyChosen && !await ask('Suggest rest days',
                        'Rest days and floaters\' home shifts already chosen will be replaced with suggestions. '
                        + 'Nothing is saved until you save the roster.', 'Suggest')) return;
                suggest();
            });
        }

        // ---- Talking to the server --------------------------------------------------------------

        function post(url, body) {
            return fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(body)
            });
        }

        // A refusal answers with a sentence, a list of problems or a message; a crash answers
        // with a page of HTML, which is no use in a dialog.
        async function said(res, fallback) {
            const text = (await res.text() || '').trim();
            if (!text || text[0] === '<') return [fallback];
            try {
                const json = JSON.parse(text);
                if (Array.isArray(json.problems)) return json.problems;
                if (json.message) return [json.message];
                if (json.conflict) return [json.conflict];
                if (typeof json === 'string') return [json];
            } catch (e) {
                if (text.length < 300) return [text];
            }
            return [fallback];
        }

        function showMoved(message) {
            document.getElementById('roMovedText').textContent = message;
            document.getElementById('roMoved').hidden = false;
        }

        function reload() {
            dirty = false;
            location.reload();
        }

        // ---- Generate from the month before ------------------------------------------------------

        const generateBtn = document.getElementById('roGenerate');
        if (generateBtn) {
            generateBtn.addEventListener('click', async function () {
                if (dirty) { toast('Save or discard your changes first.'); return; }

                const previous = generateBtn.dataset.previous;
                if (readSeats().some(function (s) { return s.driverId != null; })
                    && !await ask('Generate from ' + previous,
                        'The roster on this page is replaced with ' + previous + '\'s, every shift rotated one step '
                        + 'backward, then auto-filled: drivers no longer active and buses no longer running come off, '
                        + 'and empty places are filled for you to review. Nothing is published.', 'Generate')) return;

                generateBtn.disabled = true;
                try {
                    const res = await post('/Roster/Generate', { month: page.dataset.month, version: version });
                    if (res.status === 409) { showMoved((await said(res, ''))[0]); return; }
                    if (!res.ok || res.redirected) { toast((await said(res, 'The roster could not be generated.'))[0]); return; }
                    try {
                        sessionStorage.setItem('roFillUnmarked:' + page.dataset.month, JSON.stringify((await res.json()).unmarked || []));
                    } catch (e) { /* the marks on the page still say what changed */ }
                    reload();
                } catch (e) {
                    toast('The roster could not be generated. Try again.');
                } finally {
                    generateBtn.disabled = false;
                }
            });
        }

        // ---- Publish --------------------------------------------------------------------------------

        const publishBtn = document.getElementById('roPublish');
        const publishBox = document.getElementById('roPublishBox');
        const publishYes = document.getElementById('roPublishYes');
        const publishNo = document.getElementById('roPublishNo');
        const publishLead = document.getElementById('roPublishLead');
        const publishLines = document.getElementById('roPublishLines');
        const publishError = document.getElementById('roPublishError');
        let published = false;

        function listInto(el, lines) {
            el.replaceChildren();
            lines.forEach(function (line) {
                const li = document.createElement('li');
                li.textContent = line;
                el.appendChild(li);
            });
        }

        function publishFailed(lines) {
            publishError.replaceChildren();
            lines.forEach(function (line) {
                const div = document.createElement('div');
                div.textContent = line;
                publishError.appendChild(div);
            });
            publishError.hidden = false;
        }

        if (publishBtn) {
            publishBtn.addEventListener('click', async function () {
                if (dirty) { toast('Save the roster before publishing it.'); return; }

                published = false;
                publishLead.textContent = 'Working out what publishing writes…';
                publishLines.replaceChildren();
                publishError.hidden = true;
                publishYes.textContent = 'Publish';
                publishYes.disabled = true;
                publishNo.hidden = false;
                publishBox.hidden = false;

                try {
                    const res = await post('/Roster/Preview', { month: page.dataset.month, version: version });
                    if (res.status === 409) { publishBox.hidden = true; showMoved((await said(res, ''))[0]); return; }
                    if (!res.ok || res.redirected) {
                        publishLead.textContent = 'This roster cannot be published yet.';
                        publishFailed(await said(res, 'The plan could not be worked out. Try again.'));
                        return;
                    }
                    listInto(publishLines, (await res.json()).lines || []);
                    publishLead.textContent = 'Publishing writes the month\'s trips from the saved roster:';
                    publishYes.disabled = false;
                } catch (e) {
                    publishFailed(['The plan could not be worked out. Try again.']);
                }
            });

            publishNo.addEventListener('click', function () { publishBox.hidden = true; });

            publishYes.addEventListener('click', async function () {
                if (published) { reload(); return; }

                publishYes.disabled = true;
                publishError.hidden = true;
                try {
                    const res = await post('/Roster/Publish', { month: page.dataset.month, version: version });
                    if (!res.ok || res.redirected) {
                        publishFailed(await said(res, 'The roster could not be published. Try again.'));
                        publishYes.disabled = false;
                        return;
                    }

                    const result = await res.json();
                    version = result.version;
                    published = true;
                    publishLead.textContent = 'Published.';
                    listInto(publishLines, result.lines || []);
                    publishNo.hidden = true;
                    publishYes.textContent = 'Done';
                    publishYes.disabled = false;
                } catch (e) {
                    publishFailed(['The roster could not be published. Try again.']);
                    publishYes.disabled = false;
                }
            });
        }

        // ---- Unfilled and skipped slots ----------------------------------------------------------------

        function slotOf(button) {
            const li = button.closest('.ro-slot');
            return { date: li.dataset.date, vehicleId: li.dataset.vehicle, shift: li.dataset.shift, label: li.dataset.label };
        }

        const fillBox = document.getElementById('roFillBox');
        const fillList = document.getElementById('roFillList');
        const fillWait = document.getElementById('roFillWait');
        const fillYes = document.getElementById('roFillYes');
        const fillSkip = document.getElementById('roFillSkip');
        const fillCost = document.getElementById('roFillCost');
        const fillError = document.getElementById('roFillError');
        let filling = null;   // { slot, override, candidates, list, opener }

        // The drivers who could take a gap, on the same ranked list as every other screen. The
        // rules' best match is chosen when it costs nothing. A driver with a cost is chosen by
        // hand, and the cost is said again beside the button.
        async function openFill(slot, opener) {
            const current = { slot: slot, override: false, candidates: [], list: null, opener: opener };
            filling = current;

            document.getElementById('roFillSlot').textContent = slot.label;
            fillList.replaceChildren();
            fillWait.hidden = false;
            fillCost.hidden = true;
            fillError.hidden = true;
            fillSkip.hidden = true;
            fillYes.hidden = false;
            fillYes.textContent = 'Assign';
            fillYes.disabled = true;
            fillBox.hidden = false;
            document.getElementById('roFillNo').focus();

            try {
                const q = new URLSearchParams({ date: slot.date, vehicleId: slot.vehicleId, shift: slot.shift });
                const res = await fetch('/Roster/GapCandidates?' + q.toString());
                if (!res.ok || res.redirected) throw new Error();
                const data = await res.json();
                if (filling !== current) return;

                const candidates = data.candidates || [];
                const best = candidates[0] && candidates[0].tier <= RsCandidateList.NO_COST_TIER ? candidates[0] : null;

                fillWait.hidden = true;
                current.candidates = candidates;
                current.list = RsCandidateList.create(fillList, {
                    kind: 'driver',
                    label: 'Driver for ' + slot.label,
                    items: candidates.map(function (c) {
                        return {
                            id: c.driverId, name: c.name, tier: c.tier, rank: c.rank,
                            warning: c.warning, reason: c.reason, facts: c.facts
                        };
                    }),
                    selected: best ? best.driverId : null,
                    shortfall: data.shortfall,
                    limit: 3,
                    onChange: function (id) { fillPicked(Number(id)); }
                });

                // Nobody at all: what is left to do with the slot is say the bus is not running.
                if (!candidates.length) {
                    fillYes.hidden = true;
                    fillSkip.hidden = false;
                    fillSkip.focus();
                    return;
                }

                fillYes.disabled = !best;
                current.list.focus();
            } catch (e) {
                if (filling !== current) return;
                fillWait.hidden = true;
                fillError.textContent = 'The drivers could not be listed. Try again.';
                fillError.hidden = false;
            }
        }

        function fillPicked(driverId) {
            if (!filling) return;
            filling.override = false;
            fillYes.textContent = 'Assign';
            fillYes.disabled = false;
            fillError.hidden = true;

            const c = filling.candidates.find(function (x) { return x.driverId === driverId; });
            const cost = c && c.tier > RsCandidateList.NO_COST_TIER ? c.warning : null;
            fillCost.replaceChildren();
            if (cost) {
                const icon = document.createElement('i');
                icon.className = 'ti ti-alert-triangle';
                icon.setAttribute('aria-hidden', 'true');
                const text = document.createElement('span');
                text.textContent = c.name + ': ' + cost + '.';
                fillCost.append(icon, text);
            }
            fillCost.hidden = !cost;
        }

        function closeFill() {
            if (fillBox.hidden) return;
            const opener = filling && filling.opener;
            fillBox.hidden = true;
            filling = null;
            if (opener && document.body.contains(opener)) opener.focus();
        }

        document.getElementById('roFillNo').addEventListener('click', closeFill);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeFill(); });

        fillSkip.addEventListener('click', function () {
            const slot = filling && filling.slot;
            closeFill();
            if (slot) markNotRunning(slot);
        });

        fillYes.addEventListener('click', async function () {
            const current = filling;
            const pick = current && current.list ? current.list.value() : '';
            if (!pick) return;

            fillYes.disabled = true;
            try {
                const res = await post('/Roster/FillGap', {
                    date: current.slot.date, vehicleId: current.slot.vehicleId, shift: current.slot.shift,
                    driverId: Number(pick), override: current.override
                });

                // A clash the dispatcher may assign past, the same as everywhere else.
                if (res.status === 409) {
                    fillError.textContent = (await said(res, 'This clashes with the schedule.'))[0] + ' Assign anyway?';
                    fillError.hidden = false;
                    current.override = true;
                    fillYes.textContent = 'Assign anyway';
                    fillYes.disabled = false;
                    return;
                }
                if (!res.ok || res.redirected) {
                    fillError.textContent = (await said(res, 'The driver could not be assigned. Try again.'))[0];
                    fillError.hidden = false;
                    fillYes.disabled = false;
                    return;
                }
                reload();
            } catch (e) {
                fillError.textContent = 'The driver could not be assigned. Try again.';
                fillError.hidden = false;
                fillYes.disabled = false;
            }
        });

        async function markNotRunning(slot) {
            if (!await ask('Bus not running', slot.label + ' is kept empty, and no publish fills it. '
                    + 'It can be restored from the skipped slots.', 'Mark not running')) return;
            const res = await post('/Roster/SkipGap', slot);
            if (res.ok && !res.redirected) reload();
            else toast((await said(res, 'That could not be saved. Try again.'))[0]);
        }

        page.addEventListener('click', async function (e) {
            const fill = e.target.closest('.ro-fill');
            if (fill) { openFill(slotOf(fill), fill); return; }

            const notRunning = e.target.closest('.ro-notrunning');
            if (notRunning) {
                markNotRunning(slotOf(notRunning));
                return;
            }

            const restore = e.target.closest('.ro-restore');
            if (restore) {
                const res = await post('/Roster/RestoreSkip', slotOf(restore));
                if (res.ok && !res.redirected) reload();
                else toast((await said(res, 'That could not be restored. Try again.'))[0]);
            }
        });

        // ---- Save -------------------------------------------------------------------------------

        const saveBtn = document.getElementById('roSave');
        if (saveBtn) {
            saveBtn.addEventListener('click', async function () {
                saveBtn.disabled = true;
                try {
                    const res = await fetch('/Roster/Save', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken':
                                document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ month: page.dataset.month, version: version, seats: readSeats(), held: heldList() })
                    });

                    if (res.status === 409) {
                        const said = await res.json();
                        document.getElementById('roMovedText').textContent = said.message;
                        document.getElementById('roMoved').hidden = false;
                        return;
                    }

                    if (res.status === 400) {
                        const said = await res.json().catch(function () { return {}; });
                        showProblems(said.problems || ['The roster could not be saved.']);
                        document.getElementById('roProblems').scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }

                    if (!res.ok || res.redirected) throw new Error();

                    const saved = await res.json();
                    version = saved.version;
                    dirty = false;
                    document.getElementById('roDirty').hidden = true;
                    document.getElementById('roSaved').textContent = saved.savedLine;
                    beforeFill = null;
                    if (undoFillBtn) undoFillBtn.hidden = true;
                    if (publishBtn) publishBtn.hidden = false;
                    if (page.dataset.status === 'Published') document.getElementById('roUnpublished').hidden = false;
                    toast('Roster saved.');
                } catch (e) {
                    toast('The roster could not be saved. Try again.');
                } finally {
                    saveBtn.disabled = false;
                }
            });
        }

        // ---- Folding a route away --------------------------------------------------------------

        // Which routes are folded, remembered in this browser only.
        const foldKey = 'roFoldedRoutes';

        function foldedRoutes() {
            try { return JSON.parse(localStorage.getItem(foldKey) || '[]'); } catch (e) { return []; }
        }

        function rememberFolded(list) {
            try { localStorage.setItem(foldKey, JSON.stringify(list)); } catch (e) { /* kept for this visit only */ }
        }

        function setFolded(card, folded) {
            card.classList.toggle('ro-route--folded', folded);
            card.querySelector('.ro-route-toggle').setAttribute('aria-expanded', folded ? 'false' : 'true');
            card.querySelector('.ro-card-body').hidden = folded;
        }

        const startFolded = foldedRoutes();
        page.querySelectorAll('.ro-card[data-route]').forEach(function (card) {
            if (startFolded.indexOf(card.dataset.route) !== -1) setFolded(card, true);
        });

        page.addEventListener('click', function (e) {
            const toggle = e.target.closest('.ro-route-toggle');
            if (!toggle) return;

            const card = toggle.closest('.ro-card');
            const fold = !card.classList.contains('ro-route--folded');
            setFolded(card, fold);

            const list = foldedRoutes().filter(function (id) { return id !== card.dataset.route; });
            if (fold) list.push(card.dataset.route);
            rememberFolded(list);

            // Folded while its heading was held at the top, the route would be left above the
            // screen. It is brought back to rest where its heading was held.
            if (fold) {
                const heldAt = parseFloat(getComputedStyle(card.querySelector('.ro-card-head')).top) || 0;
                const top = card.getBoundingClientRect().top;
                if (top < heldAt) window.scrollBy({ top: top - heldAt, behavior: 'instant' });
            }
        });

        // What Generate's auto-fill took off, carried across the reload that shows its result.
        try {
            const key = 'roFillUnmarked:' + page.dataset.month;
            const carried = sessionStorage.getItem(key);
            if (carried) {
                sessionStorage.removeItem(key);
                keepUnmarked(JSON.parse(carried));
            }
        } catch (e) { /* nothing carried */ }
        countChanges();

        check();
    })();
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/roster.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/candidates.css" asp-append-version="true" />
}
