@* Views/Dispatch/_AddTripModal.cshtml *@

<div id="addTripModal" data-dialog-close="closeAddTripModal" class="atm-overlay" role="dialog" aria-modal="true" style="display:none;">
    <div class="atm-dialog">

        @* Header *@
        <div class="atm-header">
            <h2 class="atm-title">Add New Trip</h2>
            <button class="atm-close" onclick="closeAddTripModal()">&times;</button>
        </div>

        @* Body *@
        <div class="atm-body">

            @* Trip Information *@
            <div class="atm-section-label">Trip Information</div>
            <div class="atm-section">
                <div class="atm-field">
                    <label class="atm-label" for="atm-shift-type">Shift Type</label>
                    <div class="atm-select-wrap">
                        <select id="atm-shift-type" class="atm-select" onchange="onShiftChange()">
                            <option value="">Select shift type…</option>
                            <option value="Morning">Morning Shift</option>
                            <option value="Afternoon">Afternoon Shift</option>
                            <option value="Evening">Evening Shift</option>
                        </select>
                    </div>
                </div>
                <div class="atm-field">
                    <label class="atm-label" for="atm-shift-time">Shift Time</label>
                    <div class="atm-select-wrap">
                        <select id="atm-shift-time" class="atm-select" disabled>
                            <option value="">Select shift type first…</option>
                        </select>
                    </div>
                </div>
                <div class="atm-field">
                    <label class="atm-label" for="atm-route">Route</label>
                    <div class="atm-select-wrap">
                        <select id="atm-route" class="atm-select">
                            <option value="">Loading routes…</option>
                        </select>
                    </div>
                </div>
            </div>

            @* Vehicle Details *@
            <div class="atm-section-label">Vehicle Details</div>
            <div class="atm-section">
                <div class="atm-field">
                    <label class="atm-label" for="atm-vehicle-id">Vehicle ID</label>
                    <div class="atm-select-wrap">
                        <select id="atm-vehicle-id" class="atm-select">
                            <option value="">Select shift first…</option>
                        </select>
                    </div>
                    <span class="atm-hint" id="atm-vehicle-hint"></span>
                </div>
            </div>

            @* Driver Details *@
            <div class="atm-section-label">Driver Details</div>
            <div class="atm-section atm-section--last">
                <div class="atm-field">
                    <label class="atm-label" for="atm-driver">Driver Name</label>
                    <div class="atm-select-wrap">
                        <select id="atm-driver" class="atm-select rs-id-list">
                            <option value="">Select shift first…</option>
                        </select>
                    </div>
                    <span class="atm-hint" id="atm-driver-hint"></span>
                </div>
            </div>

        </div>

        @* Footer *@
        <div class="atm-footer">
            <button class="atm-btn-cancel" onclick="closeAddTripModal()">Cancel</button>
            <button class="atm-btn-create" id="atm-create-btn" onclick="submitAddTrip()">
                <span id="atm-create-label">Create Trip</span>
                <span id="atm-create-spinner" style="display:none;">
                    <svg class="atm-spin" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                         stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                    </svg>
                    Creating…
                </span>
            </button>
        </div>

    </div>
</div>

@* Override confirmation (step 2): shown when CreateTrip reports an overridable conflict *@
<div id="atm-override-modal" class="atm-overlay" style="display:none; z-index:1100;">
    <div class="atm-dialog" style="max-width:430px;">
        <div class="atm-header">
            <h2 class="atm-title">Override schedule conflict?</h2>
            <button class="atm-close" onclick="atmCancelOverride()">&times;</button>
        </div>
        <div class="atm-section atm-section--last" style="gap:10px;">
            <div id="atm-override-msg" class="atm-override-msg"></div>
            <p style="margin:0; font-size:0.88rem; color:#4A5568;">
                Create this trip anyway? This double-books against the rule above.
            </p>
        </div>
        <div class="atm-footer">
            <button class="atm-btn-cancel" onclick="atmCancelOverride()">Cancel</button>
            <button class="atm-btn-create atm-btn-override" onclick="atmConfirmOverride()">Yes, override</button>
        </div>
    </div>
</div>


<script>
    // Shift time map.
    const SHIFT_TIMES = {
        'Morning':   { label: '6:00 AM – 2:00 PM',   start: '06:00', end: '14:00' },
        'Afternoon': { label: '2:00 PM – 10:00 PM',  start: '14:00', end: '22:00' },
        'Evening':   { label: '10:00 PM – 6:00 AM',  start: '22:00', end: '06:00' },
    };

    // State.
    let _atmOptions = null;   // full options fetched once
    let _atmShift   = null;   // currently selected shift type

    // Open / Close.
    async function openAddTripModal() {
        document.getElementById('addTripModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
        resetAddTripModal();
        await fetchAddTripOptions();
    }

    function closeAddTripModal() {
        document.getElementById('addTripModal').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.getElementById('addTripModal').addEventListener('click', function(e) {
        if (e.target === this) closeAddTripModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && document.getElementById('addTripModal').style.display === 'flex')
            closeAddTripModal();
    });

    // Reset.
    function resetAddTripModal() {
        document.getElementById('atm-shift-type').value = '';
        setShiftTimeOptions([]);
        document.getElementById('atm-shift-time').disabled = true;
        document.getElementById('atm-route').innerHTML = '<option value="">Loading…</option>';
        setVehicleOptions([]);
        setDriverOptions([]);
        hideHint('atm-vehicle-hint');
        hideHint('atm-driver-hint');
        _atmShift = null;
    }

    // Fetch options once.
    async function fetchAddTripOptions() {
        try {
            const res = await fetch('/Dispatch/GetAddTripOptions');
            _atmOptions = await res.json();

            // Populate routes
            const routeSel = document.getElementById('atm-route');
            routeSel.innerHTML = '<option value="">Select a route…</option>';
            _atmOptions.routes.forEach(r => {
                const o = document.createElement('option');
                o.value = r.routeId;
                o.textContent = r.routeName;
                routeSel.appendChild(o);
            });
        } catch {
            document.getElementById('atm-route').innerHTML = '<option value="">Failed to load</option>';
        }
    }

    // Shift type change.
    function onShiftChange() {
        _atmShift = document.getElementById('atm-shift-type').value;
        const timeSel = document.getElementById('atm-shift-time');

        if (!_atmShift) {
            setShiftTimeOptions([]);
            timeSel.disabled = true;
            setVehicleOptions([]);
            setDriverOptions([]);
            return;
        }

        const t = SHIFT_TIMES[_atmShift];
        setShiftTimeOptions(t ? [{ label: t.label, start: t.start, end: t.end }] : []);
        timeSel.disabled = false;
        refreshVehicles();
        refreshDrivers();
    }

    function setShiftTimeOptions(times) {
        const sel = document.getElementById('atm-shift-time');
        sel.innerHTML = times.length === 0
            ? '<option value="">Select shift type first…</option>'
            : times.map(t => `<option value="${t.start}|${t.end}">${t.label}</option>`).join('');
    }

   

    // Populate vehicles: exclude those already booked for this shift.
    function refreshVehicles() {
        if (!_atmOptions || !_atmShift) {
            setVehicleOptions([]);
            return;
        }

           const available = _atmOptions.vehicles.filter(v =>
        !v.bookedShifts.includes(_atmShift)
    );

        setVehicleOptions(available);

        const hint = document.getElementById('atm-vehicle-hint');
        if (available.length === 0) {
            hint.textContent = 'No vehicles available for this shift.';
            hint.classList.add('atm-hint--visible');
        } else {
            hint.classList.remove('atm-hint--visible');
        }
    }

    function setVehicleOptions(vehicles) {
        const sel = document.getElementById('atm-vehicle-id');
        if (vehicles.length === 0) {
            sel.innerHTML = _atmShift
                ? '<option value="">No vehicles available</option>'
                : '<option value="">Select shift first…</option>';
            return;
        }
        atmFillSelect(sel, 'Select a vehicle…',
            vehicles.map(v => ({ value: v.vehicleId, label: v.vehicleId + ' | ' + v.plateNumber })));
    }

    // Options are built as elements with textContent, never glued together as HTML.
    // Plate numbers and driver names are typed by admins and come straight from the
    // database, so with innerHTML a name like `<img src=x onerror=...>` ran in the
    // session of whoever opened this modal next.
    function atmFillSelect(sel, placeholder, items, selectedId) {
        sel.replaceChildren();
        const blank = document.createElement('option');
        blank.value = '';
        blank.textContent = placeholder;
        sel.appendChild(blank);
        (items || []).forEach(function (it) {
            const opt = document.createElement('option');
            opt.value = it.value;
            opt.textContent = it.label;
            if (selectedId != null && it.value == selectedId) opt.selected = true;
            sel.appendChild(opt);
        });
    }


    // Populate drivers: exclude those already booked for this shift.
    function refreshDrivers() {
        if (!_atmOptions || !_atmShift) {
            setDriverOptions([]);
            return;
        }

        const available = _atmOptions.drivers.filter(d =>
            !d.bookedShifts.includes(_atmShift)
        );

        setDriverOptions(available);

        const hint = document.getElementById('atm-driver-hint');
        if (available.length === 0) {
            hint.textContent = 'No drivers available for this shift.';
            hint.classList.add('atm-hint--visible');
        } else {
            hint.classList.remove('atm-hint--visible');
        }
    }

    function setDriverOptions(drivers) {
        const sel = document.getElementById('atm-driver');
        if (drivers.length === 0) {
            sel.innerHTML = _atmShift
                ? '<option value="">No drivers available</option>'
                : '<option value="">Select shift first…</option>';
            return;
        }
        // Two drivers can share a name, so the identifier travels with it, in a
        // column of its own so the numbers can be read down the list.
        const atmLabels = rsIdLabels(drivers.map(d => ({ name: d.driverName, id: d.driverId })));

        // One who cannot be booked is listed and marked, not dropped. A name simply
        // missing reads as resigned, and sends the dispatcher hunting for somebody who is
        // standing in front of them. The reason travels with the name so it is read
        // before the choice, and the free ones come first.
        const marked = drivers
            .map((d, i) => ({
                value: d.driverId,
                label: atmLabels[i] + (d.unavailable ? '  (' + d.unavailable + ')' : ''),
                free: d.offered !== false
            }))
            .sort((a, b) => (a.free === b.free) ? 0 : (a.free ? -1 : 1));

        atmFillSelect(sel, 'Select a driver…', marked);
    }

    function hideHint(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('atm-hint--visible');
    }

    // Submit.
    // Holds the payload of an attempt blocked by an overridable conflict, so the
    // override confirmation can re-send it with override:true.
    let _atmPending = null;

    async function submitAddTrip(force) {
        const shiftType  = document.getElementById('atm-shift-type').value;
        const shiftTime  = document.getElementById('atm-shift-time').value;   // "HH:mm|HH:mm"
        const routeId    = parseInt(document.getElementById('atm-route').value);
        const vehicleId  = document.getElementById('atm-vehicle-id').value;
        const driverId   = parseInt(document.getElementById('atm-driver').value);

        if (!shiftType || !shiftTime || !routeId || !vehicleId || !driverId) {
            dpShowMsg(['Please fill in all fields before creating the trip.'], 'Incomplete trip');
            return;
        }

        const [startTime, endTime] = shiftTime.split('|');
        const payload = { shiftType, shiftStartTime: startTime, shiftEndTime: endTime, routeId, vehicleId, driverId, override: !!force };

        const btn = document.getElementById('atm-create-btn');
        btn.disabled = true;
        document.getElementById('atm-create-label').style.display  = 'none';
        document.getElementById('atm-create-spinner').style.display = 'inline-flex';

        try {
            const res = await fetch('/Dispatch/CreateTrip', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            // 409 = overridable schedule conflict -> let the dispatcher confirm + force.
            if (res.status === 409) {
                const data = await res.json().catch(() => ({}));
                _atmPending = payload;
                showAtmOverride(data.conflict || 'This assignment conflicts with an existing booking.');
                return;
            }

            if (!res.ok) {
                closeAddTripModal();
                dpShowMsg([await res.text() || 'Failed to create trip.']);
                return;
            }

            closeAddTripModal();
            window.location.reload();
        } catch (err) {
            dpShowMsg(['Failed to create trip. ' + err.message]);
        } finally {
            btn.disabled = false;
            document.getElementById('atm-create-label').style.display  = 'inline';
            document.getElementById('atm-create-spinner').style.display = 'none';
        }
    }

    // Override confirmation (step 2).
    function showAtmOverride(message) {
        document.getElementById('atm-override-msg').textContent = message;
        document.getElementById('atm-override-modal').style.display = 'flex';
    }

    function atmCancelOverride() {
        document.getElementById('atm-override-modal').style.display = 'none';
        _atmPending = null;   // dispatcher backed out -> drop the blocked attempt
    }

    function atmConfirmOverride() {
        document.getElementById('atm-override-modal').style.display = 'none';
        if (!_atmPending) return;
        _atmPending = null;
        submitAddTrip(true);   // re-send with override:true (skips the conflict gate)
    }
</script>
