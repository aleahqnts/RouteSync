@model FleetWise.ViewModels.DispatchViewModel
@{
    ViewData["Title"] = "Dispatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* PAGE TITLE *@
<div class="dp-title-row">
    <h2 class="rp-title">Dispatch</h2>
    <div class="dp-date-nav">
        <a class="dp-date-arrow" href="@Url.Action("Index", new { date = Model.PrevDate })" title="Previous day">
            <i class="ti ti-chevron-left"></i>
        </a>
        @* The badge is the way to any other day. A field laid over it opens the
           calendar wherever it is pressed, so the date already on screen is what is
           pressed to change it and nothing new is added to the row. *@
        <span class="dp-date-badge" title="One operational day runs 6:00 AM to 5:59 AM the next morning. Press to go to another day.">
            <i class="ti ti-calendar-event"></i>
            <span class="dp-cycle-main">@Model.ScheduleDate.ToString("ddd, MMM d")</span>
            <span class="dp-cycle-range">6:00 AM → @Model.ScheduleDate.AddDays(1).ToString("MMM d") 5:59 AM</span>
            <input type="date" class="dp-date-pick" id="dpDatePick"
                   value="@(Model.ScheduleDate.ToString("yyyy-MM-dd"))"
                   aria-label="Go to another day" />
        </span>
        <a class="dp-date-arrow" href="@Url.Action("Index", new { date = Model.NextDate })" title="Next day">
            <i class="ti ti-chevron-right"></i>
        </a>
        @if (!Model.IsToday)
        {
            <a class="dp-date-today" href="@Url.Action("Index")">Today</a>
        }
    </div>
</div>

@* STAT CARDS *@
<div class="dp-stat-grid" id="dpStats">

    <div class="rp-stat-card">
        <div class="rp-stat-header">
            <span class="rp-stat-icon rp-stat-icon--green">
                <i class="ti ti-bus"></i>
            </span>
            <span class="rp-stat-label">Active Trips</span>
        </div>
        <div class="rp-stat-value">@Model.ActiveTrips</div>
        <div class="rp-stat-sub">Today</div>
    </div>

    <div class="rp-stat-card">
        <div class="rp-stat-header">
            <span class="rp-stat-icon rp-stat-icon--amber">
                <i class="ti ti-clock-pause"></i>
            </span>
            <span class="rp-stat-label">Trips Not Started</span>
        </div>
        <div class="rp-stat-value">@Model.TripsNotStarted</div>
        <div class="rp-stat-sub">Awaiting departure</div>
    </div>

    <div class="rp-stat-card @(Model.UnassignedTrips > 0 ? "dp-card-click" : "")"
         @(Model.UnassignedTrips > 0 ? "onclick=dpHighlightIssues()" : "")>
        <div class="rp-stat-header">
            <span class="rp-stat-icon rp-stat-icon--red">
                <i class="ti ti-alert-circle"></i>
            </span>
            <span class="rp-stat-label">Assignment Issues</span>
        </div>
        <div class="rp-stat-value">@Model.UnassignedTrips</div>
        <div class="rp-stat-sub">@(Model.UnassignedTrips > 0 ? "Tap to view affected trips" : "Bus out of service or driver cannot drive")</div>
    </div>

    <div class="rp-stat-card dp-side-card">
        <div class="dp-side-row">
            <a class="dp-side-link" href="/Vehicles?status=Flagged" title="Buses on today's trips that carry an open fault">
                <div class="rp-stat-label">Flagged Vehicles</div>
                <div class="rp-stat-value dp-side-value--red">@Model.FlaggedVehicles</div>
                @if (Model.FlaggedVehicles > 0)
                {
                    <div class="dp-side-view">View &#8250;</div>
                }
            </a>
            <div>
                <div class="rp-stat-label">Unable to Drive</div>
                <div class="rp-stat-value dp-side-value--red">@Model.UnavailableDrivers</div>
            </div>
        </div>
    </div>

</div>

@* Phone only: this block holds at the top of the page while the trips scroll. *@
<div class="dp-sticky-head" id="dpStickyHead">

@* STATUS CHIPS. Phone only: the stat cards above carry these counts on a desk. *@
<div class="dp-chips" id="dpChips" role="group" aria-label="Filter trips by status">
    <button type="button" class="dp-chip dp-chip--on" data-chip="">All <span class="dp-chip-n"></span></button>
    <button type="button" class="dp-chip" data-chip="Assignment Issue">Issues <span class="dp-chip-n"></span></button>
    <button type="button" class="dp-chip" data-chip="Missed">Missed <span class="dp-chip-n"></span></button>
    <button type="button" class="dp-chip" data-chip="Active">Active <span class="dp-chip-n"></span></button>
</div>

@* TOOLBAR *@
<div class="dp-toolbar">
    <button class="dp-btn-primary" onclick="openAddTripModal()">
        <i class="ti ti-plus"></i> Add Trip
    </button>
    <button class="dp-btn-secondary" onclick="openBroadcastModal()"><i class="ti ti-speakerphone"></i> Broadcast Message</button>
    <a class="dp-btn-secondary" href="/Schedule" style="text-decoration:none;"><i class="ti ti-calendar-week"></i> Edit Schedule</a>
    <div class="dp-search-wrap">
        <i class="ti ti-search dp-search-icon"></i>
        <input type="text" id="searchInput" class="dp-search-input" placeholder="Search…" oninput="filterRows()" />
    </div>
    <button class="dp-btn-refresh" id="dpRefreshBtn" onclick="dpRefresh(true)" title="Refresh this page only">
        <i class="ti ti-refresh"></i> Refresh
    </button>
    <span class="dp-updated" id="dpUpdated" title="Auto-refreshes every 30 seconds"></span>

    @* Phone only: the three buttons above are planning tools, not things done at a
       terminal, so they fold behind this rather than filling the screen. *@
    <button type="button" class="dp-more" id="dpMoreBtn" aria-expanded="false"
            aria-controls="dpMoreSheet" aria-label="More actions">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" />
        </svg>
    </button>
</div>

</div>

<p class="dp-empty-state" id="dpEmptyState" hidden></p>

@* ROUTE BLOCKS *@
<div id="dpRoutes">
@foreach (var route in Model.Routes)
{
    <div class="rp-card rp-card--table dp-route-card" data-route-id="@route.RouteId">
        <div class="dp-route-header">
            <span class="dp-route-caret" aria-hidden="true"></span>
            <span class="dp-route-name">@route.RouteName</span>
            <div class="dp-route-header-right">
                @if (route.NeedsAssignment)
                {
                    <span class="dp-needs-badge"><span class="dp-needs-dot"></span> Needs Reassignment</span>
                }
                <button class="dp-btn-route-msg" onclick="openRouteMessageModal(@route.RouteId, '@route.RouteName')"><i class="ti ti-message-2"></i> Route Message</button>
            </div>
        </div>

        <div class="rp-table-wrap">
            <table class="rp-table dp-table">
                <colgroup>
                    <col class="dp-col-shift" />
                    <col class="dp-col-trip" />
                    <col class="dp-col-bus" />
                    <col class="dp-col-driver" />
                    <col class="dp-col-status" />
                    <col class="dp-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Shift</th>
                        <th>Trip ID</th>
                        <th>Bus ID</th>
                        <th>Driver</th>
                        <th>Trip Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!route.Shifts.Any())
                    {
                        <tr class="dp-trip-row dp-empty-row" data-trip-status="">
                            <td colspan="6" class="dp-empty-cell">No trips scheduled for this operational day.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var shift in route.Shifts)
                        {
                            var shiftTrips = shift.Trips;
                            var shiftId = $"{route.RouteId}-{shift.ShiftType}".Replace(" ", "-");

                            @for (int i = 0; i < shiftTrips.Count; i++)
                            {
                                var trip = shiftTrips[i];

                                // Readiness dot, derived from the trip, so a bus used by
                                // another shift cannot colour this one. A missed trip is
                                // grey rather than green, and a completed one slate.
                                // Roadworthiness is a separate marker and never overwrites
                                // this dot.
                                var (vDotClass, vTooltip) =
                                    trip.TripStatus == "Missed" ? ("dp-dot--missed", "Missed (bus not used)") :
                                    trip.VehicleStatus switch
                                    {
                                        "On Trip" => ("dp-dot--green", "On trip"),
                                        "Completed" => ("dp-dot--slate", "Trip completed"),
                                        "Ready to Deploy" => ("dp-dot--blue", "Ready to deploy"),
                                        "Flagged" => ("dp-dot--red", "Flagged on inspection"),
                                        "Pending" => ("dp-dot--yellow", "Pending checklist"),
                                        _ => ("dp-dot--gray", trip.VehicleStatus)
                                    };

                                // Driver status icon
                                var (dDotClass, dTooltip) = trip.DriverStatus switch
                                {
                                    "On Trip" => ("dp-dot--green", "On trip"),
                                    "Available" => ("dp-dot--blue", "Available"),
                                    "Unavailable" => ("dp-dot--red", "Cannot drive"),
                                    _ => ("dp-dot--gray", trip.DriverStatus)
                                };

                                // Trip status badge
                                var (badgeClass, badgeLabel) = trip.TripStatus switch
                                {
                                    "Active" => ("dp-badge--active", "Active"),
                                    "Not Yet Started" => ("dp-badge--not-started", "Not Yet Started"),
                                    "Pending" => ("dp-badge--pending", "Pending"),
                                    "Assignment Issue" => ("dp-badge--issue", "Assignment Issue"),
                                    "Missed" => ("dp-badge--missed", "Missed"),
                                    "Completed" => ("dp-badge--completed", "Completed"),
                                    _ => ("dp-badge--completed", trip.TripStatus)
                                };

                                <tr class="dp-trip-row"
                                    data-trip-status="@trip.TripStatus"
                                    data-shift-id="@shiftId"
                                    data-shift-type="@shift.ShiftType"
                                    data-shift-label="@shift.ShiftType @(shift.ShiftStartTime) to @(shift.ShiftEndTime)@(shift.IsOvernight ? " +1" : "")">
                                    @if (i == 0)
                                    {
                                        <td class="dp-shift-cell" data-shift-type="@shift.ShiftType"
                                            rowspan="@shiftTrips.Count">
                                            @shift.ShiftType<br />
                                            <span class="dp-shift-time">(@shift.ShiftStartTime – @shift.ShiftEndTime@(shift.IsOvernight ? " +1" : ""))</span>
                                            @if (shift.IsOvernight)
                                            {
                                                <span class="dp-overnight-tag" title="Ends the next morning">overnight</span>
                                            }
                                        </td>
                                    }
                                    <td data-label="Trip ID">
                                        <span class="dp-trip-id">@trip.TripId</span>
                                    </td>
                                    <td data-label="Bus">
                                        <div class="dp-status-wrap">
                                            <span class="dp-status-dot @vDotClass"></span>
                                            <span class="dp-tooltip">@vTooltip</span>
                                            <strong>@trip.VehicleId</strong>
                                            <span class="rp-plate">| @trip.PlateNumber</span>
                                            @if (trip.Flagged)
                                            {
                                                <span class="dp-flag" title="Flagged on inspection. See Trip Detail or Vehicles."><i class="ti ti-flag-filled"></i></span>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="Driver">
                                        <div class="dp-status-wrap">
                                            <span class="dp-status-dot @dDotClass"></span>
                                            <span class="dp-tooltip">@dTooltip</span>
                                            @trip.DriverName
                                        </div>
                                    </td>
                                    <td data-label="Status">
                                        @* Also carried by a running trip whose driver has reported
                                           they cannot drive, which is why this no longer asks the
                                           status first. *@
                                        @if (!string.IsNullOrEmpty(trip.AssignmentIssueReason))
                                        {
                                            <span class="dp-badge @badgeClass dp-badge--hint" data-tip="@trip.AssignmentIssueReason"
                                                  tabindex="0" role="button"
                                                  aria-label="@badgeLabel. Tap for the reason.">@badgeLabel</span>
                                        }
                                        else
                                        {
                                            <span class="dp-badge @badgeClass">@badgeLabel</span>
                                        }
                                    </td>
                                    <td data-label="Actions">
                                        <div class="dp-actions-cell">
                                            <button class="rp-btn-view" onclick="openTripModal('@trip.TripId')">View</button>
                                            @* Open while a trip is running. A driver taken ill, a bus that
                                               has to come off the road and a route that needs another bus on
                                               it all happen mid-shift, and each is answered here. A trip
                                               already finished or missed is history and stays closed. *@
                                            <button class="dp-btn-reassign"
                                                    data-trip-id="@trip.TripId"
                                                    data-status="@trip.TripStatus"
                                                    onclick="handleReassignClick(this)"
                                                @(trip.TripStatus == "Completed" || trip.TripStatus == "Missed" ? "disabled" : "")>
                                                Reassign
                                            </button>
                                            <button class="dp-btn-msg" title="Message" onclick="openTripMessageModal('@trip.TripId', '@trip.VehicleId', '@trip.DriverName')"><i class="ti ti-message"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
</div>@* /dpRoutes *@

@* spacer so content above isn't hidden behind the fixed legend bar *@
<div style="height:64px;"></div>

@* LEGEND *@
<div class="rp-card dp-legend-card">
    <div class="dp-legend-row">
        <span class="dp-legend-label">Legend</span>
        <span class="dp-legend-item"><span class="dp-status-dot dp-dot--green"></span> On trip</span>
        <span class="dp-legend-item"><span class="dp-status-dot dp-dot--blue"></span> Bus: ready to deploy &nbsp;|&nbsp; Driver: available</span>
        <span class="dp-legend-item"><span class="dp-status-dot dp-dot--yellow"></span> Bus: pending checklist</span>
        <span class="dp-legend-item"><span class="dp-status-dot dp-dot--red"></span> Bus: flagged &nbsp;|&nbsp; Driver: cannot drive</span>
        <span class="dp-legend-item"><span class="dp-status-dot dp-dot--slate"></span> Trip completed</span>
        <span class="dp-legend-item"><span class="dp-status-dot dp-dot--missed"></span> Missed Trip</span>
    </div>
</div>

@* Shared message popup (Add Trip / Reassign conflicts) *@
<div id="dp-msg-modal" class="dp-msg-overlay" style="display:none;">
    <div class="dp-msg-box">
        <div class="dp-msg-head">
            <span class="dp-msg-ico">&#9888;</span>
            <h3 id="dp-msg-title">Schedule conflict</h3>
        </div>
        <ul id="dp-msg-list" class="dp-msg-list"></ul>
        <button class="dp-msg-btn" onclick="dpCloseMsg()">Got it</button>
    </div>
</div>

<script>
    function dpShowMsg(messages, title) {
        document.getElementById('dp-msg-title').textContent = title || 'Schedule conflict';
        // These sentences are built on the server, and still rendered as text. A conflict
        // line is data, and a list item is the wrong place to discover otherwise.
        const ul = document.getElementById('dp-msg-list');
        ul.replaceChildren();
        (Array.isArray(messages) ? messages : [messages]).forEach(function (m) {
            const li = document.createElement('li');
            li.textContent = m;
            ul.appendChild(li);
        });
        document.getElementById('dp-msg-modal').style.display = 'flex';
    }
    function dpCloseMsg() { document.getElementById('dp-msg-modal').style.display = 'none'; }

    function dpHighlightIssues() {
        const rows = document.querySelectorAll('.dp-trip-row[data-trip-status="Assignment Issue"]');
        document.querySelectorAll('.dp-row-flag').forEach(r => r.classList.remove('dp-row-flag'));
        if (!rows.length) return;
        rows.forEach(r => r.classList.add('dp-row-flag'));
        rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Hover popup for an assignment issue.
    //
    // A floating element on the document body, with delegated handlers, so the route
    // card's overflow rule cannot clip it. A refresh can replace the hovered badge while
    // the pointer is still over it, in which case no mouseout fires, so a pointer-move
    // fallback clears the popup.
    (function () {
        let tip = null, current = null;
        function ensure() {
            if (!tip) {
                tip = document.createElement('div');
                tip.className = 'dp-tip';
                document.body.appendChild(tip);
            }
            return tip;
        }
        function show(badge) {
            const text = badge.getAttribute('data-tip');
            if (!text) return;
            current = badge;
            ensure().textContent = text;
            const r = badge.getBoundingClientRect();
            tip.style.opacity = '0';
            tip.classList.add('dp-tip--show');
            const tw = tip.offsetWidth, th = tip.offsetHeight;   // measure after text set
            let left = r.left + r.width / 2 - tw / 2;
            left = Math.max(8, Math.min(left, window.innerWidth - tw - 8));
            tip.style.left = left + 'px';
            tip.style.top = (r.top - th - 9) + 'px';
            tip.style.opacity = '1';
        }
        function hide() {
            current = null;
            if (tip) { tip.remove(); tip = null; }   // fully remove -> no ghost
        }
        if (window.matchMedia('(hover: hover)').matches) {
            document.addEventListener('mouseover', e => {
                const b = e.target.closest && e.target.closest('.dp-badge--hint');
                if (b && b !== current) show(b);
            });
            // Any pointer movement away from the current badge clears the popup.
            document.addEventListener('mousemove', e => {
                if (!current) return;
                const b = e.target.closest && e.target.closest('.dp-badge--hint');
                if (b !== current) hide();
            });
        }

        // A finger has no hover, and a keyboard has no pointer at all. Both open the
        // popup the same way, and anything else on the page closes it.
        // Opening only, never toggling: a tap on a focusable badge fires focusin
        // before click, so a toggle would open the popup and shut it again in one
        // touch. Tapping anywhere else closes it.
        document.addEventListener('click', e => {
            const b = e.target.closest && e.target.closest('.dp-badge--hint');
            if (b) show(b); else hide();
        });
        document.addEventListener('focusin', e => {
            const b = e.target.closest && e.target.closest('.dp-badge--hint');
            if (b) show(b); else if (current) hide();
        });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') hide(); });

        window.addEventListener('scroll', hide, true);
    })();

    // Live refresh.
    //
    // Re-fetches this page, including the date in the address, and replaces only the stats
    // and route blocks. No full reload and no persistent connection.
    //
    // The button always runs. The automatic poll skips while a modal is open, while the
    // user is searching, or while the tab is hidden, so it never disturbs work in
    // progress.
    let dpBusy = false;

    function dpAnyModalOpen() {
        return [...document.querySelectorAll('[class*="overlay"]')]
            .some(el => getComputedStyle(el).display !== 'none');
    }

    function dpStamp() {
        const at = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const el = document.getElementById('dpUpdated');
        if (el) el.textContent = 'Updated ' + at;

        // A phone has no room for a line that only carries a time, so the button
        // that refreshes the board says how old it is instead.
        const btn = document.getElementById('dpRefreshBtn');
        if (btn) btn.title = 'Updated ' + at + '. Auto-refreshes every 30 seconds.';
    }

    async function dpRefresh(manual) {
        if (dpBusy) return;
        dpBusy = true;
        const btn = document.getElementById('dpRefreshBtn');
        if (manual && btn) btn.classList.add('spinning');
        try {
            const res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'fetch' } });
            const html = await res.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            ['dpStats', 'dpRoutes'].forEach(id => {
                const fresh = doc.getElementById(id);
                const cur = document.getElementById(id);
                if (fresh && cur) cur.innerHTML = fresh.innerHTML;
            });
            // Reapply the active search filter to the replaced rows.
            const s = document.getElementById('searchInput');
            if (s && s.value) filterRows();
            if (window.dpChipsRecount) window.dpChipsRecount();
            if (window.dpSayIfEmpty) window.dpSayIfEmpty();
            dpStamp();
        } catch (e) {
            console.warn('dispatch refresh failed', e);
        } finally {
            dpBusy = false;
            if (btn) btn.classList.remove('spinning');
        }
    }

    setInterval(() => {
        if (document.hidden) return;
        if (dpAnyModalOpen()) return;
        const s = document.getElementById('searchInput');
        if (s && s.value) return;
        dpRefresh(false);
    }, 30000);

    dpStamp();
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/dispatch.css" asp-append-version="true" />
}


@section TopbarContent {
    <button type="button" class="rs-filter-toggle" data-filter-toggle="dpFilters"
            aria-expanded="false" aria-controls="dpFilters">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18M6 12h12M10 19h4" />
        </svg>
        Filters
    </button>

    <div class="dp-topfilters rs-filters" id="dpFilters">
    <div class="rp-route-wrap">
        <span class="rp-filter-label">Route:</span>
        <div class="rp-select-wrap">
            <select class="rp-select" id="routeFilter">
                <option value="0">All Routes</option>
                @foreach (var route in Model.Routes)
                {
                    <option value="@route.RouteId">@route.RouteName</option>
                }
            </select>
            <span class="rp-select-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </span>
        </div>
    </div>

    <div class="rp-status-wrap">
        <span class="rp-filter-label">Status:</span>
        <div class="rp-select-wrap">
            <select class="rp-select" id="statusFilter">
                <option value="">All</option>
                <option value="Active">Active</option>
                <option value="Not Yet Started">Not Yet Started</option>
                <option value="Pending">Pending</option>
                <option value="Assignment Issue">Assignment Issue</option>
                <option value="Missed">Missed</option>
                <option value="Completed">Completed</option>
            </select>
            <span class="rp-select-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </span>
        </div>
    </div>
    </div>
}

<script>
    function applyFilters() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        const routeId = document.getElementById('routeFilter').value;
        const status = document.getElementById('statusFilter').value;

        document.querySelectorAll('.dp-route-card').forEach(card => {
            const cardRouteId = card.dataset.routeId;
            const routeMatches = routeId === '0' || routeId === '' || cardRouteId === routeId;

            // Routes with no trips today
            const emptyRow = card.querySelector('.dp-empty-row');
            if (emptyRow) {
                const showEmpty = routeMatches && status === '' && q === '';
                card.style.display = showEmpty ? '' : 'none';
                emptyRow.style.display = showEmpty ? '' : 'none';
                return;
            }

            const rows = Array.from(card.querySelectorAll('.dp-trip-row'));
            let anyVisibleInCard = false;

            // Group rows by shift id, preserving order
            const shiftGroups = {};
            const shiftOrder = [];
            rows.forEach(row => {
                const sid = row.dataset.shiftId;
                if (!shiftGroups[sid]) {
                    shiftGroups[sid] = [];
                    shiftOrder.push(sid);
                }
                shiftGroups[sid].push(row);
            });

            shiftOrder.forEach(sid => {
                const groupRows = shiftGroups[sid];

                // Step 1: Always restore shift cell to the first row of the group
                // so each filtering pass starts from a clean, predictable state.
                let shiftCell = null;
                groupRows.forEach(row => {
                    const cell = row.querySelector('.dp-shift-cell');
                    if (cell) shiftCell = cell;
                });
                if (shiftCell && !groupRows[0].querySelector('.dp-shift-cell')) {
                    groupRows[0].insertBefore(shiftCell, groupRows[0].firstChild);
                }

                // Step 2: Determine visibility for each row
                const visibility = groupRows.map(row => {
                    const rowStatus = row.dataset.tripStatus || '';
                    const statusMatches = status === '' || rowStatus === status;
                    const textMatches = q === '' || row.textContent.toLowerCase().includes(q);
                    return routeMatches && statusMatches && textMatches;
                });

                const visibleCount = visibility.filter(Boolean).length;

                if (visibleCount === 0) {
                    // Hide all rows in this shift, including the one holding the shift cell
                    groupRows.forEach(row => { row.style.display = 'none'; });
                    return;
                }

                anyVisibleInCard = true;

                // Step 3: Move shift cell to first visible row if it isn't already there
                const firstVisibleIndex = visibility.indexOf(true);
                const firstVisibleRow = groupRows[firstVisibleIndex];
                if (shiftCell && !firstVisibleRow.querySelector('.dp-shift-cell')) {
                    firstVisibleRow.insertBefore(shiftCell, firstVisibleRow.firstChild);
                }

                // Step 4: Update rowspan to match visible count
                if (shiftCell) shiftCell.setAttribute('rowspan', visibleCount);

                // Step 5: Show/hide each row
                groupRows.forEach((row, idx) => {
                    row.style.display = visibility[idx] ? '' : 'none';
                });
            });

            card.style.display = (routeMatches && anyVisibleInCard) ? '' : 'none';
        });
    }

    function filterRows() { applyFilters(); }

    function handleReassignClick(btn) {
        const status = btn.dataset.status;
        if (status === 'Completed' || status === 'Missed') return;
        openReassignModal(btn.dataset.tripId);
    }

    document.getElementById('routeFilter').addEventListener('change', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);

    // Status chips.
    //
    // They set the status select and let applyFilters do the work, so there is still
    // one place that decides what a filter means. The counts are read from the rows
    // on the page rather than the server, which keeps them right after a refresh
    // replaces those rows.
    document.addEventListener('DOMContentLoaded', function () {
        var chipBar = document.getElementById('dpChips');
        var statusSel = document.getElementById('statusFilter');
        if (!chipBar || !statusSel) return;

        function countChips() {
            var rows = document.querySelectorAll('.dp-trip-row[data-trip-status]');
            var totals = {};
            rows.forEach(function (r) {
                var st = r.dataset.tripStatus;
                if (!st) return;
                totals[st] = (totals[st] || 0) + 1;
                totals[''] = (totals[''] || 0) + 1;
            });
            chipBar.querySelectorAll('.dp-chip').forEach(function (chip) {
                var n = totals[chip.dataset.chip] || 0;
                chip.querySelector('.dp-chip-n').textContent = n > 0 ? n : '';
                chip.classList.toggle('dp-chip--empty', n === 0);
            });
        }

        function mark() {
            chipBar.querySelectorAll('.dp-chip').forEach(function (chip) {
                chip.classList.toggle('dp-chip--on', chip.dataset.chip === statusSel.value);
            });
        }

        chipBar.addEventListener('click', function (e) {
            var chip = e.target.closest('.dp-chip');
            if (!chip) return;
            statusSel.value = chip.dataset.chip;
            applyFilters();
            mark();
            sayIfEmpty();
        });

        // What an empty page means depends on what was asked for. "Nothing was
        // missed" is worth reading; a blank screen is not.
        var EMPTY = {
            '': 'No trips today.',
            'Assignment Issue': 'No assignment issues.',
            'Missed': 'Nothing missed today.',
            'Active': 'Nothing running right now.'
        };

        function sayIfEmpty() {
            var note = document.getElementById('dpEmptyState');
            if (!note) return;
            var showing = Array.prototype.filter.call(
                document.querySelectorAll('.dp-route-card'),
                function (c) { return c.style.display !== 'none'; }).length;
            note.textContent = EMPTY[statusSel.value] || 'No trips match this filter.';
            note.hidden = showing > 0;
        }

        window.dpSayIfEmpty = sayIfEmpty;
        sayIfEmpty();

        // The route bars park under this block, whose height depends on how the
        // chips and the search wrap. Measured rather than assumed, and again
        // whenever the width changes.
        var head = document.getElementById('dpStickyHead');
        function measureHead() {
            if (!head) return;
            var h = Math.round(head.getBoundingClientRect().height);
            // Zero means it has not been laid out yet, or the width is one where
            // this block does not exist. Either way the stylesheet's own figure is
            // a better answer than none.
            if (h > 0) document.documentElement.style.setProperty('--dp-head', h + 'px');
        }

        // Watched rather than measured once: the chips and the search wrap at
        // different widths, and a font arriving late changes the height again.
        if (head && window.ResizeObserver) {
            new ResizeObserver(measureHead).observe(head);
        } else {
            window.addEventListener('resize', measureHead);
        }
        requestAnimationFrame(measureHead);

        statusSel.addEventListener('change', mark);

        // A whole route folds away, so a dispatcher working one route can put the
        // other out of sight. Header taps only; the Route Message button inside it
        // has its own job.
        document.addEventListener('click', function (e) {
            var head = e.target.closest && e.target.closest('.dp-route-header');
            if (!head) return;
            if (e.target.closest('button, a')) return;
            head.closest('.dp-route-card').classList.toggle('dp-route-card--shut');
        });

        // More actions. Its sheet is written further down the page than this script,
        // which is why the whole block waits for the document to finish.
        var moreBtn = document.getElementById('dpMoreBtn');
        var moreSheet = document.getElementById('dpMoreSheet');
        var moreBack = document.getElementById('dpMoreBackdrop');
        function setMore(open) {
            moreSheet.classList.toggle('dp-more-sheet--open', open);
            moreBack.classList.toggle('dp-more-backdrop--open', open);
            moreBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        moreBtn.addEventListener('click', function () {
            setMore(!moreSheet.classList.contains('dp-more-sheet--open'));
        });
        moreBack.addEventListener('click', function () { setMore(false); });
        moreSheet.addEventListener('click', function () { setMore(false); });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') setMore(false);
        });
        window.dpChipsRecount = function () { countChips(); mark(); };
        countChips();
    });

    // The day the board is showing.
    (function () {
        const pick = document.getElementById('dpDatePick');
        if (!pick) return;

        // A date field opens its calendar from the small icon at its end and from
        // nowhere else, which here is a few pixels of a badge the width of the date.
        // Asked directly it opens from anywhere on it, and a browser without the
        // call still has the field.
        pick.addEventListener('click', function () {
            if (typeof pick.showPicker !== 'function') return;
            try { pick.showPicker(); } catch (e) { }
        });

        pick.addEventListener('change', function () {
            if (pick.value) window.location = window.location.pathname + '?date=' + pick.value;
        });
    })();

    // A phone loses the page whenever another app comes forward, and the poll above
    // stops with it. Returning would otherwise show whatever was true up to thirty
    // seconds ago, with nothing saying so. Touch only: a desk keeps its own timing.
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) dpRefresh(false);
        });
    }
</script>

@* More actions, phone only. The three buttons in the toolbar stay put for a desk;
   this calls the same handlers rather than moving them. *@
<div class="dp-more-backdrop" id="dpMoreBackdrop"></div>
<div class="dp-more-sheet" id="dpMoreSheet" role="dialog" aria-modal="true" aria-label="More actions">
    <div class="dp-more-grip"></div>
    <button type="button" class="dp-more-item" onclick="openAddTripModal()">
        <i class="ti ti-plus"></i> Add Trip
    </button>
    <button type="button" class="dp-more-item" onclick="openBroadcastModal()">
        <i class="ti ti-speakerphone"></i> Broadcast Message
    </button>
    <a class="dp-more-item" href="/Schedule">
        <i class="ti ti-calendar-week"></i> Edit Schedule
    </a>
</div>

@* Trip Detail Modal. *@
@await Html.PartialAsync("_TripDetailModal")
@await Html.PartialAsync("_AddTripModal")
@await Html.PartialAsync("_ReassignTripModal")
@await Html.PartialAsync("_BroadcastMessageModal")
