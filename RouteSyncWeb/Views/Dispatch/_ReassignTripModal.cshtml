@* Views/Dispatch/_ReassignTripModal.cshtml *@

@* Loaded here, ahead of the script below that builds its lists. *@
<script src="~/js/candidate-list.js" asp-append-version="true"></script>

<div id="reassignModal" data-dialog-close="closeReassignModal" class="rtm-overlay" role="dialog" aria-modal="true"
     aria-labelledby="rtm-title" aria-describedby="rtm-subtitle" style="display:none;">
    <div class="rtm-dialog">

        @* Header. Names the trip being changed, so a dispatcher working through several
           problem trips can see which one this is without going back to the board. *@
        <div class="rtm-header">
            <div class="rtm-heading">
                <h2 class="rtm-title" id="rtm-title">Reassign Trip</h2>
                <p class="rtm-subtitle" id="rtm-subtitle"></p>
            </div>
            <button class="rtm-close" onclick="closeReassignModal()" aria-label="Close">&times;</button>
        </div>

        @* Loading state *@
        <div id="rtm-loading" class="rtm-loading">
            <svg class="rtm-spin" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none"
                 stroke="#4AADA8" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
            </svg>
            <span>Loading trip details…</span>
        </div>

        @* Body (hidden until loaded) *@
        <div id="rtm-body" class="rtm-body" style="display:none;">

            @* Trip Information *@
            <div class="rtm-section-label">
                Trip Information
                <span id="rtm-status-badge" class="rtm-status-badge rtm-badge--issue" style="display:none;">
                    <span class="rtm-badge-dot"></span>
                    <span id="rtm-status-text">Assignment Issue</span>
                </span>
            </div>
            <div class="rtm-section">
                <div class="rtm-info-row">
                    <span class="rtm-info-label">Shift Type:</span>
                    <span class="rtm-info-value" id="rtm-shift-type">—</span>
                </div>
                <div class="rtm-info-row">
                    <span class="rtm-info-label">Shift Time:</span>
                    <span class="rtm-info-value" id="rtm-shift-time">—</span>
                </div>
            </div>

            @* Where the bus runs. Demand moves through a day and a route can need another
               bus on it more than the one it is on now, so this is the dispatcher's to
               change while the shift is running. The driver is told when it does. *@
            <div class="rtm-section-label">Route</div>
            <div class="rtm-section">
                <div class="rtm-field">
                    <label class="rtm-label" for="rtm-route-sel">Route</label>
                    <div class="rtm-select-wrap">
                        <select id="rtm-route-sel" class="rtm-select">
                            <option value="">Loading…</option>
                        </select>
                    </div>
                    <span class="rtm-hint" id="rtm-route-hint"></span>
                </div>
            </div>

            @* Bus, then driver. The side with the problem opens on its ranked list; the other
               says what it keeps, with Change to open its list. *@
            <div class="rtm-section-label">Bus</div>
            <div class="rtm-section">
                <div class="rtm-keep" id="rtm-vehicle-keep" hidden>
                    <div class="rtm-keep-main" id="rtm-vehicle-keep-main">
                        <span class="rtm-keep-label">Current</span>
                        <span class="rtm-keep-line">
                            <span class="rtm-keep-name" id="rtm-vehicle-keep-name"></span>
                            <span class="rtm-keep-sub" id="rtm-vehicle-keep-sub"></span>
                        </span>
                    </div>
                    <button type="button" class="rtm-change" id="rtm-vehicle-change" aria-describedby="rtm-vehicle-keep-main">Change</button>
                </div>
                <div id="rtm-vehicle-list" hidden></div>
            </div>

            <div class="rtm-section-label">Driver</div>
            <div class="rtm-section rtm-section--last">
                <div class="rtm-keep" id="rtm-driver-keep" hidden>
                    <div class="rtm-keep-main" id="rtm-driver-keep-main">
                        <span class="rtm-keep-label">Current</span>
                        <span class="rtm-keep-line">
                            <span class="rtm-keep-name" id="rtm-driver-keep-name"></span>
                            <span class="rtm-keep-sub" id="rtm-driver-keep-sub"></span>
                        </span>
                    </div>
                    <button type="button" class="rtm-change" id="rtm-driver-change" aria-describedby="rtm-driver-keep-main">Change</button>
                </div>
                <div id="rtm-driver-list" hidden></div>
            </div>

        </div>

        @* Footer *@
        <div class="rtm-footer">
            @* Taking a trip off the schedule, asked for here since a list has no blank to clear. *@
            <button type="button" class="rtm-btn-remove" id="rtm-remove-btn" onclick="rtmAskRemove()">Remove trip</button>
            <button class="rtm-btn-cancel" onclick="closeReassignModal()">Cancel</button>
            <button class="rtm-btn-save" id="rtm-save-btn" onclick="submitReassign()">
                <span id="rtm-save-label">Save changes</span>
                <span id="rtm-save-spinner" style="display:none;">
                    <svg class="rtm-spin" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                         stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                    </svg>
                    Saving…
                </span>
            </button>
        </div>

    </div>
</div>

@* Override confirmation (step 2): shown when ReassignTrip reports an overridable conflict *@
<div id="rtm-override-modal" class="rtm-overlay" style="display:none; z-index:1200;">
    <div class="rtm-dialog" style="max-width:430px;">
        <div class="rtm-header">
            <h2 class="rtm-title">Override schedule conflict?</h2>
            <button class="rtm-close" onclick="rtmCancelOverride()">&times;</button>
        </div>
        <div class="rtm-section rtm-section--last" style="gap:10px;">
            <div id="rtm-override-msg" class="rtm-override-msg"></div>
            <p style="margin:0; font-size:0.88rem; color:#4A5568;">
                Save this reassignment anyway? It breaks the rule above.
            </p>
        </div>
        <div class="rtm-footer">
            <button class="rtm-btn-cancel" onclick="rtmCancelOverride()">Cancel</button>
            <button class="rtm-btn-save rtm-btn-override" onclick="rtmConfirmOverride()">Yes, override</button>
        </div>
    </div>
</div>

@* Remove confirmation: shown when both bus AND driver are cleared (delete the trip) *@
<div id="rtm-remove-modal" class="rtm-overlay" style="display:none; z-index:1200;">
    <div class="rtm-dialog" style="max-width:430px;">
        <div class="rtm-header">
            <h2 class="rtm-title">Remove this trip?</h2>
            <button class="rtm-close" onclick="rtmCancelRemove()">&times;</button>
        </div>
        <div class="rtm-section rtm-section--last">
            <p style="margin:0; font-size:0.9rem; color:#4A5568;">
                This deletes the trip from the schedule. It can't be undone.
            </p>
        </div>
        <div class="rtm-footer">
            <button class="rtm-btn-cancel" onclick="rtmCancelRemove()">Cancel</button>
            <button class="rtm-btn-save rtm-btn-danger" onclick="rtmConfirmRemove()">Remove trip</button>
        </div>
    </div>
</div>


<script>
    /* Reassign Trip Modal. */
    (function () {
        let _rtmOptions  = null;   // full options from server
        let _rtmTripId   = null;   // trip being reassigned

        // DOM refs.
        const overlay     = document.getElementById('reassignModal');
        const loadingEl   = document.getElementById('rtm-loading');
        const bodyEl      = document.getElementById('rtm-body');
        const statusBadge = document.getElementById('rtm-status-badge');
        const statusText  = document.getElementById('rtm-status-text');
        const shiftTypeEl = document.getElementById('rtm-shift-type');
        const shiftTimeEl = document.getElementById('rtm-shift-time');
        const subtitleEl  = document.getElementById('rtm-subtitle');
        const routeSel    = document.getElementById('rtm-route-sel');
        const routeHint   = document.getElementById('rtm-route-hint');
        const saveBtn     = document.getElementById('rtm-save-btn');

        // Each side of the trip: the line saying what is kept, and the list to choose from.
        const sides = {
            vehicle: {
                keep: document.getElementById('rtm-vehicle-keep'),
                keepName: document.getElementById('rtm-vehicle-keep-name'),
                keepSub: document.getElementById('rtm-vehicle-keep-sub'),
                change: document.getElementById('rtm-vehicle-change'),
                host: document.getElementById('rtm-vehicle-list'),
                list: null
            },
            driver: {
                keep: document.getElementById('rtm-driver-keep'),
                keepName: document.getElementById('rtm-driver-keep-name'),
                keepSub: document.getElementById('rtm-driver-keep-sub'),
                change: document.getElementById('rtm-driver-change'),
                host: document.getElementById('rtm-driver-list'),
                list: null
            }
        };

        // Where focus goes back to when the modal closes.
        let _rtmOpener = null;

        function rtmOpenSide(side, open) {
            side.keep.hidden = open;
            side.host.hidden = !open;
        }

        Object.values(sides).forEach(function (side) {
            side.change.addEventListener('click', function () {
                rtmOpenSide(side, true);
                if (side.list) side.list.focus();
            });
        });

        // Open.
        window.openReassignModal = async function (tripId) {
            _rtmTripId  = tripId;
            _rtmOptions = null;
            _rtmOpener  = document.activeElement;

            // Reset UI
            loadingEl.style.display = 'flex';
            bodyEl.style.display    = 'none';
            statusBadge.style.display = 'none';
            overlay.style.display   = 'flex';
            document.body.style.overflow = 'hidden';

            try {
                const res  = await fetch(`/Dispatch/GetReassignOptions?tripId=${encodeURIComponent(tripId)}`);
                if (!res.ok) throw new Error();
                _rtmOptions = await res.json();

                // Populate trip info
                const info = _rtmOptions.tripInfo;
                shiftTypeEl.textContent = info.shiftType ? info.shiftType + ' shift' : '—';
                subtitleEl.textContent = [info.tripId, info.date].filter(Boolean).join(' on ');
                shiftTimeEl.textContent = `${info.shiftStart} – ${info.shiftEnd}`;
                rtmFillSelect(routeSel, 'Select a route…',
                    (_rtmOptions.routes || []).map(function (r) {
                        return { value: r.routeId, label: r.routeName };
                    }),
                    info.currentRouteId);
                rtmRouteHint();

                // Status badge
                if (info.tripStatus === 'Assignment Issue' || info.tripStatus === 'Pending') {
                    statusText.textContent = info.tripStatus;
                    statusBadge.className  = 'rtm-status-badge ' +
                        (info.tripStatus === 'Assignment Issue' ? 'rtm-badge--issue' : 'rtm-badge--pending');
                    statusBadge.style.display = 'inline-flex';
                } else {
                    statusBadge.style.display = 'none';
                }

                // The two ranked lists, best first.
                refreshRtmVehicles();
                refreshRtmDrivers();

                loadingEl.style.display = 'none';
                bodyEl.style.display    = 'block';

                // A list's column heads stay in view below the header while it scrolls.
                const dialogEl = overlay.querySelector('.rtm-dialog');
                dialogEl.style.setProperty('--rsc-stick', dialogEl.querySelector('.rtm-header').offsetHeight + 'px');

                // Focus lands where the decision is: the open list on the problem side, or
                // the first Change when nothing is wrong.
                const open = [sides.vehicle, sides.driver].find(s => !s.host.hidden);
                if (open && open.list) open.list.focus();
                else sides.vehicle.change.focus();

            } catch {
                loadingEl.innerHTML = '<span style="color:#E74C3C;">Failed to load trip details. Please try again.</span>';
            }
        };

        // Close.
        window.closeReassignModal = function () {
            overlay.style.display = 'none';
            document.body.style.overflow = '';
            if (_rtmOpener && document.contains(_rtmOpener)) _rtmOpener.focus();
            _rtmOpener = null;
        };

        overlay.addEventListener('click', e => {
            if (e.target === overlay) closeReassignModal();
        });

        // Said before saving, not after. A driver already out on the road is told where to
        // go next, and the dispatcher should know that is what pressing save does.
        function rtmRouteHint() {
            const moved = _rtmOptions
                && routeSel.value
                && String(routeSel.value) !== String(_rtmOptions.tripInfo.currentRouteId);

            routeHint.textContent = moved
                ? 'The driver will be sent a high priority notice that this shift has moved route.'
                : '';
            routeHint.classList.toggle('rtm-hint--visible', !!moved);
        }

        routeSel.addEventListener('change', rtmRouteHint);

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && overlay.style.display === 'flex') closeReassignModal();
        });

        

    // Options are built as elements with textContent, never glued together as HTML.
    // Plate numbers and driver names are typed by admins and come straight from the
    // database, so with innerHTML a name like `<img src=x onerror=...>` ran in the
    // session of whoever opened this modal next.
    //
    // An item carrying a group lands in an optgroup of that name, created the first time
    // the name is seen, so groups appear in the order the ranked list reaches them.
    function rtmFillSelect(sel, placeholder, items, selectedId) {
        sel.replaceChildren();
        const blank = document.createElement('option');
        blank.value = '';
        blank.textContent = placeholder;
        sel.appendChild(blank);
        const groups = {};
        (items || []).forEach(function (it) {
            const opt = document.createElement('option');
            opt.value = it.value;
            opt.textContent = it.label;
            if (it.face !== undefined) opt.dataset.face = it.face;
            if (selectedId != null && it.value == selectedId) opt.selected = true;

            let parent = sel;
            if (it.group) {
                parent = groups[it.group];
                if (!parent) {
                    parent = document.createElement('optgroup');
                    parent.label = it.group;
                    sel.appendChild(parent);
                    groups[it.group] = parent;
                }
            }
            parent.appendChild(opt);
        });
    }

        // The best replacement is chosen for the dispatcher only on the side that has the
        // problem, and only when taking it costs nothing. Otherwise what the trip has stays
        // chosen, so saving a driver change never moves the bus as well.
        function rtmStartingPick(problem, best, currentId, idOf) {
            return problem && best && best.tier <= RsCandidateList.NO_COST_TIER ? idOf(best) : currentId;
        }

        function refreshRtmVehicles() {
            if (!_rtmOptions) return;

            const o = _rtmOptions;
            const cur = o.currentVehicle;
            const side = sides.vehicle;
            const plate = p => p ? 'Plate ' + p : '';

            side.list = RsCandidateList.create(side.host, {
                kind: 'vehicle',
                label: 'Bus',
                current: {
                    id: cur.vehicleId,
                    name: cur.vehicleId,
                    sub: plate(cur.plateNumber),
                    problem: o.vehicleIssue ? 'Out of service' : null
                },
                items: o.vehicles.map(v => ({
                    id: v.vehicleId, name: v.vehicleId, sub: plate(v.plateNumber),
                    tier: v.tier, rank: v.rank, warning: v.warning, reason: v.reason, facts: v.facts
                })),
                selected: rtmStartingPick(o.vehicleIssue, o.vehicles[0], cur.vehicleId, v => v.vehicleId),
                shortfall: o.vehicleShortfall
            });

            side.keepName.textContent = cur.vehicleId;
            side.keepSub.textContent = plate(cur.plateNumber);
            side.keepSub.hidden = !cur.plateNumber;
            rtmOpenSide(side, !!o.vehicleIssue);
        }

        function refreshRtmDrivers() {
            if (!_rtmOptions) return;

            const o = _rtmOptions;
            const cur = o.currentDriver;
            const side = sides.driver;
            const onLeave = (o.issues || []).indexOf('driver_on_leave') !== -1;

            side.list = RsCandidateList.create(side.host, {
                kind: 'driver',
                label: 'Driver',
                current: {
                    id: cur.driverId,
                    name: cur.driverName,
                    problem: o.driverIssue ? (onLeave ? 'On approved leave that day' : 'Cannot drive this trip') : null
                },
                items: o.drivers.map(d => ({
                    id: d.driverId, name: d.driverName,
                    tier: d.tier, rank: d.rank, warning: d.warning, reason: d.reason, facts: d.facts
                })),
                onLeave: o.driversOnLeave.map(d => ({ id: d.driverId, name: d.driverName, reason: d.reason })),
                selected: rtmStartingPick(o.driverIssue, o.drivers[0], cur.driverId, d => d.driverId),
                shortfall: o.driverShortfall
            });

            side.keepName.textContent = cur.driverName;
            side.keepSub.textContent = '';
            side.keepSub.hidden = true;
            rtmOpenSide(side, !!o.driverIssue);
        }

        // Submit.
        // Holds a reassignment blocked by an overridable conflict, so the override
        // confirmation can re-send it with override:true.
        let _rtmPending = null;

        window.submitReassign = async function (force) {
            if (!_rtmOptions) return;

            // What each list has chosen, falling back to the current assignment.
            const vehicleId = (sides.vehicle.list && sides.vehicle.list.value()) || _rtmOptions.tripInfo.currentVehicleId;
            const driverId  = parseInt(sides.driver.list && sides.driver.list.value()) || _rtmOptions.tripInfo.currentDriverId;

            const routeId = parseInt(routeSel.value) || _rtmOptions.tripInfo.currentRouteId;

            const payload = {
                tripId: _rtmTripId,
                vehicleId: vehicleId || null,
                driverId,
                routeId,
                override: !!force,
                source: 'reassign'
            };

            saveBtn.disabled = true;
            document.getElementById('rtm-save-label').style.display  = 'none';
            document.getElementById('rtm-save-spinner').style.display = 'inline-flex';

            try {
                const res = await fetch('/Dispatch/ReassignTrip', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                // 409 = overridable schedule conflict -> let the dispatcher confirm + force.
                if (res.status === 409) {
                    const data = await res.json().catch(() => ({}));
                    _rtmPending = payload;
                    rtmShowOverride(data.conflict || 'This assignment conflicts with an existing booking.');
                    return;
                }

                if (!res.ok) { closeReassignModal(); dpShowMsg([await res.text() || 'Failed to reassign trip. Please try again.']); return; }

                closeReassignModal();
                window.location.reload();

            } catch {
                dpShowMsg(['Failed to reassign trip. Please try again.']);
            } finally {
                saveBtn.disabled = false;
                document.getElementById('rtm-save-label').style.display  = 'inline';
                document.getElementById('rtm-save-spinner').style.display = 'none';
            }
        };

        // Override confirmation (step 2).
        function rtmShowOverride(message) {
            document.getElementById('rtm-override-msg').textContent = message;
            document.getElementById('rtm-override-modal').style.display = 'flex';
        }

        window.rtmCancelOverride = function () {
            document.getElementById('rtm-override-modal').style.display = 'none';
            _rtmPending = null;   // dispatcher backed out -> drop the blocked attempt
        };

        window.rtmConfirmOverride = function () {
            document.getElementById('rtm-override-modal').style.display = 'none';
            if (!_rtmPending) return;
            _rtmPending = null;
            submitReassign(true);   // re-send with override:true (skips the conflict gate)
        };

        // Remove trip.
        window.rtmAskRemove = function () {
            if (!_rtmOptions) return;
            document.getElementById('rtm-remove-modal').style.display = 'flex';
        };

        window.rtmCancelRemove = function () {
            document.getElementById('rtm-remove-modal').style.display = 'none';
        };

        window.rtmConfirmRemove = async function () {
            document.getElementById('rtm-remove-modal').style.display = 'none';

            saveBtn.disabled = true;
            document.getElementById('rtm-save-label').style.display  = 'none';
            document.getElementById('rtm-save-spinner').style.display = 'inline-flex';

            try {
                const res = await fetch('/Dispatch/RemoveTrip', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tripId: _rtmTripId })
                });

                if (!res.ok) { closeReassignModal(); dpShowMsg([await res.text() || 'Failed to remove trip. Please try again.']); return; }

                closeReassignModal();
                window.location.reload();

            } catch {
                dpShowMsg(['Failed to remove trip. Please try again.']);
            } finally {
                saveBtn.disabled = false;
                document.getElementById('rtm-save-label').style.display  = 'inline';
                document.getElementById('rtm-save-spinner').style.display = 'none';
            }
        };

    })();
</script>
