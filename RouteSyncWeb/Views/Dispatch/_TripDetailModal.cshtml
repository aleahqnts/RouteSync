@* Views/Dispatch/_TripDetailModal.cshtml *@

@* What a driver photographed at a fault, opened from the fault's row. A sibling of the
   trip dialog rather than a child, and above it, so Escape and a click outside close the
   photograph first and leave the trip open underneath. *@
<div id="tdmPhotoOverlay" data-dialog-close="closeTripPhoto" class="tdm-overlay tdm-photo-overlay"
     role="dialog" aria-modal="true" aria-labelledby="tdm-photo-title" style="display:none;">
    <div class="tdm-dialog tdm-photo-dialog">
        <div class="tdm-header">
            <h2 class="tdm-photo-title" id="tdm-photo-title">Inspection Photo</h2>
            <button class="tdm-close" onclick="closeTripPhoto()" aria-label="Close">&times;</button>
        </div>
        <div class="tdm-photo-body" id="tdm-photo-body"></div>
    </div>
</div>

<div id="tripDetailModal" data-dialog-close="closeTripModal" class="tdm-overlay" role="dialog" aria-modal="true" style="display:none;">
    <div class="tdm-dialog">

        @* Header *@
        <div class="tdm-header">
            <h2 class="tdm-title">TRIP <span id="tdm-trip-id">—</span></h2>
            <button class="tdm-close" onclick="closeTripModal()">&times;</button>
        </div>

        @* Loading *@
        <div id="tdm-loading" class="tdm-loading">
            <div class="tdm-spinner"></div>
            <span>Loading trip details…</span>
        </div>

        @* Content *@
        <div id="tdm-content" style="display:none;">

            @* Trip Information *@
            <div class="tdm-section-header">
                <span class="tdm-section-title">Trip Information</span>
                <span id="tdm-status-badge" class="tdm-badge"></span>
            </div>
            <div class="tdm-section-body">
                <div class="tdm-info-grid">
                    <div class="tdm-info-item">
                        <span class="tdm-label">Shift Type</span>
                        <span class="tdm-value" id="tdm-shift-type">—</span>
                    </div>
                    <div class="tdm-info-item">
                        <span class="tdm-label">Shift Time</span>
                        <span class="tdm-value" id="tdm-shift-time">—</span>
                    </div>
                    <div class="tdm-info-item">
                        <span class="tdm-label">Route</span>
                        <span class="tdm-value" id="tdm-route">—</span>
                    </div>
                    @* The one hour break. A picker while the shift can still change, and the
                       slot as text once it cannot. *@
                    <div class="tdm-info-item tdm-info-item--break">
                        <label class="tdm-label" for="tdm-break-select">Break</label>
                        <span class="tdm-value" id="tdm-break">—</span>
                        <select id="tdm-break-select" class="tdm-break-select" hidden></select>
                        <span id="tdm-break-note" class="tdm-break-note" hidden></span>
                    </div>
                </div>
            </div>

            @* Trip Summary (completed trips only) *@
            <div id="tdm-summary-section" style="display:none;">
                <div class="tdm-section-header">
                    <span class="tdm-section-title">Trip Summary</span>
                </div>
                <div class="tdm-section-body">
                    <div class="tdm-info-grid">
                        <div class="tdm-info-item">
                            <span class="tdm-label">Start Time</span>
                            <span class="tdm-value" id="tdm-actual-start">—</span>
                        </div>
                        <div class="tdm-info-item">
                            <span class="tdm-label">End Time</span>
                            <span class="tdm-value" id="tdm-actual-end">—</span>
                        </div>
                        <div class="tdm-info-item">
                            <span class="tdm-label">Total Boarded</span>
                            <span class="tdm-value" id="tdm-total-boarded">—</span>
                        </div>
                        <div class="tdm-info-item">
                            <span class="tdm-label">Revenue</span>
                            <span class="tdm-value" id="tdm-revenue">—</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Assignment Information *@
            <div class="tdm-section-header">
                <span class="tdm-section-title">Assignment Information</span>
            </div>

            @* Vehicle Details *@
            <div class="tdm-subsection-header">Vehicle Details</div>
            <div class="tdm-section-body">
                <div class="tdm-info-grid">
                    <div class="tdm-info-item">
                        <span class="tdm-label">Vehicle ID</span>
                        <span class="tdm-value" id="tdm-vehicle-id">—</span>
                    </div>
                    <div class="tdm-info-item">
                        <span class="tdm-label">Plate Number</span>
                        <span class="tdm-value" id="tdm-plate">—</span>
                    </div>
                    <div class="tdm-info-item">
                        <span class="tdm-label">Status</span>
                        <span class="tdm-value" id="tdm-vehicle-status">—</span>
                    </div>
                </div>

                @* Inspection Log Accordion *@
                <div class="tdm-accordion">
                    <button class="tdm-accordion-btn" onclick="toggleInspectionLog()">
                        <span>View Inspection Log</span>
                        <svg class="tdm-accordion-chevron" id="tdm-chevron"
                             xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                    <div class="tdm-accordion-body" id="tdm-inspection-body" style="display:none;">

                        <div class="tdm-insp-card">
                            <div class="tdm-insp-card-header">
                                <span class="tdm-insp-card-title">Inspection Log</span>
                                <span id="tdm-insp-badge" class="tdm-badge"></span>
                            </div>
                            <div class="tdm-insp-card-body">
                                <div class="tdm-insp-row">
                                    <span class="tdm-insp-row-label">Reported By:</span>
                                    <span id="tdm-insp-reporter">—</span>
                                </div>
                                <div class="tdm-insp-row">
                                    <span class="tdm-insp-row-label">Time of Report:</span>
                                    <span id="tdm-insp-time">—</span>
                                </div>
                                @* One row per failed item, so a photograph can sit beside
                                   the item it shows rather than trailing a joined list. *@
                                <div class="tdm-insp-issues-wrap" id="tdm-insp-issue-row" style="display:none;">
                                    <div class="tdm-insp-row-label">Issues:</div>
                                    <ul class="tdm-insp-issues" id="tdm-insp-issues"></ul>
                                </div>
                                <div id="tdm-insp-remarks-wrap" style="display:none;">
                                    <div class="tdm-insp-row-label" style="margin-bottom:6px;">Remarks:</div>
                                    <div class="tdm-notes-box tdm-notes-box--highlight" id="tdm-insp-remarks"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            @* Driver Details *@
            <div class="tdm-subsection-header">Driver Details</div>
            <div class="tdm-section-body" style="border-bottom:none;">
                <div class="tdm-info-grid">
                    <div class="tdm-info-item">
                        <span class="tdm-label">Driver Name</span>
                        <span class="tdm-value" id="tdm-driver-name">—</span>
                    </div>
                    <div class="tdm-info-item">
                        <span class="tdm-label">Driver ID</span>
                        <span class="tdm-value" id="tdm-driver-id">—</span>
                    </div>
                    <div class="tdm-info-item">
                        <span class="tdm-label">Status</span>
                        <span class="tdm-value" id="tdm-driver-status">—</span>
                    </div>
                </div>
            </div>

        </div>@* /tdm-content *@
        @* Error *@
        <div id="tdm-error" class="tdm-error" style="display:none;">
            <i class="ti ti-alert-circle"></i> Failed to load trip details. Please try again.
        </div>

    </div>
</div>


<script>
    function openTripModal(tripId) {
        document.getElementById('tripDetailModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
        loadTripDetails(tripId);
    }

    function closeTripModal() {
        closeTripPhoto();
        document.getElementById('tripDetailModal').style.display = 'none';
        document.body.style.overflow = '';
        document.getElementById('tdm-inspection-body').style.display = 'none';
        document.getElementById('tdm-chevron').classList.remove('open');
    }

    // Opens the photographs of one failed item, newest first.
    //
    // Asked for by row identifier. The stored path never reaches the page, because the
    // key behind the image endpoint would fetch any path it was handed. Built as elements
    // rather than markup, so a label typed by an admin stays text.
    function openTripPhoto(label, photos) {
        const body = document.getElementById('tdm-photo-body');
        document.getElementById('tdm-photo-title').textContent = label || 'Inspection Photo';

        body.replaceChildren();
        photos.forEach(function (p) {
            const figure = document.createElement('figure');
            figure.className = 'tdm-photo';

            const img = document.createElement('img');
            img.src = '@Url.Action("InspectionPhoto", "Dispatch")?photoId=' + encodeURIComponent(p.photoId);
            img.alt = 'Photograph taken during the inspection';

            // Worded without a cause. A failed image cannot say whether the photograph
            // aged out after the trip was opened or the server could not fetch it, and
            // naming the wrong one sends whoever reads it looking in the wrong place.
            img.onerror = function () {
                const gone = document.createElement('p');
                gone.className = 'tdm-photo-gone';
                gone.textContent = 'This photo could not be loaded.';
                figure.replaceChildren(gone);
            };

            const caption = document.createElement('figcaption');
            caption.textContent = p.takenAt || '';

            figure.append(img, caption);
            body.appendChild(figure);
        });

        // The dialog takes its width from the photograph, so it opens once the first one
        // has arrived rather than appearing narrow and jumping wider. The wait is short
        // and capped: a slow connection gets the dialog promptly and the jump with it,
        // which is better than a click that seems to do nothing.
        const opening = ++tdmPhotoOpening;
        const first = body.querySelector('img');
        Promise.race([
            first ? first.decode().catch(function () { }) : Promise.resolve(),
            new Promise(function (resolve) { setTimeout(resolve, 400); })
        ]).then(function () {
            // Closed, or another photograph asked for, while this one was arriving.
            if (opening !== tdmPhotoOpening) return;
            document.getElementById('tdmPhotoOverlay').style.display = 'flex';
        });
    }

    var tdmPhotoOpening = 0;

    function closeTripPhoto() {
        tdmPhotoOpening++;
        const overlay = document.getElementById('tdmPhotoOverlay');
        if (!overlay || overlay.style.display === 'none') return;
        overlay.style.display = 'none';
        document.getElementById('tdm-photo-body').replaceChildren();
    }

    document.getElementById('tdmPhotoOverlay').addEventListener('click', function (e) {
        if (e.target === this) closeTripPhoto();
    });

    document.getElementById('tripDetailModal').addEventListener('click', function (e) {
        if (e.target === this) closeTripModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeTripModal();
    });

    function toggleInspectionLog() {
        const body = document.getElementById('tdm-inspection-body');
        const chevron = document.getElementById('tdm-chevron');
        const isOpen = body.style.display !== 'none';
        body.style.display = isOpen ? 'none' : 'block';
        chevron.classList.toggle('open', !isOpen);
    }

    function applyStatusBadge(el, status) {
        const map = {
            'Active':           ['tdm-badge--active',     'Active'],
            'Assignment Issue': ['tdm-badge--issue',      'Assignment Issue'],
            'Not Yet Started':  ['tdm-badge--not-started','Not Yet Started'],
            'Pending':          ['tdm-badge--pending',    'Pending'],
            'Missed':           ['tdm-badge--missed',     'Missed'],
            'Completed':        ['tdm-badge--completed',  'Completed'],
        };
        const [cls, label] = map[status] ?? ['tdm-badge--completed', status];
        el.className = 'tdm-badge ' + cls;
        el.textContent = label;
    }

    function statusDot(status) {
        const map = {
            'On Trip':         'tdm-dot--green',
            'Available':       'tdm-dot--blue',
            'Ready to Deploy': 'tdm-dot--blue',
            'Flagged':         'tdm-dot--red',
            'Unavailable':     'tdm-dot--red',
            'Pending':         'tdm-dot--yellow',
            'Completed':       'tdm-dot--gray',
        };
        return `<span class="tdm-dot ${map[status] ?? 'tdm-dot--gray'}"></span>${status}`;
    }

    function applyInspectionBadge(el, status) {
        // Skipped is not Pending. The bus was inspected earlier in the day and this shift
        // stood on that, so reading it as an inspection nobody has done yet would send a
        // dispatcher chasing one that already exists.
        const map = {
            'Passed':              ['tdm-badge--passed',  'Passed'],
            'Passed with Defects': ['tdm-badge--defects', 'Passed with defects'],
            'Failed':              ['tdm-badge--failed',  'Failed'],
            'Skipped':             ['tdm-badge--passed',  'Carried over'],
            'Pending':             ['tdm-badge--pending', 'Pending'],
        };
        const [cls, label] = map[status] ?? ['tdm-badge--pending', 'Pending'];
        el.className = 'tdm-badge ' + cls;
        el.textContent = label;
    }

    // ---- Break --------------------------------------------------------------------
    //
    // Saved the moment another slot is picked, the same as a board action: there is no
    // form here to submit, and a picker that needs a second press is one that gets left
    // showing a slot nobody saved.

    let tdmBreakTrip = null;

    function tdmBreakText(d) {
        if (!d.breakLabel) return 'Not set';
        return d.onBreak ? d.breakLabel + ' · on break now' : d.breakLabel;
    }

    function renderBreak(d) {
        const text = document.getElementById('tdm-break');
        const select = document.getElementById('tdm-break-select');
        const note = document.getElementById('tdm-break-note');

        tdmBreakTrip = d.tripId;
        note.hidden = true;
        note.classList.remove('tdm-break-note--bad');
        text.textContent = tdmBreakText(d);

        if (!d.breakEditable || !d.breakOptions?.length) {
            text.hidden = false;
            select.hidden = true;
            return;
        }

        select.replaceChildren();
        if (!d.breakStart) {
            const none = document.createElement('option');
            none.value = '';
            none.textContent = 'Not set';
            none.disabled = true;
            select.appendChild(none);
        }
        d.breakOptions.forEach(function (o) {
            const opt = document.createElement('option');
            opt.value = o.value;
            opt.textContent = o.others === 0 ? o.label
                : o.label + ' (' + o.others + (o.others === 1 ? ' other bus)' : ' other buses)');
            select.appendChild(opt);
        });
        select.value = d.breakStart ?? '';
        select.dataset.saved = select.value;

        text.hidden = !d.onBreak;
        if (d.onBreak) text.textContent = 'On break now';
        select.hidden = false;
    }

    document.getElementById('tdm-break-select').addEventListener('change', async function () {
        const select = this;
        const note = document.getElementById('tdm-break-note');
        const trip = tdmBreakTrip;

        select.disabled = true;
        note.hidden = true;
        try {
            const res = await fetch('/Dispatch/SetBreak', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tripId: trip, breakStart: select.value })
            });
            if (!res.ok) {
                const said = (await res.text() || '').trim();
                throw new Error(said && said.length < 200 && said[0] !== '<' && said[0] !== '{'
                    ? said : 'The break could not be saved. Try again.');
            }
            if (trip !== tdmBreakTrip) return;
            select.dataset.saved = select.value;
            // Whether the bus is on break now was worked out for the slot it just left.
            document.getElementById('tdm-break').hidden = true;
            note.textContent = 'Saved. The driver has been told.';
            note.classList.remove('tdm-break-note--bad');
        } catch (e) {
            if (trip !== tdmBreakTrip) return;
            select.value = select.dataset.saved;
            note.textContent = e.message;
            note.classList.add('tdm-break-note--bad');
        } finally {
            select.disabled = false;
            note.hidden = false;
        }
    });

    function formatIssueKey(key) {
        return key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    async function loadTripDetails(tripId) {
        document.getElementById('tdm-loading').style.display  = 'flex';
        document.getElementById('tdm-content').style.display  = 'none';
        document.getElementById('tdm-error').style.display    = 'none';

        try {
            const res = await fetch(`/Dispatch/GetTripDetails?id=${encodeURIComponent(tripId)}`);
            if (!res.ok) throw new Error();
            const d = await res.json();

            // Header
            document.getElementById('tdm-trip-id').textContent = d.tripId;
            applyStatusBadge(document.getElementById('tdm-status-badge'), d.tripStatus);

            // Trip info
            document.getElementById('tdm-shift-type').textContent = d.shiftType ?? '—';
            document.getElementById('tdm-shift-time').textContent =
                (d.shiftStartTime && d.shiftEndTime) ? `${d.shiftStartTime} – ${d.shiftEndTime}` : '—';
            document.getElementById('tdm-route').textContent = d.routeName ?? '—';
            renderBreak(d);

            // Trip Summary (completed only)
            const summary = document.getElementById('tdm-summary-section');
            if (d.isCompleted) {
                document.getElementById('tdm-actual-start').textContent  = d.actualStartTime ?? '—';
                document.getElementById('tdm-actual-end').textContent    = d.actualEndTime ?? '—';
                document.getElementById('tdm-total-boarded').textContent =
                    (d.totalBoarded ?? 0) + ' passengers';
                document.getElementById('tdm-revenue').textContent =
                    '₱' + Number(d.estimatedRevenue ?? 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                summary.style.display = 'block';
            } else {
                summary.style.display = 'none';
            }

            // Vehicle
            document.getElementById('tdm-vehicle-id').textContent   = d.vehicleId   ?? '—';
            document.getElementById('tdm-plate').textContent        = d.plateNumber  ?? '—';
            document.getElementById('tdm-vehicle-status').innerHTML = statusDot(d.vehicleStatus);

            // Driver
            document.getElementById('tdm-driver-name').textContent   = d.driverName ?? '—';
            document.getElementById('tdm-driver-id').textContent     = d.driverId;
            document.getElementById('tdm-driver-status').innerHTML   = statusDot(d.driverStatus);

            // Inspection Log card
            const inspBadge   = document.getElementById('tdm-insp-badge');
            const inspReporter = document.getElementById('tdm-insp-reporter');
            const inspTime    = document.getElementById('tdm-insp-time');
            const inspIssueRow = document.getElementById('tdm-insp-issue-row');
            const inspIssues  = document.getElementById('tdm-insp-issues');
            const inspRemarksWrap = document.getElementById('tdm-insp-remarks-wrap');
            const inspRemarks = document.getElementById('tdm-insp-remarks');

            inspIssueRow.style.display     = 'none';
            inspRemarksWrap.style.display  = 'none';

            if (!d.checklist) {
                // No checklist submitted yet → bus is still Pending
                applyInspectionBadge(inspBadge, 'Pending');
                inspReporter.textContent = '—';
                inspTime.textContent     = '—';
                inspRemarks.textContent  = 'No inspection log submitted for this trip yet.';
                inspRemarksWrap.style.display = 'block';
            } else {
                // The badge now shows the inspection's own outcome, which distinguishes
                // a bus that was grounded from one that merely reported defects.
                const status = d.checklist.checklistStatus ?? 'Pending';
                const passed = status.toLowerCase() === 'passed';
                applyInspectionBadge(inspBadge, status);

                inspReporter.textContent = d.driverName ?? '—';
                inspTime.textContent = new Date(d.checklist.submittedAt).toLocaleString('en-PH',
                    { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });

                const remarks = [];
                if (d.checklist.notes) remarks.push(d.checklist.notes);

                // One row per failed item, read from the inspection itself. What grounds
                // the bus arrives first from the server, which is where a dispatcher
                // deciding on a reassignment looks. A photograph sits at the right of the
                // item it shows.
                const issues = passed ? [] : (d.inspectionIssues ?? []);
                inspIssues.replaceChildren();
                issues.forEach(function (issue) {
                    const row = document.createElement('li');
                    row.className = 'tdm-insp-issue';

                    const name = document.createElement('span');
                    name.className = 'tdm-insp-issue-label';
                    name.textContent = formatIssueKey(issue.label ?? '');
                    row.appendChild(name);

                    const photos = issue.photos ?? [];
                    if (photos.length > 0) {
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'tdm-photo-chip';
                        chip.title = 'Photographed by the driver during the inspection';
                        chip.setAttribute('aria-label',
                            photos.length === 1 ? 'View photo' : 'View ' + photos.length + ' photos');
                        chip.innerHTML = '<span class="tdm-photo-chip-mark" aria-hidden="true">▣</span>';
                        chip.append(String(photos.length));
                        chip.addEventListener('click', function () {
                            openTripPhoto(name.textContent, photos);
                        });
                        row.appendChild(chip);
                    } else if (issue.photoExpired) {
                        const gone = document.createElement('span');
                        gone.className = 'tdm-photo-expired';
                        gone.title = 'Photographs are kept for thirty days after the order closes';
                        gone.textContent = 'Photo expired';
                        row.appendChild(gone);
                    }

                    inspIssues.appendChild(row);
                });
                if (issues.length > 0) inspIssueRow.style.display = 'block';

                if (!passed) d.maintenanceLogs?.forEach(l => { if (l.remarks) remarks.push(l.remarks); });

                if (remarks.length > 0) {
                    inspRemarks.textContent = remarks.join(' ');
                    inspRemarksWrap.style.display = 'block';
                }
            }

            document.getElementById('tdm-loading').style.display = 'none';
            document.getElementById('tdm-content').style.display = 'block';

        } catch {
            document.getElementById('tdm-loading').style.display = 'none';
            document.getElementById('tdm-error').style.display   = 'block';
        }
    }
</script>
