<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new phone. The stored device id and its token
     are this phone's identity: a copy restored onto another phone would claim the same
     trips under the same name. A replacement phone is set up fresh with the passcode. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
