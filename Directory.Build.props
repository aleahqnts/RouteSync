<Project>

  <!--
    One version for the whole RouteSync suite, read from the git tag at build time.

    A commit tagged v1.2.0 builds as 1.2.0. A commit after it builds as the next minor
    release in preview, 1.3.0-alpha.0.4 for the fourth commit, so a build between releases
    can never be mistaken for one. The informational version also carries the commit it
    was built from, which is what the dashboard shows beside the number.

    The tag has to be in the checkout. A shallow clone has none and builds as 0.0.0, which
    is why the deploy workflow fetches the full history.

    The camera app is built by Gradle and reads the same tag itself, in its build script.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
